<?xml version="1.0" encoding="utf-8"?>
<!--
    Dispositivos USB para los que Android ofrece «abrir Nexo cuando se conecte» (placas de desarrollo y adaptadores USB↔serie).
    Con ese ofrecimiento (y si el usuario marca «usar siempre» para ese dispositivo) Android recuerda el permiso USB y Nexo no
    tiene que volver a preguntar cada vez que se enchufa. No lleva teclados, ratones ni discos: esos no los abre Nexo.
    Los identificadores van en decimal (así lo exige el formato); entre paréntesis, en hexadecimal.
-->
<resources>
    <!-- Cualquier dispositivo CDC-ACM (Arduino con ATmega16U2/32U4, ESP32-S2/S3/C3, Pi Pico, CH9102, etc.) -->
    <usb-device class="2" subclass="2" />

    <usb-device vendor-id="9025" />   <!-- 0x2341 Arduino -->
    <usb-device vendor-id="10755" />  <!-- 0x2A03 Arduino.org -->
    <usb-device vendor-id="6991" />   <!-- 0x1B4F SparkFun -->
    <usb-device vendor-id="9114" />   <!-- 0x239A Adafruit -->
    <usb-device vendor-id="5824" />   <!-- 0x16C0 Teensy -->
    <usb-device vendor-id="12346" />  <!-- 0x303A Espressif -->
    <usb-device vendor-id="11914" />  <!-- 0x2E8A Raspberry Pi -->
    <usb-device vendor-id="6790" />   <!-- 0x1A86 QinHeng: CH340 / CH341 -->
    <usb-device vendor-id="4292" />   <!-- 0x10C4 Silicon Labs: CP210x -->
    <usb-device vendor-id="1027" />   <!-- 0x0403 FTDI -->
</resources>
