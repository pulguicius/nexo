#!/usr/bin/env bash
# NEXO-TOOLS 2.4.0 — transferencia universal de archivos con HTTPS fijado por huella.
# 2.4.0 (integrado en Nexo 0.4.0): descubre y se empareja con otros dispositivos Nexo (código de un solo uso),
# explorador de terminal y web (gestor de archivos), escritura opcional con papelera, y «send/fetch» con un código.
# Propósito: compartir carpetas, recibir archivos y sincronizar por rsync/SSH.
# Dependencias: Bash >=4.3, Python 3 y OpenSSL; rsync/OpenSSH y Tkinter son opcionales.
# Compatibilidad: Termux, proot-distro y Linux; no requiere root.
# Verificación: ejecute `nexo-tools doctor` después de instalar con `nexo-tools install`.
# Seguridad: proteja token y pin TLS; no abra HTML no confiable; rsync nunca usa --delete.
# El pin SHA-256 del certificado autofirmado sustituye la validación de una PKI pública.
# Casos de regresión para tests/ si se separa este archivo: metadatos con &, \, =;
# rutas fuera de root y enlaces simbólicos; Range 0-0/416/ETag; reanudación SHA corrupta;
# doble arranque concurrente; rotación de token/certificado y PID reutilizado;
# nombres Unicode/NFD/reservados FAT; archivos vacíos/grandes/cambiantes; symlink escape;
# FIFO/socket; límites por bytes/profundidad/archivos; clasificación de apertura.

set -Eeuo pipefail
IFS=$' \t\n'

NEXO_TOOLS_VERSION="2.4.0"
NEXO_TOOLS_DISCOVER_PORT="${NEXO_TOOLS_DISCOVER_PORT:-8767}"
NEXO_TOOLS_RW="${NEXO_TOOLS_RW:-0}"
NEXO_TOOLS_ONLY="${NEXO_TOOLS_ONLY:-}"
NEXO_TOOLS_ANNOUNCE="${NEXO_TOOLS_ANNOUNCE:-1}"
NEXO_TOOLS_ACTIVE_EXTS="${NEXO_TOOLS_ACTIVE_EXTS:-.html,.htm,.xhtml,.svg,.xml,.xsl,.xslt,.js,.mjs,.cjs,.pdf,.docx,.docm,.xlsx,.xlsm,.pptx,.pptm,.odt,.ods,.odp,.epub,.jar,.apk,.exe,.msi,.dmg,.pkg,.deb,.rpm,.appimage,.sh,.bash,.zsh,.py,.rb,.pl,.bat,.cmd,.ps1,.lnk,.desktop,.url,.webloc,.hta,.chm}"
NEXO_TOOLS_PASSIVE_EXTS="${NEXO_TOOLS_PASSIVE_EXTS:-.png,.jpg,.jpeg,.gif,.webp,.bmp,.tiff,.tif,.heic,.avif,.ico,.mp3,.wav,.ogg,.oga,.flac,.m4a,.opus,.aac,.wma,.mp4,.mkv,.webm,.mov,.avi,.m4v,.mpg,.mpeg,.3gp,.txt,.md,.markdown,.log,.csv,.tsv,.json,.yaml,.yml,.toml,.ini,.conf,.cfg,.rst,.tex,.ttf,.otf,.woff,.woff2}"
NEXO_TOOLS_MAX_FILE_BYTES="${NEXO_TOOLS_MAX_FILE_BYTES:-0}"
NEXO_TOOLS_MAX_DEPTH="${NEXO_TOOLS_MAX_DEPTH:-64}"
NEXO_TOOLS_MAX_FILES="${NEXO_TOOLS_MAX_FILES:-100000}"
NEXO_TOOLS_ALLOW_SYMLINK_DOWNLOAD="${NEXO_TOOLS_ALLOW_SYMLINK_DOWNLOAD:-0}"
NEXO_TOOLS_HASH_SKIP_ABOVE="${NEXO_TOOLS_HASH_SKIP_ABOVE:-0}"
export NEXO_TOOLS_ACTIVE_EXTS NEXO_TOOLS_PASSIVE_EXTS NEXO_TOOLS_MAX_FILE_BYTES NEXO_TOOLS_MAX_DEPTH NEXO_TOOLS_MAX_FILES NEXO_TOOLS_ALLOW_SYMLINK_DOWNLOAD NEXO_TOOLS_HASH_SKIP_ABOVE
export NEXO_TOOLS_VERSION NEXO_TOOLS_DISCOVER_PORT
DEFAULT_PORT="${NEXO_TOOLS_PORT:-8766}"
PROBE_TIMEOUT=0.3
READY_RETRIES=40
READY_SLEEP=0.15
HAVE_PROC=0
[[ -d /proc && -r /proc/self/stat ]] && HAVE_PROC=1
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
SELF="$SELF_DIR/$(basename -- "${BASH_SOURCE[0]}")"
STATE_DIR="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/nexo-tools"
SERVER_META="$STATE_DIR/server.env"
SERVER_LOCK_MODE=""

# Colores solo cuando stdout es una terminal.
if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
    C_CYAN=$'\033[36m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'
else
    C_RESET=''; C_BOLD=''; C_DIM=''; C_CYAN=''; C_GREEN=''; C_YELLOW=''; C_RED=''
fi

say()  { printf '%b\n' "$*"; }
ok()   { say "${C_GREEN}✔${C_RESET} $*"; }
warn() { say "${C_YELLOW}⚠${C_RESET} $*" >&2; }
err()  { say "${C_RED}✘${C_RESET} $*" >&2; }

usage() {
    cat <<EOF
${C_BOLD}NEXO-TOOLS $NEXO_TOOLS_VERSION${C_RESET}
Transferencia local cifrada para Termux, proot-distro y Linux.

Uso:
  nexo-tools                         Abrir menú
  nexo-tools server [DIR] [PUERTO]   Compartir una carpeta por HTTPS (--rw escritura, --name NOMBRE)
  nexo-tools receive [URL] [opciones] Explorar y descargar archivos
  nexo-tools open RUTA               Abrir cualquier archivo local tras clasificarlo
  nexo-tools open-html ARCHIVO       Alias compatible para abrir archivos HTML
  nexo-tools status [--reveal]       Ver estado (token oculto por defecto)
  nexo-tools stop                    Detener el servidor HTTPS
  nexo-tools rsync-push [opciones]   Enviar una carpeta por rsync/SSH
  nexo-tools rsync-pull [opciones]   Recibir una carpeta por rsync/SSH
  nexo-tools install                 Instalar el comando global (recomendado)
  nexo-tools setup                   Preparar dependencias
  nexo-tools ssh-start|ssh-stop      Activar/detener SSH local
  nexo-tools doctor [--files]        Diagnóstico no interactivo; --files prueba FS y nombres
  nexo-tools rotate-token            Cambiar el token sin reiniciar HTTPS
  nexo-tools rotate-cert             Renovar certificado y reiniciar HTTPS
  nexo-tools logs [--follow|--verify] Ver registros del servidor o verificaciones
  nexo-tools --tui | --gui           Abrir interfaz de terminal o gráfica
  nexo-tools --html ARCHIVO          Abrir un HTML local
  nexo-tools --version               Imprimir solo la versión
  nexo-tools help                    Mostrar esta ayuda

Dispositivos Nexo (descubrir, emparejar, explorar):
  nexo-tools send ARCHIVO...         Enviar SOLO eso: da un código y espera a que el otro lo baje
  nexo-tools fetch IP[:PUERTO] CÓDIGO  Recibir lo que otro envía con «send» (empareja, baja y olvida)
  nexo-tools discover [-t SEG]       Buscar dispositivos Nexo en la red (los que tienen «server» activo)
  nexo-tools pair [--rw]             Código para que otro dispositivo se empareje con este
  nexo-tools connect IP[:PUERTO] --code CÓDIGO   Emparejarme con otro dispositivo (guarda su huella)
  nexo-tools devices | forget NOMBRE Ver / olvidar dispositivos emparejados
  nexo-tools browse NOMBRE           Explorador de terminal de un dispositivo emparejado
  nexo-tools ls NOMBRE [RUTA] [--ext .jpg,.png] [--find 'a*|b*'] [--types]   Listar (sin límite, todas las extensiones)
  nexo-tools get NOMBRE RUTA... [-o CARPETA] [--ext ..] [--find ..] [--all]  Bajar archivos o carpetas (reanudable, SHA-256)
  nexo-tools put NOMBRE ARCHIVO... [--to RUTA] [--overwrite]   Subir (si el otro te dio escritura)
  nexo-tools mkdir|mv|rm NOMBRE ...  Crear carpeta, mover/renombrar, borrar (a la papelera .nexo-trash del otro)
  nexo-tools web [--rw] [NOMBRE]     Gestor de archivos en el navegador (de este dispositivo o de uno emparejado)
  nexo-tools authorized | revoke ID  Quién puede entrar en este dispositivo / quitarle el acceso

Opciones rsync:
  --dry-run                          Mostrar lo que se transferiría
  --exclude PATRON                   Excluir patrón (se puede repetir)
  --bwlimit RATE                     Limitar velocidad (KiB/s, aproximado)
  --sparse                           Preservar archivos dispersos
  --hard-links                       Preservar enlaces duros
  --xattrs                           Preservar atributos extendidos si rsync lo admite
  --no-links                         Omitir enlaces simbólicos explícitamente

Recepción HTTPS:
  receive URL --token TOKEN --pin SHA256 --dest CARPETA [--max-bytes N]
  receive URL --auto-pin --fingerprint-file ARCHIVO --token TOKEN --dest CARPETA
  --fingerprint-file se actualiza al terminar una recepción sin --auto-pin.

Ejemplos:
  nexo-tools server ~/Documentos
  nexo-tools receive https://192.168.1.23:8766
  nexo-tools rsync-push --dry-run --exclude '*.tmp'
  nexo-tools doctor --files
  nexo-tools logs --verify
  nexo-tools open ~/Descargas/imagen.png

Preparación en Termux:
  pkg install python openssl rsync openssh python-tkinter
  termux-setup-storage
  Para la GUI, instala/abre también la app Android Termux:X11.

Motores:
  HTTPS: explorador remoto, descarga reanudable, SHA-256 y pin TLS.
  rsync/SSH: sincronización direccional; no usa --delete.
  TUI: terminal. GUI: Tkinter con DISPLAY/Termux:X11.

Tipos de archivo:
  • HTTPS transfiere cualquier contenido binario, incluidos archivos vacíos y grandes.
  • Los symlinks se muestran, pero no se descargan salvo NEXO_TOOLS_ALLOW_SYMLINK_DOWNLOAD=1.
  • HTTPS no preserva symlinks, hardlinks ni archivos dispersos; usa rsync-pull.
  • Abrir activos pide confirmación; pasivos se abren tras verificar integridad.

Seguridad:
  • El token es secreto; status lo oculta. Usa status --reveal solo en privado.
  • Verifica la huella SHA-256 por un canal confiable antes de introducir el token.
  • HTML, SVG, XML, PDF, documentos, scripts y tipos desconocidos se tratan como activos.
  • Los archivos activos recibidos permanecen en cuarentena hasta verificar SHA-256.
  • NEXO_TOOLS_OPEN_ALLOW puede restringir las extensiones que se permiten abrir.
  • Por defecto el servidor solo descarga. Con «server --rw» y un código «pair --rw» se permite escribir
    (nunca borra de verdad: lo borrado va a .nexo-trash dentro de la carpeta compartida).
  • Nunca se sirven claves ni tokens (el estado de nexo-tools, ~/.ssh, ~/.gnupg, ~/.config/nexo), ni compartiendo «/».
  • El token que muestra el servidor es de SOLO LECTURA; los dispositivos emparejados tienen su propio token y se revocan solos.

VARIABLES DE ENTORNO:
  NEXO_TOOLS_PORT       Puerto HTTPS (default 8766)
  NEXO_TOOLS_DISCOVER_PORT  Puerto UDP de anuncios (default 8767)
  NEXO_TOOLS_IP         Forzar la IPv4 que se muestra y se anuncia (por defecto se detecta la del Wi-Fi)
  NEXO_TOOLS_DEVICE     Nombre con el que este dispositivo se anuncia
  NEXO_TOOLS_RW=1       Equivale a «server --rw»
  NEXO_TOOLS_MAX_UPLOAD_BYTES  Máximo por archivo subido (0 = ilimitado)
  NEXO_TOOLS_BWLIMIT    Bytes/s del servidor (0 = sin límite; aproximado)
  NEXO_TOOLS_REVEAL=1   Mostrar token en status
  NEXO_TOOLS_NOTIFY=1   Notificaciones al terminar transferencias
  NEXO_TOOLS_MAX_FILE_BYTES  Máximo por archivo (0 = ilimitado)
  NEXO_TOOLS_MAX_DEPTH       Profundidad máxima al descargar carpetas (64)
  NEXO_TOOLS_MAX_FILES       Máximo de archivos por operación (100000)
  NEXO_TOOLS_ALLOW_SYMLINK_DOWNLOAD=1  Permitir seguir symlinks dentro del root
  NEXO_TOOLS_OPEN_ALLOW      Lista separada por comas de extensiones permitidas
  NEXO_TOOLS_HASH_SKIP_ABOVE Umbral para omitir SHA-256 (0 = nunca)
  XDG_STATE_HOME             Directorio base de estado (default ~/.local/state)
EOF
}

require_runtime() {
    local missing=0
    command -v python3 >/dev/null 2>&1 || { err "Falta Python 3. Instálalo con: pkg install python (Termux)"; missing=1; }
    command -v openssl >/dev/null 2>&1 || { err "Falta OpenSSL. Instálalo con: pkg install openssl (Termux)"; missing=1; }
    if [[ "$missing" -ne 0 ]]; then return 1; fi
    python3 -c 'import ssl, http.server, hashlib' >/dev/null 2>&1 || {
        err "La instalación de Python 3 no incluye los módulos SSL estándar."; return 1;
    }
}

ensure_state_dir() {
    mkdir -p -- "$STATE_DIR" || { err "No se pudo crear $STATE_DIR"; return 1; }
    chmod 700 "$STATE_DIR" 2>/dev/null || true
}

human_size() {
    local n=${1:-0}
    awk -v n="$n" 'BEGIN { split("B KiB MiB GiB TiB PiB",u," "); i=1; while(n>=1024 && i<6){n/=1024;i++} if(i==1) printf "%.0f %s",n,u[i]; else printf "%.1f %s",n,u[i] }'
}

detect_fs_type() {
    local path=${1:-.} raw="" kind=unknown
    if [[ "${OSTYPE:-}" == darwin* ]]; then
        raw=$(stat -f '%T' "$path" 2>/dev/null || true)
    else
        raw=$(stat -f -c '%T' "$path" 2>/dev/null || true)
    fi
    case "${raw,,}" in
        ext2|ext3|ext4) kind=ext4 ;;
        xfs) kind=xfs ;;
        btrfs) kind=btrfs ;;
        f2fs) kind=f2fs ;;
        msdos|fat|vfat) kind=vfat ;;
        exfat) kind=exfat ;;
        fuseblk|ntfs) kind=msdos ;;
        apfs) kind=apfs ;;
        hfs|hfs+) kind=hfs ;;
    esac
    if [[ "$kind" == unknown && ( "$path" == /sdcard/* || "$path" == /storage/emulated/* || "$path" == */sdcard/* || "$path" == */storage/emulated/* ) ]]; then kind=vfat; fi
    printf '%s\n' "$kind"
}

classify_extension() {
    local ext=${1##*.}
    [[ "$1" == *.* ]] && ext=".${ext,,}" || ext=""
    case ",$NEXO_TOOLS_ACTIVE_EXTS," in *",$ext,"*) printf 'active\n'; return 0 ;; esac
    case ",$NEXO_TOOLS_PASSIVE_EXTS," in *",$ext,"*) printf 'passive\n'; return 0 ;; esac
    printf 'unknown\n'
}

acquire_server_lock() {
    ensure_state_dir || return 1
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$STATE_DIR/server.lock" || return 1
        chmod 600 "$STATE_DIR/server.lock" 2>/dev/null || true
        flock -x 9 || { exec 9>&-; return 1; }
        SERVER_LOCK_MODE=flock
    else
        local tries=0
        while ! mkdir "$STATE_DIR/.lock" 2>/dev/null; do
            ((tries+=1))
            (( tries < 300 )) || { err "No se pudo adquirir el bloqueo del servidor."; return 1; }
            sleep 0.1
        done
        SERVER_LOCK_MODE=mkdir
        trap 'release_server_lock' EXIT
    fi
}

release_server_lock() {
    case "$SERVER_LOCK_MODE" in
        flock) flock -u 9 2>/dev/null || true; exec 9>&- ;;
        mkdir) rmdir "$STATE_DIR/.lock" 2>/dev/null || true; trap - EXIT ;;
    esac
    SERVER_LOCK_MODE=""
}

notify_transfer_done() {
    [[ ! -t 1 || "${NEXO_TOOLS_NOTIFY:-0}" == 1 ]] || return 0
    if command -v termux-notification >/dev/null 2>&1; then
        termux-notification --title "NEXO-TOOLS" --content "Transferencia terminada" >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "NEXO-TOOLS" "Transferencia terminada" >/dev/null 2>&1 || true
    fi
}

# Devuelve la IP informada por la app Nexo. El JSON puede venir como data o envoltorio {ok,data}.
nexo_wifi_ip() {
    command -v nexo >/dev/null 2>&1 || return 1
    local raw ip
    # El contrato público de Nexo permite consultar ambos estados. Se prueba
    # primero el JSON y luego el texto legible (que muestra la IPv4 en la línea Wi-Fi).
    if command -v timeout >/dev/null 2>&1; then
        raw=$(timeout 3 nexo wifi status --json 2>/dev/null) || raw=""
    else
        raw=$(python3 -c 'import subprocess;
try: print(subprocess.run(["nexo","wifi","status","--json"],capture_output=True,text=True,timeout=3).stdout,end="")
except Exception: pass' 2>/dev/null) || raw=""
    fi
    if [[ -n "$raw" ]]; then
        ip=$(printf '%s' "$raw" | python3 -c '
import json,sys,ipaddress
try:
    obj=json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
# Nexo devuelve el objeto de datos en --json; aceptamos también envoltorios.
root=obj.get("data",obj) if isinstance(obj,dict) else obj
found=[]; disconnected=[]
def walk(x, key=""):
    if isinstance(x,dict):
        for k,v in x.items():
            kl=str(k).lower().replace("_", "")
            if kl in ("connected","wificonnected","isconnected") and v is False:
                disconnected.append(True)
            if kl in ("ip","ipv4","localip","ipaddress","ipv4address"):
                vals=v if isinstance(v,list) else [v]
                for val in vals:
                    if isinstance(val,str):
                        try:
                            a=ipaddress.ip_address(val.split("/")[0])
                            if a.version==4 and not a.is_loopback and not a.is_unspecified and a.is_private:
                                found.append(str(a))
                        except ValueError: pass
            walk(v,kl)
    elif isinstance(x,list):
        for v in x: walk(v,key)
walk(root)
if disconnected or not found: raise SystemExit(1)
print(found[0])
' 2>/dev/null) || ip=""
        [[ -n "$ip" ]] && { printf '%s\n' "$ip"; return 0; }
    fi
    # La salida textual de Nexo contiene, por ejemplo:
    # WiFi: conectado a MiCasa · -55 dBm · 5GHz · 192.168.1.23
    local cmdout
    for raw in "$( { command -v timeout >/dev/null 2>&1 && timeout 3 nexo wifi status || python3 -c 'import subprocess;
try: print(subprocess.run(["nexo","wifi","status"],capture_output=True,text=True,timeout=3).stdout,end="")
except Exception: pass'; } 2>/dev/null || true)" "$( { command -v timeout >/dev/null 2>&1 && timeout 3 nexo status || python3 -c 'import subprocess;
try: print(subprocess.run(["nexo","status"],capture_output=True,text=True,timeout=3).stdout,end="")
except Exception: pass'; } 2>/dev/null || true)"; do
        [[ -n "$raw" ]] || continue
        ip=$(printf '%s\n' "$raw" | python3 -c '
import sys,re,ipaddress
text=sys.stdin.read()
for line in text.splitlines():
    low=line.lower()
    if "wifi" not in low and "ip local" not in low and "ipv4" not in low:
        continue
    for candidate in re.findall(r"(?<![0-9])(?:[0-9]{1,3}\.){3}[0-9]{1,3}(?![0-9])",line):
        try:
            a=ipaddress.ip_address(candidate)
            if a.version==4 and a.is_private and not a.is_loopback and not a.is_unspecified:
                print(a); raise SystemExit(0)
        except ValueError: pass
raise SystemExit(1)
' 2>/dev/null) || ip=""
        [[ -n "$ip" ]] && { printf '%s\n' "$ip"; return 0; }
    done
    return 1
}

# Fallback sin enviar paquetes: un connect UDP solo permite al kernel escoger la ruta/IP.
route_wifi_ip() {
    python3 -c '
import socket,ipaddress
s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.settimeout(2)
try:
    s.connect(("1.1.1.1",80))
    ip=ipaddress.ip_address(s.getsockname()[0])
    if ip.is_loopback or ip.is_unspecified or not ip.is_private: raise SystemExit(1)
    print(ip)
finally:
    s.close()
' 2>/dev/null
}

local_interface_has_ip() {
    python3 - "$1" <<'PYIP'
import sys, socket, platform, subprocess, re
wanted=sys.argv[1]
if platform.system() == "Linux":
    try:
        import fcntl, struct
        s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM)
        try:
            for _,name in socket.if_nameindex():
                try:
                    req=struct.pack("256s",name.encode()[:15])
                    raw=fcntl.ioctl(s.fileno(),0x8915,req)
                    if socket.inet_ntoa(raw[20:24]) == wanted: raise SystemExit(0)
                except OSError: pass
        finally: s.close()
    except ImportError: pass
for command in (("ip","-o","-4","addr","show"),("ifconfig",)):
    try:
        out=subprocess.run(command,capture_output=True,text=True,timeout=2).stdout
        if re.search(r"(?<![0-9])"+re.escape(wanted)+r"(?![0-9])",out): raise SystemExit(0)
    except (OSError,subprocess.SubprocessError): pass
raise SystemExit(1)
PYIP
}

discover_ip() {
    local ip now
    if [[ -n "${NEXO_TOOLS_IP:-}" ]]; then
        python3 -c 'import sys,ipaddress; raise SystemExit(0 if ipaddress.ip_address(sys.argv[1]).version==4 else 1)' "$NEXO_TOOLS_IP" 2>/dev/null \
            || { err "NEXO_TOOLS_IP no es una IPv4 válida."; return 1; }
        printf '%s\n' "$NEXO_TOOLS_IP"; return 0
    fi
    now=$(date +%s 2>/dev/null || printf '0')
    if [[ -r "$STATE_DIR/.ip_cache" ]]; then
        ip=$(python3 - "$STATE_DIR/.ip_cache" <<'PYCACHE' 2>/dev/null || true
import os,sys,time,ipaddress
p=sys.argv[1]
try:
 st=os.stat(p)
 if time.time()-st.st_mtime <= 5:
  value=open(p,encoding="ascii").read().strip(); a=ipaddress.ip_address(value)
  if a.version==4 and not a.is_loopback and not a.is_unspecified: print(value)
except Exception: pass
PYCACHE
)
        if [[ -n "$ip" ]]; then printf '%s\n' "$ip"; return 0; fi
    fi
    if ip=$(nexo_wifi_ip) || ip=$(route_wifi_ip); then
        ( umask 077; printf '%s\n' "$ip" > "$STATE_DIR/.ip_cache" ) 2>/dev/null || true
        chmod 600 "$STATE_DIR/.ip_cache" 2>/dev/null || true
        printf '%s\n' "$ip"; return 0
    fi
    rm -f -- "$STATE_DIR/.ip_cache"
    return 1
}

read_meta_value() {
    local key=$1
    [[ -r "$SERVER_META" ]] || return 1
    python3 - "$SERVER_META" "$key" <<'PYMETA'
import sys
try:
    data=open(sys.argv[1],encoding="utf-8",errors="surrogateescape").read().splitlines()
except OSError: raise SystemExit(1)
for line in data:
    k,sep,v=line.partition("=")
    if sep and k==sys.argv[2]:
        print(v)
        raise SystemExit(0)
raise SystemExit(1)
PYMETA
}

read_meta_values() {
    [[ -r "$SERVER_META" ]] || return 1
    python3 - "$SERVER_META" "$@" <<'PYMETABATCH'
import sys
try: lines=open(sys.argv[1],encoding="utf-8",errors="surrogateescape").read().splitlines()
except OSError: raise SystemExit(1)
values={}
for line in lines:
    key,sep,value=line.partition("=")
    if sep: values[key]=value
for key in sys.argv[2:]: print(values.get(key,""))
PYMETABATCH
}

proc_start_ticks() {
    [[ "$HAVE_PROC" == 1 ]] || return 1
    python3 - "$1" <<'PYTICKS' 2>/dev/null
import sys
try:
    s=open('/proc/%s/stat' % sys.argv[1], encoding='ascii').read()
    rest=s.rsplit(')',1)[1].strip().split()
    print(rest[19])
except Exception: raise SystemExit(1)
PYTICKS
}

server_pid_is_ours() {
    local pid=$1 expected actual expected_lstart actual_lstart args
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    local proc_state
    proc_state=$(ps -o stat= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)
    [[ "$proc_state" == Z* || "$proc_state" == X* ]] && return 1
    local -a meta_values=()
    mapfile -t meta_values < <(read_meta_values START_TICKS START_LSTART PORT || true)
    expected=${meta_values[0]:-}; expected_lstart=${meta_values[1]:-}; local expected_port=${meta_values[2]:-}
    actual=$(proc_start_ticks "$pid" || true)
    if [[ "$HAVE_PROC" == 1 && -n "$expected" && -n "$actual" ]]; then
        [[ "$expected" == "$actual" ]] && return 0
        return 1
    fi
    actual_lstart=$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true)
    if [[ -n "$expected_lstart" && -n "$actual_lstart" ]]; then
        [[ "$expected_lstart" == "$actual_lstart" ]] && return 0
        return 1
    fi
    args=$(ps -o args= -p "$pid" 2>/dev/null || true)
    [[ -n "$args" && "$args" == *"$STATE_DIR/token"* && ( -z "$expected_port" || "$args" == *"$expected_port"* ) ]] && return 0
    return 1
}

show_server() {
    local pid root port url ip token fp reveal exp installed bwlimit srv_rw srv_only srv_name
    if [[ ! -r "$SERVER_META" ]]; then
        say "No hay un servidor NEXO-TOOLS registrado."
        if [[ -r "$STATE_DIR/installed.sha256" ]]; then installed=$(cat "$STATE_DIR/installed.sha256" 2>/dev/null || true); [[ -n "$installed" ]] && say "Hash instalado: ${installed%% *}"; fi
        return 0
    fi
    local -a meta_values=()
    mapfile -t meta_values < <(read_meta_values PID ROOT PORT URL IP TOKEN FINGERPRINT BWLIMIT RW ONLY DEVICE || true)
    pid=${meta_values[0]:-}; root=${meta_values[1]:-}; port=${meta_values[2]:-}; url=${meta_values[3]:-}
    ip=${meta_values[4]:-}; token=${meta_values[5]:-}; fp=${meta_values[6]:-}; bwlimit=${meta_values[7]:-0}
    srv_rw=${meta_values[8]:-0}; srv_only=${meta_values[9]:-}; srv_name=${meta_values[10]:-}
    reveal=0
    [[ "${NEXO_TOOLS_REVEAL:-0}" == 1 || "${1:-}" == --reveal ]] && reveal=1
    if [[ -n "$pid" ]] && server_pid_is_ours "$pid"; then
        say "${C_GREEN}${C_BOLD}● SERVIDOR ACTIVO${C_RESET}"
        say "Carpeta:       $root"; say "Dirección:     ${url:-https://$ip:$port}"
        say "Puerto:        $port"
        if (( reveal )); then say "Token:         $token"; else say "Token:         ******** (usa 'nexo-tools status --reveal' para verlo)"; fi
        say "Huella SHA256: $fp"; say "PID:           $pid"
        say "Nombre:        ${srv_name:-?}"; say "Modo:          $(mode_text "$srv_rw" "$srv_only")"
        if [[ "$bwlimit" =~ ^[0-9]+$ ]] && (( bwlimit > 0 )); then say "Límite HTTPS:   $(human_size "$bwlimit")/s (aproximado)"; else say "Límite HTTPS:   sin límite"; fi
        exp=$(openssl x509 -in "$STATE_DIR/server.crt" -noout -enddate 2>/dev/null | cut -d= -f2- || true)
        [[ -n "$exp" ]] && say "Expira:        $exp"
    else
        warn "El archivo de estado existe, pero no se pudo verificar que el proceso siga siendo nuestro."
        say "Ejecuta: nexo-tools stop"
    fi
    if [[ -r "$STATE_DIR/installed.sha256" ]]; then
        installed=$(cat "$STATE_DIR/installed.sha256" 2>/dev/null || true)
        [[ -n "$installed" ]] && say "Hash instalado: ${installed%% *}"
    fi
}

choose_share_dir() {
    python3 -c "$(cat <<'PYDIR'
import os,sys
cur=os.path.realpath(os.path.expanduser(sys.argv[1] if len(sys.argv)>1 else os.getcwd()))
page=0; page_size=20
def read_command():
    # os.read(0,1) evita que Python haga read-ahead de las siguientes
    # respuestas cuando este explorador se ejecuta dentro de $(...).
    buf=bytearray()
    while True:
        ch=os.read(0,1)
        if not ch: raise EOFError
        if ch == b"\r": continue
        if ch == b"\n": return buf.decode("utf-8","replace").strip()
        buf.extend(ch)
while True:
    try:
        if not os.path.isdir(cur) or not os.access(cur,os.R_OK|os.X_OK):
            print("No se puede leer esa carpeta:",cur,file=sys.stderr)
            cur=os.path.dirname(cur) or os.path.expanduser("~"); page=0
            continue
        dirs=[]
        with os.scandir(cur) as it:
            for e in it:
                try:
                    if e.is_dir(follow_symlinks=True): dirs.append(e.name)
                except OSError: pass
        dirs.sort(key=str.casefold)
        pages=max(1,(len(dirs)+page_size-1)//page_size)
        page=max(0,min(page,pages-1))
        start=page*page_size
        print("\nNEXO-TOOLS · ELEGIR CARPETA PARA COMPARTIR",file=sys.stderr)
        print("Carpeta actual: "+cur,file=sys.stderr)
        print(f"Subcarpetas: {len(dirs)} · Página {page+1}/{pages}",file=sys.stderr)
        print("─"*60,file=sys.stderr)
        for i,name in enumerate(dirs[start:start+page_size],start+1):
            print(f"{i:>3}. 📁 {name}",file=sys.stderr)
        if not dirs: print("(No hay subcarpetas)",file=sys.stderr)
        print("\nNúmero=entrar · s=compartir esta carpeta · u=subir · g RUTA=ir a ruta",file=sys.stderr)
        print("h=inicio · c=almacenamiento del teléfono (termux-setup-storage)",file=sys.stderr)
        print("n=siguiente · p=anterior · q=cancelar",file=sys.stderr)
        print("carpeta> ",end="",file=sys.stderr)
        cmd=read_command()
        low=cmd.lower()
        if low in ("s","share","usar"):
            print(os.path.realpath(cur)); raise SystemExit(0)
        if low in ("q","quit","cancelar"): raise SystemExit(1)
        if low=="h": cur=os.path.realpath(os.path.expanduser("~")); page=0; continue
        if low=="c":
            for cand in (os.path.expanduser("~/storage/shared"),"/storage/emulated/0","/sdcard"):
                if os.path.isdir(cand) and os.access(cand,os.R_OK|os.X_OK): cur=os.path.realpath(cand); page=0; break
            else: print("No encontré el almacenamiento del teléfono (¿ejecutaste termux-setup-storage?).",file=sys.stderr)
            continue
        if low in ("u",".."):
            parent=os.path.dirname(cur)
            if parent and parent!=cur: cur=parent; page=0
            continue
        if low=="n": page=min(page+1,pages-1); continue
        if low=="p": page=max(0,page-1); continue
        if low.startswith("g "):
            target=os.path.realpath(os.path.expanduser(cmd[2:].strip()))
            if os.path.isdir(target) and os.access(target,os.R_OK|os.X_OK): cur=target; page=0
            else: print("Ruta inexistente o sin permiso.",file=sys.stderr)
            continue
        if cmd.isdigit():
            idx=int(cmd)-1
            if start<=idx<min(start+page_size,len(dirs)):
                target=os.path.join(cur,dirs[idx])
                if os.path.isdir(target) and os.access(target,os.R_OK|os.X_OK): cur=os.path.realpath(target); page=0
            else: print("Número fuera de la página.",file=sys.stderr)
            continue
        print("Opción no reconocida.",file=sys.stderr)
    except (EOFError,KeyboardInterrupt):
        raise SystemExit(1)
PYDIR
)" "${1:-$PWD}"
}

_make_server_certificate() {
    local cert=$1 key=$2
    openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 365 \
        -keyout "$key" -out "$cert" -subj "/CN=NEXO-TOOLS local transfer" \
        >/dev/null 2>&1 || return 1
    chmod 600 "$key"; chmod 644 "$cert"
}

_start_server_locked() {
    local root=$1 port=$2 token cert key log pid ip fp url bind_ip probe_ip ready i lstart
    if [[ -r "$SERVER_META" ]]; then
        pid=$(read_meta_value PID || true)
        if [[ -n "$pid" ]] && server_pid_is_ours "$pid"; then
            warn "Ya hay un servidor activo; no se compartió la nueva carpeta."
            show_server
            return 3
        fi
    fi
    token=$(openssl rand -hex 24) || { err "No se pudo generar el token."; return 1; }
    cert="$STATE_DIR/server.crt"; key="$STATE_DIR/server.key"; log="$STATE_DIR/server.log"
    if [[ ! -s "$cert" || ! -s "$key" ]] || ! openssl x509 -in "$cert" -noout -checkend 604800 >/dev/null 2>&1; then
        [[ -s "$cert" || -s "$key" ]] && warn "El certificado vence en menos de 7 días; se renovará y cambiará la huella TLS."
        _make_server_certificate "$cert" "$key" || { err "No se pudo crear el certificado TLS."; return 1; }
    fi
    fp=$(openssl x509 -in "$cert" -noout -fingerprint -sha256 2>/dev/null | sed -E 's/^[^=]*=//; s/[[:space:]]//g; s/://g' | tr '[:lower:]' '[:upper:]')
    [[ "$fp" =~ ^[A-F0-9]{64}$ ]] || { err "No se pudo calcular la huella del certificado."; return 1; }
    ip=$(discover_ip || true)
    if [[ -z "$ip" ]] && command -v nexo >/dev/null 2>&1; then
        nexo start >/dev/null 2>&1 || true
        for ((i=0; i<4; i++)); do sleep 0.5; ip=$(discover_ip || true); [[ -n "$ip" ]] && break; done
    fi
    [[ -n "$ip" ]] || ip="127.0.0.1"
    : > "$log"; chmod 600 "$log"
    ( umask 077; printf '%s\n' "$token" > "$STATE_DIR/token" )
    chmod 600 "$STATE_DIR/token"
    bind_ip="0.0.0.0"; probe_ip="127.0.0.1"
    if [[ "$ip" != "127.0.0.1" ]] && local_interface_has_ip "$ip"; then bind_ip="$ip"; probe_ip="$ip"; fi
    local bwlimit_env=${NEXO_TOOLS_BWLIMIT:-0} device rw=${NEXO_TOOLS_RW:-0} only=${NEXO_TOOLS_ONLY:-} announce=${NEXO_TOOLS_ANNOUNCE:-1}
    device=${NEXO_TOOLS_DEVICE:-$(device_name)}
    [[ "$rw" == 1 && "$root" != "/" ]] || rw=0
    [[ "$announce" == 0 ]] || announce=1
    if [[ ! "$bwlimit_env" =~ ^[0-9]+$ ]]; then warn "NEXO_TOOLS_BWLIMIT debe ser un entero en bytes/s; se desactivará el límite."; bwlimit_env=0; fi
    local -a launch=(env -i "PATH=$PATH" "HOME=${HOME:-/tmp}" "TMPDIR=${TMPDIR:-/tmp}" \
        "NEXO_TOOLS_VERSION=$NEXO_TOOLS_VERSION" "NEXO_TOOLS_BWLIMIT=$bwlimit_env" \
        "NEXO_TOOLS_MAX_FILE_BYTES=$NEXO_TOOLS_MAX_FILE_BYTES" "NEXO_TOOLS_HASH_SKIP_ABOVE=$NEXO_TOOLS_HASH_SKIP_ABOVE" \
        "NEXO_TOOLS_ALLOW_SYMLINK_DOWNLOAD=$NEXO_TOOLS_ALLOW_SYMLINK_DOWNLOAD" \
        "NEXO_TOOLS_ACTIVE_EXTS=$NEXO_TOOLS_ACTIVE_EXTS" "NEXO_TOOLS_PASSIVE_EXTS=$NEXO_TOOLS_PASSIVE_EXTS" \
        "NEXO_TOOLS_STATE=$STATE_DIR" "NEXO_TOOLS_RW=$rw" "NEXO_TOOLS_ONLY=$only" "NEXO_TOOLS_DEVICE=$device" \
        "NEXO_TOOLS_DISCOVER_PORT=$NEXO_TOOLS_DISCOVER_PORT" "NEXO_TOOLS_ANNOUNCE=$announce" "NEXO_TOOLS_BEACON_TO=${NEXO_TOOLS_BEACON_TO:-}" \
        "NEXO_TOOLS_SHOW_SECRETS=${NEXO_TOOLS_SHOW_SECRETS:-0}" "NEXO_TOOLS_MAX_LIST=${NEXO_TOOLS_MAX_LIST:-200000}" \
        "NEXO_TOOLS_MAX_UPLOAD_BYTES=${NEXO_TOOLS_MAX_UPLOAD_BYTES:-0}" \
        bash "$SELF" __serve "$root" "$port" "$STATE_DIR/token" "$cert" "$key" "$bind_ip")
    if command -v nohup >/dev/null 2>&1; then
        nohup "${launch[@]}" 9>&- >"$log" 2>&1 </dev/null &
    elif command -v setsid >/dev/null 2>&1; then
        setsid "${launch[@]}" 9>&- >"$log" 2>&1 </dev/null &
    else
        "${launch[@]}" 9>&- >"$log" 2>&1 </dev/null &
        disown "$!" 2>/dev/null || true
    fi
    pid=$!
    ready=0
    for ((i=0; i<READY_RETRIES; i++)); do
        kill -0 "$pid" 2>/dev/null || break
        if python3 - "$port" "$fp" "$probe_ip" "$PROBE_TIMEOUT" <<'PYPROBE' >/dev/null 2>&1
import socket,sys,ssl,hashlib
ctx=ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT); ctx.check_hostname=False; ctx.verify_mode=ssl.CERT_NONE
with socket.create_connection((sys.argv[3],int(sys.argv[1])),timeout=float(sys.argv[4])) as raw:
 with ctx.wrap_socket(raw,server_hostname="localhost") as s:
  got=hashlib.sha256(s.getpeercert(binary_form=True)).hexdigest().upper()
  if got != sys.argv[2]: raise SystemExit(1)
PYPROBE
        then ready=1; break; fi
        sleep "$READY_SLEEP"
    done
    if [[ "$ready" -ne 1 ]]; then err "No se pudo iniciar el servidor. Revisa $log"; kill "$pid" 2>/dev/null || true; return 1; fi
    url="https://$ip:$port"
    lstart=$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true)
    ( umask 077
      {
        printf 'PID=%s\n' "$pid"
        printf 'START_TICKS=%s\n' "$(proc_start_ticks "$pid" || true)"
        printf 'START_LSTART=%s\n' "$lstart"
        printf 'ROOT=%s\n' "$root"; printf 'PORT=%s\n' "$port"
        printf 'IP=%s\n' "$ip"; printf 'URL=%s\n' "$url"
        printf 'TOKEN=%s\n' "$token"; printf 'FINGERPRINT=%s\n' "$fp"
        printf 'BWLIMIT=%s\n' "$bwlimit_env"
        printf 'RW=%s\n' "$rw"; printf 'ONLY=%s\n' "$only"; printf 'DEVICE=%s\n' "$device"
      } > "$SERVER_META"
    )
    chmod 600 "$SERVER_META"
    say ""; say "${C_GREEN}${C_BOLD}╔══════════════════════════════════════════════╗${C_RESET}"
    say "${C_GREEN}${C_BOLD}║          NEXO-TOOLS · SERVIDOR ACTIVO        ║${C_RESET}"
    say "${C_GREEN}${C_BOLD}╚══════════════════════════════════════════════╝${C_RESET}"
    say "Carpeta compartida: $root"; say ""
    say "${C_CYAN}URL${C_RESET}             $url"
    say "${C_CYAN}TOKEN${C_RESET}           $token"
    say "${C_CYAN}HUELLA SHA-256${C_RESET}  $fp"
    say "${C_CYAN}NOMBRE${C_RESET}          $device  (así te verán en «nexo-tools discover»)"
    say "${C_CYAN}MODO${C_RESET}            $(mode_text "$rw" "$only")"
    if command -v qrencode >/dev/null 2>&1; then
        say "QR del URL (no contiene el token; verifica la huella SHA-256 por separado):"
        qrencode -t ANSIUTF8 "$url" 2>/dev/null || warn "No se pudo generar el QR del URL."
    fi
    say "En el otro dispositivo ejecuta: nexo-tools receive $url"
    say "Más fácil, con código:  nexo-tools pair  → en el otro:  nexo-tools connect ${ip}:${port} --code CÓDIGO"
    say "En el navegador:        nexo-tools web"
    if [[ "$rw" == 1 ]]; then warn "Lectura y escritura: quien se empareje con «nexo-tools pair --rw» podrá subir, renombrar y mover a la papelera dentro de $root."; fi
    say "El receptor pedirá el token y la huella TLS. Para cerrar: nexo-tools stop"
    if [[ "$ip" == "127.0.0.1" ]]; then warn "No se detectó IP Wi-Fi; usa una IP LAN si otro equipo debe conectarse."; fi
    if ! command -v nexo >/dev/null 2>&1; then
        if command -v pkg >/dev/null 2>&1; then warn "Nexo CLI no está disponible. Instálalo con: pkg install nexo";
        else warn "Nexo CLI no está disponible; se usó la detección alternativa de IP."; fi
    fi
}

start_server() {
    require_runtime || return 1
    ensure_state_dir || return 1
    local root=${1:-} port=${2:-$DEFAULT_PORT} rc
    if [[ -z "$root" ]]; then root=$(choose_share_dir "$PWD") || { warn "Selección cancelada."; return 1; }; fi
    [[ -d "$root" ]] || { err "No existe esa carpeta: $root"; return 1; }
    root=$(CDPATH= cd -- "$root" && pwd -P) || return 1
    [[ "$root" != "/" ]] || { err "Por seguridad no se permite compartir todo el sistema (/)."; return 1; }
    [[ "$port" =~ ^[0-9]+$ ]] || { err "Puerto inválido: $port"; return 1; }
    (( port >= 1024 && port <= 65535 )) || { err "El puerto debe estar entre 1024 y 65535."; return 1; }
    acquire_server_lock || return 1
    if _start_server_locked "$root" "$port"; then rc=0; else rc=$?; fi
    release_server_lock
    return "$rc"
}

_stop_server_locked() {
    local pid rc=0 i
    if [[ ! -r "$SERVER_META" ]]; then rm -f -- "$STATE_DIR/.ip_cache"; say "No hay servidor registrado."; return 0; fi
    pid=$(read_meta_value PID || true)
    if [[ -n "$pid" ]] && server_pid_is_ours "$pid"; then
        kill "$pid" 2>/dev/null || { err "No se pudo detener el proceso $pid."; return 1; }
        for ((i=0; i<20; i++)); do server_pid_is_ours "$pid" || break; sleep 0.1; done
        # Revalidar inmediatamente antes de SIGKILL reduce la ventana de reutilización del PID.
        if server_pid_is_ours "$pid"; then
            kill -9 "$pid" 2>/dev/null || rc=1
            (( rc == 0 )) && ok "Servidor detenido."
        elif kill -0 "$pid" 2>/dev/null; then
            local proc_state
            proc_state=$(ps -o stat= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)
            if [[ "$proc_state" == Z* || "$proc_state" == X* ]]; then
                ok "Servidor detenido (proceso finalizado; el sistema aún lo está recogiendo)."
            else
                err "El PID ahora pertenece a otro proceso; no se enviará SIGKILL."
                rc=1
            fi
        else
            ok "Servidor detenido."
        fi
    else
        say "El servidor ya estaba detenido o el PID dejó de ser verificable; no se mató ningún proceso ajeno."
    fi
    rm -f -- "$SERVER_META" "$STATE_DIR/token" "$STATE_DIR/.ip_cache" "$STATE_DIR/pair.json" "$STATE_DIR/send.list"
    return "$rc"
}

stop_server() {
    ensure_state_dir || return 1
    acquire_server_lock || return 1
    local rc
    if _stop_server_locked; then rc=0; else rc=$?; fi
    release_server_lock
    return "$rc"
}

start_ssh_server() {
    command -v sshd >/dev/null 2>&1 || { err "Falta OpenSSH server. Ejecuta: nexo-tools setup"; return 1; }
    ensure_state_dir || return 1
    local port=8022 pidfile="$STATE_DIR/sshd.pid" pid ip user
    if [[ -r "$pidfile" ]]; then
        pid=$(cat "$pidfile" 2>/dev/null || true)
        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
            ok "SSH ya está activo (PID $pid)."
            return 0
        fi
        rm -f -- "$pidfile"
    fi
    # Las claves de usuario se crean para facilitar ssh-copy-id, pero sshd no las usa automáticamente.
    mkdir -p "$STATE_DIR/ssh"; chmod 700 "$STATE_DIR/ssh"
    if command -v ssh-keygen >/dev/null 2>&1 && [[ ! -s "$STATE_DIR/ssh/id_ed25519" ]]; then
        ssh-keygen -q -t ed25519 -N '' -f "$STATE_DIR/ssh/id_ed25519" -C "nexo-tools@$(hostname 2>/dev/null || printf local)" || warn "No se pudo generar la clave Ed25519 de usuario."
        [[ -s "$STATE_DIR/ssh/id_ed25519" ]] && chmod 600 "$STATE_DIR/ssh/id_ed25519"
        [[ -s "$STATE_DIR/ssh/id_ed25519.pub" ]] && { chmod 644 "$STATE_DIR/ssh/id_ed25519.pub"; say "Clave pública para ssh-copy-id: $(cat "$STATE_DIR/ssh/id_ed25519.pub")"; }
        say "La clave privada no se usa automáticamente: configura la autorización SSH explícitamente."
    fi
    if command -v ssh-keygen >/dev/null 2>&1; then ssh-keygen -A >/dev/null 2>&1 || true; fi
    if ! sshd -t -p "$port" -o "PidFile=$pidfile" >/dev/null 2>&1; then
        err "sshd no superó su validación. Comprueba las claves de host y la configuración de OpenSSH."
        return 1
    fi
    sshd -p "$port" -o "PidFile=$pidfile" || { err "No se pudo iniciar sshd en el puerto $port."; return 1; }
    local n
    for ((n=0; n<20; n++)); do
        [[ -s "$pidfile" ]] && break
        sleep 0.1
    done
    pid=$(cat "$pidfile" 2>/dev/null || true)
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || { err "sshd no confirmó su PID; revisa la configuración de OpenSSH."; return 1; }
    ip=$(discover_ip || true); user=$(id -un 2>/dev/null || whoami)
    ok "Servidor SSH activo."
    say "Usuario: $user"
    say "Puerto:  $port"
    [[ -n "$ip" ]] && say "IP LAN:  $ip" || warn "No se detectó IP LAN; consulta nexo wifi status."
    say "Desde el otro dispositivo usa: $user@${ip:-IP_DEL_DISPOSITIVO} y puerto $port"
    if [[ -n "${PREFIX:-}" && "$PREFIX" == *com.termux* ]]; then
        say "En Termux, configura una contraseña una sola vez con: passwd"
    fi
}

stop_ssh_server() {
    local pidfile="$STATE_DIR/sshd.pid" pid
    rm -f -- "$STATE_DIR/.ip_cache"
    [[ -r "$pidfile" ]] || { say "No hay SSH iniciado por NEXO-TOOLS."; return 0; }
    pid=$(cat "$pidfile" 2>/dev/null || true)
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || { err "No se pudo detener sshd."; return 1; }
        ok "Servidor SSH detenido."
    else
        say "El servidor SSH ya estaba detenido."
    fi
    rm -f -- "$pidfile" "$STATE_DIR/.ip_cache"
}

setup_environment() {
    say "${C_BOLD}CONFIGURACIÓN AUTOMÁTICA DE NEXO-TOOLS${C_RESET}"
    local is_termux=0 manager=""
    [[ -n "${PREFIX:-}" && "$PREFIX" == *com.termux* ]] && is_termux=1
    if (( is_termux )) || command -v pkg >/dev/null 2>&1 && [[ -n "${TERMUX_VERSION:-}" ]]; then
        manager=pkg
        say "Entorno detectado: Termux"
        pkg install -y x11-repo || warn "No se pudo habilitar x11-repo; la TUI seguirá disponible."
        pkg update -y || { warn "No se pudo actualizar el índice de paquetes; continuaré con la instalación."; }
        pkg install -y python openssl rsync openssh || return 1
        pkg install -y termux-x11-nightly || pkg install -y x11-repo termux-x11-nightly || warn "No se pudo instalar Termux:X11; HTTPS/TUI siguen disponibles."
        # Tkinter habilita la GUI; la app Android Termux:X11 se instala por separado.
        pkg install -y python-tkinter || warn "No se pudo instalar python-tkinter; la TUI seguirá funcionando."
        if command -v termux-setup-storage >/dev/null 2>&1; then
            termux-setup-storage || warn "Concede manualmente permiso de archivos a Termux desde Android."
        fi
        say "${C_DIM}Instala/abre también la app Android Termux:X11; el paquete de terminal no instala el APK.${C_RESET}"
    elif command -v apt-get >/dev/null 2>&1; then
        manager=apt-get
        local -a prefix=()
        if (( EUID != 0 )); then command -v sudo >/dev/null 2>&1 && prefix=(sudo) || { err "Ejecuta setup como root o instala sudo."; return 1; }; fi
        "${prefix[@]}" apt-get update || return 1
        "${prefix[@]}" apt-get install -y python3 openssl rsync openssh-client openssh-server python3-tk || return 1
    elif command -v pacman >/dev/null 2>&1; then
        manager=pacman
        if (( EUID != 0 )); then err "Ejecuta setup como root en Arch Linux."; return 1; fi
        pacman -Sy --needed --noconfirm python openssl rsync openssh tk || return 1
    elif command -v dnf >/dev/null 2>&1; then
        manager=dnf
        local -a prefix=()
        if (( EUID != 0 )); then command -v sudo >/dev/null 2>&1 && prefix=(sudo) || { err "Ejecuta setup como root o instala sudo."; return 1; }; fi
        "${prefix[@]}" dnf install -y python3 openssl rsync openssh-clients openssh-server python3-tkinter || return 1
    elif command -v apk >/dev/null 2>&1; then
        manager=apk
        if (( EUID != 0 )); then err "Ejecuta setup como root en Alpine."; return 1; fi
        apk add python3 openssl rsync openssh-client openssh-server py3-tkinter tk || return 1
    elif command -v zypper >/dev/null 2>&1; then
        manager=zypper
        local -a prefix=()
        if (( EUID != 0 )); then command -v sudo >/dev/null 2>&1 && prefix=(sudo) || { err "Ejecuta setup como root o instala sudo."; return 1; }; fi
        "${prefix[@]}" zypper --non-interactive install python3 openssl rsync openssh python3-tk || return 1
    else
        err "No reconocí el gestor de paquetes. Instala Python 3, OpenSSL, rsync y OpenSSH manualmente."
        return 1
    fi
    ensure_state_dir || return 1
    if [[ ! -s "$STATE_DIR/server.crt" || ! -s "$STATE_DIR/server.key" ]]; then
        openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 365 \
            -keyout "$STATE_DIR/server.key" -out "$STATE_DIR/server.crt" \
            -subj "/CN=NEXO-TOOLS local transfer" >/dev/null 2>&1 || { err "No se pudo crear el certificado TLS."; return 1; }
        chmod 600 "$STATE_DIR/server.key"; chmod 644 "$STATE_DIR/server.crt"
    fi
    ok "Dependencias y estructura local preparadas ($manager)."
    if command -v nexo >/dev/null 2>&1; then
        ok "Nexo CLI detectado: $(command -v nexo)"
        nexo status 2>/dev/null || warn "Nexo está instalado, pero su puente no respondió ahora."
    else
        warn "Nexo CLI no detectado. HTTPS seguirá funcionando con detección de IP alternativa."
    fi
}

maybe_first_run_setup() {
    local missing=0 answer
    command -v python3 >/dev/null 2>&1 || missing=1
    command -v openssl >/dev/null 2>&1 || missing=1
    if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && ! python3 -c 'import tkinter' >/dev/null 2>&1; then missing=1; fi
    if (( missing )) && [[ -t 0 ]]; then
        warn "Faltan dependencias necesarias para transferencias o interfaz gráfica."
        printf "¿Quieres que NEXO-TOOLS las instale automáticamente? [S/n] "
        IFS= read -r answer || answer=n
        case "${answer,,}" in n|no) return 1 ;; *) setup_environment || return 1 ;; esac
    fi
    ensure_state_dir
}

install_global() {
    local bindir
    if [[ -n "${PREFIX:-}" && -d "$PREFIX" && -w "$PREFIX" ]]; then
        bindir="$PREFIX/bin"
    else
        bindir="${HOME:-/tmp}/.local/bin"
    fi
    [[ -r "$SELF" ]] || { err "El script de origen no se puede leer: $SELF"; return 1; }
    mkdir -p -- "$bindir" || { err "No se pudo crear $bindir"; return 1; }
    cp -- "$SELF" "$bindir/nexo-tools" || { err "No se pudo instalar el ejecutable."; return 1; }
    chmod 755 "$bindir/nexo-tools"
    [[ -r "$bindir/nexo-tools" && -x "$bindir/nexo-tools" ]] || { err "La copia instalada no quedó legible y ejecutable."; return 1; }
    if command -v sha256sum >/dev/null 2>&1; then
        ensure_state_dir || return 1
        sha256sum "$bindir/nexo-tools" > "$STATE_DIR/installed.sha256"
        chmod 600 "$STATE_DIR/installed.sha256"
    fi
    ok "Instalado en $bindir/nexo-tools"
    case ":$PATH:" in *":$bindir:"*) say "Ya está en PATH." ;; *) warn "Agrega esta línea a ~/.bashrc para usarlo desde cualquier carpeta:"; say "  export PATH=\"$bindir:\$PATH\"" ;; esac
}

ui_clear() {
    if [[ -t 1 ]]; then printf '\033[2J\033[H'; fi
}

ui_pause() {
    if [[ -t 0 ]]; then
        printf '\nPresiona Enter para volver al menú...'
        IFS= read -r _ || true
        printf '\n'
    fi
}

ui_header() {
    ui_clear
    say "${C_CYAN}${C_BOLD}╭──────────────────────────────────────────────────────────────────────╮${C_RESET}"
    say "${C_CYAN}${C_BOLD}│  N E X O - T O O L S                                      v$NEXO_TOOLS_VERSION  │${C_RESET}"
    say "${C_CYAN}${C_BOLD}│  TRANSFERENCIA LOCAL · HTML · HTTPS · RSYNC/SSH                      │${C_RESET}"
    say "${C_CYAN}${C_BOLD}╰──────────────────────────────────────────────────────────────────────╯${C_RESET}"
}

show_wifi_brief() {
    local info ip cache="$STATE_DIR/.nexo_brief" now mtime
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    now=$(date +%s)
    mtime=$(stat -c %Y "$cache" 2>/dev/null || stat -f %m "$cache" 2>/dev/null || printf 0)
    if [[ -r "$cache" ]] && (( now - mtime < 5 )); then
        info=$(sed -n '1p' "$cache"); ip=$(sed -n '2p' "$cache")
    else
        if command -v nexo >/dev/null 2>&1; then
            if command -v timeout >/dev/null 2>&1; then info=$(timeout 3 nexo wifi status 2>/dev/null || true)
            else info=$(python3 -c 'import subprocess;
try: print(subprocess.run(["nexo","wifi","status"],capture_output=True,text=True,timeout=3).stdout,end="")
except Exception: pass' 2>/dev/null || true); fi
        else info=""; fi
        ip=$(discover_ip 2>/dev/null || true)
        ( umask 077; printf '%s\n%s\n' "$info" "$ip" > "$cache" ) 2>/dev/null || true
        chmod 600 "$cache" 2>/dev/null || true
    fi
    if command -v nexo >/dev/null 2>&1; then
        [[ -n "$info" ]] && say "${C_GREEN}● Nexo:${C_RESET} $info" || say "${C_YELLOW}● Nexo:${C_RESET} disponible, pero no entregó estado Wi-Fi"
    else say "${C_YELLOW}● Nexo:${C_RESET} CLI no detectado; se intentará detectar la IP automáticamente"; fi
    [[ -n "$ip" ]] && say "${C_DIM}IP local detectada: $ip${C_RESET}"
}

# El clasificador es conservador: extensiones desconocidas se tratan como activas.
open_verified_in_browser() {
    python3 - "$1" <<'PYOPEN'
import pathlib,sys,subprocess,time,shutil,os
p=pathlib.Path(sys.argv[1]).expanduser()
try: p=p.resolve(strict=True)
except Exception as exc: print(f"No se puede abrir el archivo: {exc}",file=sys.stderr); raise SystemExit(2)
if not p.is_file(): print("La ruta no es un archivo regular.",file=sys.stderr); raise SystemExit(2)
try: p.relative_to((pathlib.Path(os.environ.get("NEXO_TOOLS_DEST", "")) / ".nexo-quarantine").resolve())
except Exception: pass
if ".nexo-quarantine" in p.parts: print("No se abre un archivo en cuarentena; espera a que se mueva.",file=sys.stderr); raise SystemExit(2)
candidates=[]
for name,args in (("termux-open",[]),("xdg-open",[]),("gio",["open"]),("open",[])):
 exe=shutil.which(name)
 if exe:candidates.append([exe,*args,str(p)])
errors=[]
for cmd in candidates:
 try:
  proc=subprocess.Popen(cmd,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
  time.sleep(.3)
  if proc.poll() is None or proc.returncode==0: print(cmd[0].rsplit("/",1)[-1]);raise SystemExit(0)
  errors.append(f"{cmd[0]} terminó con código {proc.returncode}")
 except SystemExit:raise
 except Exception as exc:errors.append(f"{cmd[0]}: {exc}")
print("No se pudo iniciar un abridor compatible. "+"; ".join(errors),file=sys.stderr);raise SystemExit(1)
PYOPEN
}

open_in_browser() { open_verified_in_browser "$@"; }

open_verified_file() {
    local requested=${1:-} file ext kind allow opener
    [[ -n "$requested" ]] || { err "Indica la ruta del archivo."; return 2; }
    file=$(python3 - "$requested" <<'PYVERIFY'
import pathlib,sys
p=pathlib.Path(sys.argv[1]).expanduser()
try:p=p.resolve(strict=True)
except Exception as e:print(f"No se puede abrir el archivo: {e}",file=sys.stderr);raise SystemExit(2)
if not p.is_file():print("La ruta no es un archivo regular.",file=sys.stderr);raise SystemExit(2)
if ".nexo-quarantine" in p.parts:print("No se abre un archivo en cuarentena; espera a que se mueva.",file=sys.stderr);raise SystemExit(2)
print(p)
PYVERIFY
) || return $?
    ext=".${file##*.}"; [[ "$file" == *.* ]] || ext=""; ext=${ext,,}
    if [[ -n "${NEXO_TOOLS_OPEN_ALLOW:-}" ]]; then
        case ",${NEXO_TOOLS_OPEN_ALLOW,,}," in *",$ext,"*) ;; *) err "Extensión no permitida por NEXO_TOOLS_OPEN_ALLOW."; return 1 ;; esac
    fi
    kind=$(classify_extension "$ext")
    case "$kind" in
        active)
            warn "Tipo activo ($ext): puede ejecutar código o cargar recursos externos. Abre solo archivos de confianza."
            [[ -t 0 ]] || { err "La apertura de tipos activos requiere confirmación interactiva."; return 1; }
            printf '¿Abrir después de verificar que el archivo es local? [s/N]: '
            local answer; IFS= read -r answer || return 1
            [[ "${answer,,}" == s || "${answer,,}" == si || "${answer,,}" == sí ]] || { say "Apertura cancelada."; return 0; }
            ;;
        unknown)
            warn "Tipo desconocido; se trata como activo por seguridad."
            [[ -t 0 ]] || { err "La apertura de tipos desconocidos requiere confirmación interactiva."; return 1; }
            printf '¿Abrir este archivo? [s/N]: '
            local answer; IFS= read -r answer || return 1
            [[ "${answer,,}" == s || "${answer,,}" == si || "${answer,,}" == sí ]] || { say "Apertura cancelada."; return 0; }
            ;;
    esac
    opener=$(open_verified_in_browser "$file") || {
        case "$kind" in
            passive)
                if [[ "$ext" == .txt || "$ext" == .md || "$ext" == .csv || "$ext" == .json || "$ext" == .log ]]; then
                    if command -v less >/dev/null 2>&1; then less -- "$file"; elif command -v bat >/dev/null 2>&1; then bat --paging=always -- "$file"; elif command -v more >/dev/null 2>&1; then more "$file"; else cat -- "$file"; fi
                    return $?
                elif command -v chafa >/dev/null 2>&1; then chafa "$file"; return $?
                elif command -v viu >/dev/null 2>&1; then viu "$file"; return $?
                fi
                ;;
        esac
        err "No encontré un abridor compatible. Instala termux-open, xdg-open, chafa o viu según el tipo."; return 1
    }
    ok "Archivo abierto: $file · $opener"
}

open_html_file() { open_verified_file "$@"; }

html_viewer_menu() {
    ui_header
    say "${C_BOLD}${C_CYAN}VISOR DE ARCHIVOS HTML${C_RESET}"
