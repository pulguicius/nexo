    local file
    IFS= read -r file || return 0
    [[ -n "$file" ]] || { warn "No se indicó ningún archivo."; ui_pause; return 0; }
    open_verified_file "$file" || true
    ui_pause
}

require_rsync_runtime() {
    local missing=0
    command -v rsync >/dev/null 2>&1 || { err "Falta rsync. Instálalo con: pkg install rsync (Termux) o tu gestor de paquetes Linux."; missing=1; }
    command -v ssh >/dev/null 2>&1 || { err "Falta OpenSSH cliente. Instálalo con: pkg install openssh (Termux)."; missing=1; }
    [[ "$missing" -eq 0 ]]
}

read_ssh_target() {
    local target port
    printf 'Usuario y dirección del otro dispositivo (ej. u0_a123@192.168.1.20): ' >&2
    IFS= read -r target || return 1
    target="${target#"${target%%[![:space:]]*}"}"
    target="${target%"${target##*[![:space:]]}"}"
    [[ "$target" =~ ^[a-zA-Z0-9._-]+@[a-zA-Z0-9.-]+$ ]] || { err "Destino inválido. Usa usuario@IP o usuario@equipo."; return 1; }
    printf 'Puerto SSH [8022 Termux / 22 Linux] (por defecto 8022): ' >&2
    IFS= read -r port || return 1
    port=${port:-8022}
    [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || { err "Puerto SSH inválido."; return 1; }
    printf '%s\n%s\n' "$target" "$port"
}

build_ssh_cmd() {
    local port=$1 known_hosts=$2 qp qh
    printf -v qp '%q' "$port"; printf -v qh '%q' "$known_hosts"
    printf 'ssh -p %s -o UserKnownHostsFile=%s -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=15 -o ServerAliveCountMax=3' "$qp" "$qh"
}

rsync_transfer() {
    require_rsync_runtime || return 1
    local direction=${1:-push}; shift || true
    local dry_run=0 bwlimit="" source dest target port remote_path ssh_cmd rsync_arg rc flag
    local sparse=0 hard_links=0 xattrs=0 no_links=0 fs_type="unknown"
    local -a excludes=() args=()
    while (($#)); do
        case "$1" in
            --dry-run) dry_run=1; shift ;;
            --exclude) (($# >= 2)) || { err "Falta el patrón de --exclude."; return 2; }; excludes+=("$2"); shift 2 ;;
            --bwlimit) (($# >= 2)) || { err "Falta RATE para --bwlimit."; return 2; }; bwlimit=$2; shift 2 ;;
            --bwlimit=*) bwlimit=${1#*=}; shift ;;
            --sparse) sparse=1; shift ;;
            --hard-links) hard_links=1; shift ;;
            --xattrs) xattrs=1; shift ;;
            --no-links) no_links=1; shift ;;
            *) err "Opción rsync desconocida: $1"; return 2 ;;
        esac
    done
    if [[ -n "$bwlimit" && ! "$bwlimit" =~ ^[0-9]+([KkMmGg])?$ ]]; then err "RATE inválido para --bwlimit (ej. 512, 2M)."; return 2; fi
    local bw_bytes=0 bw_num="$bwlimit" bw_suffix=""
    if [[ -n "$bwlimit" ]]; then
        bw_suffix=${bwlimit: -1}
        if [[ "$bw_suffix" =~ [KkMmGg] ]]; then bw_num=${bwlimit%?}; else bw_suffix=""; fi
        case "${bw_suffix,,}" in k) bw_bytes=$((bw_num*1024));; m) bw_bytes=$((bw_num*1024*1024));; g) bw_bytes=$((bw_num*1024*1024*1024));; *) bw_bytes=$bw_num;; esac
    fi
    if [[ "$direction" == "push" ]]; then
        say "${C_BOLD}ENVIAR UNA CARPETA CON RSYNC/SSH${C_RESET}"
        source=$(choose_share_dir "$PWD") || { warn "Selección cancelada."; return 1; }
        printf 'Carpeta destino en el otro dispositivo (ej. /home/usuario/Recibidos): '
        IFS= read -r remote_path || return 1
        [[ -n "$remote_path" && ( "$remote_path" == /* || "$remote_path" == "~/"* ) ]] || { err "La ruta remota debe ser absoluta."; return 1; }
        local pair; pair=$(read_ssh_target) || return 1
        target=${pair%%$'\n'*}; port=${pair#*$'\n'}
        mkdir -p "$STATE_DIR/ssh"; chmod 700 "$STATE_DIR/ssh"
        ssh_cmd=$(build_ssh_cmd "$port" "$STATE_DIR/ssh/known_hosts")
        args=(-a --human-readable --info=progress2 --partial)
        if rsync --help 2>&1 | grep -q -- '--secluded-args'; then args+=(-s); else args+=(--protect-args); fi
        (( dry_run )) && args+=(-n)
        (( sparse )) && args+=(--sparse)
        (( hard_links )) && args+=(--hard-links)
        (( no_links )) && args+=(--no-links)
        if (( xattrs )); then
            if rsync --help 2>&1 | grep -q -- '--xattrs'; then args+=(--xattrs)
            else warn "Esta versión de rsync no admite --xattrs; se omitió."; fi
        fi
        [[ -n "$bwlimit" ]] && args+=("--bwlimit=$bwlimit")
        for flag in "${excludes[@]}"; do args+=(--exclude "$flag"); done
        say "\n${C_CYAN}Enviando:${C_RESET} $source/"
        say "${C_CYAN}Destino:${C_RESET} $target:$remote_path/"
        (( dry_run )) && say "${C_YELLOW}Simulación: no se modificarán archivos.${C_RESET}"
        [[ -n "$bwlimit" ]] && say "Límite rsync: $(human_size "$bw_bytes")/s (aproximado)"
        say "Se copiarán los cambios; no se borrarán archivos del destino.\n"
        rsync "${args[@]}" -e "$ssh_cmd" -- "$source/" "$target:$remote_path/" || { rc=$?; err "Rsync terminó con código $rc."; return "$rc"; }
    else
        say "${C_BOLD}RECIBIR UNA CARPETA CON RSYNC/SSH${C_RESET}"
        printf 'Carpeta remota completa (ej. usuario@192.168.1.20:/ruta/Carpeta): '
        IFS= read -r source || return 1
        [[ "$source" =~ ^[a-zA-Z0-9._-]+@[a-zA-Z0-9.-]+:.+ ]] || { err "Origen remoto no válido. Usa usuario@IP:/ruta."; return 1; }
        remote_path=${source#*:}; [[ "$remote_path" == /* || "$remote_path" == "~/"* ]] || { err "La ruta remota debe ser absoluta."; return 1; }
        printf 'Carpeta local destino [%s]: ' "$HOME/Recibidos"; IFS= read -r dest || return 1
        dest=${dest:-"$HOME/Recibidos"}; mkdir -p -- "$dest" || { err "No se pudo crear $dest"; return 1; }
        [[ -w "$dest" ]] || { err "No tienes permiso de escritura en $dest"; return 1; }
        fs_type=$(detect_fs_type "$dest")
        if [[ "$fs_type" == vfat || "$fs_type" == exfat || "$fs_type" == msdos || "$dest" == /sdcard/* || "$dest" == /storage/emulated/* ]]; then
            if (( ! no_links )); then warn "Destino FAT-like: se omitirán enlaces simbólicos (rsync --no-links)."; args+=(--no-links); no_links=1; fi
        fi
        printf 'Puerto SSH [8022 Termux / 22 Linux] (por defecto 8022): '; IFS= read -r port || return 1
        port=${port:-8022}; [[ "$port" =~ ^[0-9]+$ ]] && (( port>=1 && port<=65535 )) || { err "Puerto SSH inválido."; return 1; }
        mkdir -p "$STATE_DIR/ssh"; chmod 700 "$STATE_DIR/ssh"
        ssh_cmd=$(build_ssh_cmd "$port" "$STATE_DIR/ssh/known_hosts")
        args=(-a --human-readable --info=progress2 --partial)
        if rsync --help 2>&1 | grep -q -- '--secluded-args'; then args+=(-s); else args+=(--protect-args); fi
        (( dry_run )) && args+=(-n)
        (( sparse )) && args+=(--sparse)
        (( hard_links )) && args+=(--hard-links)
        (( no_links )) && args+=(--no-links)
        if (( xattrs )); then
            if rsync --help 2>&1 | grep -q -- '--xattrs'; then args+=(--xattrs)
            else warn "Esta versión de rsync no admite --xattrs; se omitió."; fi
        fi
        [[ -n "$bwlimit" ]] && args+=("--bwlimit=$bwlimit")
        for flag in "${excludes[@]}"; do args+=(--exclude "$flag"); done
        say "\n${C_CYAN}Origen:${C_RESET} $source"; say "${C_CYAN}Destino:${C_RESET} $dest/"
        (( dry_run )) && say "${C_YELLOW}Simulación: no se modificarán archivos.${C_RESET}"
        [[ -n "$bwlimit" ]] && say "Límite rsync: $(human_size "$bw_bytes")/s (aproximado)"
        say "Se copiarán los cambios; no se borrarán archivos del destino.\n"
        rsync "${args[@]}" -e "$ssh_cmd" -- "$source" "$dest/" || { rc=$?; err "Rsync terminó con código $rc."; return "$rc"; }
    fi
    ok "Transferencia rsync completada."
    notify_transfer_done
}

send_menu() {
    while :; do
        ui_header
        say "${C_BOLD}MANDAR ARCHIVOS${C_RESET}\n"
        say "  1) Transferencia rápida HTTPS"
        say "     Comparte una carpeta; el otro equipo navega y elige archivos."
        say "  2) Enviar carpeta completa con rsync/SSH"
        say "     Ideal para carpetas grandes o transferencias repetidas."
        say "  0) Volver"
        printf '\nElige: '
        local choice; IFS= read -r choice || return 0
        case "$choice" in
            1) start_server; ui_pause ;;
            2) rsync_transfer push; ui_pause ;;
            0|q|Q) return 0 ;;
            *) warn "Opción no válida."; ui_pause ;;
        esac
    done
}

receive_menu() {
    while :; do
        ui_header
        say "${C_BOLD}RECIBIR ARCHIVOS${C_RESET}\n"
        say "  1) Recibir por HTTPS"
        say "     Explora el teléfono emisor y descarga archivos seleccionados."
        say "  2) Recibir carpeta completa con rsync/SSH"
        say "     Descarga solo los cambios desde el otro dispositivo."
        say "  0) Volver"
        printf '\nElige: '
        local choice url; IFS= read -r choice || return 0
        case "$choice" in
            1) printf 'URL del emisor (https://IP:8766): '; IFS= read -r url || true; [[ -n "$url" ]] && start_receiver "$url"; ui_pause ;;
            2) rsync_transfer pull; ui_pause ;;
            0|q|Q) return 0 ;;
            *) warn "Opción no válida."; ui_pause ;;
        esac
    done
}

