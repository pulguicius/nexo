start_receiver() {
    require_runtime || return 1
    ensure_state_dir || return 1
    local url=${1:-} token="" pin="" dest="${PWD}" secret_file rc auto_pin=0 fingerprint_file="" max_bytes=""
    shift || true
    while (($#)); do
        case "$1" in
            --token) (($# >= 2)) || { err "Falta el valor de --token"; return 2; }; token=$2; shift 2 ;;
            --pin) (($# >= 2)) || { err "Falta el valor de --pin"; return 2; }; pin=$2; shift 2 ;;
            --dest) (($# >= 2)) || { err "Falta el valor de --dest"; return 2; }; dest=$2; shift 2 ;;
            --auto-pin) auto_pin=1; shift ;;
            --fingerprint-file) (($# >= 2)) || { err "Falta --fingerprint-file"; return 2; }; fingerprint_file=$2; shift 2 ;;
            --max-bytes) (($# >= 2)) || { err "Falta N para --max-bytes"; return 2; }; max_bytes=$2; shift 2 ;;
            *) err "Opción desconocida: $1"; return 2 ;;
        esac
    done
    [[ -n "$url" ]] || { printf 'URL del servidor (https://IP:8766): '; IFS= read -r url || return 1; }
    if [[ -z "$token" ]]; then
        if [[ -t 0 ]]; then
            printf 'Token del emisor: '
            IFS= read -r -s token; printf '\n'
        else
            err "Falta el token. Usa --token TOKEN."; return 2
        fi
    fi
    if (( auto_pin )); then
        [[ -n "$fingerprint_file" && -r "$fingerprint_file" ]] || { err "--auto-pin requiere un --fingerprint-file existente de una ejecución previa."; return 2; }
        pin=$(tr -d '[:space:]:' < "$fingerprint_file" | tr '[:upper:]' '[:lower:]')
    elif [[ -z "$pin" ]]; then
        printf 'Huella SHA-256 del certificado (64 hex): '
        IFS= read -r pin || return 1
    fi
    [[ "$dest" == "~" ]] && dest="$HOME"
    [[ "$dest" == "~/"* ]] && dest="$HOME/${dest#~/}"
    mkdir -p -- "$dest" || { err "No se pudo crear la carpeta destino: $dest"; return 1; }
    dest=$(CDPATH= cd -- "$dest" && pwd -P) || return 1
    [[ -w "$dest" ]] || { err "No tienes permiso de escritura en el destino: $dest"; return 1; }
    [[ -n "$max_bytes" ]] && { [[ "$max_bytes" =~ ^[0-9]+$ ]] || { err "--max-bytes requiere un entero no negativo."; return 2; }; NEXO_TOOLS_MAX_FILE_BYTES=$max_bytes; export NEXO_TOOLS_MAX_FILE_BYTES; }
    export NEXO_TOOLS_DEST_FS="$(detect_fs_type "$dest")"
    secret_file=$(umask 077; mktemp "$STATE_DIR/receiver.XXXXXXXX" 2>/dev/null) || {
        secret_file="$STATE_DIR/receiver.$$.$RANDOM"
        ( umask 077; : > "$secret_file" ) || { err "No se pudo crear el archivo temporal seguro."; return 1; }
    }
    printf '%s\n%s\n' "$token" "$pin" > "$secret_file"
    chmod 600 "$secret_file"
    if python3 -c "$(cat <<'PYCLIENT'
