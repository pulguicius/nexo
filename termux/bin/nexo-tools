show_logs() {
    local mode=${1:-}
    case "$mode" in
        --verify) [[ -f "$STATE_DIR/verify.log" ]] && tail -n 300 "$STATE_DIR/verify.log" || say "Todavía no hay verificaciones registradas." ;;
        ""|--follow|-f)
            [[ -f "$STATE_DIR/server.log" ]] || { say "Todavía no existe $STATE_DIR/server.log"; return 0; }
            if [[ "$mode" == --follow || "$mode" == -f ]]; then tail -F "$STATE_DIR/server.log"; else tail -n 200 "$STATE_DIR/server.log"; fi
            ;;
        *) err "Uso: nexo-tools logs [--follow|--verify]"; return 2 ;;
    esac
}

rotate_token() {
    ensure_state_dir || return 1
    acquire_server_lock || return 1
    local rc
    if _rotate_token_locked; then rc=0; else rc=$?; fi
    release_server_lock
    return "$rc"
}

_rotate_token_locked() {
    [[ -r "$SERVER_META" ]] || { err "No hay metadatos de servidor."; return 1; }
    local pid token tmp
    pid=$(read_meta_value PID || true)
    [[ -n "$pid" ]] && server_pid_is_ours "$pid" || { err "El servidor no está activo o no se pudo verificar."; return 1; }
    token=$(openssl rand -hex 24) || return 1
    tmp="$STATE_DIR/token.tmp.$$"
    ( umask 077; printf '%s\n' "$token" > "$tmp" )
    chmod 600 "$tmp"; mv -f -- "$tmp" "$STATE_DIR/token"
    python3 - "$SERVER_META" "$token" <<'PYMETAWRITE'
import sys,os,tempfile
p,token=sys.argv[1:]
lines=[]
for line in open(p,encoding="utf-8",errors="surrogateescape").read().splitlines():
 k,sep,v=line.partition("=")
 if sep and k=="TOKEN": line="TOKEN="+token
 lines.append(line)
fd,tmp=tempfile.mkstemp(prefix="server.env.",dir=os.path.dirname(p),text=True)
with os.fdopen(fd,"w",encoding="utf-8",errors="surrogateescape") as f: f.write("\n".join(lines)+"\n")
os.chmod(tmp,0o600); os.replace(tmp,p)
PYMETAWRITE
    ok "Token renovado sin reiniciar el servidor."
    say "Nuevo token: $token"
    warn "Actualiza el token en todos los receptores; el anterior dejó de funcionar."
}

rotate_cert() {
    ensure_state_dir || return 1
    acquire_server_lock || return 1
    local root port rc
    local -a meta_values=()
    if [[ ! -r "$SERVER_META" ]]; then err "No hay metadatos de servidor."; release_server_lock; return 1; fi
    mapfile -t meta_values < <(read_meta_values ROOT PORT RW ONLY DEVICE || true)
    root=${meta_values[0]:-}; port=${meta_values[1]:-}
    NEXO_TOOLS_RW=${meta_values[2]:-0}; NEXO_TOOLS_ONLY=${meta_values[3]:-}
    [[ -n "${NEXO_TOOLS_DEVICE:-}" ]] || NEXO_TOOLS_DEVICE=${meta_values[4]:-}
    if [[ -z "$root" || -z "$port" ]]; then err "Los metadatos del servidor están incompletos."; release_server_lock; return 1; fi
    _stop_server_locked || { release_server_lock; return 1; }
    rm -f -- "$STATE_DIR/server.crt" "$STATE_DIR/server.key" "$STATE_DIR/peers.json"
    warn "Se generará un certificado nuevo; cambia la huella TLS y también se renovará el token."
    warn "Los dispositivos ya emparejados tendrán que emparejarse de nuevo (nexo-tools pair), porque guardaron la huella anterior."
    if _start_server_locked "$root" "$port"; then
        rc=0
        local fp
        fp=$(read_meta_value FINGERPRINT || true)
        if [[ -n "$fp" ]]; then
            ( umask 077; printf '%s\n' "$fp" > "$STATE_DIR/last_fingerprint.txt" )
            chmod 600 "$STATE_DIR/last_fingerprint.txt"
            say "Nueva huella SHA-256: $fp"
            say "Guardada en: $STATE_DIR/last_fingerprint.txt"
        fi
    else rc=$?; fi
    release_server_lock
    return "$rc"
}

doctor() {
    local files_mode=0
    [[ "${1:-}" == --files ]] && files_mode=1
    local failures=0 cmd certok=0 serverok=0
    printf '%-24s %s\n' "Comprobación" "Resultado"
    printf '%-24s %s\n' "------------------------" "------------------------------"
    for cmd in bash python3 openssl; do
        if command -v "$cmd" >/dev/null 2>&1; then printf '%-24s ✔ %s\n' "$cmd" "$(command -v "$cmd")"; else printf '%-24s ✘ falta\n' "$cmd"; failures=1; fi
    done
    for cmd in rsync ssh sshd flock; do
        if command -v "$cmd" >/dev/null 2>&1; then printf '%-24s ✔ %s\n' "$cmd" "$(command -v "$cmd")"; else printf '%-24s ✘ %s\n' "$cmd" "no disponible (opcional)"; fi
    done
    if python3 -c 'import ssl,http.server,hashlib' >/dev/null 2>&1; then printf '%-24s ✔ %s\n' "Python SSL" "módulos estándar disponibles"; else printf '%-24s ✘ %s\n' "Python SSL" "módulos ausentes"; failures=1; fi
    printf '%-24s %s\n' "Bash" "$BASH_VERSION"
    printf '%-24s %s\n' "Python" "$(python3 --version 2>&1 || true)"
    printf '%-24s %s\n' "OpenSSL" "$(openssl version 2>/dev/null || printf no disponible)"
    printf '%-24s %s\n' "/proc" "$([[ "$HAVE_PROC" == 1 ]] && printf '✔ disponible' || printf '✘ no disponible; usa ps')"
    if [[ -s "$STATE_DIR/server.crt" ]] && openssl x509 -in "$STATE_DIR/server.crt" -noout -checkend 604800 >/dev/null 2>&1; then certok=1; fi
    printf '%-24s %s\n' "Certificado (>7 días)" "$([[ $certok == 1 ]] && printf '✔ vigente' || printf '✘ ausente/vencido pronto')"
    if [[ -r "$SERVER_META" ]]; then
        local pid url token
        local -a meta_values=()
        mapfile -t meta_values < <(read_meta_values PID URL TOKEN || true)
        pid=${meta_values[0]:-}; url=${meta_values[1]:-}; token=${meta_values[2]:-}
        if [[ -n "$pid" ]] && server_pid_is_ours "$pid" && python3 - "$url" "$token" <<'PYDOCTOR' >/dev/null 2>&1
import sys,ssl,urllib.request,json
u,t=sys.argv[1:]
ctx=ssl.create_default_context(); ctx.check_hostname=False; ctx.verify_mode=ssl.CERT_NONE
r=urllib.request.urlopen(urllib.request.Request(u+"/api/ping",headers={"Authorization":"Bearer "+t}),context=ctx,timeout=3)
if r.status!=200 or json.load(r).get("name")!="NEXO-TOOLS": raise SystemExit(1)
PYDOCTOR
        then serverok=1; fi
    fi
    printf '%-24s %s\n' "Servidor HTTPS" "$([[ $serverok == 1 ]] && printf '✔ responde con token' || printf '%s' 'detenido/no verificable')"
    if command -v nexo >/dev/null 2>&1; then
        printf '%-24s ✔ %s\n' "Nexo CLI" "$(command -v nexo)"
        if command -v timeout >/dev/null 2>&1; then timeout 3 nexo status >/dev/null 2>&1 && printf '%-24s ✔ %s\n' "Estado Nexo" "respuesta" || printf '%-24s ⚠ %s\n' "Estado Nexo" "instalado, sin respuesta";
        else python3 -c 'import subprocess; subprocess.run(["nexo","status"],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=3,check=True)' >/dev/null 2>&1 && printf '%-24s ✔ %s\n' "Estado Nexo" "respuesta" || printf '%-24s ⚠ %s\n' "Estado Nexo" "instalado, sin respuesta"; fi
    else printf '%-24s %s\n' "Nexo CLI" "no instalado"; fi
    if command -v sha256sum >/dev/null 2>&1; then printf '%-24s %s\n' "sha256sum" "✔ disponible"; else printf '%-24s %s\n' "sha256sum" "no disponible"; fi
    if (( files_mode )); then
        local state_fs home_fs tmpdir test_rc=0 test_json
        ensure_state_dir || return 1
        state_fs=$(detect_fs_type "$STATE_DIR"); home_fs=$(detect_fs_type "${HOME:-/tmp}")
        printf '%-24s %s\n' "FS STATE_DIR" "$state_fs"
        printf '%-24s %s\n' "FS HOME" "$home_fs"
        tmpdir=$(mktemp -d "$STATE_DIR/doctor.XXXXXXXX" 2>/dev/null) || { tmpdir="$STATE_DIR/doctor.$$.$RANDOM"; mkdir -m 700 "$tmpdir" 2>/dev/null || { err "No se pudo crear directorio temporal de pruebas."; return 1; }; }
        while IFS=$'\t' read -r state label detail; do
            [[ -n "$label" ]] || continue
            printf '%-24s %s %s\n' "$label" "$([[ "$state" == OK ]] && printf '✔' || printf '✘')" "$detail"
            [[ "$state" == OK ]] || test_rc=1
        done < <(python3 - "$tmpdir" <<'PYDOCTORFILES'
import os,sys,pathlib
base=pathlib.Path(sys.argv[1])
for label,name,kind in (("Nombres de 255 bytes","x"*255,"file"),("Nombre reservado escapado","_NEXO_CON","file")):
 try:
  p=base/name;p.write_bytes(b"x");p.unlink();print("OK\t"+label+"\tcompatible")
 except OSError as e:print("FAIL\t"+label+"\t"+str(e))
try:
 a=base/"target";a.write_bytes(b"x");b=base/"link";b.symlink_to(a);b.unlink();a.unlink();print("OK\tSymlinks\tcompatibles")
except OSError as e:print("FAIL\tSymlinks\t"+str(e))
PYDOCTORFILES
        )
        rm -rf -- "$tmpdir"
        for cmd in chafa viu img2txt; do command -v "$cmd" >/dev/null 2>&1 && printf '%-24s ✔ disponible\n' "$cmd" || printf '%-24s – no instalado\n' "$cmd"; done
        (( test_rc == 0 )) || failures=1
    fi
    return "$failures"
}

# ---------------------------------------------------------------- Dispositivos Nexo (2.4): descubrir, emparejar, explorar y escribir
# Nombre con el que este dispositivo se anuncia en la red (modelo del teléfono o nombre del equipo).
device_name() {
    local n=""
    if command -v getprop >/dev/null 2>&1; then n=$(getprop ro.product.model 2>/dev/null || true); fi
    [[ -n "$n" ]] || n=$(hostname 2>/dev/null || true)
    n=$(printf '%s' "$n" | tr -cd '[:alnum:] ._-' | cut -c1-40)
    printf '%s' "${n:-dispositivo}"
}

require_client() {
    command -v python3 >/dev/null 2>&1 || { err "Falta Python 3. Instálalo con: pkg install python (Termux)"; return 1; }
    python3 -c 'import ssl, http.client, socket' >/dev/null 2>&1 || { err "Tu Python no trae los módulos SSL estándar."; return 1; }
}

# Cliente de dispositivos (descubrir, emparejar, listar, bajar, subir…). Todo el código está dentro de este archivo.
peer_code() {
    cat <<'PYPEER'
import os, sys, json, ssl, socket, hashlib, hmac, http.client, urllib.parse, time, secrets, re, shutil, unicodedata
from pathlib import Path

STATE = Path(os.environ.get("NEXO_TOOLS_STATE") or (Path.home() / ".local" / "state" / "nexo-tools"))
KNOWN = STATE / "known.json"       # dispositivos a los que ME conecto (con su huella y mi token)
PEERS = STATE / "peers.json"       # dispositivos que pueden entrar AQUÍ (solo guardo el hash de su token)
PAIR = STATE / "pair.json"         # código de emparejamiento vigente
DPORT = int(os.environ.get("NEXO_TOOLS_DISCOVER_PORT", "8767") or 8767)
MYNAME = (os.environ.get("NEXO_TOOLS_DEVICE") or socket.gethostname() or "dispositivo")[:40]
TTY = sys.stdout.isatty()
G, R, Y, B, Z = ("\033[32m", "\033[31m", "\033[33m", "\033[1m", "\033[0m") if TTY else ("", "", "", "", "")
CODE_ALPHABET = "23456789ABCDEFGHJKMNPQRSTUVWXYZ"


class Fail(Exception):
    def __init__(self, msg, code=1):
        Exception.__init__(self, msg)
        self.code = code


class Api(Fail):
    def __init__(self, status, err, msg):
        hint = {
            401: " Vuelve a emparejar: nexo-tools connect IP --code CÓDIGO",
            403: "",
        }.get(status, "")
        if err == "read_only":
            msg = msg + " Para escribir, ese dispositivo debe ejecutar «nexo-tools server --rw» y «nexo-tools pair --rw»."
        Fail.__init__(self, "%s (HTTP %s)%s" % (msg or err or "error", status, hint), 3 if status >= 500 else 1)
        self.status, self.err = status, err


def clean(s, n=120):
    return "".join("?" if (ch in "\r\n\t" or unicodedata.category(ch).startswith("C")) else ch for ch in str(s))[:n]


def human(n):
    v = float(n)
    for u in ("B", "KiB", "MiB", "GiB", "TiB"):
        if v < 1024 or u == "TiB":
            return "%d B" % v if u == "B" else "%.1f %s" % (v, u)
        v /= 1024


def when(ts):
    try:
        return time.strftime("%Y-%m-%d %H:%M", time.localtime(int(ts)))
    except (ValueError, OverflowError, OSError):
        return "—"


def read_json(path):
    try:
        d = json.loads(path.read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def write_json(path, obj):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".%d.tmp" % os.getpid())
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(obj, f, ensure_ascii=True, indent=1)
        os.replace(str(tmp), str(path))
    except Exception:
        try:
            os.unlink(str(tmp))
        except OSError:
            pass
        raise


def norm_code(c):
    return str(c).upper().replace("-", "").replace(" ", "").replace("O", "0").replace("I", "1").replace("L", "1")


def say(*a):
    print(*a)
    sys.stdout.flush()


def note(*a):
    print(*a, file=sys.stderr)
    sys.stderr.flush()


# ---------------------------------------------------------------- argumentos (mensajes en español, sin argparse)
def parse(argv, valued=(), flags=(), aliases=None):
    aliases = aliases or {}
    pos, opt, i = [], {}, 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            pos.extend(argv[i + 1:])
            break
        if a.startswith("-") and len(a) > 1 and not a[1:].isdigit():
            key = aliases.get(a, a).lstrip("-")
            if key in valued:
                if i + 1 >= len(argv):
                    raise Fail("Falta el valor de %s" % a, 2)
                opt[key] = argv[i + 1]
                i += 2
                continue
            if key in flags:
                opt[key] = True
                i += 1
                continue
            raise Fail("Opción desconocida: %s" % a, 2)
        pos.append(a)
        i += 1
    return pos, opt


# ---------------------------------------------------------------- conexión HTTPS con la huella fijada
CTX = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
CTX.minimum_version = ssl.TLSVersion.TLSv1_2
CTX.check_hostname = False
CTX.verify_mode = ssl.CERT_NONE


class Link:
    def __init__(self, host, port, fp="", token="", timeout=30):
        self.host, self.port, self.fp, self.token, self.timeout = host, int(port), (fp or "").lower(), token, timeout
        self.conn = None
        self.seen_fp = ""

    def open(self):
        c = http.client.HTTPSConnection(self.host, self.port, context=CTX, timeout=self.timeout)
        c.connect()
        try:
            c.sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        except OSError:
            pass
        got = hashlib.sha256(c.sock.getpeercert(binary_form=True)).hexdigest()
        if self.fp and not hmac.compare_digest(got, self.fp):
            c.close()
            raise Fail("La huella del certificado de %s:%d NO coincide con la que guardé al emparejar. "
                       "Puede ser otro dispositivo o alguien en medio de la red: conexión cancelada." % (self.host, self.port), 4)
        self.seen_fp, self.conn = got, c
        return c

    def close(self):
        if self.conn is not None:
            try:
                self.conn.close()
            except Exception:
                pass
        self.conn = None

    def request(self, method, path, body=None, headers=None):
        hdr = {"Accept-Encoding": "identity"}
        if self.token:
            hdr["Authorization"] = "Bearer " + self.token
        if headers:
            hdr.update(headers)
        for attempt in (0, 1):
            try:
                if self.conn is None:
                    self.open()
                self.conn.request(method, path, body=body, headers=hdr)
                return self.conn.getresponse()
            except Fail:
                raise
            except (OSError, http.client.HTTPException):
                self.close()
                if attempt or not (body is None or isinstance(body, (bytes, str))):
                    raise

    def json(self, method, path, obj=None):
        body, hdr = None, {}
        if obj is not None:
            body, hdr = json.dumps(obj).encode("utf-8"), {"Content-Type": "application/json"}
        r = self.request(method, path, body, hdr)
        data = r.read()
        try:
            j = json.loads(data.decode("utf-8", "replace")) if data else {}
        except ValueError:
            j = {}
        if r.status != 200:
            raise Api(r.status, j.get("error", ""), j.get("message", "") or r.reason)
        return j


def q(**kw):
    return urllib.parse.urlencode({k: v for k, v in kw.items() if v not in (None, "")}, encoding="utf-8", errors="surrogateescape")


def hostport(text, default=8766):
    t = text.strip()
    t = re.sub(r"^https?://", "", t).split("/", 1)[0]
    if t.startswith("["):
        raise Fail("Las direcciones IPv6 todavía no están soportadas; usa la IPv4 del dispositivo.", 2)
    host, _, p = t.partition(":")
    if not host:
        raise Fail("Falta la dirección (IP o nombre): %s" % text, 2)
    try:
        port = int(p) if p else default
    except ValueError:
        raise Fail("Puerto no válido: %s" % p, 2)
    if not 1 <= port <= 65535:
        raise Fail("Puerto no válido: %s" % p, 2)
    return host, port


# ---------------------------------------------------------------- descubrimiento (anuncios UDP)
def own_id():
    try:
        pem = (STATE / "server.crt").read_text(encoding="ascii")
        return hashlib.sha256(ssl.PEM_cert_to_DER_cert(pem)).hexdigest()[:16]
    except Exception:
        return ""


def listen(seconds):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    if hasattr(socket, "SO_REUSEPORT"):
        try:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        except OSError:
            pass
    try:
        s.bind(("", DPORT))
    except OSError as e:
        raise Fail("No puedo escuchar los anuncios en UDP %d (%s). Conéctate directo: nexo-tools connect IP --code CÓDIGO" % (DPORT, e.strerror or e), 3)
    s.settimeout(0.25)
    end, found = time.time() + seconds, {}
    while time.time() < end:
        try:
            data, addr = s.recvfrom(2048)
        except socket.timeout:
            continue
        except OSError:
            break
        try:
            d = json.loads(data.decode("utf-8"))
        except ValueError:
            continue
        if not isinstance(d, dict) or d.get("nexo") != 1 or d.get("app") != "nexo-tools":
            continue
        did = str(d.get("id", ""))
        if not re.fullmatch(r"[0-9a-f]{16}", did):
            continue
        try:
            port = int(d.get("port"))
        except (TypeError, ValueError):
            continue
        if not 1 <= port <= 65535:
            continue
        found[did] = {"id": did, "ip": addr[0], "port": port, "name": clean(d.get("name", "?"), 40), "rw": bool(d.get("rw")),
                      "only": bool(d.get("only")), "version": clean(d.get("v", ""), 16)}
    s.close()
    return found


def cmd_discover(args):
    pos, o = parse(args, valued=("t",), flags=("json",), aliases={"-t": "t", "--tiempo": "t", "-j": "json"})
    try:
        secs = float(o.get("t", 4))
    except ValueError:
        raise Fail("El tiempo debe ser un número de segundos.", 2)
    found = listen(max(1.0, min(secs, 60.0)))
    known = read_json(KNOWN)
    byid = {v.get("id"): k for k, v in known.items() if isinstance(v, dict)}
    me = own_id()
    rows = sorted(found.values(), key=lambda x: (x["name"].lower(), x["ip"]))
    for r in rows:
        r["state"] = "this" if r["id"] == me else ("paired" if r["id"] in byid else "new")
        r["known_as"] = byid.get(r["id"], "")
    if o.get("json"):
        say(json.dumps(rows, ensure_ascii=True))
        return 0
    if not rows:
        say("No vi ningún dispositivo Nexo en %d s." % int(secs))
        say("  • El otro debe tener un servidor activo: nexo-tools server")
        say("  • Ambos en la misma red Wi-Fi (algunos routers bloquean la difusión; entonces usa: nexo-tools connect IP --code CÓDIGO)")
        return 0
    say("Dispositivos Nexo en la red:")
    say("  %-18s %-22s %-14s %-8s %s" % ("NOMBRE", "DIRECCIÓN", "MODO", "VERSIÓN", "ESTADO"))
    news = False
    for r in rows:
        mode = "selección" if r["only"] else ("lectura/escr." if r["rw"] else "solo lectura")
        st = {"this": "este dispositivo", "paired": "emparejado (%s)" % r["known_as"], "new": "nuevo"}[r["state"]]
        news = news or r["state"] == "new"
        say("  %-18s %-22s %-14s %-8s %s" % (r["name"][:18], "%s:%d" % (r["ip"], r["port"]), mode, r["version"][:8], st))
    if news:
        say("Para conectarte a uno nuevo: pídele que ejecute «nexo-tools pair» y usa:")
        say("  nexo-tools connect IP:PUERTO --code CÓDIGO")
    return 0


# ---------------------------------------------------------------- emparejamiento (lado cliente)
def known_key(name, rid, known):
    base = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-.")[:30] or "dispositivo"
    k, n = base.lower(), 2
    while k in known and known[k].get("id") != rid:
        k = "%s-%d" % (base.lower(), n)
        n += 1
    return k


def do_connect(target, code, label=None):
    host, port = hostport(target)
    secret = norm_code(code)
    if len(secret) != 12:
        raise Fail("El código tiene 12 caracteres (por ejemplo K7QF-3M9D-2XHA).", 2)
    lk = Link(host, port, "", "", 15)
    try:
        lk.open()
    except Fail:
        raise
    except OSError as e:
        raise Fail("No logro conectar con %s:%d (%s). ¿Está encendido y con «nexo-tools server»?" % (host, port, e.strerror or e), 3)
    fp = lk.seen_fp
    nc = secrets.token_hex(16)
    proof = hmac.new(secret.encode("ascii"), b"nexo-pair-c|" + nc.encode("ascii") + b"|" + fp.encode("ascii"), hashlib.sha256).hexdigest()
    try:
        j = lk.json("POST", "/api/pair", {"nc": nc, "proof": proof, "name": MYNAME})
    except Api as e:
        lk.close()
        if e.err == "bad_code":
            raise Fail("Código incorrecto. Pídelo de nuevo en el otro dispositivo (caduca y tiene pocos intentos).", 1)
        raise
    lk.close()
    token = str(j.get("token", ""))
    good = hmac.new(secret.encode("ascii"), b"nexo-pair-s|" + nc.encode("ascii") + b"|" + fp.encode("ascii") + b"|" + token.encode("ascii"), hashlib.sha256).hexdigest()
    if not token or not hmac.compare_digest(good, str(j.get("proof", ""))):
        raise Fail("El dispositivo no supo demostrar que conoce el código: puede ser un impostor. Emparejamiento cancelado.", 4)
    known = read_json(KNOWN)
    rid = fp[:16]
    dev = clean(label or j.get("device") or host, 40)
    key = None
    for k, v in known.items():       # el mismo dispositivo (aunque renovara su certificado) o la misma dirección: se sustituye
        if isinstance(v, dict) and (v.get("id") == rid or (v.get("host") == host and v.get("port") == port)):
            key = k
            if v.get("id") != rid:
                note("(Sustituyo el emparejamiento anterior de «%s»: su huella había cambiado.)" % k)
            break
    if key is None:
        key = known_key(dev, rid, known)
    known[key] = {"name": dev, "host": host, "port": port, "fp": fp, "token": token, "role": str(j.get("role", "ro")), "id": rid, "added": int(time.time())}
    write_json(KNOWN, known)
    return key, known[key]


def cmd_connect(args):
    pos, o = parse(args, valued=("code", "name"), aliases={"-c": "code", "-n": "name"})
    if len(pos) != 1:
        raise Fail("Uso: nexo-tools connect IP[:PUERTO] [--code CÓDIGO] [--name NOMBRE]", 2)
    code = o.get("code") or os.environ.get("NEXO_TOOLS_CODE", "")
    if not code:
        if not sys.stdin.isatty():
            raise Fail("Falta el código. Usa --code CÓDIGO (lo muestra «nexo-tools pair» en el otro dispositivo).", 2)
        code = input("Código de emparejamiento (el que muestra el otro dispositivo): ")
    key, rec = do_connect(pos[0], code, o.get("name"))
    say("%s✔%s Emparejado con «%s» (%s:%d), permiso: %s." % (G, Z, rec["name"], rec["host"], rec["port"], "lectura y escritura" if rec["role"] == "rw" else "solo lectura"))
    say("  Huella del certificado: %s" % rec["fp"])
    say("  Ahora puedes usar:  nexo-tools browse %s   ·   nexo-tools ls %s   ·   nexo-tools get %s RUTA   ·   nexo-tools web %s" % (key, key, key, key))
    return 0


def find_known(spec):
    known = read_json(KNOWN)
    s = spec.strip().lower()
    if s in known:
        return s, known[s]
    m = [k for k in known if k.startswith(s)] or [k for k, v in known.items() if str(v.get("id", "")).startswith(s)]
    if not m:
        h, _, p = s.partition(":")
        m = [k for k, v in known.items() if v.get("host") == h and (not p or str(v.get("port")) == p)]
    if len(m) == 1:
        return m[0], known[m[0]]
    if len(m) > 1:
        raise Fail("«%s» coincide con varios dispositivos: %s" % (spec, ", ".join(sorted(m))), 2)
    raise Fail("No conozco ningún dispositivo llamado «%s». Mira «nexo-tools devices» o empareja con «nexo-tools connect IP --code CÓDIGO»." % spec, 2)


def link_for(spec, timeout=20):
    key, rec = find_known(spec)
    lk = Link(rec["host"], rec["port"], rec["fp"], rec["token"], timeout)
    try:
        lk.open()
    except Fail:
        raise
    except OSError:
        lk.close()
        seen = listen(3.0).get(rec.get("id"))     # ¿cambió de IP? Su huella manda: si es otro, la conexión fallará al comprobarla
        if not seen:
            raise Fail("No logro conectar con «%s» (%s:%s). ¿Está encendido y con «nexo-tools server»? Si cambió de red, prueba «nexo-tools discover»."
                       % (key, rec["host"], rec["port"]), 3)
        lk = Link(seen["ip"], seen["port"], rec["fp"], rec["token"], timeout)
        lk.open()
        known = read_json(KNOWN)
        if key in known:
            known[key]["host"], known[key]["port"] = seen["ip"], seen["port"]
            write_json(KNOWN, known)
        rec["host"], rec["port"] = seen["ip"], seen["port"]
        note("(«%s» cambió de dirección: ahora %s:%d)" % (key, seen["ip"], seen["port"]))
    return key, rec, lk


def cmd_devices(args):
    pos, o = parse(args, flags=("json",), aliases={"-j": "json"})
    known = read_json(KNOWN)
    if o.get("json"):
        say(json.dumps([{"key": k, **{x: v.get(x) for x in ("name", "host", "port", "role", "id", "added")}} for k, v in sorted(known.items())], ensure_ascii=True))
        return 0
    if not known:
        say("Todavía no hay dispositivos emparejados.")
        say("  1) En el otro:  nexo-tools server   y   nexo-tools pair")
        say("  2) Aquí:        nexo-tools discover   y   nexo-tools connect IP --code CÓDIGO")
        return 0
    say("Dispositivos emparejados (a los que puedo entrar):")
    say("  %-18s %-22s %-14s %s" % ("NOMBRE", "DIRECCIÓN", "PERMISO", "HUELLA"))
    for k, v in sorted(known.items()):
        say("  %-18s %-22s %-14s %s…" % (k[:18], "%s:%s" % (v.get("host"), v.get("port")), "lectura/escr." if v.get("role") == "rw" else "solo lectura", str(v.get("fp", ""))[:16]))
    return 0


def cmd_forget(args):
    pos, o = parse(args)
    if len(pos) != 1:
        raise Fail("Uso: nexo-tools forget NOMBRE", 2)
    key, rec = find_known(pos[0])
    known = read_json(KNOWN)
    known.pop(key, None)
    write_json(KNOWN, known)
    say("%s✔%s «%s» olvidado en este dispositivo. (Para quitarle el acceso desde el otro lado: «nexo-tools revoke» allí.)" % (G, Z, key))
    return 0


def cmd_resolve(args):          # uso interno: imprime URL, token y huella (para el explorador de terminal)
    pos, o = parse(args)
    key, rec, lk = link_for(pos[0])
    lk.close()
    say("https://%s:%d" % (rec["host"], rec["port"]))
    say(rec["token"])
    say(rec["fp"])
    say(key)
    return 0


def cmd_web(args):              # URL para el navegador de un dispositivo emparejado
    pos, o = parse(args)
    if len(pos) != 1:
        raise Fail("Uso: nexo-tools web NOMBRE", 2)
    key, rec, lk = link_for(pos[0])
    lk.close()
    say("https://%s:%d/ui#t=%s" % (rec["host"], rec["port"], rec["token"]))
    say(rec["fp"])
    return 0


# ---------------------------------------------------------------- lado servidor: códigos, dispositivos autorizados, navegador
def cmd_mkpair(args):
    pos, o = parse(args, valued=("minutes", "uses"), flags=("rw",), aliases={"-m": "minutes", "--minutos": "minutes", "--usos": "uses"})
    try:
        minutes, uses = int(o.get("minutes", 10)), int(o.get("uses", 1))
    except ValueError:
        raise Fail("--minutes y --uses son números enteros.", 2)
    if not 1 <= minutes <= 120 or not 1 <= uses <= 20:
        raise Fail("Usa entre 1 y 120 minutos y entre 1 y 20 usos.", 2)
    secret = "".join(secrets.choice(CODE_ALPHABET) for _ in range(12))
    write_json(PAIR, {"secret": secret, "expires": time.time() + minutes * 60, "max": uses, "uses": 0, "role": "rw" if o.get("rw") else "ro", "fails": 0})
    say("%s-%s-%s" % (secret[:4], secret[4:8], secret[8:]))
    return 0


def cmd_mint(args):             # token para el navegador de ESTE dispositivo (se guarda como un dispositivo más)
    pos, o = parse(args, valued=("role", "name"))
    role = "rw" if o.get("role") == "rw" else "ro"
    token = secrets.token_hex(24)
    peers = read_json(PEERS)
    peers[secrets.token_hex(6)] = {"name": clean(o.get("name") or "Navegador", 40), "hash": hashlib.sha256(token.encode("ascii")).hexdigest(),
                                   "role": role, "created": int(time.time()), "ip": "local"}
    write_json(PEERS, peers)
    say(token)
    return 0


def cmd_authorized(args):
    pos, o = parse(args, flags=("json",), aliases={"-j": "json"})
    peers = read_json(PEERS)
    if o.get("json"):
        say(json.dumps([{"id": k, "name": v.get("name"), "role": v.get("role"), "created": v.get("created"), "ip": v.get("ip")} for k, v in peers.items() if isinstance(v, dict)], ensure_ascii=True))
        return 0
    if not peers:
        say("Ningún dispositivo emparejado con este (solo funciona el token que muestra el servidor, que es de solo lectura).")
        return 0
    say("Dispositivos autorizados en ESTE dispositivo:")
    say("  %-14s %-20s %-14s %-16s %s" % ("ID", "NOMBRE", "PERMISO", "DESDE", "IP"))
    for k, v in sorted(peers.items(), key=lambda kv: kv[1].get("created", 0) if isinstance(kv[1], dict) else 0):
        if isinstance(v, dict):
            say("  %-14s %-20s %-14s %-16s %s" % (k, clean(v.get("name", "?"), 20), "lectura/escr." if v.get("role") == "rw" else "solo lectura", when(v.get("created", 0)), clean(v.get("ip", ""), 40)))
    say("Para quitar el acceso:  nexo-tools revoke ID|NOMBRE|--all")
    return 0


def cmd_revoke(args):
    pos, o = parse(args, flags=("all",))
    peers = read_json(PEERS)
    if o.get("all"):
        n = len(peers)
        peers = {}
    else:
        if len(pos) != 1:
            raise Fail("Uso: nexo-tools revoke ID|NOMBRE   (o --all). Mira los ID con «nexo-tools authorized».", 2)
        s = pos[0].lower()
        hit = [k for k, v in peers.items() if k.lower() == s or (isinstance(v, dict) and str(v.get("name", "")).lower() == s)] or \
              [k for k in peers if k.lower().startswith(s)]
        if not hit:
            raise Fail("Ningún dispositivo autorizado coincide con «%s»." % pos[0], 1)
        for k in hit:
            peers.pop(k, None)
        n = len(hit)
    write_json(PEERS, peers)
    say("%s✔%s Acceso quitado a %d dispositivo(s). Surte efecto al instante." % (G, Z, n))
    return 0


def cmd_follow(args):           # muestra en vivo lo importante del registro del servidor (para «send»)
    pos, o = parse(args, valued=("seconds",))
    path = Path(pos[0])
    end = time.time() + float(o.get("seconds", 0) or 0) if o.get("seconds") else None
    try:
        f = open(str(path), "r", encoding="utf-8", errors="replace")
        f.seek(0, 2)
        while end is None or time.time() < end:
            line = f.readline()
            if not line:
                time.sleep(0.3)
                continue
            if any(w in line for w in ("emparejado", "descarga", "rechazado", "invalidado", "listo")):
                say("  · " + clean(line.strip(), 200))
    except KeyboardInterrupt:
        pass
    except OSError:
        pass
    return 0


# ---------------------------------------------------------------- listar
def list_all(lk, path, ext="", glob=""):
    off, out, meta = 0, [], {}
    while True:
        j = lk.json("GET", "/api/list?" + q(path=path, offset=off, limit=10000, ext=ext, glob=glob))
        ents = j.get("entries", [])
        out.extend(ents)
        off += len(ents)
        meta = j
        if not j.get("has_more") or not ents:
            break
    meta["entries"] = out
    return meta


def remote_path(p):
    p = p.strip().replace("\\", "/").strip("/")
    parts = [x for x in p.split("/") if x]
    if any(x in (".", "..") for x in parts):
        raise Fail("La ruta remota no puede llevar «.» ni «..»: %s" % p, 2)
    return "/".join(parts)


def stat_remote(lk, path):
    if path == "":
        return {"kind": "directory", "name": "", "path": ""}
    try:
        lk.json("GET", "/api/list?" + q(path=path, limit=1))
        return {"kind": "directory", "name": path.rsplit("/", 1)[-1], "path": path}
    except Api as e:
        if e.err != "not_directory":
            if e.status == 404:
                raise Fail("No existe en el otro dispositivo: /%s" % path, 1)
            raise
    parent, _, name = path.rpartition("/")
    for e in list_all(lk, parent)["entries"]:
        if e.get("name") == name:
            return e
    raise Fail("No existe en el otro dispositivo: /%s" % path, 1)


def cmd_ls(args):
    pos, o = parse(args, valued=("ext", "find"), flags=("json", "types"), aliases={"-j": "json", "-e": "ext", "-f": "find"})
    if not pos:
        raise Fail("Uso: nexo-tools ls NOMBRE [RUTA] [--ext .jpg,.png] [--find 'a*|b*'] [--types] [--json]", 2)
    key, rec, lk = link_for(pos[0])
    path = remote_path(pos[1]) if len(pos) > 1 else ""
    meta = list_all(lk, path, o.get("ext", ""), o.get("find", ""))
    lk.close()
    if o.get("json"):
        say(json.dumps(meta, ensure_ascii=True))
        return 0
    say("%s%s:/%s%s  —  %d elementos" % (B, key, path, Z, meta.get("total", len(meta["entries"]))))
    for e in meta["entries"]:
        k = e.get("kind")
        t = "d" if k == "directory" else "l" if k == "symlink" else "-" if k == "file" else "?"
        size = "" if k != "file" else human(e.get("size", 0))
        say("  %s %10s  %s  %s%s" % (t, size, when(e.get("mtime", 0)), clean(e.get("name", "")), "/" if k == "directory" else (" → " + clean(e.get("target", "")) if k == "symlink" else "")))
    if meta.get("truncated"):
        note("(La carpeta es enorme: el otro dispositivo solo enumera los primeros %d. Filtra con --ext o --find.)" % meta.get("total", 0))
    if meta.get("skipped"):
        note("(%d elementos omitidos: sin permiso o con nombres no válidos.)" % meta["skipped"])
    if o.get("types"):
        counts = meta.get("ext_counts", {})
        say("Extensiones en esta carpeta (%d distintas):" % len(counts))
        for ext, n in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])):
            say("  %-16s %d" % (ext or "(sin extensión)", n))
    return 0


# ---------------------------------------------------------------- descargar
def fat_names(dest):
    s = str(dest.resolve())
    return os.environ.get("NEXO_TOOLS_FAT_NAMES") == "1" or s.startswith(("/storage/", "/sdcard", "/mnt/media_rw/"))


def local_name(name, fat):
    name = name.replace("\x00", "_")
    if fat:
        name = re.sub(r'[<>:"|?*\\]', "_", name).rstrip(" .")
    return name if name not in ("", ".", "..") else "_" + name


def unique(p):
    if not p.exists():
        return p
    n = 1
    while True:
        c = p.with_name("%s (%d)%s" % (p.stem, n, p.suffix))
        if not c.exists():
            return c
        n += 1


class Stats:
    def __init__(self):
        self.files = self.bytes = self.same = self.errors = self.skipped = 0
        self.t0 = time.time()


def fetch_file(lk, remote, entry, target, o, st):
    size, mt = int(entry.get("size", 0)), int(entry.get("mtime", 0))
    label = clean(remote)
    if target.exists():
        try:
            s = target.stat()
            same = s.st_size == size and abs(s.st_mtime - mt) <= 2
        except OSError:
            same = False
        if same and not o.get("overwrite"):
            st.same += 1
            note("  = %s (ya estaba)" % label)
            return
        if o.get("skip"):
            st.skipped += 1
            note("  ⤼ %s (ya existe, omitido)" % label)
            return
        if not o.get("overwrite"):
            target = unique(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    part = target.with_name(target.name + ".nexo-part")
    have = part.stat().st_size if part.exists() else 0
    if have > size:
        have = 0
    for attempt in (0, 1):
        hdr = {"Range": "bytes=%d-" % have} if have else {}
        r = lk.request("GET", "/api/download?" + q(path=remote), headers=hdr)
        if r.status == 416 and have:
            r.read()
            have = 0
            continue
        break
    if r.status not in (200, 206):
        data = r.read()
        try:
            j = json.loads(data.decode("utf-8", "replace"))
        except ValueError:
            j = {}
        raise Api(r.status, j.get("error", ""), j.get("message", "") or r.reason)
    want = (r.getheader("X-Nexo-SHA256") or "").lower()
    resume = r.status == 206 and have > 0
    h = hashlib.sha256()
    if resume:
        with open(str(part), "rb") as f:
            for b in iter(lambda: f.read(1 << 20), b""):
                h.update(b)
    else:
        have = 0
    got, last = have, 0.0
    with open(str(part), "ab" if resume else "wb") as f:
        while True:
            b = r.read(1 << 20)
            if not b:
                break
            f.write(b)
            h.update(b)
            got += len(b)
            now = time.time()
            if TTY and now - last > 0.25:
                last = now
                sys.stderr.write("\r  ↓ %s  %s/%s " % (label[:48], human(got), human(size)))
                sys.stderr.flush()
    if TTY:
        sys.stderr.write("\r\033[K")
    if got != size:
        raise Fail("Conexión cortada en %s (%s de %s). Repite el mismo comando para reanudar." % (label, human(got), human(size)), 3)
    if want and h.hexdigest() != want:
        part.unlink()
        raise Fail("La suma SHA-256 de %s no coincide; se descartó el archivo. Vuelve a intentarlo." % label, 1)
    os.replace(str(part), str(target))
    if mt:
        try:
            os.utime(str(target), (mt, mt))
        except OSError:
            pass
    st.files += 1
    st.bytes += size
    say("  ↓ %s  (%s)%s" % (label, human(size), " ✔" if want else ""))


def walk(lk, base, ext, glob, st):
    stack, seen = [base], set()
    while stack:
        d = stack.pop()
        if d in seen:
            continue
        seen.add(d)
        meta = list_all(lk, d, ext, glob)
        st.skipped += int(meta.get("skipped", 0))
        for e in meta["entries"]:
            k = e.get("kind")
            if k == "directory":
                stack.append(e["path"])
            elif k == "file" or (k == "symlink" and e.get("downloadable")):
                yield e
            else:
                st.skipped += 1


def do_get(key, lk, paths, o, dest):
    st = Stats()
    dest.mkdir(parents=True, exist_ok=True)
    fat = fat_names(dest)
    droot = dest.resolve()
    plan = []
    bases = [""] if o.get("all") else [remote_path(p) for p in paths]
    for base in bases:
        ent = stat_remote(lk, base)
        if ent.get("kind") == "directory":
            prefix = [] if base == "" else [ent.get("name") or base.rsplit("/", 1)[-1]]
            for e in walk(lk, base, o.get("ext", ""), o.get("find", ""), st):
                rel = e["path"][len(base):].strip("/") if base else e["path"]
                plan.append((e, prefix + [x for x in rel.split("/") if x]))
        elif ent.get("kind") in ("file", "symlink") and (ent.get("kind") == "file" or ent.get("downloadable")):
            plan.append((ent, [ent["name"]]))
        else:
            st.skipped += 1
            note("  ⤼ /%s: no se puede descargar por HTTPS (enlace o archivo especial)." % clean(base))
    if not plan:
        say("No hay archivos que descargar con ese filtro.")
        return 0
    say("Descargando %d archivo(s) de «%s» a %s" % (len(plan), key, droot))
    net_fails = 0
    for e, parts in plan:
        target = droot.joinpath(*[local_name(x, fat) for x in parts])
        try:
            target.resolve().relative_to(droot)
        except ValueError:
            st.errors += 1
            note("  ✘ ruta insegura rechazada: %s" % clean(e.get("path", "")))
            continue
        try:
            fetch_file(lk, e["path"], e, target, o, st)
            net_fails = 0
        except Fail as ex:
            st.errors += 1
            note("  ✘ %s: %s" % (clean(e.get("path", "")), ex))
            if ex.code == 4:
                break
            net_fails = net_fails + 1 if ex.code == 3 else 0
        except (OSError, http.client.HTTPException) as ex:
            lk.close()
            st.errors += 1
            net_fails += 1
            note("  ✘ %s: conexión perdida (%s). Repite el comando para reanudar." % (clean(e.get("path", "")), getattr(ex, "strerror", None) or ex.__class__.__name__))
        if net_fails >= 3:
            note("  ✘ Demasiados fallos de red seguidos: me detengo. Repite el comando para reanudar donde quedó.")
            break
    secs = max(0.1, time.time() - st.t0)
    say("%s %d archivo(s), %s en %.0f s%s%s%s" % ("✘" if st.errors else "✔", st.files, human(st.bytes), secs,
        " · %d ya estaban" % st.same if st.same else "", " · %d omitidos" % st.skipped if st.skipped else "", " · %d con error" % st.errors if st.errors else ""))
    return 1 if st.errors else 0


GET_OPTS = dict(valued=("o", "ext", "find"), flags=("all", "overwrite", "skip"), aliases={"-o": "o", "--dest": "o", "-a": "all", "-e": "ext", "-f": "find"})


def cmd_get(args):
    pos, o = parse(args, **GET_OPTS)
    if not pos or (len(pos) == 1 and not o.get("all")):
        raise Fail("Uso: nexo-tools get NOMBRE RUTA... [-o CARPETA] [--ext .jpg,.png] [--find 'a*|b*'] [--all]   (--all baja todo lo que el otro comparte)", 2)
    key, rec, lk = link_for(pos[0])
    try:
        return do_get(key, lk, pos[1:], o, Path(o.get("o") or ".").expanduser())
    finally:
        lk.close()


def cmd_fetch(args):
    pos, o = parse(args, valued=("o", "code", "ext", "find"), flags=("keep", "overwrite", "skip"), aliases={"-o": "o", "--dest": "o", "-c": "code"})
    if len(pos) < 1 or (len(pos) < 2 and not o.get("code")):
        raise Fail("Uso: nexo-tools fetch IP[:PUERTO] CÓDIGO [-o CARPETA] [--keep]   (empareja, baja todo lo que el otro envía y olvida el emparejamiento)", 2)
    code = o.get("code") or pos[1]
    key, rec = do_connect(pos[0], code)
    say("%s✔%s Conectado con «%s»." % (G, Z, rec["name"]))
    lk = Link(rec["host"], rec["port"], rec["fp"], rec["token"], 30)
    try:
        o["all"] = True
        rc = do_get(key, lk, [], o, Path(o.get("o") or "nexo-recibido").expanduser())
    finally:
        lk.close()
        if not o.get("keep"):
            known = read_json(KNOWN)
            known.pop(key, None)
            write_json(KNOWN, known)
    return rc


# ---------------------------------------------------------------- escribir (solo si el otro dispositivo te dio permiso)
def sha_file(p):
    h = hashlib.sha256()
    with open(str(p), "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def put_one(lk, src, remote, o, st):
    size = src.stat().st_size
    digest = sha_file(src)
    lk.close()                      # conexión nueva: calcular la suma de un archivo grande puede haber dejado la anterior caducar
    with open(str(src), "rb") as fh:
        r = lk.request("PUT", "/api/upload?" + q(path=remote, overwrite="1" if o.get("overwrite") else "0"), body=fh,
                       headers={"Content-Length": str(size), "X-Nexo-SHA256": digest, "Content-Type": "application/octet-stream"})
        data = r.read()
    try:
        j = json.loads(data.decode("utf-8", "replace"))
    except ValueError:
        j = {}
    if r.status == 200:
        st.files += 1
        st.bytes += size
        say("  ↑ %s  (%s) ✔" % (clean(remote), human(size)))
    elif r.status == 409 and j.get("error") == "exists":
        st.same += 1
        note("  = %s (ya existe; usa --overwrite para reemplazarlo)" % clean(remote))
    else:
        raise Api(r.status, j.get("error", ""), j.get("message", "") or r.reason)


def cmd_put(args):
    pos, o = parse(args, valued=("to",), flags=("overwrite",), aliases={"-t": "to", "--a": "to"})
    if len(pos) < 2:
        raise Fail("Uso: nexo-tools put NOMBRE ARCHIVO_O_CARPETA... [--to RUTA_REMOTA] [--overwrite]", 2)
    key, rec, lk = link_for(pos[0])
    to = remote_path(o.get("to", ""))
    st = Stats()
    try:
        for s in pos[1:]:
            p = Path(s).expanduser()
            if p.is_symlink() or not p.exists():
                st.errors += 1
                note("  ✘ %s: no existe o es un enlace simbólico (se omite)" % clean(s))
            elif p.is_file():
                try:
                    put_one(lk, p, (to + "/" if to else "") + p.name, o, st)
                except Fail as ex:
                    st.errors += 1
                    note("  ✘ %s: %s" % (clean(s), ex))
                    if ex.code in (3, 4) or getattr(ex, "status", 0) in (401, 403):
                        break
            elif p.is_dir():
                for cur, dirs, files in os.walk(str(p), followlinks=False):
                    rel = os.path.relpath(cur, str(p.parent)).replace(os.sep, "/")
                    rdir = (to + "/" if to else "") + rel
                    try:
                        lk.json("POST", "/api/mkdir", {"path": rdir})
                    except Api as ex:
                        if ex.status != 409:
                            st.errors += 1
                            note("  ✘ carpeta %s: %s" % (clean(rdir), ex))
                            dirs[:] = []
                            continue
                    dirs.sort()
                    for fn in sorted(files):
                        fp = Path(cur) / fn
                        if fp.is_symlink() or not fp.is_file():
                            st.skipped += 1
                            continue
                        try:
                            put_one(lk, fp, rdir + "/" + fn, o, st)
                        except Fail as ex:
                            st.errors += 1
                            note("  ✘ %s: %s" % (clean(str(fp)), ex))
    finally:
        lk.close()
    say("%s %d archivo(s) enviados (%s)%s%s" % ("✘" if st.errors else "✔", st.files, human(st.bytes), " · %d ya existían" % st.same if st.same else "", " · %d con error" % st.errors if st.errors else ""))
    return 1 if st.errors else 0


def cmd_mkdir(args):
    pos, o = parse(args)
    if len(pos) != 2:
        raise Fail("Uso: nexo-tools mkdir NOMBRE RUTA_NUEVA", 2)
    key, rec, lk = link_for(pos[0])
    j = lk.json("POST", "/api/mkdir", {"path": remote_path(pos[1])})
    lk.close()
    say("%s✔%s Carpeta creada: /%s" % (G, Z, clean(j.get("created", ""))))
    return 0


def cmd_mv(args):
    pos, o = parse(args)
    if len(pos) != 3:
        raise Fail("Uso: nexo-tools mv NOMBRE ORIGEN DESTINO", 2)
    key, rec, lk = link_for(pos[0])
    j = lk.json("POST", "/api/rename", {"path": remote_path(pos[1]), "to": remote_path(pos[2])})
    lk.close()
    say("%s✔%s Movido a /%s" % (G, Z, clean(j.get("renamed", ""))))
    return 0


def cmd_rm(args):
    pos, o = parse(args, flags=("yes",), aliases={"-y": "yes"})
    if len(pos) != 2:
        raise Fail("Uso: nexo-tools rm NOMBRE RUTA [--yes]   (va a la papelera .nexo-trash del otro dispositivo, no se pierde)", 2)
    key, rec, lk = link_for(pos[0])
    path = remote_path(pos[1])
    if not o.get("yes"):
        if not sys.stdin.isatty():
            raise Fail("Sin terminal interactiva hace falta --yes para confirmar.", 2)
        if input("¿Mover /%s de «%s» a su papelera (.nexo-trash)? [s/N]: " % (path, key)).strip().lower() not in ("s", "si", "sí", "y", "yes"):
            say("Cancelado.")
            return 1
    j = lk.json("POST", "/api/delete", {"path": path})
    lk.close()
    say("%s✔%s Movido a la papelera del otro dispositivo: %s" % (G, Z, clean(j.get("to", ""))))
    return 0


def cmd_info(args):
    pos, o = parse(args, flags=("json",), aliases={"-j": "json"})
    if len(pos) != 1:
        raise Fail("Uso: nexo-tools info NOMBRE", 2)
    key, rec, lk = link_for(pos[0])
    j = lk.json("GET", "/api/ping")
    lk.close()
    if o.get("json"):
        say(json.dumps(j, ensure_ascii=True))
        return 0
    say("%s%s%s  ·  %s %s (protocolo %s)" % (B, clean(j.get("device", key)), Z, clean(j.get("name", "")), clean(j.get("version", "")), j.get("protocol", "?")))
    say("  Dirección:  %s:%s" % (rec["host"], rec["port"]))
    say("  Mi permiso: %s%s" % ("lectura y escritura" if j.get("role") == "rw" else "solo lectura", "  (modo selección: solo ve lo que le enviaron)" if j.get("selection") else ""))
    say("  Huella:     %s" % rec["fp"])
    return 0


COMMANDS = {
    "discover": cmd_discover, "connect": cmd_connect, "devices": cmd_devices, "forget": cmd_forget, "resolve": cmd_resolve, "web": cmd_web,
    "mkpair": cmd_mkpair, "mint": cmd_mint, "authorized": cmd_authorized, "revoke": cmd_revoke, "follow": cmd_follow,
    "ls": cmd_ls, "get": cmd_get, "fetch": cmd_fetch, "put": cmd_put, "mkdir": cmd_mkdir, "mv": cmd_mv, "rm": cmd_rm, "info": cmd_info,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        note("Comando interno desconocido: %s" % (sys.argv[1] if len(sys.argv) > 1 else ""))
        return 2
    os.umask(0o077)
    try:
        return COMMANDS[sys.argv[1]](sys.argv[2:]) or 0
    except Fail as e:
        note("%s✘%s %s" % (R, Z, e))
        return e.code
    except KeyboardInterrupt:
        note("\nCancelado.")
        return 130
    except (OSError, http.client.HTTPException) as e:
        note("%s✘%s Error de red o de archivos: %s" % (R, Z, getattr(e, "strerror", None) or e))
        return 3


raise SystemExit(main())
PYPEER
}

peer_py() {
    NEXO_TOOLS_STATE="$STATE_DIR" NEXO_TOOLS_DISCOVER_PORT="$NEXO_TOOLS_DISCOVER_PORT" NEXO_TOOLS_DEVICE="${NEXO_TOOLS_DEVICE:-$(device_name)}" \
        python3 -c "$(peer_code)" "$@"
}

peer_cmd() {
    require_client || return 1
    ensure_state_dir || return 1
    peer_py "$@"
}

server_active() {
    [[ -r "$SERVER_META" ]] || return 1
    local pid
    pid=$(read_meta_value PID || true)
    [[ -n "$pid" ]] && server_pid_is_ours "$pid"
}

mode_text() {      # $1 = 1 si admite escritura, $2 = archivo de selección (si es un envío)
    if [[ -n "${2:-}" ]]; then printf 'envío de una selección (solo lectura)'
    elif [[ "${1:-0}" == 1 ]]; then printf 'lectura y escritura (escribe quien se empareje con «nexo-tools pair --rw»)'
    else printf 'solo lectura'; fi
}

# nexo-tools server [CARPETA] [PUERTO] [--rw] [--name NOMBRE] [--no-announce]
cmd_server() {
    local dir="" port="$DEFAULT_PORT" rw=0 name="" announce=1 n=0
    while (($#)); do
        case "$1" in
            --rw|--write|--escritura) rw=1 ;;
            --ro|--read-only|--solo-lectura) rw=0 ;;
            --no-announce|--sin-anuncio) announce=0 ;;
            --name|--nombre) (($# >= 2)) || { err "Falta el valor de $1"; return 2; }; name=$2; shift ;;
            --port|--puerto) (($# >= 2)) || { err "Falta el valor de $1"; return 2; }; port=$2; shift ;;
            -*) err "Opción desconocida: $1"; return 2 ;;
            *) n=$((n + 1))
               case "$n" in 1) dir=$1 ;; 2) port=$1 ;; *) err "Sobra el argumento: $1"; return 2 ;; esac ;;
        esac
        shift
    done
    NEXO_TOOLS_RW=$rw; NEXO_TOOLS_ANNOUNCE=$announce; NEXO_TOOLS_ONLY=""
    [[ -z "$name" ]] || NEXO_TOOLS_DEVICE=$name
    start_server "$dir" "$port"
}

# nexo-tools pair [--rw] [--minutes N] [--uses N]  → código para que otro dispositivo se empareje con este
cmd_pair() {
    require_client || return 1
    ensure_state_dir || return 1
    if ! server_active; then
        err "No hay un servidor activo en este dispositivo."
        say "  Arráncalo con:  nexo-tools server [CARPETA]    (añade --rw para permitir que el otro escriba)"
        return 1
    fi
    local want_rw=0 a code
    for a in "$@"; do [[ "$a" == --rw ]] && want_rw=1; done
    local -a mv=()
    mapfile -t mv < <(read_meta_values IP PORT RW || true)
    local ip=${mv[0]:-} port=${mv[1]:-} srv_rw=${mv[2]:-0}
    code=$(peer_py mkpair "$@") || return $?
    say ""
    say "  Código de emparejamiento:  ${C_BOLD}${C_GREEN}${code}${C_RESET}"
    say "  Vale unos minutos, tiene intentos limitados y se gasta al usarlo. No lo publiques."
    say ""
    say "  En el otro dispositivo (Termux, distro o PC con nexo-tools):"
    say "      nexo-tools connect ${ip}:${port} --code ${code}"
    say "  (o primero búscame con:  nexo-tools discover)"
    if (( want_rw )) && [[ "$srv_rw" != 1 ]]; then
        warn "El servidor está en solo lectura: este código dará solo lectura. Para escribir: nexo-tools stop && nexo-tools server --rw"
    fi
}

# nexo-tools web [--rw] [--open] [NOMBRE]  → dirección para el navegador (gestor de archivos web)
cmd_web() {
    require_client || return 1
    ensure_state_dir || return 1
    local rw=0 open=0 name="" a url fp token out
    for a in "$@"; do
        case "$a" in
            --rw) rw=1 ;;
            --open|--abrir) open=1 ;;
            -*) err "Opción desconocida: $a"; return 2 ;;
            *) name=$a ;;
        esac
    done
    if [[ -n "$name" ]]; then
        out=$(peer_py web "$name") || return $?
        url=${out%%$'\n'*}; fp=${out#*$'\n'}
    else
        if ! server_active; then err "No hay un servidor activo. Arráncalo con: nexo-tools server"; return 1; fi
        local -a mv=()
        mapfile -t mv < <(read_meta_values URL FINGERPRINT RW || true)
        if (( rw )) && [[ "${mv[2]:-0}" != 1 ]]; then warn "El servidor está en solo lectura; el navegador solo podrá leer. Para escribir: nexo-tools stop && nexo-tools server --rw"; fi
        token=$(peer_py mint --role "$( ((rw)) && echo rw || echo ro )" --name "Navegador") || return $?
        url="${mv[0]}/ui#t=$token"; fp=${mv[1]:-}
    fi
    say ""
    say "  Abre esta dirección en el navegador (de este equipo o de cualquiera de la misma red):"
    say "      ${C_BOLD}${C_GREEN}$url${C_RESET}"
    say ""
    say "  El navegador avisará de un certificado no confiable: es normal (es autofirmado y solo tú lo conoces)."
    [[ -z "$fp" ]] || say "  Si quieres comprobarlo, la huella SHA-256 debe ser:  $fp"
    say "  La dirección lleva tu acceso después del «#»: no la compartas."
    if command -v qrencode >/dev/null 2>&1 && [[ -t 1 ]]; then qrencode -t ANSIUTF8 "$url" 2>/dev/null || true; fi
    if (( open )); then
        if command -v termux-open-url >/dev/null 2>&1; then termux-open-url "$url" || true
        elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 || true
        else warn "No encontré cómo abrir el navegador desde aquí; copia la dirección."; fi
    fi
}

# nexo-tools browse [NOMBRE] [--dest CARPETA]  → explorador de terminal de un dispositivo emparejado
cmd_browse() {
    require_client || return 1
    ensure_state_dir || return 1
    local name="" dest="$PWD" out url token fp
    while (($#)); do
        case "$1" in
            --dest|-o) (($# >= 2)) || { err "Falta el valor de $1"; return 2; }; dest=$2; shift ;;
            -*) err "Opción desconocida: $1"; return 2 ;;
            *) name=$1 ;;
        esac
        shift
    done
    if [[ -z "$name" ]]; then
        peer_py devices || true
        [[ -t 0 ]] || { err "Indica el nombre: nexo-tools browse NOMBRE"; return 2; }
        printf '\nNombre del dispositivo: '
        IFS= read -r name || return 1
        [[ -n "$name" ]] || return 1
    fi
    out=$(peer_py resolve "$name") || return $?
    { IFS= read -r url; IFS= read -r token; IFS= read -r fp; } <<<"$out"
    start_receiver "$url" --token "$token" --pin "$fp" --dest "$dest"
}

# nexo-tools send ARCHIVO_O_CARPETA... → comparte SOLO eso, da un código y espera a que el otro lo baje
send_cleanup() {
    stop_server >/dev/null 2>&1 || true
    rm -f -- "$STATE_DIR/send.list" "$STATE_DIR/pair.json"
    say ""
    ok "Envío terminado; el servidor está cerrado."
}

cmd_send() {
    require_runtime || return 1
    ensure_state_dir || return 1
    local minutes=15 uses=1 port="$DEFAULT_PORT" name="" root code sel="$STATE_DIR/send.list"
    local -a items=()
    while (($#)); do
        case "$1" in
            --minutes|--minutos) (($# >= 2)) || { err "Falta el valor de $1"; return 2; }; minutes=$2; shift ;;
            --uses|--usos) (($# >= 2)) || { err "Falta el valor de $1"; return 2; }; uses=$2; shift ;;
            --port|--puerto) (($# >= 2)) || { err "Falta el valor de $1"; return 2; }; port=$2; shift ;;
            --name|--nombre) (($# >= 2)) || { err "Falta el valor de $1"; return 2; }; name=$2; shift ;;
            -*) err "Opción desconocida: $1"; return 2 ;;
            *) items+=("$1") ;;
        esac
        shift
    done
    ((${#items[@]})) || { err "Indica qué enviar:  nexo-tools send ARCHIVO_O_CARPETA [...]"; return 2; }
    if server_active; then err "Ya hay un servidor activo. Páralo antes (nexo-tools stop) para enviar solo esos archivos."; return 1; fi
    root=$(python3 - "$sel" "${items[@]}" <<'PYSEND'
import os, sys
sel = sys.argv[1]
items = []
for a in sys.argv[2:]:
    p = os.path.abspath(os.path.expanduser(a))
    if not os.path.lexists(p):
        sys.stderr.write("No existe: %s\n" % a); raise SystemExit(1)
    if "\n" in p:
        sys.stderr.write("Nombre no admitido (lleva un salto de línea): %r\n" % a); raise SystemExit(1)
    items.append(p)
root = os.path.commonpath(sorted({os.path.dirname(p) for p in items}))
if root == "/":
    sys.stderr.write("Los elementos están en sitios muy distintos (no comparten una carpeta que no sea «/»). Envíalos por partes.\n"); raise SystemExit(1)
rels = sorted({os.path.relpath(p, root) for p in items})
fd = os.open(sel, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape") as f:
    f.write("\n".join(rels) + "\n")
print(root)
PYSEND
    ) || return 1
    NEXO_TOOLS_RW=0; NEXO_TOOLS_ONLY=$sel
    [[ -z "$name" ]] || NEXO_TOOLS_DEVICE=$name
    if ! start_server "$root" "$port" >/dev/null; then rm -f -- "$sel"; return 1; fi
    if ! code=$(peer_py mkpair --minutes "$minutes" --uses "$uses"); then send_cleanup; return 1; fi
    local -a mv=()
    mapfile -t mv < <(read_meta_values IP PORT || true)
    say ""
    say "  ${C_BOLD}Enviando${C_RESET} ${#items[@]} elemento(s) desde $root"
    say "  Código:  ${C_BOLD}${C_GREEN}${code}${C_RESET}    (vale $minutes min y $uses uso(s))"
    say ""
    say "  En el OTRO dispositivo escribe:"
    say "      ${C_BOLD}nexo-tools fetch ${mv[0]:-IP}:${mv[1]:-$port} $code${C_RESET}"
    say "  (si no tiene nexo-tools, abre en su navegador la dirección de «nexo-tools web» en este)"
    say ""
    say "  Esperando… (Ctrl-C para terminar y cerrar el servidor)"
    # «follow» va en segundo plano para que Ctrl-C o un «kill» interrumpan la espera y se cierre el servidor sí o sí
    local fpid
    ( export NEXO_TOOLS_STATE="$STATE_DIR"; exec python3 -c "$(peer_code)" follow "$STATE_DIR/server.log" ) &
    fpid=$!
    trap 'kill "$fpid" 2>/dev/null || true' INT TERM HUP
    wait "$fpid" 2>/dev/null || true
    kill "$fpid" 2>/dev/null || true
    trap - INT TERM HUP
    send_cleanup
}

devices_menu() {
    local c ip name dir wr
    while :; do
        ui_header
        say "  ${C_BOLD}${C_CYAN}DISPOSITIVOS NEXO${C_RESET}  (otros móviles, distros o PC con nexo-tools)"
        say ""
        say "  ${C_GREEN}1${C_RESET}) Buscar dispositivos en la red"
        say "  ${C_GREEN}2${C_RESET}) Emparejar con uno nuevo (IP y código)"
        say "  ${C_GREEN}3${C_RESET}) Explorar los archivos de un dispositivo emparejado"
        say "  ${C_GREEN}4${C_RESET}) Ver mis dispositivos emparejados"
        say "  ${C_GREEN}5${C_RESET}) Compartir una carpeta de este dispositivo"
        say "  ${C_GREEN}6${C_RESET}) Código para que otro se empareje conmigo"
        say "  ${C_GREEN}7${C_RESET}) Abrir mi carpeta compartida en el navegador (gestor web)"
        say "  ${C_GREEN}8${C_RESET}) Quién puede entrar en este dispositivo"
        say "  ${C_GREEN}0${C_RESET}) Volver"
        printf '\nSelecciona una opción: '
        IFS= read -r c || return 0
        case "$c" in
            1) peer_cmd discover || true; ui_pause ;;
            2) printf 'IP del otro dispositivo (p. ej. 192.168.1.20 o 192.168.1.20:8766): '
               IFS= read -r ip || return 0
               if [[ -n "$ip" ]]; then peer_cmd connect "$ip" || true; fi
               ui_pause ;;
            3) peer_cmd devices || true
               printf '\nNombre del dispositivo (Enter = volver): '
               IFS= read -r name || return 0
               if [[ -n "$name" ]]; then cmd_browse "$name" || ui_pause; fi ;;
            4) peer_cmd devices || true; ui_pause ;;
            5) printf 'Carpeta a compartir (Enter = elegirla en pantalla): '
               IFS= read -r dir || return 0
               printf '¿Permitir que los dispositivos que emparejes con --rw escriban aquí? [s/N]: '
               IFS= read -r wr || return 0
               case "$wr" in s|S|si|sí|y|Y) cmd_server ${dir:+"$dir"} --rw || true ;; *) cmd_server ${dir:+"$dir"} || true ;; esac
               ui_pause ;;
            6) wr=""; printf '¿Con permiso de escritura? [s/N]: '; IFS= read -r wr || return 0
               case "$wr" in s|S|si|sí|y|Y) cmd_pair --rw || true ;; *) cmd_pair || true ;; esac
               ui_pause ;;
            7) cmd_web || true; ui_pause ;;
            8) peer_cmd authorized || true; ui_pause ;;
            0|q|Q) return 0 ;;
            *) warn "Opción no válida."; ui_pause ;;
        esac
    done
}

# Modo interno: servidor HTTPS. Solo lo invoca este mismo script.
if [[ "${1:-}" == "__serve" ]]; then
    shift
    exec python3 - "$@" <<'PY'
import os, sys, json, hmac, hashlib, ssl, mimetypes, urllib.parse, time, threading, fnmatch, stat, errno, socket
from pathlib import Path
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from collections import OrderedDict, deque

root=Path(sys.argv[1]).resolve(); port=int(sys.argv[2]); token_path=Path(sys.argv[3])
cert=sys.argv[4]; key=sys.argv[5]; bind_ip=sys.argv[6] if len(sys.argv)>6 else "127.0.0.1"
VERSION=os.environ.get("NEXO_TOOLS_VERSION","2.3.0")
BWLIMIT=max(0,int(os.environ.get("NEXO_TOOLS_BWLIMIT","0") or 0))
MAX_FILE_BYTES=max(0,int(os.environ.get("NEXO_TOOLS_MAX_FILE_BYTES","0") or 0))
ALLOW_SYMLINK=os.environ.get("NEXO_TOOLS_ALLOW_SYMLINK_DOWNLOAD","0") == "1"
HASH_SKIP_ABOVE=max(0,int(os.environ.get("NEXO_TOOLS_HASH_SKIP_ABOVE","0") or 0))
ACTIVE_EXTS={x.lower() for x in os.environ.get("NEXO_TOOLS_ACTIVE_EXTS","").split(",") if x}
STATE=Path(os.environ.get("NEXO_TOOLS_STATE") or (Path(os.path.expanduser("~"))/".local"/"state"/"nexo-tools"))
RW=os.environ.get("NEXO_TOOLS_RW","0")=="1"
ONLY_FILE=os.environ.get("NEXO_TOOLS_ONLY","")
DEVICE=(os.environ.get("NEXO_TOOLS_DEVICE","") or socket.gethostname() or "dispositivo")[:40]
DISCOVER_PORT=int(os.environ.get("NEXO_TOOLS_DISCOVER_PORT","8767") or 8767)
ANNOUNCE=os.environ.get("NEXO_TOOLS_ANNOUNCE","1")!="0"
BEACON_TO=[x.strip() for x in os.environ.get("NEXO_TOOLS_BEACON_TO","").split(",") if x.strip()]
SHOW_SECRETS=os.environ.get("NEXO_TOOLS_SHOW_SECRETS","0")=="1"
MAX_LIST=max(1000,int(os.environ.get("NEXO_TOOLS_MAX_LIST","200000") or 200000))
MAX_UPLOAD=max(0,int(os.environ.get("NEXO_TOOLS_MAX_UPLOAD_BYTES","0") or 0))
if str(root)=="/": RW=False        # la raíz del sistema nunca se comparte con escritura
if not token_path.is_file() or not token_path.read_text(encoding="ascii").strip(): raise SystemExit("token vacío")
HASH_CACHE=OrderedDict(); HASH_LOCK=threading.Lock(); HASH_LIMIT=32
AUTH_FAILS={}; AUTH_LOCK=threading.Lock(); DOWNLOAD_SLOTS=threading.BoundedSemaphore(8)

def inside(p):
    try: return os.path.commonpath((os.fsencode(root),os.fsencode(p)))==os.fsencode(root)
    except Exception: return False

def has_symlink_component(raw):
    current=root
    for part in (raw or "").split("/"):
        if not part: continue
        current=current/part
        try:
            if current.is_symlink(): return True
        except OSError: return True
    return False

def resolve_rel(raw,must_exist=True):
    raw=raw or ""
    parts=raw.split("/") if raw else []
    if raw.startswith("/") or any(x in (".","..") for x in parts) or "\x00" in raw:
        raise ValueError("ruta no válida")
    candidate=root.joinpath(*parts)
    p=candidate.resolve(strict=must_exist)
    if not inside(p): raise ValueError("ruta fuera de la carpeta compartida")
    if denied(p): raise FileNotFoundError(raw)
    return p

def file_key(p,st): return (os.fspath(p),st.st_size,st.st_mtime_ns,st.st_dev,st.st_ino)

def digest_file(p,fd,st):
    k=file_key(p,st)
    with HASH_LOCK:
        cached=HASH_CACHE.get(k)
        if cached is not None:
            HASH_CACHE.move_to_end(k); return cached
    h=hashlib.sha256(); fd.seek(0)
    while True:
        b=fd.read(1024*1024)
        if not b: break
        h.update(b)
    value=h.hexdigest()
    with HASH_LOCK:
        for old in list(HASH_CACHE):
            if old[0]==os.fspath(p) and old!=k: HASH_CACHE.pop(old,None)
        HASH_CACHE[k]=value; HASH_CACHE.move_to_end(k)
        while len(HASH_CACHE)>HASH_LIMIT: HASH_CACHE.popitem(last=False)
    return value

def same_stat(a,b):
    return (a.st_dev,a.st_ino,a.st_size,a.st_mtime_ns)==(b.st_dev,b.st_ino,b.st_size,b.st_mtime_ns)

def api_error_for_oserror(exc):
    if isinstance(exc, PermissionError) or getattr(exc,"errno",None) in (errno.EACCES,errno.EPERM): return 403,"permission_denied","Sin permiso para leer el archivo"
    if getattr(exc,"errno",None) in (errno.EBUSY,errno.ETXTBSY): return 423,"file_locked","El archivo está ocupado o bloqueado"
    if isinstance(exc,FileNotFoundError): return 404,"not_found","El archivo ya no existe"
    return 500,"read_failed","No se pudo leer el archivo"

def audit(msg):
    msg="".join(c if c.isprintable() else "?" for c in str(msg))     # un nombre de archivo no puede falsificar líneas del registro
    print(time.strftime("%Y-%m-%d %H:%M:%S ")+msg,flush=True)

try: FP=hashlib.sha256(ssl.PEM_cert_to_DER_cert(Path(cert).read_text(encoding="ascii"))).hexdigest()
except Exception as _e: raise SystemExit("no se pudo leer el certificado: %s"%_e)

def _canon(p):
    try: return os.path.realpath(os.fspath(p))
    except Exception: return os.fspath(p)

# Lo que NUNCA se sirve (aunque se comparta la carpeta que lo contiene): claves y tokens. NEXO_TOOLS_SHOW_SECRETS=1 lo desactiva.
DENY=[]
if not SHOW_SECRETS:
    _home=Path(os.path.expanduser("~"))
    DENY=[_canon(d) for d in (STATE,_home/".ssh",_home/".gnupg",_home/".config"/"nexo")]
    if str(root)=="/": DENY+=["/proc","/sys","/dev"]

def denied(p):
    c=_canon(p)
    for d in DENY:
        if c==d or c.startswith(d.rstrip("/")+"/"): return True
    return False

def rel_of(p):
    return "" if p==root else p.relative_to(root).as_posix()

# Modo «enviar»: solo se ven y se descargan los elementos elegidos (y las carpetas que llevan a ellos).
_ONLY={"sig":None,"items":None}
def only_list():
    if not ONLY_FILE: return None
    try:
        st=os.stat(ONLY_FILE); sig=(st.st_mtime_ns,st.st_size)
        if sig!=_ONLY["sig"]:
            items=[]
            for line in Path(ONLY_FILE).read_text(encoding="utf-8",errors="surrogateescape").split("\n"):
                line=line.strip("/")
                if line: items.append(line)
            _ONLY["items"]=items; _ONLY["sig"]=sig
    except OSError:
        if _ONLY["items"] is None: _ONLY["items"]=[]
    return _ONLY["items"]

def allowed_rel(rel):
    only=only_list()
    return True if only is None else any(rel==a or rel.startswith(a+"/") for a in only)

def nav_rel(rel):
    only=only_list()
    return True if only is None else (rel=="" or any(a==rel or a.startswith(rel+"/") or rel.startswith(a+"/") for a in only))

# Dispositivos autorizados (tokens por dispositivo) y código de emparejamiento de un solo uso.
PEERS_PATH=STATE/"peers.json"; PAIR_PATH=STATE/"pair.json"; PAIR_LOCK=threading.Lock()

def write_json_atomic(path,obj):
    tmp=path.with_name(path.name+".%d.tmp"%os.getpid())
    fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)
    try:
        with os.fdopen(fd,"w",encoding="utf-8") as f: json.dump(obj,f,ensure_ascii=True,separators=(",",":"))
        os.replace(tmp,path)
    except Exception:
        try: os.unlink(tmp)
        except OSError: pass
        raise

def peers_load():
    try: d=json.loads(PEERS_PATH.read_text(encoding="utf-8"))
    except Exception: return {}
    return d if isinstance(d,dict) else {}

def norm_code(c):
    return str(c).upper().replace("-","").replace(" ","").replace("O","0").replace("I","1").replace("L","1")

def pair_state():
    try: d=json.loads(PAIR_PATH.read_text(encoding="utf-8"))
    except Exception: return None
    if not isinstance(d,dict) or time.time()>float(d.get("expires",0)) or len(norm_code(d.get("secret","")))!=12:
        try: PAIR_PATH.unlink()
        except OSError: pass
        return None
    return d

def role_for_token(supplied,legacy):
    if not supplied: return None
    if legacy and hmac.compare_digest(supplied,legacy): return "ro"      # el token que se ve en pantalla nunca escribe: solo los dispositivos emparejados
    h=hashlib.sha256(supplied.encode("utf-8","replace")).hexdigest(); found=None
    for rec in peers_load().values():
        if isinstance(rec,dict) and hmac.compare_digest(h,str(rec.get("hash",""))): found=rec
    if found is None: return None
    return "rw" if (found.get("role")=="rw" and RW and only_list() is None) else "ro"

# Enlaces de descarga de un solo archivo para el navegador (caducan; no llevan el token).
TICKETS={}; TICKET_LOCK=threading.Lock()
def new_ticket(rel,inline):
    tid=os.urandom(16).hex(); now=time.time()
    with TICKET_LOCK:
        for k in [k for k,v in TICKETS.items() if v[1]<now]: TICKETS.pop(k,None)
        if len(TICKETS)>=5000: raise OSError(errno.EBUSY,"demasiados enlaces")
        TICKETS[tid]=(rel,now+600,inline)
    return tid

# Rutas para operaciones de escritura (siempre dentro de la carpeta compartida y sin pasar por enlaces simbólicos).
def check_name(name):
    if not name or name in (".","..") or "/" in name or "\x00" in name or any(ord(c)<32 for c in name) or len(os.fsencode(name))>255:
        raise ValueError("nombre no válido")

def split_path(raw):
    raw=raw or ""
    parts=raw.split("/") if raw else []
    if not parts or raw.startswith("/") or any(x in (".","..","") for x in parts) or "\x00" in raw: raise ValueError("ruta no válida")
    parent_rel="/".join(parts[:-1])
    if has_symlink_component(parent_rel): raise ValueError("la ruta pasa por un enlace simbólico")
    return resolve_rel(parent_rel),parts[-1]

def resolve_entry(raw):
    parent,name=split_path(raw)
    lex=parent/name
    if denied(lex) or not os.path.lexists(lex): raise FileNotFoundError(raw)
    return parent,name,lex

def split_new(raw):
    parent,name=split_path(raw)
    check_name(name)
    if not parent.is_dir(): raise ValueError("la carpeta de destino no existe")
    if denied(parent/name): raise ValueError("ruta no disponible")
    return parent,name

def write_error(exc):
    e=getattr(exc,"errno",None)
    if e==errno.ENOSPC: return 507,"no_space","No queda espacio en el dispositivo"
    if e==errno.EXDEV: return 409,"cross_device","No se puede mover entre sistemas de archivos distintos"
    if e==errno.EROFS: return 403,"read_only_fs","El sistema de archivos es de solo lectura"
    if isinstance(exc,PermissionError) or e in (errno.EACCES,errno.EPERM): return 403,"permission_denied","Sin permiso para escribir ahí"
    if e==errno.ENOTEMPTY: return 409,"not_empty","La carpeta no está vacía"
    return 500,"write_failed","No se pudo completar la operación"

_INLINE_IMG={"image/png","image/jpeg","image/gif","image/webp","image/bmp","image/avif","image/x-icon","image/vnd.microsoft.icon"}
_INLINE_TXT={".txt",".md",".log",".csv",".tsv",".json",".yaml",".yml",".toml",".ini",".conf",".cfg",".rst",".tex",".py",".sh",".js",".c",".h",".cpp",".java",".kt",".rs",".go",".css",".xml",".html",".htm"}
def inline_type(p,ct):
    main=(ct or "").split(";")[0].strip().lower()
    if main in _INLINE_IMG or main.startswith(("audio/","video/")): return main
    if p.suffix.lower() in _INLINE_TXT: return "text/plain; charset=utf-8"
    return None

# Anuncio por difusión UDP: «aquí hay un servidor Nexo». No lleva secretos (solo nombre, puerto y huella corta).
def beacon_targets():
    t=["255.255.255.255"]
    parts=bind_ip.split(".")
    if len(parts)==4 and bind_ip not in ("0.0.0.0","127.0.0.1"): t.append(".".join(parts[:3]+["255"]))
    for x in BEACON_TO:
        if x not in t: t.append(x)
    return t

def beacon_loop():
    sock=socket.socket(socket.AF_INET,socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET,socket.SO_BROADCAST,1)
    while True:
        msg=json.dumps({"nexo":1,"app":"nexo-tools","name":DEVICE,"id":FP[:16],"port":port,"rw":RW,"only":only_list() is not None,"v":VERSION},ensure_ascii=True,separators=(",",":")).encode("ascii")
        for target in beacon_targets():
            try: sock.sendto(msg,(target,DISCOVER_PORT))
            except OSError: pass
        time.sleep(2.0)

