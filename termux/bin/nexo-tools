class TransferError(Exception): pass
class RemoteChanged(TransferError): pass
class LimitExceeded(TransferError): pass

class HttpSession:
 def __init__(self): self.local=threading.local(); self.pool=[]; self.lock=threading.Lock()
 def connection(self):
  c=getattr(self.local,"conn",None)
  if c is not None and c.sock is not None: return c
  c=http.client.HTTPSConnection(host,port,timeout=30,context=context)
  try:
   c.connect(); cert=c.sock.getpeercert(binary_form=True)
   actual=hashlib.sha256(cert).digest()
   if not hmac.compare_digest(actual,expected_pin):
    c.close(); raise TransferError("La huella SHA-256 no coincide. Conexión cancelada por seguridad.")
  except Exception:
   c.close(); raise
  self.local.conn=c
  with self.lock: self.pool.append(c)
  return c
 def request(self,path,headers=None):
  hdr={"Authorization":"Bearer "+token,"Accept-Encoding":"identity","Connection":"keep-alive"}
  if headers: hdr.update(headers)
  last=None
  for attempt in range(2):
   c=None
   try:
    c=self.connection()
    c.request("GET",path,headers=hdr)
    return c.getresponse()
   except TransferError: raise
   except (OSError,http.client.HTTPException) as e:
    last=e
    if c is not None:
     try: c.close()
     except Exception: pass
    self.local.conn=None
    if attempt: raise TransferError("Conexión perdida; vuelve a ejecutar para reanudar.") from e
  raise TransferError(str(last))
 def close(self):
  with self.lock: pool=list(self.pool); self.pool.clear()
  for c in pool:
   try: c.close()
   except Exception: pass

SESSION=HttpSession()

def api_send(method,path,body=None,headers=None):
 hdr={"Authorization":"Bearer "+token,"Accept-Encoding":"identity","Accept":"application/json",**(headers or {})}
 c=http.client.HTTPSConnection(host,port,timeout=120,context=context)
 try:
  c.connect()
  if not hmac.compare_digest(hashlib.sha256(c.sock.getpeercert(binary_form=True)).digest(),expected_pin):raise TransferError("La huella SHA-256 no coincide. Conexión cancelada por seguridad.")
  c.request(method,path,body=body,headers=hdr);r=c.getresponse();data=r.read()
 finally:c.close()
 try:j=json.loads(data.decode("utf-8","replace")) if data else {}
 except ValueError:j={}
 if r.status!=200:raise TransferError(f"El otro dispositivo respondió HTTP {r.status}: {j.get('message') or r.reason}")
 return j

def api_get(path,extra_headers=None):
 r=SESSION.request(path,{"Accept":"application/json",**(extra_headers or {})})
 body=r.read()
 if r.status!=200:
  try: msg=json.loads(body.decode("utf-8","replace")).get("message","")
  except Exception: msg=body[:200].decode("utf-8","replace")
  raise TransferError(f"El servidor respondió HTTP {r.status}: {msg or r.reason}")
 try: return json.loads(body.decode("utf-8","surrogateescape"))
 except Exception as e: raise TransferError("El servidor devolvió JSON no válido") from e

def safe_text(s):
 out=[]
 for ch in str(s): out.append("?" if ch in "\n\r\t" or unicodedata.category(ch).startswith("C") else ch)
 return "".join(out)

def classify_extension(path):
 ext=Path(str(path)).suffix.lower()
 if ext in ACTIVE_EXTS:return "active"
 if ext in PASSIVE_EXTS:return "passive"
 return "unknown"

def is_fat_like(fs=DEST_FS):
 return fs in ("vfat","exfat","msdos","ntfs","fuseblk","apfs","hfs")

def safe_filename(name,dest_fs=DEST_FS,max_bytes=255):
 original=os.fsencode(str(name)); value=str(name)
 if "\x00" in value: value=value.replace("\x00","_")
 if not value or value in (".",".."): value="_NEXO_vacio"
 if is_fat_like(dest_fs):
  value=re.sub(r'[\\/:*?<>|"]',"_",value).rstrip(" .")
  stem=value.split(".",1)[0].upper()
  if stem in {"CON","PRN","AUX","NUL",*(f"COM{i}" for i in range(1,10)),*(f"LPT{i}" for i in range(1,10))} or value.lower()=="desktop.ini":
   value="_NEXO_"+value
  if not value:value="_NEXO_nombre"
 encoded=os.fsencode(value)
 if len(encoded)>max_bytes:
  suffix=Path(value).suffix
  suffix_b=os.fsencode(suffix)
  tag="~"+hashlib.sha256(original).hexdigest()[:8]
  room=max(1,min(200,max_bytes-len(os.fsencode(tag))-len(suffix_b)))
  prefix=os.fsencode(value)[:room]
  while prefix:
   try:prefix.decode("utf-8");break
   except UnicodeDecodeError:prefix=prefix[:-1]
  value=os.fsdecode(prefix)+tag+suffix
 return value

def _name_key(value):
 value=unicodedata.normalize("NFC",value)
 return value.casefold() if is_fat_like() else value

def map_relative_name(value):
 parts=pathlib.PurePosixPath(str(value)).parts
 mapped=[]; parent_key=""
 for part in parts:
  safe=safe_filename(part)
  parent=DEST.joinpath(*mapped)
  try: existing={x.name for x in parent.iterdir()} if parent.is_dir() else set()
  except OSError: existing=set()
  key=_name_key(safe); used_key=(str(parent),key)
  collision=next((x for x in existing if _name_key(x)==key and x!=safe),None)
  with NAME_LOCK:
   if used_key in NAME_USED and NAME_USED[used_key]!=safe: collision=NAME_USED[used_key]
   if collision is not None:
    base=Path(safe); n=1
    while True:
     candidate=f"{base.stem} ({n}){base.suffix}"
     ckey=_name_key(candidate)
     if not any(_name_key(x)==ckey for x in existing) and (str(parent),ckey) not in NAME_USED:break
     n+=1
    safe=candidate; key=_name_key(safe); used_key=(str(parent),key)
    with PRINT_LOCK:print(f"⚠ Colisión Unicode/case-insensitive: renombrado a {safe_text(safe)}")
   NAME_USED[used_key]=safe
  if safe!=part and (is_fat_like() or len(os.fsencode(part))>255):
   with PRINT_LOCK:print(f"⚠ Nombre incompatible o demasiado largo: {safe_text(part)} → {safe_text(safe)}")
  mapped.append(safe)
 return pathlib.Path(*mapped)

def quote_remote_path(value):
 return urllib.parse.quote_from_bytes(os.fsencode(str(value)),safe="")

