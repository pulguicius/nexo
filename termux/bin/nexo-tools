        outer = ttk.Frame(self.root, padding=18); outer.pack(fill="both", expand=True)
        outer.columnconfigure(0, weight=1)
        outer.rowconfigure(3, weight=1)

        hero = tk.Frame(outer, bg="#112a38", highlightthickness=1, highlightbackground="#285064")
        hero.grid(row=0, column=0, sticky="ew", pady=(0, 12))
        hero.columnconfigure(0, weight=1)
        left = tk.Frame(hero, bg="#112a38"); left.grid(row=0, column=0, sticky="w", padx=18, pady=15)
        tk.Label(left, text="NEXO-TOOLS", bg="#112a38", fg="#5eead4",
                 font=("TkDefaultFont", 23, "bold")).pack(anchor="w")
        tk.Label(left, text="Tu centro local para transferir, sincronizar y visualizar archivos",
                 bg="#112a38", fg="#c3d5df", font=("TkDefaultFont", 10)).pack(anchor="w", pady=(3, 0))
        tk.Label(hero, text="v"+VERSION, bg="#0f766e", fg="white",
                 font=("TkDefaultFont", 10, "bold"), padx=12, pady=7).grid(row=0, column=1, padx=18, pady=16, sticky="e")

        status = ttk.Frame(outer, style="Panel.TFrame", padding=(13, 10))
        status.grid(row=1, column=0, sticky="ew", pady=(0, 12))
        status.columnconfigure(0, weight=1)
        ttk.Label(status, text="ESTADO DE RED", style="Eyebrow.TLabel").grid(row=0, column=0, sticky="w")
        ttk.Label(status, textvariable=self.status_var, style="Status.TLabel", wraplength=900).grid(row=1, column=0, sticky="ew", pady=(4, 0))
        ttk.Button(status, text="↻ Actualizar", command=self.refresh_status).grid(row=0, column=1, rowspan=2, padx=(12, 0))

        ttk.Label(outer, text="¿QUÉ QUIERES HACER?", style="Section.TLabel").grid(row=2, column=0, sticky="w", pady=(2, 7))
        grid = ttk.Frame(outer); grid.grid(row=3, column=0, sticky="nsew")
        for col in range(3): grid.columnconfigure(col, weight=1, uniform="cards")
        for row in range(3): grid.rowconfigure(row, weight=1, uniform="cards")
        cards = [
            ("⇧", "MANDAR ARCHIVOS", "Comparte carpetas por HTTPS con token y huella TLS.", self.send_files),
            ("⇩", "RECIBIR ARCHIVOS", "Explora otro dispositivo y descarga archivos seleccionados.", self.receive_files),
            ("⟳", "SINCRONIZAR", "Transfiere cambios de carpetas mediante rsync y SSH.", self.sync_files),
            ("⌘", "ABRIR ARCHIVOS", "Abre cualquier archivo local tras clasificarlo.", self.view_html),
            ("▣", "ESTADO DEL SERVIDOR", "Consulta dirección, puerto y estado del servidor local.", self.server_status),
            ("■", "DETENER SERVIDOR", "Cierra el servidor HTTPS iniciado por NEXO-TOOLS.", self.stop_server),
            ("⌁", "PREPARAR SSH", "Activa SSH local para recibir sincronizaciones rsync.", self.start_ssh),
            ("⚙", "CONFIGURAR", "Instala dependencias y prepara el entorno local.", self.setup),
            ("✓", "DIAGNÓSTICO", "Revisa Python, TLS, rsync, SSH, Nexo y Tkinter.", self.diagnostics),
        ]
        for i, (symbol, title, desc, cmd) in enumerate(cards):
            frame = tk.Frame(grid, bg="#172b3a", highlightthickness=1, highlightbackground="#294456")
            frame.grid(row=i//3, column=i%3, sticky="nsew", padx=5, pady=5)
            top = tk.Frame(frame, bg="#172b3a"); top.pack(fill="x", padx=12, pady=(11, 2))
            tk.Label(top, text=symbol, bg="#172b3a", fg="#5eead4", font=("TkDefaultFont", 17, "bold")).pack(side="left")
            tk.Label(top, text=title, bg="#172b3a", fg="#e6f1f7", font=("TkDefaultFont", 9, "bold")).pack(side="left", padx=(8, 0))
            tk.Label(frame, text=desc, bg="#172b3a", fg="#a9bdca", justify="left", anchor="nw",
                     wraplength=260, font=("TkDefaultFont", 9)).pack(fill="both", expand=True, padx=13, pady=(5, 9))
            ttk.Button(frame, text="Abrir  →", command=cmd, style="Accent.TButton").pack(anchor="e", padx=11, pady=(0, 10))

        footer = ttk.Frame(outer, style="Panel.TFrame", padding=(12, 8))
        footer.grid(row=4, column=0, sticky="ew", pady=(12, 0))
        ttk.Label(footer, text="ACTIVIDAD", style="Eyebrow.TLabel").pack(anchor="w")
        self.log = tk.Text(footer, height=5, bg="#09141d", fg="#d6e4ee", insertbackground="white",
                           relief="flat", wrap="word", font=("TkFixedFont", 9), padx=8, pady=6)
        self.log.pack(fill="both", expand=True, pady=(5, 0))
        self.log.configure(state="disabled")
        self.write_log("NEXO-TOOLS listo · HTTPS + rsync/SSH + visor HTML.")
        self.root.bind("<F5>", lambda _e: self.refresh_status())
        self.root.bind("<Control-o>", lambda _e: self.view_html())
        self.root.bind("<Escape>", self.close_active_dialog)
        self.root.protocol("WM_DELETE_WINDOW", self.close)

    def write_log(self, text):
        self.log.configure(state="normal"); self.log.insert("end", str(text).rstrip()+"\n"); self.log.see("end"); self.log.configure(state="disabled")

    def show_output(self, title, content):
        win=tk.Toplevel(self.root); win.title(title); win.geometry("760x520"); win.transient(self.root)
        frame=ttk.Frame(win,padding=10); frame.pack(fill="both",expand=True)
        txt=tk.Text(frame,wrap="word"); scroll=ttk.Scrollbar(frame,command=txt.yview); txt.configure(yscrollcommand=scroll.set)
        txt.pack(side="left",fill="both",expand=True); scroll.pack(side="right",fill="y")
        txt.insert("1.0",str(content)); txt.configure(state="disabled")
        win.bind("<Escape>",lambda _e:win.destroy())

    def close_active_dialog(self, event=None):
        try:
            focus=self.root.focus_get()
            top=focus.winfo_toplevel() if focus else None
            if top is not None and top is not self.root:
                top.destroy()
        except tk.TclError: pass

    def close(self):
        try:
            self.gui_state.parent.mkdir(parents=True,exist_ok=True)
            self.gui_state.write_text(json.dumps({"geometry":self.root.winfo_geometry()}),encoding="utf-8")
            os.chmod(self.gui_state,0o600)
        except Exception: pass
        self.root.destroy()

    def run_cli(self, *args, timeout=25):
        return subprocess.run(["bash", SCRIPT, *map(str,args)], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)

    def refresh_status(self):
        if self._refreshing: return
        self._refreshing = True
        def worker():
            info = ""
            if shutil_which("nexo"):
                try:
                    r=subprocess.run(["nexo","status"],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=3)
                    info=r.stdout.strip().replace("\n"," · ")
                except Exception as e: info="Nexo no respondió: "+str(e)
            else: info="Nexo CLI no detectado"
            ip=""
            try:
                r=subprocess.run(["bash",SCRIPT,"__detect_ip"],text=True,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,timeout=4)
                ip=r.stdout.strip()
            except Exception: pass
            msg=("Nexo: "+info[:380])+ (" · IP local: "+ip if ip else " · IP no detectada")
            def done():
                self.status_var.set(msg)
                self._refreshing = False
            self.root.after(0,done)
        threading.Thread(target=worker,daemon=True).start()

    def send_files(self):
        folder=filedialog.askdirectory(title="Elige la carpeta que quieres compartir")
        if not folder: return
        try: r=self.run_cli("server",folder,timeout=15)
        except Exception as e: messagebox.showerror("NEXO-TOOLS",str(e)); return
        self.write_log(r.stdout)
        if r.returncode==0:
            self.show_output("Servidor NEXO-TOOLS",r.stdout or "Servidor iniciado.")
            self.refresh_status()
        elif r.returncode==3:
            self.show_output("Servidor ya activo",r.stdout or "Ya existe un servidor activo; la carpeta nueva no fue compartida.")
        else: self.show_output("No se pudo compartir",r.stdout[-5000:])

    def view_html(self):
        path=filedialog.askopenfilename(
            title="Abrir archivo HTML",
            filetypes=[("Páginas web", "*.html *.htm *.xhtml *.HTML *.HTM *.XHTML"), ("Todos los archivos", "*.*")],
            parent=self.root)
        if not path: return
        if not messagebox.askyesno("Abrir página HTML",
                "Se abrirá en el navegador predeterminado. Abre solo páginas de confianza: pueden ejecutar JavaScript o cargar contenido externo.\n\n¿Continuar?",
                parent=self.root): return
        try:
            opener=open_html_path(path)
            self.write_log(f"HTML abierto: {Path(path).name} · {opener}")
            self.status_var.set(f"Visor HTML · {Path(path).name}")
        except Exception as e:
            messagebox.showerror("No se pudo abrir HTML",str(e),parent=self.root)

    def receive_files(self):
        url=simpledialog.askstring("Conectar", "URL del emisor (https://IP:8766):", parent=self.root)
        if not url: return
        token=simpledialog.askstring("Autenticación", "Token que muestra el dispositivo emisor:", parent=self.root, show="•")
        if not token: return
        pin=simpledialog.askstring("Verificación TLS", "Huella SHA-256 de 64 caracteres que muestra el emisor:", parent=self.root)
        if not pin: return
        dest=filedialog.askdirectory(title="Carpeta donde guardar los archivos")
        if not dest: return
        try: browser=RemoteBrowser(self.root,url,token,pin,dest,self.write_log)
        except Exception as e: messagebox.showerror("Conexión fallida",str(e))

    def sync_files(self):
        win=tk.Toplevel(self.root); win.title("Sincronizar con rsync/SSH"); win.configure(bg="#101923"); win.transient(self.root); win.grab_set()
        win.bind("<Escape>",lambda _e:win.destroy())
        box=ttk.Frame(win,padding=16); box.pack(fill="both",expand=True)
        direction=tk.StringVar(value="push")
        ttk.Label(box,text="Dirección",font=("TkDefaultFont",11,"bold")).grid(row=0,column=0,sticky="w")
        ttk.Radiobutton(box,text="Enviar carpeta local → remoto",variable=direction,value="push").grid(row=1,column=0,sticky="w",pady=3)
        ttk.Radiobutton(box,text="Recibir carpeta remoto → local",variable=direction,value="pull").grid(row=2,column=0,sticky="w",pady=3)
        ttk.Label(box,text="Carpeta local (origen al enviar; destino al recibir)").grid(row=3,column=0,sticky="w",pady=(10,3))
        local=tk.StringVar(value=str(Path.home()))
        row=ttk.Frame(box); row.grid(row=4,column=0,sticky="ew")
        ttk.Entry(row,textvariable=local,width=55).pack(side="left",fill="x",expand=True)
        ttk.Button(row,text="Elegir…",command=lambda:local.set(filedialog.askdirectory() or local.get())).pack(side="left",padx=5)
        ttk.Label(box,text="Destino/origen remoto: user@IP:/ruta/remota").grid(row=5,column=0,sticky="w",pady=(10,3))
        remote=tk.StringVar(); ttk.Entry(box,textvariable=remote,width=65).grid(row=6,column=0,sticky="ew")
        ttk.Label(box,text="Puerto SSH (Termux normalmente 8022; Linux puede usar 22 o 2222)").grid(row=7,column=0,sticky="w",pady=(10,3))
        port=tk.StringVar(value="8022"); ttk.Entry(box,textvariable=port,width=12).grid(row=8,column=0,sticky="w")
        dry=tk.BooleanVar(value=False); ttk.Checkbutton(box,text="Simular sin transferir (--dry-run)",variable=dry).grid(row=9,column=0,sticky="w",pady=(8,2))
        ttk.Label(box,text="Excluir patrones (separados por ;)").grid(row=10,column=0,sticky="w")
        excludes=tk.StringVar(); ttk.Entry(box,textvariable=excludes).grid(row=11,column=0,sticky="ew")
        ttk.Label(box,text="Límite rsync en KiB/s (vacío = sin límite)").grid(row=12,column=0,sticky="w",pady=(6,0))
        bwlimit=tk.StringVar(); ttk.Entry(box,textvariable=bwlimit,width=16).grid(row=13,column=0,sticky="w")
        sparse=tk.BooleanVar(value=False); hard_links=tk.BooleanVar(value=False); xattrs=tk.BooleanVar(value=False); no_links=tk.BooleanVar(value=False)
        flags=ttk.Frame(box); flags.grid(row=14,column=0,sticky="w",pady=(4,0))
        ttk.Checkbutton(flags,text="--sparse",variable=sparse).pack(side="left",padx=(0,10))
        ttk.Checkbutton(flags,text="--hard-links",variable=hard_links).pack(side="left",padx=(0,10))
        ttk.Checkbutton(flags,text="--xattrs",variable=xattrs).pack(side="left",padx=(0,10))
        ttk.Checkbutton(flags,text="--no-links",variable=no_links).pack(side="left")
        output=tk.Text(box,height=10,bg="#0a1118",fg="#d6e4ee",wrap="word"); output.grid(row=15,column=0,sticky="nsew",pady=10)
        output.tag_configure("progress",foreground="#5eead4")
        box.columnconfigure(0,weight=1); box.rowconfigure(15,weight=1)
        proc_state={"proc":None,"cancel":False}
        def append_output(line, progress=False):
            output.configure(state="normal")
            if progress:
                try: output.delete("progress.first","progress.last")
                except tk.TclError: pass
                output.insert("end",line+"\n","progress")
            else:
                output.insert("end",line+"\n")
            output.see("end"); output.configure(state="disabled")
        def cancel():
            proc=proc_state.get("proc")
            if proc and proc.poll() is None:
                proc_state["cancel"]=True
                try:
                    proc.terminate(); proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill(); proc.wait()
                except Exception: pass
                self.root.after(0,append_output,"Transferencia cancelada por el usuario.")
            cancel_btn.configure(state="disabled")
        def go():
            d=direction.get(); loc=local.get().strip(); rem=remote.get().strip(); prt=port.get().strip()
            if not Path(loc).is_dir(): messagebox.showerror("Ruta local","Elige una carpeta local válida.",parent=win); return
            if not re.fullmatch(r"[0-9]{1,5}",prt) or not 1<=int(prt)<=65535: messagebox.showerror("Puerto","Puerto SSH no válido.",parent=win); return
            if not re.fullmatch(r"[A-Za-z0-9._-]+@[A-Za-z0-9.-]+:.+",rem) or "\n" in rem: messagebox.showerror("Ruta remota","Usa usuario@IP:/ruta/remota.",parent=win); return
            if bwlimit.get().strip() and not re.fullmatch(r"[0-9]+",bwlimit.get().strip()): messagebox.showerror("Límite","Escribe un número de KiB/s.",parent=win); return
            if not shutil_which("rsync"): messagebox.showerror("Falta rsync","Pulsa Configurar o instala rsync.",parent=win); return
            known=STATE/"ssh"/"known_hosts"; known.parent.mkdir(mode=0o700,parents=True,exist_ok=True); os.chmod(known.parent,0o700)
            ssh_result=subprocess.run(["bash",SCRIPT,"__build_ssh_cmd",str(int(prt)),str(known)],text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=5)
            if ssh_result.returncode: messagebox.showerror("SSH",ssh_result.stderr.strip() or "No se pudo preparar el comando SSH.",parent=win); return
            ssh=ssh_result.stdout.strip()
            src=(loc.rstrip("/")+"/") if d=="push" else rem
            dst=(rem+"/") if d=="push" else str(Path(loc).resolve())+"/"
            help_out=subprocess.run(["rsync","--help"],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT).stdout
            safe_args=["-s"] if "--secluded-args" in help_out else ["--protect-args"]
            cmd=["rsync","-a","--human-readable","--info=progress2","--partial",*safe_args]
            if dry.get(): cmd.append("--dry-run")
            if sparse.get():cmd.append("--sparse")
            if hard_links.get():cmd.append("--hard-links")
            if no_links.get() or (d=="pull" and (loc.startswith("/sdcard/") or loc.startswith("/storage/emulated/"))):cmd.append("--no-links")
            if xattrs.get():
                if "--xattrs" in help_out:cmd.append("--xattrs")
                else:self.root.after(0,append_output,"Esta versión de rsync no admite --xattrs; se omitió.")
            for pattern in [x.strip() for x in excludes.get().split(";") if x.strip()]: cmd.extend(["--exclude",pattern])
            if bwlimit.get().strip(): cmd.append("--bwlimit="+bwlimit.get().strip())
            cmd.extend(["-e",ssh,"--",src,dst])
            simulated=dry.get()
            proc_state.update(proc=None,cancel=False)
            output.configure(state="normal"); output.delete("1.0","end"); output.configure(state="disabled")
            run_btn.configure(state="disabled"); cancel_btn.configure(state="normal")
            self.root.after(0,append_output,"Comando: "+shlex.join(cmd))
            def worker():
                try:
                    proc=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,bufsize=0)
                    proc_state["proc"]=proc
                    pending=bytearray()
                    while True:
                        chunk=proc.stdout.read(4096)
                        if not chunk: break
                        for byte in chunk:
                            if byte in (10,13):
                                if pending:
                                    line=pending.decode("utf-8","replace"); pending.clear()
                                    self.root.after(0,append_output,line,byte==13)
                            else: pending.append(byte)
                    if pending: self.root.after(0,append_output,pending.decode("utf-8","replace"),False)
                    rc=proc.wait()
                    msg="Simulación completada; no se modificaron archivos." if rc==0 and simulated else ("Sincronización completada." if rc==0 else f"Rsync terminó con código {rc}.")
                    self.root.after(0,append_output,msg)
                except Exception as e: self.root.after(0,append_output,"Error: "+str(e))
                finally:
                    proc_state["proc"]=None
                    self.root.after(0,lambda:(run_btn.configure(state="normal"),cancel_btn.configure(state="disabled")))
            threading.Thread(target=worker,daemon=True).start()
        buttons=ttk.Frame(box); buttons.grid(row=16,column=0,sticky="e")
        run_btn=ttk.Button(buttons,text="Iniciar sincronización",command=go,style="Accent.TButton"); run_btn.pack(side="left",padx=4)
        cancel_btn=ttk.Button(buttons,text="Cancelar",command=cancel,state="disabled"); cancel_btn.pack(side="left",padx=4)
        ttk.Button(buttons,text="Cerrar",command=win.destroy).pack(side="left",padx=4)

    def server_status(self):
        try: r=self.run_cli("status")
        except Exception as e: r=type("R",(),{"stdout":str(e)})()
        self.write_log(r.stdout); self.show_output("Estado del servidor",r.stdout or "Sin información.")

    def stop_server(self):
        try: r=self.run_cli("stop")
        except Exception as e: messagebox.showerror("Error",str(e)); return
        self.write_log(r.stdout); self.show_output("NEXO-TOOLS",r.stdout or "Operación terminada."); self.refresh_status()

    def start_ssh(self):
        if not shutil_which("sshd"):
            messagebox.showwarning("OpenSSH no instalado","Usa Configurar para instalar OpenSSH y rsync."); return
        try:
            r=self.run_cli("ssh-start",timeout=15)
            self.write_log(r.stdout)
            if r.returncode==0: messagebox.showinfo("SSH para rsync",r.stdout)
            else: messagebox.showerror("No se pudo iniciar SSH",r.stdout)
        except Exception as e: messagebox.showerror("No se pudo iniciar SSH",str(e))

    def setup(self):
        if not messagebox.askyesno("Configurar NEXO-TOOLS","Se instalarán dependencias del sistema (puede requerir confirmación del gestor de paquetes). ¿Continuar?"): return
        try: r=self.run_cli("setup",timeout=600)
        except Exception as e: messagebox.showerror("Configuración",str(e)); return
        self.write_log(r.stdout); self.show_output("Configuración",r.stdout or "Configuración terminada.")

    def diagnostics(self):
        lines=[]
        for c in ("python3","openssl","rsync","ssh","sshd","nexo"):
            path=shutil.which(c)
            lines.append(("✓ " if path else "– ")+c+ (" · "+str(path) if path else " · no instalado"))
        try:
            import tkinter; lines.append("✓ Tkinter "+str(tkinter.TkVersion))
        except Exception as e: lines.append("– Tkinter: "+str(e))
        try:
            r=subprocess.run(["nexo","status"],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=3)
            lines.append("\nNEXO STATUS\n"+r.stdout.strip())
        except Exception: lines.append("\nNexo: no disponible o puente apagado")
        text="\n".join(lines); self.write_log(text); messagebox.showinfo("Diagnóstico",text[:3000])

class RemoteBrowser:
    def __init__(self,parent,url,token,pin,dest,logger):
        self.win=None
        try:
            self._initialize(parent,url,token,pin,dest,logger)
        except Exception:
            if self.win is not None:
                try:self.win.destroy()
                except tk.TclError:pass
            raise

    def _initialize(self, parent, url, token, pin, dest, logger):
        self.parent=parent; self.token=token; self.dest=Path(dest).resolve(); self.logger=logger
        if not url.startswith("https://"): url="https://"+url
        u=urllib.parse.urlsplit(url)
        if u.scheme!="https" or not u.hostname or u.username or u.password or u.path not in ("", "/") or u.query or u.fragment:
            raise ValueError("URL inválida. Usa https://IP:PUERTO")
        self.host=u.hostname; self.port=u.port or 443
        self.pin=pin.replace(":","").replace(" ","").strip().lower()
        if len(self.pin)!=64 or any(c not in "0123456789abcdef" for c in self.pin): raise ValueError("La huella SHA-256 debe tener 64 caracteres hexadecimales.")
        self.pin_bytes=bytes.fromhex(self.pin)
        self.context=ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT); self.context.check_hostname=False; self.context.verify_mode=ssl.CERT_NONE
        self.path=""; self.entries=[]; self.item_map={}; self.path_to_iid={}
        self._local=threading.local(); self._connections=[]; self._conn_lock=threading.Lock()
        self._progress_lock=threading.Lock(); self._download_total=1; self._download_done=0; self._download_active=False
        self._name_lock=threading.Lock(); self._name_used={}
        self.win=tk.Toplevel(parent); self.win.title("NEXO-TOOLS · Explorador remoto"); self.win.geometry("980x650"); self.win.configure(bg="#101923")
        self.win.bind("<Escape>",lambda _e:self.close())
        self.win.protocol("WM_DELETE_WINDOW",self.close)
        frame=ttk.Frame(self.win,padding=12); frame.pack(fill="both",expand=True)
        ttk.Label(frame,text="Explorador remoto",font=("TkDefaultFont",15,"bold")).pack(anchor="w")
        self.path_var=tk.StringVar(value="/"); ttk.Label(frame,textvariable=self.path_var).pack(anchor="w",pady=5)
        bar=ttk.Frame(frame); bar.pack(fill="x",pady=5)
        ttk.Button(bar,text="↑ Subir",command=self.up).pack(side="left")
        ttk.Button(bar,text="↻ Actualizar",command=self.refresh).pack(side="left",padx=5)
        self.download_button=ttk.Button(bar,text="Descargar seleccionados",command=self.download_selected,style="Accent.TButton")
        self.download_button.pack(side="right")
        self.open_button=ttk.Button(bar,text="Abrir",command=self.open_selected_file)
        self.open_button.pack(side="right",padx=6)
        search=ttk.Frame(frame); search.pack(fill="x",pady=(2,5))
        ttk.Label(search,text="Filtro glob:").pack(side="left")
        self.filter_var=tk.StringVar()
        filter_entry=ttk.Entry(search,textvariable=self.filter_var,width=28); filter_entry.pack(side="left",padx=6)
        filter_entry.bind("<Return>",lambda _e:self.refresh())
        ttk.Button(search,text="Buscar",command=self.refresh).pack(side="left")
        ttk.Label(search,text="Ejemplo: *.jpg").pack(side="left",padx=8)
        self.show_hidden_var=tk.BooleanVar(value=True)
        ttk.Checkbutton(search,text="Mostrar ocultos",variable=self.show_hidden_var,command=self.refresh).pack(side="right")
        cols=("kind","size","date","state")
        self.tree=ttk.Treeview(frame,columns=cols,show="tree headings",selectmode="extended")
        self.tree.heading("#0",text="Nombre"); self.tree.heading("kind",text="Tipo"); self.tree.heading("size",text="Tamaño"); self.tree.heading("date",text="Modificado"); self.tree.heading("state",text="Estado")
        self.tree.column("#0",width=390); self.tree.column("kind",width=90); self.tree.column("size",width=105,anchor="e"); self.tree.column("date",width=145); self.tree.column("state",width=130)
        self.tree.pack(fill="both",expand=True,pady=8); self.tree.bind("<Double-1>",self.double_click)
        self.progress=ttk.Progressbar(frame,mode="determinate",maximum=1000); self.progress.pack(fill="x")
        self.info=tk.StringVar(value="Conectando y verificando huella TLS…"); ttk.Label(frame,textvariable=self.info).pack(anchor="w",pady=5)
        self.refresh()

    def close(self):
        with self._conn_lock:
            for c in self._connections:
                try: c.close()
                except Exception: pass
            self._connections.clear()
        try: self.win.destroy()
        except tk.TclError: pass

    def conn(self):
        c=getattr(self._local,"connection",None)
        if c is not None and c.sock is not None:
            return c
        c=http.client.HTTPSConnection(self.host,self.port,timeout=25,context=self.context)
        try:
            c.connect()
            cert=c.sock.getpeercert(binary_form=True)
            actual=hashlib.sha256(cert).digest()
            if not hmac.compare_digest(actual,self.pin_bytes):
                raise RuntimeError("La huella TLS no coincide; conexión cancelada.")
        except Exception:
            c.close()
            raise
        self._local.connection=c
        with self._conn_lock: self._connections.append(c)
        return c

    def request(self,method,path,headers=None):
        last=None
        for attempt in range(2):
            c=None
            try:
                c=self.conn()
                h={"Connection":"keep-alive","Authorization":"Bearer "+self.token,"Accept-Encoding":"identity"}
                if headers: h.update(headers)
                c.request(method,path,headers=h)
                return c.getresponse()
            except (OSError,http.client.HTTPException) as exc:
                last=exc
                if c is not None:
                    try: c.close()
                    except Exception: pass
                self._local.connection=None
        raise RuntimeError("Se perdió la conexión HTTPS: "+str(last))

    def json_get(self,path):
        r=self.request("GET",path,{"Accept":"application/json"}); body=r.read()
        if r.status!=200:
            try: msg=json.loads(body.decode("utf-8","replace")).get("message","")
            except Exception: msg=body[:200].decode("utf-8","replace")
            raise RuntimeError(f"HTTP {r.status}: {msg or r.reason}")
        return json.loads(body.decode("utf-8"))

    def list_remote(self,path,glob=""):
        collected=[]; offset=0; last={}
        while True:
            params={"path":path,"offset":offset,"limit":2000}
            if glob: params["glob"]=glob
            data=self.json_get("/api/list?"+urllib.parse.urlencode(params,encoding="utf-8",errors="surrogateescape"))
            last=data; batch=data.get("entries",[]); collected.extend(batch)
            if not data.get("has_more") or not batch: break
            offset+=len(batch)
            if offset>=10000: break
        self.remote_total=last.get("total",len(collected)); self.remote_skipped=last.get("skipped",0); self.remote_truncated=last.get("truncated",False)
        return collected

    def refresh(self):
        try:
            if not self.token: raise RuntimeError("Token vacío")
            glob=self.filter_var.get().strip() if hasattr(self,"filter_var") else ""
            all_entries=self.list_remote(self.path,glob)
            self.entries=[e for e in all_entries if self.show_hidden_var.get() or not e.get("name","").startswith(".")]
            if not self.path: self.json_get("/api/ping")
            self.path_var.set("/"+self.path if self.path else "/")
            for iid in self.tree.get_children(): self.tree.delete(iid)
            self.item_map={}; self.path_to_iid={}
            for i,e in enumerate(self.entries):
                kind=e.get("kind"); name=e.get("name",""); isdir=kind=="directory"
                typ=gui_file_type(name,kind)
                if kind=="symlink":label="🔗 "+name
                elif kind=="special":label="⚙ "+name
                elif isdir:label="📁 "+name
                else:label=("🌐 " if typ=="HTML" else "📄 ")+name
                label=safe_gui_text(label)
                size="—" if isdir or kind=="special" else human(e.get("size",0))
                try: date=time.strftime("%Y-%m-%d %H:%M",time.localtime(int(e.get("mtime",0))))
                except Exception: date="—"
                iid=str(i); self.item_map[iid]=e; self.path_to_iid[e.get("path","")]=iid
                state="no descargable" if kind in ("special","unsupported") or (kind=="symlink" and not e.get("downloadable")) else "disponible"
                self.tree.insert("","end",iid=iid,text=label,values=(typ,size,date,state))
            extra=(f" · {self.remote_skipped} omitidos" if getattr(self,"remote_skipped",0) else "")
            if getattr(self,"remote_truncated",False):extra+=" · directorio truncado (usa find o rsync)"
            self.info.set(f"Mostrando {len(self.entries)} de {self.remote_total} elementos · destino local: {self.dest}"+(" · filtro: "+glob if glob else "")+extra)
        except Exception as e:
            self.info.set("Error: "+str(e)); messagebox.showerror("Explorador NEXO-TOOLS",str(e),parent=self.win)

    def set_state(self,e,state):
        iid=self.path_to_iid.get(e.get("path",""))
        if iid:
            try: self.parent.after(0,lambda:self.tree.set(iid,"state",state))
            except Exception: pass

    def update_progress(self,index,sent,total):
        def update():
            ratio=(min(1.0,sent/total) if total else 1.0)
            value=1000*(index+ratio)/max(1,self._download_total)
            self.progress.configure(value=value)
            self.info.set(f"Descargando {index+1}/{self._download_total}: {human(sent)} de {human(total)}")
        try: self.parent.after(0,update)
        except Exception: pass

    def up(self):
        if self.path: self.path=self.path.rsplit("/",1)[0] if "/" in self.path else ""
        self.refresh()

    def double_click(self,event=None):
        sel=self.tree.selection()
        if not sel:return
        entry=self.item_map.get(sel[0],{})
        if entry.get("kind")=="directory":self.path=entry.get("path","");self.refresh()
        elif entry.get("kind") in ("file","symlink") and (entry.get("kind")=="file" or entry.get("downloadable")):
            self.open_selected_file()

    def open_selected_file(self):
        if self._download_active:
            messagebox.showinfo("Descarga en curso","Espera a que termine la descarga actual.",parent=self.win);return
        sel=self.tree.selection()
        if len(sel)!=1:
            messagebox.showinfo("Abrir","Selecciona exactamente un archivo.",parent=self.win);return
        entry=self.item_map.get(sel[0],{})
        if entry.get("kind") not in ("file","symlink") or (entry.get("kind")=="symlink" and not entry.get("downloadable")):
            messagebox.showinfo("Abrir","Este elemento no se puede abrir por HTTPS; usa rsync-pull para preservar enlaces.",parent=self.win);return
        ext=Path(entry.get("name","")).suffix.lower(); kind=classify_extension(entry.get("name",""))
        allow=os.environ.get("NEXO_TOOLS_OPEN_ALLOW","").strip()
        if allow and ext not in {x.strip().lower() for x in allow.split(",") if x.strip()}:
            messagebox.showerror("Extensión no permitida","Extensión no permitida por NEXO_TOOLS_OPEN_ALLOW.",parent=self.win);return
        if MAX_FILE_BYTES and int(entry.get("size",0))>MAX_FILE_BYTES:
            messagebox.showerror("Límite excedido",f"Archivo de {human(entry.get('size',0))} supera NEXO_TOOLS_MAX_FILE_BYTES ({MAX_FILE_BYTES}); abortado.",parent=self.win);return
        if kind=="active":
            warning=f"Tipo activo ({ext}): puede ejecutar código o cargar recursos externos. Se descargará en cuarentena, se verificará SHA-256 y luego se abrirá. ¿Continuar?"
            if not messagebox.askyesno("Abrir archivo activo",warning,parent=self.win):return
        elif kind=="unknown":
            if not messagebox.askyesno("Tipo desconocido","Tipo desconocido; se trata como activo por seguridad. ¿Descargar, verificar y abrir?",parent=self.win):return
        self._download_total=1;self._download_done=0;self._download_active=True;self.download_button.configure(state="disabled");self.progress.configure(value=0);self.set_state(entry,"descargando")
        def worker():
            try:result=self.download_one(entry,open_after=True,target_rel=entry.get("name"),progress_cb=lambda a,b:self.update_progress(0,a,b))
            except Exception as exc:result="ERROR: "+str(exc)
            def done():
                self.progress.configure(value=1000 if not result.startswith("ERROR:") else 0)
                self.set_state(entry,"error" if result.startswith("ERROR:") else "verificado")
                self.info.set(result[:220]);self.logger(result)
                self._download_active=False;self.download_button.configure(state="normal")
                if result.startswith("ERROR:"):messagebox.showerror("No se pudo abrir",result,parent=self.win)
            self.parent.after(0,done)
        threading.Thread(target=worker,daemon=True).start()

    def open_selected_html(self):
        return self.open_selected_file()

    def _expand_directory(self,root_entry):
        root_path=root_entry.get("path","").strip("/")
        if not root_path: raise ValueError("No se puede descargar la raíz completa.")
        files=[]; stack=[(root_path,0)]; visited=set(); skipped=0; confirmed_more=False
        while stack:
            current,depth=stack.pop()
            if depth>int(os.environ.get("NEXO_TOOLS_MAX_DEPTH","64")):raise ValueError("Se alcanzó NEXO_TOOLS_MAX_DEPTH; descarga abortada.")
            if current in visited: continue
            visited.add(current)
            for entry in self.list_remote(current):
                rel=entry.get("path","").strip("/")
                if entry.get("kind")=="directory": stack.append((rel,depth+1))
                elif entry.get("kind")=="file" or (entry.get("kind")=="symlink" and entry.get("downloadable")):
                    parts=rel.split("/")
                    base_parts=root_path.split("/")
                    if parts[:len(base_parts)]!=base_parts: raise ValueError("El servidor devolvió una ruta fuera de la carpeta seleccionada.")
                    relative="/".join(parts[len(base_parts):])
                    if relative and all(x not in (".","..","") for x in relative.split("/")):
                        files.append((entry,root_entry.get("name",Path(root_path).name)+"/"+relative))
                else:skipped+=1
                limit=int(os.environ.get("NEXO_TOOLS_MAX_FILES","100000"))
                if len(files)>limit and not confirmed_more:
                    if not messagebox.askyesno("Límite de archivos",f"La carpeta supera NEXO_TOOLS_MAX_FILES={limit}. ¿Continuar con la descarga?",parent=self.win):
                        raise ValueError("Descarga cancelada por superar NEXO_TOOLS_MAX_FILES.")
                    confirmed_more=True
        self._last_skipped=skipped
        return files

    def download_selected(self):
        sel=self.tree.selection()
        if not sel: messagebox.showinfo("Descargar","Selecciona uno o varios archivos o carpetas.",parent=self.win); return
        chosen=[(i,self.item_map[i]) for i in sel if i in self.item_map]
        dirs=[e for _,e in chosen if e.get("kind")=="directory"]
        tasks=[]
        for iid,e in chosen:
            if e.get("kind")=="file" or (e.get("kind")=="symlink" and e.get("downloadable")): tasks.append((iid,e,e.get("name","")))
            elif e.get("kind")=="directory":
                if not messagebox.askyesno("Descarga recursiva",f"¿Descargar toda la carpeta «{e.get('name','')}» y sus subcarpetas?",parent=self.win): continue
                try: tasks.extend((iid,child,target_rel) for child,target_rel in self._expand_directory(e))
                except Exception as exc: messagebox.showerror("Descarga de carpeta",str(exc),parent=self.win); return
        if not tasks:
            messagebox.showinfo("Descargar","No hay archivos en la selección.",parent=self.win); return
        self._download_total=len(tasks); self._download_done=0; self.progress.configure(value=0)
        self._download_active=True
        self.download_button.configure(state="disabled")
        for iid,e,_ in tasks:
            try: self.tree.set(iid,"state","pendiente")
            except tk.TclError: pass
        def worker():
            results=[None]*len(tasks); lock=threading.Lock()
            def one(index,task):
                iid,e,target_rel=task
                try: self.parent.after(0,lambda row=iid:self.tree.set(row,"state","descargando"))
                except Exception: pass
                self.set_state(e,"descargando")
                try:
                    result=self.download_one(e,target_rel=target_rel,progress_cb=lambda a,b:self.update_progress(index,a,b))
                    state="verificado"
                except Exception as exc:
                    result=f"ERROR {target_rel}: {exc}"; state="error"
                self.set_state(e,state)
                try: self.parent.after(0,lambda row=iid,st=state:self.tree.set(row,"state",st))
                except Exception: pass
                with lock:
                    results[index]=result; self._download_done+=1
                    done=self._download_done
                self.parent.after(0,lambda d=done:self.info.set(f"Procesados {d}/{self._download_total} archivos"))
            with concurrent.futures.ThreadPoolExecutor(max_workers=min(3,len(tasks))) as pool:
                futures=[pool.submit(one,i,t) for i,t in enumerate(tasks)]
                for f in futures: f.result()
            def done():
                self.progress.configure(value=1000 if not any(x and x.startswith("ERROR") for x in results) else 0)
                message="\n".join(x for x in results if x)
                self.info.set(f"Transferencia terminada · {len(tasks)} archivo(s)")
                self.logger(message); self.show_results("Resultado de descarga",message)
                self._download_active=False
                self.download_button.configure(state="normal")
            self.parent.after(0,done)
        threading.Thread(target=worker,daemon=True).start()

    def show_results(self,title,content):
        win=tk.Toplevel(self.win); win.title(title); win.geometry("700x430"); win.transient(self.win)
        frame=ttk.Frame(win,padding=10); frame.pack(fill="both",expand=True)
        txt=tk.Text(frame,wrap="word"); scroll=ttk.Scrollbar(frame,command=txt.yview); txt.configure(yscrollcommand=scroll.set)
        txt.pack(side="left",fill="both",expand=True); scroll.pack(side="right",fill="y")
        txt.insert("1.0",content); txt.configure(state="disabled")
        win.bind("<Escape>",lambda _e:win.destroy())

    def download_one(self,e,open_after=False,target_rel=None,progress_cb=None,_retry=0):
        name=e.get("name","");rel=e.get("path","");size=int(e.get("size",0));mtime=int(e.get("mtime",0))
        if not name or name in (".","..") or "/" in name or "\x00" in name:raise ValueError("Nombre remoto no válido")
        if e.get("kind") not in ("file","symlink") or (e.get("kind")=="symlink" and not e.get("downloadable")):raise ValueError("Elemento no descargable por HTTPS; usa rsync-pull.")
        if MAX_FILE_BYTES and size>MAX_FILE_BYTES:raise ValueError(f"Archivo de {human(size)} supera NEXO_TOOLS_MAX_FILE_BYTES ({MAX_FILE_BYTES}); abortado.")
        rel_dest=target_rel or name; parts=rel_dest.split("/")
        if rel_dest.startswith("/") or any(p in ("",".","..") for p in parts):raise ValueError("Ruta local remota no válida")
        dest_fs=os.environ.get("NEXO_TOOLS_DEST_FS","unknown").lower()
        fat_like=dest_fs in ("vfat","exfat","msdos","ntfs","apfs","hfs")
        def safe_name(value):
            original=os.fsencode(value);out=value
            if fat_like:
                out=re.sub(r'[\\/:*?<>|\"]',"_",out).rstrip(" .")
                stem=out.split(".",1)[0].upper()
                if stem in {"CON","PRN","AUX","NUL",*(f"COM{i}" for i in range(1,10)),*(f"LPT{i}" for i in range(1,10))} or out.lower()=="desktop.ini":out="_NEXO_"+out
            if not out:out="_NEXO_nombre"
            raw=os.fsencode(out)
            if len(raw)>255:
                suffix=os.fsencode(Path(out).suffix);tag="~"+hashlib.sha256(original).hexdigest()[:8];room=max(1,min(200,255-len(tag)-len(suffix)));prefix=raw[:room]
                while prefix:
                    try:prefix.decode("utf-8");break
                    except UnicodeDecodeError as exc:
                        if exc.reason=="unexpected end of data" and exc.end==len(prefix):prefix=prefix[:exc.start];break
                        prefix=prefix[:-1]
                out=os.fsdecode(prefix)+tag+os.fsdecode(suffix)
            return out
        mapped=[]
        for component in parts:
            candidate=safe_name(component); parent=self.dest.joinpath(*mapped)
            try:existing={x.name for x in parent.iterdir()} if parent.is_dir() else set()
            except OSError:existing=set()
            def name_key(value):
                normalized=unicodedata.normalize("NFC",value)
                return normalized.casefold() if fat_like else normalized
            key=name_key(candidate); used_key=(str(parent),key)
            with self._name_lock:
                collision=any(name_key(x)==key and x!=candidate for x in existing)
                if collision or (used_key in self._name_used and self._name_used[used_key]!=candidate):
                    base=Path(candidate);n=1
                    while True:
                        alt=f"{base.stem} ({n}){base.suffix}";alt_key=name_key(alt)
                        if alt not in existing and (str(parent),alt_key) not in self._name_used:break
                        n+=1
                    candidate=alt;used_key=(str(parent),alt_key)
                    self.logger(f"⚠ Colisión Unicode/case-insensitive: renombrado a {safe_gui_text(candidate)}")
                self._name_used[used_key]=candidate
            if candidate!=component:self.logger(f"⚠ Nombre incompatible; renombrado a {safe_gui_text(candidate)}")
            mapped.append(candidate)
        parts=mapped
        target=self.dest.joinpath(*parts).resolve(strict=False);target.parent.mkdir(parents=True,exist_ok=True)
        try:target.relative_to(self.dest)
        except ValueError:raise ValueError("La ruta de descarga sale de la carpeta destino.")
        etag_file=target.with_name("."+target.name+".nexo-etag");q=urllib.parse.quote_from_bytes(os.fsencode(rel),safe="")
        is_active=classify_extension(target.name)!="passive";quarantine=self.dest/".nexo-quarantine" if is_active else None
        if quarantine:
            quarantine.mkdir(mode=0o700,parents=True,exist_ok=True)
            if quarantine.is_symlink():raise ValueError("La cuarentena no puede ser un enlace simbólico")
            os.chmod(quarantine,0o700);part=quarantine/(hashlib.sha256(os.fsencode(rel_dest)).hexdigest()+".nexo-part")
        else:part=target.with_name("."+target.name+".nexo-part")
        if open_after:
            for stale in (target,etag_file,part):
                try:stale.unlink()
                except FileNotFoundError:pass
                except OSError:pass
        offset=part.stat().st_size if part.exists() else 0
        if offset>size:part.unlink();offset=0
        headers={}
        if target.is_file() and etag_file.is_file():headers["If-None-Match"]=etag_file.read_text(encoding="ascii",errors="surrogateescape").strip()
        for attempt in range(4):
            r=self.request("GET","/api/download?path="+q,headers if attempt==0 else ({"Range":f"bytes={offset}-"} if offset else {}))
            if r.status==503 and attempt<3:
                delay=r.getheader("Retry-After","5");r.read()
                try:time.sleep(max(1,min(30,int(delay))))
                except ValueError:time.sleep(5)
                continue
            break
        if r.status==304:
            r.read()
            if open_after:
                op=gui_open_verified_path(target);return f"✓ Archivo ya verificado y abierto: {target.name} · {op}"
            return f"= Sin cambios (ETag): {target.name}"
        if r.status==409:
            r.read()
            try:part.unlink()
            except OSError:pass
            if _retry==0:return self.download_one(e,open_after,target_rel,progress_cb,_retry=1)
            raise RuntimeError("El archivo cambió en el servidor; reintenta más tarde.")
        if r.status==413:raise RuntimeError("El servidor rechazó el archivo: supera el límite NEXO_TOOLS_MAX_FILE_BYTES.")
        if r.status not in (200,206):raise RuntimeError(f"HTTP {r.status}: {r.read(250).decode('utf-8','replace')}")
        if offset and r.status==206:
            if not r.getheader("Content-Range","").startswith(f"bytes {offset}-"):raise RuntimeError("Rango de reanudación incorrecto")
            mode="ab"
        else:offset=0;mode="wb"
        content_length=int(r.getheader("Content-Length",str(max(0,size-offset))))
        expected=size
        cr=r.getheader("Content-Range","")
        try:expected=int(cr.rsplit("/",1)[1]) if cr else (content_length if mode=="wb" else size)
        except ValueError:expected=size
        if MAX_FILE_BYTES and expected>MAX_FILE_BYTES:raise RuntimeError("El archivo supera NEXO_TOOLS_MAX_FILE_BYTES; abortado.")
        remote_hash=r.getheader("X-Nexo-SHA256","").lower();etag=r.getheader("ETag","")
        if remote_hash and not re.fullmatch(r"[0-9a-f]{64}",remote_hash):raise RuntimeError("El servidor envió SHA-256 no válido")
        total=offset;last_progress=0.0;started=time.monotonic();part.parent.mkdir(parents=True,exist_ok=True)
        with open(part,mode) as f:
            while True:
                block=r.read(1024*1024)
                if not block:break
                f.write(block);total+=len(block)
                now=time.monotonic()
                if progress_cb and (now-last_progress>=0.2 or total>=expected):progress_cb(total,expected);last_progress=now
        if total!=expected or part.stat().st_size!=expected:
            try:part.unlink()
            except OSError:pass
            if _retry==0:return self.download_one(e,open_after,target_rel,progress_cb,_retry=1)
            raise RuntimeError("El archivo cambió en el servidor; reintenta más tarde.")
        digest_hex=""
        if remote_hash:
            h=hashlib.sha256()
            with open(part,"rb") as f:
                for block in iter(lambda:f.read(1024*1024),b""):h.update(block)
            digest_hex=h.hexdigest()
            if not hmac.compare_digest(h.digest(),bytes.fromhex(remote_hash)):
                try:part.unlink()
                except OSError:pass
                if _retry==0:return self.download_one(e,open_after,target_rel,progress_cb,_retry=1)
                raise RuntimeError("El archivo cambió en el servidor; reintenta más tarde.")
            verify="SHA-256 verificado"
        else:
            verify="verificado por ETag (sin SHA-256)"
            self.logger(f"⚠ {name}: verificado por ETag (sin SHA-256); HASH_SKIP_ABOVE activo.")
        os.utime(part,(mtime,mtime));os.replace(part,target)
        if etag:
            tmp=etag_file.with_name(etag_file.name+".tmp");tmp.write_text(etag,encoding="ascii");os.replace(tmp,etag_file);os.chmod(etag_file,0o600)
        verifylog=STATE/"verify.log";verifylog.parent.mkdir(mode=0o700,parents=True,exist_ok=True)
        fd=os.open(verifylog,os.O_WRONLY|os.O_CREAT|os.O_APPEND,0o600)
        try:os.write(fd,f"{time.strftime('%Y-%m-%dT%H:%M:%S')}\t{target}\t{digest_hex or etag}\t{verify}\n".encode("utf-8","backslashreplace"))
        finally:os.close(fd)
        if open_after:
            op=gui_open_verified_path(target);return f"✓ Archivo descargado, {verify} y abierto: {target.name} · {op}"
        return f"✓ {rel_dest} · {human(expected)} · {verify}"

def gui_open_verified_path(value):
    path=Path(value).expanduser().resolve(strict=True)
    if not path.is_file():raise ValueError("La ruta no es un archivo regular.")
    if ".nexo-quarantine" in path.parts:raise ValueError("No se abre un archivo en cuarentena; espera a que se mueva.")
    result=subprocess.run(["bash",SCRIPT,"__open_verified_browser",str(path)],text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=10)
    if result.returncode:raise RuntimeError(result.stderr.strip() or "No se encontró un abridor compatible.")
    return result.stdout.strip()

def human(n):
    v=float(n)
    for unit in ("B","KiB","MiB","GiB","TiB","PiB"):
        if v<1024 or unit=="PiB": return f"{int(v)} {unit}" if unit=="B" else f"{v:.1f} {unit}"
        v/=1024

def shutil_which(name):
    return shutil.which(name)

