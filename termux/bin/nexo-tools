def icon_for(e):
 if e.get("kind")=="directory":return "📁"
 if e.get("kind")=="symlink":return "🔗"
 if e.get("kind")=="special":return "⚙️"
 ext=Path(e.get("name","")).suffix.lower()
 for icon,group in ICON_GROUPS:
  if ext in group:return icon
 return "📄"
def fmt_date(ts):
 try:return datetime.datetime.fromtimestamp(int(ts)).strftime("%Y-%m-%d %H:%M")
 except Exception:return "—"
def parse_selection(text,max_index):
 result=[]
 for part in text.split(","):
  part=part.strip()
  if not part:continue
  if "-" in part:
   a,b=part.split("-",1)
   if not a.isdigit() or not b.isdigit():raise ValueError()
   lo,hi=int(a),int(b)
   if lo>hi:lo,hi=hi,lo
   result.extend(range(lo,hi+1))
  else:
   if not part.isdigit():raise ValueError()
   result.append(int(part))
 result=sorted(set(result))
 if not result or any(i<1 or i>max_index for i in result):raise ValueError()
 return result

def list_remote(path,glob_pattern="",ext_filter=""):
 global LAST_LIST_META
 all_entries=[]; offset=0; last={}
 while True:
  params={"path":path,"offset":str(offset),"limit":"5000"}
  if glob_pattern:params["glob"]=glob_pattern
  if ext_filter:params["ext"]=ext_filter
  data=api_get("/api/list?"+urllib.parse.urlencode(params,encoding="utf-8",errors="surrogateescape"))
  last=data; all_entries.extend(data.get("entries",[])); offset+=len(data.get("entries",[]))
  if not data.get("has_more") or not data.get("entries"):break
 LAST_LIST_META={"total":last.get("total",len(all_entries)),"truncated":last.get("truncated",False),"skipped":last.get("skipped",0),"ext_counts":last.get("ext_counts",{})}
 return {**last,"entries":all_entries}

def safe_relative(value):
 value=str(value)
 p=pathlib.PurePosixPath(value)
 if p.is_absolute() or not p.parts or "\x00" in value or any(x in ("",".","..") for x in p.parts):
  raise TransferError("Ruta remota insegura; descarga cancelada.")
 return pathlib.Path(*p.parts)

def target_for(entry,relative=None):
 rel=safe_relative(relative if relative is not None else entry.get("name",""))
 mapped=map_relative_name(rel.as_posix())
 target=(DEST/mapped).resolve(strict=False)
 try: target.relative_to(DEST)
 except ValueError: raise TransferError("La ruta de destino sale de la carpeta elegida.")
 return target

def resolve_conflicts(files):
 prepared=[]
 for entry,rel in files:
  target=target_for(entry,rel)
  if target.exists():
   try:
    if target.is_file() and target.stat().st_size==int(entry.get("size",0)) and abs(target.stat().st_mtime-float(entry.get("mtime",0)))<=2:
     prepared.append((entry,target));continue
   except OSError:pass
   if TTY:
    ans=input(f"\nYa existe {target}. [s]altar / [o]sobrescribir / [c]opia (s): ").strip().lower() or "s"
   else: ans="c"
   if ans=="s":
    with PRINT_LOCK: print("Omitido:",target)
    continue
   if ans=="c":
    base=target; n=1
    while target.exists():target=base.with_name(f"{base.stem} ({n}){base.suffix}");n+=1
   elif ans!="o":raise TransferError("Opción de conflicto no válida")
  target.parent.mkdir(parents=True,exist_ok=True)
  prepared.append((entry,target))
 return prepared

def download_one(entry,target,quiet=False):
 name=entry.get("name",""); rel=entry.get("path",""); size=int(entry.get("size",0)); mtime=int(entry.get("mtime",0))
 if not name or name in (".","..") or "/" in name or "\\x00" in name:raise TransferError("Nombre remoto no válido")
 if entry.get("kind") not in ("file","symlink") or (entry.get("kind")=="symlink" and not entry.get("downloadable")):
  raise TransferError("Elemento no descargable por HTTPS; usa rsync-pull para preservar enlaces simbólicos.")
 if MAX_FILE_BYTES and size>MAX_FILE_BYTES:raise LimitExceeded(f"Archivo de {human_size(size)} supera NEXO_TOOLS_MAX_FILE_BYTES ({MAX_FILE_BYTES}); abortado.")
 if target is None:target=target_for(entry)
 target=Path(target); target.parent.mkdir(parents=True,exist_ok=True)
 active=classify_extension(target.name)!="passive"
 quarantine=DEST/".nexo-quarantine" if active else None
 if quarantine:
  quarantine.mkdir(mode=0o700,parents=True,exist_ok=True)
  if quarantine.is_symlink():raise TransferError("La cuarentena no puede ser un enlace simbólico.")
  os.chmod(quarantine,0o700)
  part=quarantine/(hashlib.sha256(os.fsencode(str(target.relative_to(DEST)))).hexdigest()+".nexo-part")
 else:part=target.with_name("."+target.name+".nexo-part")
 etag_file=target.with_name("."+target.name+".nexo-etag")
 existing_etag=""
 try:existing_etag=etag_file.read_text(encoding="ascii",errors="surrogateescape").strip()
 except OSError:pass
 url_path="/api/download?path="+quote_remote_path(rel)
 for version_try in range(2):
  offset=part.stat().st_size if part.exists() else 0
  if offset>size:part.unlink();offset=0
  if target.is_file() and existing_etag and target.stat().st_size==size:
   resp=SESSION.request(url_path,{"If-None-Match":existing_etag})
   if resp.status==304:
    resp.read();write_verify_log(target,existing_etag,"etag-304")
    if not quiet:
     with PRINT_LOCK:print("= Sin cambios (ETag):",safe_text(target.name))
    return str(target)
  else:resp=None
  retries_503=0
  while True:
   headers={}
   if offset and offset<size:headers["Range"]=f"bytes={offset}-"
   if resp is None:resp=SESSION.request(url_path,headers)
   if resp.status==503 and retries_503<3:
    wait=resp.getheader("Retry-After","5");resp.read()
    try:delay=max(1,min(30,int(wait)))
    except ValueError:delay=5
    time.sleep(delay);resp=None;retries_503+=1;continue
   break
  if resp.status==409:
   body=resp.read(300)
   try:message=json.loads(body.decode("utf-8","replace")).get("message","")
   except Exception:message=""
   try:part.unlink()
   except OSError:pass
   if version_try==0:
    refreshed=api_get("/api/list?path="+quote_remote_path(str(pathlib.PurePosixPath(rel).parent if "/" in rel else "")))
    newer=next((x for x in refreshed.get("entries",[]) if x.get("name")==name),None)
    if newer:entry.update(newer);size=int(entry.get("size",0));mtime=int(entry.get("mtime",0))
    continue
   raise RemoteChanged("El archivo cambió en el servidor; reintenta más tarde.")
  if resp.status==413:
   body=resp.read(300).decode("utf-8","replace")
   raise LimitExceeded(body or "El servidor rechazó el archivo por superar el límite de bytes.")
  if resp.status not in (200,206):
   body=resp.read(300).decode("utf-8","replace")
   try:message=json.loads(body).get("message",body)
   except Exception:message=body
   raise TransferError(f"HTTP {resp.status}: {message or resp.reason}")
  if offset and resp.status==206:
   if not resp.getheader("Content-Range","").startswith(f"bytes {offset}-"):
    resp.read();raise TransferError("Rango de reanudación incorrecto")
   mode="ab"
  else:offset=0;mode="wb"
  content_length=resp.getheader("Content-Length")
  total_expected=size
  cr=resp.getheader("Content-Range","")
  if cr and "/" in cr:
   try:total_expected=int(cr.rsplit("/",1)[1])
   except ValueError:pass
  elif content_length is not None and mode=="wb":
   try:total_expected=int(content_length)
   except ValueError:pass
  if MAX_FILE_BYTES and total_expected>MAX_FILE_BYTES:
   resp.read();raise LimitExceeded(f"Archivo de {human_size(total_expected)} supera NEXO_TOOLS_MAX_FILE_BYTES ({MAX_FILE_BYTES}); abortado.")
  remote_hash=resp.getheader("X-Nexo-SHA256","").lower(); etag=resp.getheader("ETag","")
  if remote_hash and not re.fullmatch(r"[0-9a-f]{64}",remote_hash):resp.read();raise TransferError("El servidor envió un SHA-256 no válido")
  if part.exists() and part.stat().st_size==total_expected and total_expected>0 and remote_hash:
   digest=hashlib.sha256()
   with part.open("rb") as pf:
    for block in iter(lambda:pf.read(1024*1024),b""):digest.update(block)
   if hmac.compare_digest(digest.digest(),bytes.fromhex(remote_hash)):
    resp.read();os.utime(part,(mtime,mtime));os.replace(part,target)
    if etag:etag_file.write_text(etag,encoding="ascii",errors="surrogateescape")
    VERIFIED_META[str(target)]={"sha256":remote_hash,"etag":etag,"status":"sha256"}
    write_verify_log(target,remote_hash,"sha256-partial-complete")
    return str(target)
   try:part.unlink()
   except OSError:pass
   offset=0;mode="wb"
  began=time.monotonic();last_progress=0.0;transferred=offset
  try:
   with part.open(mode) as out:
    while True:
     block=resp.read(1024*1024)
     if not block:break
     out.write(block);transferred+=len(block)
     now=time.monotonic()
     if TTY and not quiet and (now-last_progress>=0.2 or transferred>=total_expected):
      pct=min(100,transferred*100/max(1,total_expected));speed=max(0,transferred-offset)/max(0.001,now-began)
      with PRINT_LOCK:print(f"\\r{icon_for(entry)} {clip(name,26):26} {pct:6.1f}% {human_size(transferred)}/{human_size(total_expected)} {human_size(int(speed))}/s",end="",flush=True)
      last_progress=now
  except (OSError,http.client.HTTPException):
   if version_try==0:
    try:part.unlink()
    except OSError:pass
    continue
   raise RemoteChanged("El archivo cambió en el servidor; reintenta más tarde.")
  if transferred!=total_expected or part.stat().st_size!=total_expected:
   if version_try==0:
    try:part.unlink()
    except OSError:pass
    continue
   raise RemoteChanged("El archivo cambió en el servidor; reintenta más tarde.")
  digest_hex=""
  if remote_hash:
   h=hashlib.sha256()
   with part.open("rb") as f:
    for block in iter(lambda:f.read(1024*1024),b""):h.update(block)
   digest_hex=h.hexdigest()
   if not hmac.compare_digest(h.digest(),bytes.fromhex(remote_hash)):
    try:part.unlink()
    except OSError:pass
    if version_try==0:continue
    raise RemoteChanged("El archivo cambió en el servidor; reintenta más tarde.")
   status="sha256"
  else:
   status="etag-sin-sha256"
   with PRINT_LOCK:print(f"⚠ {safe_text(name)}: verificado por ETag (sin SHA-256); el emisor aplicó NEXO_TOOLS_HASH_SKIP_ABOVE.")
  os.utime(part,(mtime,mtime));os.replace(part,target)
  if etag:
   tmp=etag_file.with_name(etag_file.name+".tmp");tmp.write_text(etag,encoding="ascii",errors="surrogateescape");os.replace(tmp,etag_file);os.chmod(etag_file,0o600)
  VERIFIED_META[str(target)]={"sha256":digest_hex,"etag":etag,"status":status}
  write_verify_log(target,digest_hex or etag,status)
  if not quiet:
   with PRINT_LOCK:
    if TTY:print("\\r",end="")
    print(f"✓ {safe_text(target.relative_to(DEST))} · {human_size(total_expected)} · {'SHA-256 verificado' if remote_hash else 'ETag débil'}")
  return str(target)
 raise RemoteChanged("El archivo cambió en el servidor; reintenta más tarde.")

def open_verified_path(value,confirmed=False):
 path=Path(value).expanduser().resolve(strict=True)
 if not path.is_file():raise TransferError("La ruta no es un archivo regular.")
 if ".nexo-quarantine" in path.parts:raise TransferError("No se abre un archivo en cuarentena; espera a que se mueva.")
 ext=path.suffix.lower(); allow=os.environ.get("NEXO_TOOLS_OPEN_ALLOW","").strip()
 if allow and ext not in {x.strip().lower() for x in allow.split(",") if x.strip()}:
  raise TransferError("Extensión no permitida por NEXO_TOOLS_OPEN_ALLOW.")
 kind=classify_extension(path)
 if kind=="active" and not confirmed:
  print(f"⚠ Tipo activo ({ext}): puede ejecutar código o cargar recursos externos. Abre solo archivos de confianza.")
  if not TTY or input("¿Abrir? [s/N]: ").strip().lower() not in ("s","si","sí","y","yes"):raise TransferError("Apertura cancelada.")
 if kind=="unknown" and not confirmed:
  print("⚠ Tipo desconocido; se trata como activo por seguridad.")
  if not TTY or input("¿Abrir? [s/N]: ").strip().lower() not in ("s","si","sí","y","yes"):raise TransferError("Apertura cancelada.")
 result=subprocess.run(["bash",script_path,"__open_verified_browser",str(path)],text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=10)
 if result.returncode:
  ext=path.suffix.lower()
  if kind=="passive" and ext in {".txt",".md",".markdown",".log",".csv",".tsv",".json",".yaml",".yml",".toml",".ini",".conf",".cfg",".rst",".tex"}:
   exe=shutil.which("less") or shutil.which("bat") or shutil.which("more")
   if exe:subprocess.run([exe,str(path)])
   else:
    with path.open("r",encoding="utf-8",errors="replace") as f:
     for line in f:
      print(line,end="")
      if TTY and input("Enter para continuar (q para salir): ").lower()=="q":break
   return "terminal"
  if kind=="passive" and ext in {".png",".jpg",".jpeg",".gif",".webp",".bmp",".tiff",".tif",".ico"}:
   for tool in ("chafa","viu","img2txt","jp2"):
    exe=shutil.which(tool)
    if exe:subprocess.run([exe,str(path)]);return tool
  raise TransferError(result.stderr.strip() or "No se encontró un abridor compatible.")
 return result.stdout.strip()

def recursive_files(dir_entry):
 root_remote=dir_entry.get("path",""); results=[]; stack=[(root_remote,0)]; visited=set(); global SESSION_SKIPPED
 while stack:
  folder,depth=stack.pop()
  if depth>MAX_DEPTH:raise TransferError(f"Se alcanzó NEXO_TOOLS_MAX_DEPTH={MAX_DEPTH}; descarga abortada.")
  if folder in visited:continue
  visited.add(folder);listing=list_remote(folder);SESSION_SKIPPED+=int(listing.get("skipped",0))
  if listing.get("truncated"):SESSION_SKIPPED+=1
  for item in listing.get("entries",[]):
   kind=item.get("kind")
   if kind=="directory":stack.append((item.get("path",""),depth+1))
   elif kind=="file" or (kind=="symlink" and item.get("downloadable")):
    full=pathlib.PurePosixPath(item.get("path",""));base=pathlib.PurePosixPath(root_remote)
    rel=full.relative_to(base);results.append((item,rel.as_posix()))
   else:SESSION_SKIPPED+=1
   if len(results)>MAX_FILES:
    if not TTY:raise TransferError(f"La operación supera NEXO_TOOLS_MAX_FILES={MAX_FILES}; no se ejecutará sin confirmación interactiva.")
    ans=input(f"Se encontraron más de {MAX_FILES} archivos. ¿Continuar? [s/N]: ").strip().lower()
    if ans not in ("s","si","sí","y","yes"):raise TransferError("Operación cancelada por exceder el máximo de archivos.")
    break
 return results

def manifest_path(root_key):
 digest=hashlib.sha256(os.fsencode(str(root_key))).hexdigest()[:20]
 return DEST/('.nexo-manifest-'+digest+'.json')

def manifest_load(path):
 try:return json.loads(path.read_text(encoding="utf-8",errors="surrogateescape"))
 except Exception:return {}

def manifest_save(path,data):
 path.parent.mkdir(parents=True,exist_ok=True)
 fd,tmp=tempfile.mkstemp(prefix=path.name+'.',dir=str(path.parent))
 try:
  os.fchmod(fd,0o600)
  with os.fdopen(fd,'w',encoding='utf-8',errors='surrogateescape') as f:json.dump(data,f,ensure_ascii=True,separators=(',',':'))
  os.replace(tmp,path);os.chmod(path,0o600)
 except Exception:
  try:os.unlink(tmp)
  except OSError:pass
  raise

def download_many(files,manifest_root=None):
 global SESSION_ERRORS,SESSION_VERIFIED,SESSION_SKIPPED,SESSION_EXIT
 if len(files)>MAX_FILES:
  if not TTY:raise TransferError(f"Se encontraron {len(files)} archivos; excede NEXO_TOOLS_MAX_FILES={MAX_FILES} y no hay TTY para confirmar.")
  if input(f"Se encontraron {len(files)} archivos (límite {MAX_FILES}). ¿Continuar? [s/N]: ").strip().lower() not in ("s","si","sí","y","yes"):
   raise TransferError("Operación cancelada por límite de archivos.")
 mp=manifest_path(manifest_root) if manifest_root is not None else None
 manifest=manifest_load(mp) if mp else {}
 prepared=resolve_conflicts(files);filtered=[]
 for entry,target in prepared:
  rel=entry.get("path",entry.get("name","")); key=str(rel)
  rec=manifest.get(key,{}) if mp else {}
  remote_size=int(entry.get("size",0)); remote_mtime_ns=int(entry.get("mtime_ns",0))
  if rec.get("status") in ("sha256","etag-sin-sha256") and target.is_file() and target.stat().st_size==remote_size==int(rec.get("size",-1)) and int(rec.get("mtime_ns",-1))==remote_mtime_ns:
   good=False
   if rec.get("sha256"):
    h=hashlib.sha256()
    with target.open("rb") as f:
     for b in iter(lambda:f.read(1024*1024),b""):h.update(b)
    good=h.hexdigest()==rec.get("sha256")
   if good:
    with PRINT_LOCK:print("= Reanudación de carpeta: archivo ya verificado",safe_text(target.name))
    SESSION_VERIFIED+=1;continue
  filtered.append((entry,target))
 if not filtered:return []
 results=[None]*len(filtered)
 def work(index,item):
  global SESSION_ERRORS,SESSION_VERIFIED,SESSION_EXIT
  entry,target=item
  try:
   result=download_one(entry,target,quiet=True);meta=VERIFIED_META.get(str(target),{})
   with MANIFEST_LOCK:
    if mp:
     manifest[str(entry.get("path",entry.get("name",""))) ]={"size":target.stat().st_size,"mtime_ns":int(entry.get("mtime_ns",0)),"sha256":meta.get("sha256",""),"etag":meta.get("etag",""),"status":meta.get("status","sha256"),"local_path":str(target.relative_to(DEST))}
     manifest_save(mp,manifest)
   SESSION_VERIFIED+=1;results[index]=result
  except LimitExceeded as exc:
   SESSION_ERRORS+=1;SESSION_EXIT=max(SESSION_EXIT,6);results[index]="ERROR "+str(exc)
  except RemoteChanged as exc:
   SESSION_ERRORS+=1;SESSION_EXIT=max(SESSION_EXIT,5);results[index]="ERROR "+str(exc)
  except Exception as exc:
   SESSION_ERRORS+=1
   if SESSION_EXIT==0:SESSION_EXIT=4
   results[index]=f"ERROR {safe_text(entry.get('name','?'))}: {exc}"
 with ThreadPoolExecutor(max_workers=min(3,len(filtered)),thread_name_prefix="nexo-download") as pool:
  futures=[pool.submit(work,i,item) for i,item in enumerate(filtered)]
  for f in futures:f.result()
 with PRINT_LOCK:
  for result in results:
   if result:print(result)
  print(f"Resumen: {SESSION_VERIFIED} archivos verificados; {SESSION_ERRORS} errores; {SESSION_SKIPPED} omitidos (symlinks/especiales/sin permiso).")
  if SESSION_ERRORS and SESSION_EXIT==0:SESSION_EXIT=4
 return results

def join_remote(base,name):
 return (base+"/"+name) if base else name

def rw_command(cmd,entries):
 if not CAN_WRITE:
  print("Este dispositivo te dejó en solo lectura. Para escribir debe ejecutar «nexo-tools server --rw» y darte un código con «nexo-tools pair --rw».");return
 verb,_,rest=cmd.partition(" ");rest=rest.strip();verb=verb.lower()
 try:
  if verb=="mkdir":
   if not rest or "/" in rest:print("Uso: mkdir NOMBRE (sin barras)");return
   api_send("POST","/api/mkdir",json.dumps({"path":join_remote(remote_path,rest)}).encode(),{"Content-Type":"application/json"});print("Carpeta creada:",safe_text(rest))
  elif verb=="mv":
   a,_,new=rest.partition(" ");new=new.strip()
   nums=parse_selection(a,len(entries))
   if len(nums)!=1 or not new or "/" in new:print("Uso: mv N NUEVO_NOMBRE (en la misma carpeta)");return
   api_send("POST","/api/rename",json.dumps({"path":entries[nums[0]-1]["path"],"to":join_remote(remote_path,new)}).encode(),{"Content-Type":"application/json"});print("Renombrado.")
  elif verb=="rm":
   nums=parse_selection(rest,len(entries));items=[entries[i-1] for i in nums]
   if input(f"¿Mover {len(items)} elemento(s) a la papelera (.nexo-trash) del otro dispositivo? [s/N]: ").strip().lower() not in ("s","si","sí","y","yes"):return
   for item in items:
    api_send("POST","/api/delete",json.dumps({"path":item["path"]}).encode(),{"Content-Type":"application/json"});print("  🗑",safe_text(item.get("name","")))
  elif verb=="put":
   files=[Path(x).expanduser() for x in __import__("shlex").split(rest)] if rest else []
   if not files:print("Uso: put RUTA_LOCAL [RUTA_LOCAL...] (archivos; para carpetas usa «nexo-tools put»)");return
   for f in files:
    if not f.is_file() or f.is_symlink():print("  ✘",safe_text(str(f)),"no es un archivo normal");continue
    h=hashlib.sha256()
    with open(f,"rb") as fh:
     for b in iter(lambda:fh.read(1<<20),b""):h.update(b)
    with open(f,"rb") as fh:
     api_send("PUT","/api/upload?"+urllib.parse.urlencode({"path":join_remote(remote_path,f.name)}),fh,{"Content-Length":str(f.stat().st_size),"X-Nexo-SHA256":h.hexdigest()})
    print("  ↑",safe_text(f.name),human_size(f.stat().st_size))
 except Exception as e:print("No se pudo:",e)

def render(entries,page,cwd,sort_key,order,show_hidden):
 if not show_hidden:entries=[e for e in entries if not e.get("name","").startswith(".")]
 reverse=(order=="desc");directories=[e for e in entries if e.get("kind")=="directory"];files=[e for e in entries if e.get("kind")!="directory"]
 key=(lambda e:e.get("name","").casefold()) if sort_key=="name" else (lambda e:e.get(sort_key,0))
 directories.sort(key=key,reverse=reverse);files.sort(key=key,reverse=reverse);entries=directories+files
 term=shutil.get_terminal_size((100,24)).columns;page_size=18
 total_pages=max(1,(len(entries)+page_size-1)//page_size);page=max(0,min(page,total_pages-1));start=page*page_size;visible=entries[start:start+page_size]
 namew=max(18,min(48,term-48))
 if TTY:print("\033[2J\033[H",end="")
 print("╭────────────────────── NEXO-TOOLS · EXPLORADOR ──────────────────────╮")
 print("│ Ruta remota: "+clip(cwd or "/",max(1,term-18)))
 print("╰─────────────────────────────────────────────────────────────────────╯")
 print(f"{len(entries)} elementos · Página {page+1}/{total_pages} · destino local: {DEST} · orden {sort_key} {order}"+(f" · filtro: {glob_pattern}" if glob_pattern else "")+(f" · extensiones: {ext_filter}" if ext_filter else ""))
 print("─"*min(term,100));print(f"{'N':>3}  {'NOMBRE':<{namew}}  {'TIPO':<10} {'TAMAÑO':>10}  MODIFICADO");print("─"*min(term,100))
 for idx,e in enumerate(visible,start+1):
  kind=e.get("kind");label=icon_for(e)+" "+safe_text(e.get("name",""))
  kind_label={"directory":"Carpeta","file":"Archivo","symlink":"Enlace","special":"Especial","unsupported":"No compatible"}.get(kind,"Desconocido")
  if kind=="symlink" and not e.get("downloadable"):kind_label="Enlace (solo rsync)"
  size="—" if kind in ("directory","special","unsupported") else human_size(e.get("size",0))
  print(f"{idx:>3}  {pad(label,namew)}  {kind_label:<10} {size:>10}  {fmt_date(e.get('mtime',0))}")
 if not visible:print("(Carpeta vacía)")
 if LAST_LIST_META.get("skipped",0):print(f"{LAST_LIST_META['skipped']} elementos omitidos (sin permiso o no soportados).")
 if LAST_LIST_META.get("truncated"):print(f"Carpeta enorme: el otro dispositivo solo enumera los primeros {LAST_LIST_META.get('total','')}. Usa find o ext para acotar.")
 print("─"*min(term,100));print("Acciones: número/cd N · get N[,N] o get CARPETA/ · open N · info N · all")
 print("          find GLOB (a*|b*) · ext .jpg,.png · types · sort name|size|date · order asc|desc · hide/show · ? · up · q")
 if CAN_WRITE:print("          escritura: mkdir NOMBRE · mv N NUEVO · rm N · put RUTA_LOCAL")
