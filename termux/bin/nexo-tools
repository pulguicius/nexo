  elif do_all:
   spec=",".join(str(i) for i,e in enumerate(entries,1) if e.get("kind")=="file")
   SESSION_SKIPPED+=sum(1 for e in entries if e.get("kind") in ("symlink","special","unsupported"))
   if spec.count(",")>=199 and input(f"Hay {spec.count(',')+1} archivos en esta carpeta (con el filtro actual). ¿Descargarlos todos? [s/N]: ").strip().lower() not in ("s","si","sí","y","yes"):continue
  else:spec=cmd
