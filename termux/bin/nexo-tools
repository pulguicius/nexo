def read_command(names):
 if not sys.stdin.isatty():return input("nexo-tools> ")
 fd=sys.stdin.fileno();old=termios.tcgetattr(fd);buf=bytearray();hist_idx=len(history)
 def redraw():
  sys.stdout.write("\r\033[K n e x o-tools> ".replace(" ","")+buf.decode("utf-8","replace"));sys.stdout.flush()
 try:
  tty.setraw(fd);sys.stdout.write("nexo-tools> ");sys.stdout.flush()
  while True:
   ch=os.read(fd,1)
   if ch in (b"\r",b"\n"):sys.stdout.write("\r\n");sys.stdout.flush();break
   if ch==b"\x03":raise KeyboardInterrupt
   if ch in (b"\x7f",b"\x08"):
    if buf:buf.pop();redraw()
    continue
   if ch==b"\x1b":
    seq=os.read(fd,2)
    if seq==b"[A" and history:
     hist_idx=max(0,hist_idx-1);buf=bytearray(history[hist_idx].encode("utf-8"));redraw()
    elif seq==b"[B":
     hist_idx=min(len(history),hist_idx+1);buf=bytearray((history[hist_idx] if hist_idx<len(history) else "").encode("utf-8"));redraw()
    continue
   if ch==b"\t":
    prefix=buf.decode("utf-8","replace");matches=[n for n in names if n.startswith(prefix)]
    if len(matches)==1:buf.extend(matches[0][len(prefix):].encode("utf-8"));redraw()
    elif matches:sys.stdout.write("\r\n"+"  ".join(safe_text(x) for x in matches[:12])+"\r\n");redraw()
    continue
   if ch>=b" ":buf.extend(ch);redraw()
  value=buf.decode("utf-8","replace").strip()
  if value and (not history or history[-1]!=value):history.append(value);history[:]=history[-100:]
  return value
 finally:termios.tcsetattr(fd,termios.TCSADRAIN,old)

