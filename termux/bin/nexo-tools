      var target = acc, b = el("button", "", p);
      b.type = "button";
      b.onclick = function () { go(target); };
      box.appendChild(b);
    });
  }

  function chips() {
    var box = $("types");
    box.textContent = "";
    var keys = Object.keys(extCounts).sort(function (a, b) { return extCounts[b] - extCounts[a] || a.localeCompare(b); });
    if (keys.length < 2) return;
    keys.forEach(function (k) {
      var c = el("button", "chip" + (extFilter === k ? " on" : ""), (k === "" ? "(sin ext.)" : k) + " · " + extCounts[k]);
      c.type = "button";
      c.onclick = function () { extFilter = extFilter === k ? null : k; render(); };
      box.appendChild(c);
    });
  }

  function visible() {
    var f = $("filter").value.trim().toLowerCase(), showHidden = $("hidden").checked, key = $("sort").value;
    var out = entries.filter(function (e) {
      if (!showHidden && e.name.charAt(0) === ".") return false;
      if (extFilter !== null && e.kind !== "directory" && ext(e.name) !== extFilter) return false;
      if (f) {
        if (f.charAt(0) === "." && f.indexOf("/") < 0 && f.length > 1) { if (e.kind !== "directory" && ext(e.name) !== f) return false; }
        else if (e.name.toLowerCase().indexOf(f) < 0) return false;
      }
      return true;
    });
    out.sort(function (a, b) {
      var da = a.kind === "directory" ? 0 : 1, db = b.kind === "directory" ? 0 : 1;
      if (da !== db) return da - db;
      if (key === "size") return (b.size || 0) - (a.size || 0);
      if (key === "mtime") return (b.mtime || 0) - (a.mtime || 0);
      return a.name.toLowerCase() < b.name.toLowerCase() ? -1 : a.name.toLowerCase() > b.name.toLowerCase() ? 1 : 0;
    });
    return out;
  }

  function button(label, fn) { var b = el("button", "", label); b.type = "button"; b.onclick = fn; return b; }

  function ticket(e, inline) {
    return api("/api/ticket", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ path: e.path, inline: !!inline }) }).then(function (d) { return d.url; });
  }

  function view(e) {
    var x = ext(e.name).slice(1), kind = IMG.test(x) ? "img" : VID.test(x) ? "video" : AUD.test(x) ? "audio" : TXT.test(x) ? "text" : "";
    if (!kind) return download(e);
    ticket(e, true).then(function (url) {
      var body = $("vbody");
      body.textContent = "";
      $("vtitle").textContent = e.name;
      if (kind === "text") {
        return fetch(url, { headers: { "Range": "bytes=0-1048575" } }).then(function (r) { return r.text(); }).then(function (t) {
          var pre = el("pre", "", t);
          body.appendChild(pre);
          $("viewer").showModal();
        });
      }
      var m = el(kind === "img" ? "img" : kind);
      if (kind !== "img") m.controls = true;
      m.src = url;
      body.appendChild(m);
      $("viewer").showModal();
    }).catch(function (err) { say("No se pudo abrir: " + err.message, true); });
  }

  function download(e) {
    ticket(e, false).then(function (url) {
      var a = document.createElement("a");
      a.href = url; a.download = e.name; a.rel = "noopener";
      document.body.appendChild(a); a.click(); a.remove();
    }).catch(function (err) { say("No se pudo descargar: " + err.message, true); });
  }

  function post(url, body) {
    return api(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
  }
  function join(dir, name) { return dir ? dir + "/" + name : name; }

  function rename(e) {
    var to = prompt("Nuevo nombre para «" + e.name + "»:", e.name);
    if (!to || to === e.name) return;
    post("/api/rename", { path: e.path, to: join(cwd, to) }).then(function () { go(cwd); }).catch(function (err) { say("No se pudo renombrar: " + err.message, true); });
  }
  function remove(e) {
    if (!confirm("¿Mover «" + e.name + "» a la papelera (.nexo-trash) del dispositivo?")) return;
    post("/api/delete", { path: e.path }).then(function () { go(cwd); }).catch(function (err) { say("No se pudo borrar: " + err.message, true); });
  }

  function render() {
    crumbs(); chips();
    var list = $("list");
    list.textContent = "";
    var rows = visible();
    rows.forEach(function (e) {
      var li = el("li");
      li.appendChild(el("span", "ico", icon(e)));
      var name = el("button", "name", e.name);
      name.type = "button";
      name.title = e.name;
      name.onclick = function () { if (e.kind === "directory") go(e.path); else if (e.kind === "file" || e.downloadable) view(e); };
      li.appendChild(name);
      li.appendChild(el("span", "meta", e.kind === "directory" ? "" : fmtSize(e.size)));
      li.appendChild(el("span", "meta date", fmtDate(e.mtime)));
      var acts = el("span", "acts");
      if (e.kind === "file" || (e.kind === "symlink" && e.downloadable)) acts.appendChild(button("Descargar", function () { download(e); }));
      if (role === "rw" && e.kind !== "special") {
        acts.appendChild(button("Renombrar", function () { rename(e); }));
        acts.appendChild(button("Borrar", function () { remove(e); }));
      }
      li.appendChild(acts);
      list.appendChild(li);
    });
    if (!rows.length) list.appendChild(el("li", "muted", entries.length ? "Nada coincide con el filtro." : "Carpeta vacía."));
  }

  function upload(files) {
    var list = Array.prototype.slice.call(files), done = 0, fail = 0, errs = [];
    function next() {
      if (!list.length) {
        return go(cwd).then(function () {          // go() limpia el aviso: el resultado se dice DESPUÉS de recargar la carpeta
          say("Subida terminada: " + done + " correctos, " + fail + " con error." + (errs.length ? " " + errs.slice(0, 3).join(" · ") : ""), fail > 0);
        });
      }
      var f = list.shift();
      say("Subiendo " + f.name + " (" + (done + fail + 1) + "/" + (done + fail + 1 + list.length) + ")…");
      return api("/api/upload?path=" + q(join(cwd, f.name)) + "&overwrite=0", { method: "PUT", body: f }).then(function () { done++; }, function (e) { fail++; errs.push("«" + f.name + "»: " + e.message); say(errs[errs.length - 1], true); }).then(next);
    }
    next();
  }

  function logout() {
    token = "";
    try { sessionStorage.removeItem("nexo-tools-token"); } catch (e) { /* sin almacenamiento */ }
    $("app").hidden = true; $("login").hidden = false; $("logout").hidden = true; $("role").hidden = true;
  }

  function enter(tok, silent) {
    token = tok;
    return api("/api/ping").then(function (p) {
      role = p.role || "ro";
      $("dev").textContent = "NEXO-TOOLS · " + (p.device || "dispositivo");
      var b = $("role");
      b.hidden = false;
      b.textContent = role === "rw" ? "lectura y escritura" : "solo lectura";
      b.className = "badge" + (role === "rw" ? " rw" : "");
      $("rwbar").hidden = role !== "rw";
      $("login").hidden = true; $("app").hidden = false; $("logout").hidden = false;
      try { sessionStorage.setItem("nexo-tools-token", tok); } catch (e) { /* sin almacenamiento */ }
      return go("");
    }).catch(function (e) {
      token = "";
      if (!silent) $("loginerr").textContent = e.status === 401 ? "Token incorrecto." : e.status === 429 ? "Demasiados intentos; espera un minuto." : "No se pudo conectar: " + e.message;
    });
  }

  $("login").onsubmit = function (ev) { ev.preventDefault(); $("loginerr").textContent = ""; enter($("token").value.trim(), false); };
  $("logout").onclick = logout;
  $("filter").oninput = render; $("sort").onchange = render; $("hidden").onchange = render;
  $("vclose").onclick = function () { $("viewer").close(); };
  $("viewer").addEventListener("close", function () { $("vbody").textContent = ""; });
  $("upload").onchange = function (ev) { if (ev.target.files.length) upload(ev.target.files); ev.target.value = ""; };
  $("mkdir").onclick = function () {
    var n = prompt("Nombre de la carpeta nueva:");
    if (!n) return;
    post("/api/mkdir", { path: join(cwd, n) }).then(function () { go(cwd); }).catch(function (e) { say("No se pudo crear: " + e.message, true); });
  };

  var h = location.hash.match(/^#t=([0-9a-fA-F]+)$/), saved = "";
  try { saved = sessionStorage.getItem("nexo-tools-token") || ""; } catch (e) { saved = ""; }
  if (h) { history.replaceState(null, "", location.pathname); enter(h[1], false); }
  else if (saved) enter(saved, true);
})();
"""

class NexoHTTPServer(ThreadingHTTPServer):
    request_queue_size=64
    daemon_threads=True
    def get_request(self):
        sock,addr=self.socket.accept()      # el TLS se negocia en el hilo de la conexión: un cliente lento no frena al resto
        return sock,addr
    def process_request_thread(self,request,client_address):
        try:
            request.settimeout(20)
            try: request.setsockopt(socket.IPPROTO_TCP,socket.TCP_NODELAY,1)     # sin esto, Nagle + ACK retardado frenan ~40 ms cada archivo pequeño
            except OSError: pass
            request=SSL_CTX.wrap_socket(request,server_side=True)
        except Exception:
            try: request.close()
            except Exception: pass
            return
        ThreadingHTTPServer.process_request_thread(self,request,client_address)
    def handle_error(self,request,client_address):
        e=sys.exc_info()[1]
        if isinstance(e,OSError): return          # clientes que cortan, TLS roto o tiempos de espera: es normal en una red
        audit("error interno atendiendo a %s: %r"%(client_address[0],e))

class Handler(BaseHTTPRequestHandler):
    server_version="NEXO-TOOLS/"+VERSION
    protocol_version="HTTP/1.1"
    timeout=120
    def log_message(self,*args): pass
    def security_headers(self,csp=None):
        self.send_header("X-Content-Type-Options","nosniff")
        self.send_header("Content-Security-Policy",csp or "default-src 'none'; frame-ancestors 'none'")
        self.send_header("X-Frame-Options","DENY")
        self.send_header("Referrer-Policy","no-referrer")
    def reply(self,code,obj,extra=None):
        body=json.dumps(obj,ensure_ascii=True,separators=(",",":")).encode("ascii")
        self.send_response(code); self.send_header("Content-Type","application/json; charset=utf-8")
        self.send_header("Content-Length",str(len(body))); self.send_header("Cache-Control","no-store")
        self.security_headers()
        for k,v in (extra or {}).items(): self.send_header(k,str(v))
        self.end_headers(); self.wfile.write(body)
    def current_token(self):
        try: return token_path.read_text(encoding="ascii").strip()
        except Exception: return ""
    def role(self):
        value=self.headers.get("Authorization","")
        supplied=value[7:].strip() if value.startswith("Bearer ") else ""
        return role_for_token(supplied,self.current_token())
    def require_role(self):
        r=self.role()
        if r is not None: return r
        retry=self.auth_limited()
        if retry: self.reply(429,{"error":"rate_limited","message":"Demasiados intentos fallidos"},{"Retry-After":retry})
        else: self.reply(401,{"error":"unauthorized","message":"Token incorrecto"})
        return None
    def rate_blocked(self):
        ip=self.client_address[0]; now=time.monotonic()
        with AUTH_LOCK:
            q=AUTH_FAILS.get(ip)
            if not q: return 0
            while q and now-q[0]>60: q.popleft()
            return max(1,int(60-(now-q[0]))) if len(q)>=10 else 0
    def auth_limited(self):
        ip=self.client_address[0]; now=time.monotonic()
        with AUTH_LOCK:
            q=AUTH_FAILS.setdefault(ip,deque())
            while q and now-q[0]>60: q.popleft()
            if len(q)>=10: return max(1,int(60-(now-q[0])))
            q.append(now)
            if len(AUTH_FAILS)>4096:
                for old,items in list(AUTH_FAILS.items()):
                    while items and now-items[0]>60: items.popleft()
                    if not items: AUTH_FAILS.pop(old,None)
            return 0
    def do_GET(self):
        parsed=urllib.parse.urlsplit(self.path)
        if parsed.path in ("/","/ui","/ui.js","/ui.css"): self.serve_ui(parsed.path); return
        if parsed.path.startswith("/api/dl/"): self.serve_ticket(parsed); return
        if parsed.path not in ("/api/ping","/api/list","/api/download"):
            self.reply(404,{"error":"not_found","message":"Ruta no encontrada"}); return
        role=self.require_role()
        if role is None: return
        q=urllib.parse.parse_qs(parsed.query,keep_blank_values=True,encoding="utf-8",errors="surrogateescape")
        if parsed.path=="/api/ping":
            self.reply(200,self.ping_body(role)); return
        raw=q.get("path",[""])[0]
        try:
            if parsed.path=="/api/download" and has_symlink_component(raw):
                if not ALLOW_SYMLINK:
                    self.reply(403,{"error":"symlink_disabled","message":"La descarga de enlaces simbólicos está desactivada; usa rsync-pull."}); return
                lexical=root.joinpath(*(raw.split("/") if raw else []))
                if not lexical.exists():
                    self.reply(404,{"error":"symlink_dangling","message":"El enlace simbólico está roto."}); return
                real=Path(os.path.realpath(lexical))
                if not inside(real):
                    self.reply(403,{"error":"symlink_escape","message":"El enlace simbólico sale de la carpeta compartida."}); return
            p=resolve_rel(raw)
            if parsed.path=="/api/download" and not allowed_rel(rel_of(p)): raise FileNotFoundError(raw)
            if parsed.path=="/api/list" and not nav_rel(rel_of(p)): raise FileNotFoundError(raw)
        except FileNotFoundError:
            self.reply(404,{"error":"not_found","message":"La ruta no existe o el enlace está roto."}); return
        except (ValueError,OSError) as e:
            self.reply(400,{"error":"bad_path","message":str(e)}); return
        if parsed.path=="/api/list":
            if not p.is_dir(): self.reply(400,{"error":"not_directory","message":"La ruta no es una carpeta"}); return
            try:
                items=[]; skipped=0; seen=0; counts={}
                pats=[x.strip().casefold() for x in q.get("glob",[""])[0].split("|") if x.strip()]
                exts=set()
                for x in q.get("ext",[""])[0].split(","):
                    x=x.strip().lower()
                    if x=="(none)": exts.add("")
                    elif x: exts.add(x if x.startswith(".") else "."+x)
                match_dirs=q.get("dirs",["all"])[0]=="match"
                with os.scandir(p) as it:
                    for item in it:
                        try:
                            name=item.name
                            if "\x00" in name:
                                skipped+=1; continue
                            if denied(item.path): continue
                            st=item.stat(follow_symlinks=False)
                            rel=os.path.relpath(item.path,root).replace(os.sep,"/")
                            if not (allowed_rel(rel) or nav_rel(rel)): continue
                            if stat.S_ISLNK(st.st_mode):
                                try: target=os.readlink(item.path)
                                except OSError: target=""
                                resolved=os.path.realpath(item.path)
                                downloadable=False; size=0; mt=st.st_mtime
                                if ALLOW_SYMLINK and os.path.exists(item.path) and inside(resolved):
                                    try:
                                        target_st=os.stat(item.path)
                                        downloadable=stat.S_ISREG(target_st.st_mode)
                                        if downloadable: size=target_st.st_size; mt=target_st.st_mtime
                                    except OSError: pass
                                value={"name":name,"path":rel,"kind":"symlink","target":target,"downloadable":downloadable,"size":size,"mtime":int(mt)}
                            elif stat.S_ISDIR(st.st_mode):
                                value={"name":name,"path":rel,"kind":"directory","size":0,"mtime":int(st.st_mtime)}
                            elif stat.S_ISREG(st.st_mode):
                                value={"name":name,"path":rel,"kind":"file","size":st.st_size,"mtime":int(st.st_mtime),"mtime_ns":st.st_mtime_ns,"downloadable":True}
                            else:
                                subtype="fifo" if stat.S_ISFIFO(st.st_mode) else "socket" if stat.S_ISSOCK(st.st_mode) else "char" if stat.S_ISCHR(st.st_mode) else "block" if stat.S_ISBLK(st.st_mode) else "unknown"
                                value={"name":name,"path":rel,"kind":"special","special_type":subtype,"downloadable":False,"size":0,"mtime":int(st.st_mtime)}
                            suffix=Path(name).suffix.lower()
                            if value["kind"] in ("file","symlink") and (suffix in counts or len(counts)<300): counts[suffix]=counts.get(suffix,0)+1
                            is_dir=value["kind"]=="directory"
                            if pats and (not is_dir or match_dirs) and not any(fnmatch.fnmatchcase(name.casefold(),pt) for pt in pats): continue
                            if exts and not is_dir and suffix not in exts: continue
                            seen+=1
                            if len(items)<MAX_LIST: items.append(value)
                        except (OSError,ValueError): skipped+=1
            except OSError as e:
                code,kind,msg=api_error_for_oserror(e); self.reply(code,{"error":kind,"message":msg}); return
            items.sort(key=lambda x:(x["kind"]!="directory",str(x["name"]).casefold()))
            truncated=seen>MAX_LIST
            total=seen
            try: offset=max(0,int(q.get("offset",["0"])[0] or 0)); limit=max(1,min(10000,int(q.get("limit",["2000"])[0] or 2000)))
            except ValueError: self.reply(400,{"error":"bad_pagination","message":"offset/limit no válidos"}); return
            page=items[offset:offset+limit]
            rel=p.relative_to(root).as_posix() if p!=root else ""; parent=rel.rsplit("/",1)[0] if "/" in rel else ""
            self.reply(200,{"cwd":"/"+rel if rel else "/","parent":parent,"entries":page,"offset":offset,"limit":limit,"total":total,"has_more":offset+limit<total,"truncated":truncated,"skipped":skipped,"ext_counts":counts,"selection":only_list() is not None}); return
        if not DOWNLOAD_SLOTS.acquire(blocking=False):
            self.reply(503,{"error":"busy","message":"Hay demasiadas descargas simultáneas"},{"Retry-After":5}); return
        try: self.serve_file(p)
        finally: DOWNLOAD_SLOTS.release()
    def serve_file(self,p,inline=False):
        try:
            try:
                path_stat=p.stat()
            except OSError as exc:
                code,kind,msg=api_error_for_oserror(exc); self.reply(code,{"error":kind,"message":msg}); return
            if not stat.S_ISREG(path_stat.st_mode):
                self.reply(403,{"error":"unsupported_file","message":"Solo se pueden descargar archivos regulares; los objetos especiales se omiten."}); return
            with p.open("rb") as f:
                st=os.fstat(f.fileno()); pst=p.stat()
                if not same_stat(st,pst): self.reply(409,{"error":"file_changed","message":"El archivo cambió; inténtalo otra vez"}); return
                size=st.st_size
                if MAX_FILE_BYTES and size>MAX_FILE_BYTES:
                    self.reply(413,{"error":"file_too_large","message":f"El archivo de {size} bytes supera el límite de {MAX_FILE_BYTES} bytes."}); return
                digest=None
                if not HASH_SKIP_ABOVE or size<=HASH_SKIP_ABOVE:
                    digest=digest_file(p,f,st)
                    etag='"'+digest+'"'
                else:
                    etag=f'W/"{size}-{st.st_mtime_ns}"'
                st2=os.fstat(f.fileno()); pst2=p.stat()
                if not same_stat(st,st2) or not same_stat(st,pst2): self.reply(409,{"error":"file_changed","message":"El archivo cambió durante la preparación"}); return
                inm=self.headers.get("If-None-Match","").strip()
                if inm and inm==etag:
                    self.send_response(304); self.send_header("ETag",etag); self.send_header("Content-Length","0"); self.send_header("Cache-Control","no-store"); self.security_headers(); self.end_headers(); return
                start=0; status=200; rng=self.headers.get("Range","")
                if rng:
                    if not rng.startswith("bytes=") or "," in rng:
                        self.reply(416,{"error":"bad_range","message":"Rango no válido"}); return
                    spec=rng[6:].split("-",1); raw_start=spec[0]; raw_end=spec[1] if len(spec)>1 else ""
                    if not raw_start.isdigit() or (raw_end and not raw_end.isdigit()):
                        self.reply(416,{"error":"bad_range","message":"Rango no válido"}); return
                    start=int(raw_start); end=int(raw_end) if raw_end else size-1
                    if start<0 or end<start or start>=size:
                        self.send_response(416); self.send_header("Content-Range",f"bytes */{size}"); self.send_header("Content-Length","0"); self.security_headers(); self.end_headers(); return
                    end=min(end,size-1); status=206
                else: end=size-1
                length=max(0,end-start+1)
                st3=os.fstat(f.fileno()); pst3=p.stat()
                if not same_stat(st,st3) or not same_stat(st,pst3): self.reply(409,{"error":"file_changed","message":"El archivo cambió antes de la descarga"}); return
                ext=p.suffix.lower(); content_type="application/octet-stream" if ext in ACTIVE_EXTS else (mimetypes.guess_type(p.name)[0] or "application/octet-stream")
                disposition="attachment"
                if inline:
                    safe_ct=inline_type(p,content_type)
                    if safe_ct: content_type=safe_ct; disposition="inline"
                self.send_response(status); self.send_header("Content-Type",content_type)
                self.send_header("Content-Length",str(length)); self.send_header("Accept-Ranges","bytes"); self.send_header("ETag",etag)
                if digest: self.send_header("X-Nexo-SHA256",digest)
                safe_name=urllib.parse.quote_from_bytes(os.fsencode(p.name),safe="")
                self.send_header("Content-Disposition",f"{disposition}; filename*=UTF-8''{safe_name}")
                if status==206: self.send_header("Content-Range",f"bytes {start}-{end}/{size}")
                self.send_header("Cache-Control","no-store"); self.security_headers(); self.end_headers(); self.wfile.flush()
                f.seek(start); sent=0; began=time.monotonic(); chunk_size=1024*1024 if size>16*1024*1024 else 256*1024
                while sent<length:
                    block=f.read(min(chunk_size,length-sent))
                    if not block: break
                    self.wfile.write(block); sent+=len(block)
                    if BWLIMIT:
                        delay=sent/BWLIMIT-(time.monotonic()-began)
                        if delay>0: time.sleep(delay)
                if length>0 and sent>=length: audit("descarga %s (%d bytes) a %s"%(rel_of(p),sent,self.client_address[0]))
                st_after=os.fstat(f.fileno())
                try: path_after=p.stat()
                except OSError: path_after=None
                if not same_stat(st,st_after) or path_after is None or not same_stat(st,path_after):
                    self.close_connection=True
        except (BrokenPipeError,ConnectionResetError): pass
        except OSError as e:
            code,kind,msg=api_error_for_oserror(e)
            try: self.reply(code,{"error":kind,"message":msg})
            except Exception: self.close_connection=True
    def ping_body(self,role):
        feats=["list","download","pair","ticket","web"]+(["write"] if role=="rw" else [])
        return {"name":"NEXO-TOOLS","version":VERSION,"protocol":2,"device":DEVICE,"id":FP[:16],"role":role,"rw":role=="rw","selection":only_list() is not None,"features":feats}
    def serve_ui(self,path):
        if path=="/":
            self.send_response(302); self.send_header("Location","/ui"); self.send_header("Content-Length","0"); self.security_headers(); self.end_headers(); return
        body,ctype={"/ui":(UI_HTML,"text/html; charset=utf-8"),"/ui.js":(UI_JS,"application/javascript; charset=utf-8"),"/ui.css":(UI_CSS,"text/css; charset=utf-8")}[path]
        data=body.encode("utf-8")
        self.send_response(200); self.send_header("Content-Type",ctype); self.send_header("Content-Length",str(len(data))); self.send_header("Cache-Control","no-store")
        self.security_headers(UI_CSP); self.end_headers(); self.wfile.write(data)
    def check_download(self,raw):
        try:
            if has_symlink_component(raw):
                if not ALLOW_SYMLINK: return None,(403,{"error":"symlink_disabled","message":"La descarga de enlaces simbólicos está desactivada; usa rsync-pull."})
                lexical=root.joinpath(*(raw.split("/") if raw else []))
                if not lexical.exists(): return None,(404,{"error":"symlink_dangling","message":"El enlace simbólico está roto."})
                if not inside(Path(os.path.realpath(lexical))): return None,(403,{"error":"symlink_escape","message":"El enlace simbólico sale de la carpeta compartida."})
            p=resolve_rel(raw)
            if not allowed_rel(rel_of(p)): raise FileNotFoundError(raw)
            return p,None
        except FileNotFoundError: return None,(404,{"error":"not_found","message":"La ruta no existe o el enlace está roto."})
        except (ValueError,OSError) as e: return None,(400,{"error":"bad_path","message":str(e)})
    def serve_ticket(self,parsed):
        tid=parsed.path[len("/api/dl/"):]
        with TICKET_LOCK:
            rec=TICKETS.get(tid)
            if rec is not None and rec[1]<time.time(): TICKETS.pop(tid,None); rec=None
        if rec is None:
            self.reply(404,{"error":"ticket_invalid","message":"El enlace de descarga caducó; vuelve a pedirlo."}); return
        p,err=self.check_download(rec[0])
        if err: self.reply(*err); return
        if not DOWNLOAD_SLOTS.acquire(blocking=False):
            self.reply(503,{"error":"busy","message":"Hay demasiadas descargas simultáneas"},{"Retry-After":5}); return
        try: self.serve_file(p,inline=rec[2])
        finally: DOWNLOAD_SLOTS.release()
    def read_json(self,limit=16384):
        try: n=int(self.headers.get("Content-Length","0"))
        except ValueError: n=-1
        if n<0 or n>limit:
            self.close_connection=True; self.reply(413,{"error":"too_large","message":"Petición demasiado grande"}); return None
        raw=self.rfile.read(n) if n else b""
        try: obj=json.loads(raw.decode("utf-8"))
        except Exception:
            self.reply(400,{"error":"bad_json","message":"JSON no válido"}); return None
        if not isinstance(obj,dict):
            self.reply(400,{"error":"bad_json","message":"Se esperaba un objeto JSON"}); return None
        return obj
    def handle_pair(self):
        retry=self.rate_blocked()
        if retry:
            self.close_connection=True
            self.reply(429,{"error":"rate_limited","message":"Demasiados intentos fallidos"},{"Retry-After":retry}); return
        body=self.read_json(4096)
        if body is None: self.close_connection=True; return
        nc=str(body.get("nc","")).lower(); proof=str(body.get("proof","")).lower()
        cname="".join(c for c in str(body.get("name","")) if c.isprintable())[:40] or "dispositivo"
        if not (8<=len(nc)<=64) or any(c not in "0123456789abcdef" for c in nc):
            self.reply(400,{"error":"bad_request","message":"Petición de emparejamiento no válida"}); return
        ip=self.client_address[0]
        with PAIR_LOCK:
            st=pair_state()
            if st is None:
                self.reply(403,{"error":"no_pairing","message":"Este dispositivo no tiene un código de emparejamiento activo. En él ejecuta: nexo-tools pair"}); return
            secret=norm_code(st["secret"]).encode("ascii")
            expected=hmac.new(secret,b"nexo-pair-c|"+nc.encode("ascii")+b"|"+FP.encode("ascii"),hashlib.sha256).hexdigest()
            if not hmac.compare_digest(expected,proof):
                st["fails"]=int(st.get("fails",0))+1
                if st["fails"]>=5:
                    try: PAIR_PATH.unlink()
                    except OSError: pass
                    audit("emparejamiento: código invalidado tras 5 intentos fallidos (último desde %s)"%ip)
                else: write_json_atomic(PAIR_PATH,st); audit("emparejamiento rechazado desde %s: código incorrecto"%ip)
                self.auth_limited()
                self.reply(403,{"error":"bad_code","message":"Código incorrecto"}); return
            role="rw" if (st.get("role")=="rw" and RW and only_list() is None) else "ro"
            token=os.urandom(24).hex(); pid=os.urandom(6).hex()
            peers=dict(peers_load())
            peers[pid]={"name":cname,"hash":hashlib.sha256(token.encode("ascii")).hexdigest(),"role":role,"created":int(time.time()),"ip":ip}
            write_json_atomic(PEERS_PATH,peers)
            uses=int(st.get("uses",0))+1
            if uses>=int(st.get("max",1)):
                try: PAIR_PATH.unlink()
                except OSError: pass
            else:
                st["uses"]=uses; write_json_atomic(PAIR_PATH,st)
        sproof=hmac.new(secret,b"nexo-pair-s|"+nc.encode("ascii")+b"|"+FP.encode("ascii")+b"|"+token.encode("ascii"),hashlib.sha256).hexdigest()
        audit("emparejado «%s» (%s) desde %s con permiso %s"%(cname,pid,ip,role))
        self.reply(200,{"token":token,"role":role,"id":pid,"device":DEVICE,"server_id":FP[:16],"proof":sproof})
    def op_ticket(self,body):
        raw=str(body.get("path","")); p,err=self.check_download(raw)
        if err: self.reply(*err); return
        self.reply(200,{"url":"/api/dl/"+new_ticket(raw,bool(body.get("inline"))),"expires_in":600})
    def op_mkdir(self,body):
        parent,name=split_new(str(body.get("path","")))
        (parent/name).mkdir()
        audit("mkdir %s"%rel_of(parent/name)); self.reply(200,{"created":rel_of(parent/name)})
    def op_rename(self,body):
        parent,name,lex=resolve_entry(str(body.get("path","")))
        dparent,dname=split_new(str(body.get("to","")))
        dst=dparent/dname
        if lex==root or rel_of(parent/name)==".nexo-trash": raise ValueError("no se puede renombrar eso")
        if os.path.lexists(dst): raise FileExistsError(str(body.get("to","")))
        os.rename(lex,dst)
        audit("rename %s -> %s"%(rel_of(parent/name),rel_of(dst))); self.reply(200,{"renamed":rel_of(dst)})
    def op_delete(self,body):
        parent,name,lex=resolve_entry(str(body.get("path","")))
        rel=rel_of(parent/name)
        if rel==".nexo-trash" or rel.startswith(".nexo-trash/"): raise ValueError("la papelera solo se vacía desde el propio dispositivo")
        stamp=time.strftime("%Y%m%d-%H%M%S")+"-"+os.urandom(2).hex()
        dest=root/".nexo-trash"/stamp/rel
        dest.parent.mkdir(parents=True,exist_ok=True)
        os.rename(lex,dest)
        audit("delete %s -> .nexo-trash/%s"%(rel,stamp)); self.reply(200,{"trashed":rel,"to":".nexo-trash/%s/%s"%(stamp,rel)})
    def do_POST(self):
        parsed=urllib.parse.urlsplit(self.path); path=parsed.path
        if path=="/api/pair": self.handle_pair(); return
        if path not in ("/api/ticket","/api/mkdir","/api/rename","/api/delete"):
            self.close_connection=True; self.reply(404,{"error":"not_found","message":"Ruta no encontrada"}); return
        role=self.require_role()
        if role is None: self.close_connection=True; return
        if path!="/api/ticket" and role!="rw":
            self.close_connection=True; self.reply(403,{"error":"read_only","message":"Este dispositivo te dejó en solo lectura."}); return
        body=self.read_json()
        if body is None: return
        try:
            {"/api/ticket":self.op_ticket,"/api/mkdir":self.op_mkdir,"/api/rename":self.op_rename,"/api/delete":self.op_delete}[path](body)
        except FileNotFoundError: self.reply(404,{"error":"not_found","message":"La ruta no existe"})
        except FileExistsError: self.reply(409,{"error":"exists","message":"Ya existe algo con ese nombre"})
        except ValueError as e: self.reply(400,{"error":"bad_path","message":str(e)})
        except OSError as e:
            code,kind,msg=write_error(e); self.reply(code,{"error":kind,"message":msg})
    def do_PUT(self):
        parsed=urllib.parse.urlsplit(self.path)
        if parsed.path!="/api/upload":
            self.close_connection=True; self.reply(404,{"error":"not_found","message":"Ruta no encontrada"}); return
        role=self.require_role()
        if role is None: self.close_connection=True; return
        if role!="rw":
            self.close_connection=True; self.reply(403,{"error":"read_only","message":"Este dispositivo te dejó en solo lectura."}); return
        q=urllib.parse.parse_qs(parsed.query,keep_blank_values=True,encoding="utf-8",errors="surrogateescape")
        overwrite=q.get("overwrite",["0"])[0]=="1"
        try:
            parent,name=split_new(q.get("path",[""])[0]); target=parent/name
        except FileNotFoundError:
            self.close_connection=True; self.reply(404,{"error":"not_found","message":"La carpeta de destino no existe"}); return
        except ValueError as e:
            self.close_connection=True; self.reply(400,{"error":"bad_path","message":str(e)}); return
        try: length=int(self.headers.get("Content-Length",""))
        except ValueError: length=-1
        if length<0 or self.headers.get("Transfer-Encoding"):
            self.close_connection=True; self.reply(411,{"error":"length_required","message":"Falta Content-Length"}); return
        if MAX_UPLOAD and length>MAX_UPLOAD:
            self.close_connection=True; self.reply(413,{"error":"file_too_large","message":"El archivo supera el límite de %d bytes."%MAX_UPLOAD}); return
        if os.path.lexists(target) and (not overwrite or target.is_dir() or target.is_symlink()):
            self.close_connection=True; self.reply(409,{"error":"exists","message":"Ya existe algo con ese nombre"}); return
        tmp=parent/(".%s.nexo-up-%s"%(name[:80],os.urandom(4).hex()))
        h=hashlib.sha256(); got=0
        try:
            with open(tmp,"wb") as f:
                while got<length:
                    block=self.rfile.read(min(1<<20,length-got))
                    if not block: raise ConnectionError("cuerpo incompleto")
                    f.write(block); h.update(block); got+=len(block)
            want=self.headers.get("X-Nexo-SHA256","").strip().lower()
            if want and want!=h.hexdigest():
                os.unlink(tmp); self.close_connection=True
                self.reply(422,{"error":"checksum_mismatch","message":"La suma SHA-256 no coincide; el archivo no se guardó."}); return
            if overwrite: os.replace(tmp,target)
            else:
                try: os.link(tmp,target); os.unlink(tmp)
                except FileExistsError:
                    os.unlink(tmp); self.reply(409,{"error":"exists","message":"Ya existe algo con ese nombre"}); return
                except OSError:
                    if os.path.lexists(target): os.unlink(tmp); self.reply(409,{"error":"exists","message":"Ya existe algo con ese nombre"}); return
                    os.rename(tmp,target)       # sistemas de archivos sin enlaces duros (FAT, almacenamiento compartido)
        except (ConnectionError,OSError) as e:
            try: os.unlink(tmp)
            except OSError: pass
            self.close_connection=True
            if isinstance(e,ConnectionError) or isinstance(e,TimeoutError): return
            code,kind,msg=write_error(e); self.reply(code,{"error":kind,"message":msg}); return
        audit("upload %s (%d bytes)"%(rel_of(target),got))
        self.reply(200,{"saved":rel_of(target),"size":got,"sha256":h.hexdigest()})

httpd=NexoHTTPServer((bind_ip,port),Handler)
ctx=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); ctx.minimum_version=ssl.TLSVersion.TLSv1_2
ctx.set_ciphers("ECDHE+AESGCM:ECDHE+CHACHA20:!aNULL:!MD5:!DSS")
ctx.load_cert_chain(certfile=cert,keyfile=key)
SSL_CTX=ctx
if ANNOUNCE: threading.Thread(target=beacon_loop,daemon=True).start()
audit("servidor listo en %s:%d (%s, %s%s)"%(bind_ip,port,DEVICE,"lectura y escritura" if RW else "solo lectura"," · selección" if only_list() is not None else ""))
httpd.serve_forever(poll_interval=0.5)
PY
fi

case "${1:-menu}" in
    --version) printf 'NEXO-TOOLS %s\n' "$NEXO_TOOLS_VERSION"; exit 0 ;;
    --tui|tui) main_menu ;;
    --gui|gui) launch_gui ;;
    --html|html|open-html) shift; open_verified_file "${1:-}" ;;
    open) shift; open_verified_file "${1:-}" ;;
    doctor) shift; doctor "${1:-}" ;;
    help|-h|--help|usage) usage ;;
    install) install_global ;;
    logs) shift; show_logs "${1:-}" ;;
    menu) maybe_first_run_setup || true; if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then launch_gui || main_menu; else main_menu; fi ;;
    receive) shift; url="${1:-}"; [[ $# -gt 0 ]] && shift || true; start_receiver "$url" "$@" ;;
    rotate-cert) rotate_cert ;;
    rotate-token) rotate_token ;;
    rsync-pull) shift; rsync_transfer pull "$@" ;;
    rsync-push) shift; rsync_transfer push "$@" ;;
    server) shift; cmd_server "$@" ;;
    discover) shift; peer_cmd discover "$@" ;;
    connect) shift; peer_cmd connect "$@" ;;
    devices|peers) shift; peer_cmd devices "$@" ;;
    forget) shift; peer_cmd forget "$@" ;;
    browse|explore) shift; cmd_browse "$@" ;;
    ls|get|put|mkdir|mv|rm|info|fetch|authorized|revoke) cmd=$1; shift; peer_cmd "$cmd" "$@" ;;
    send) shift; cmd_send "$@" ;;
    pair) shift; cmd_pair "$@" ;;
    web) shift; cmd_web "$@" ;;
    devices-menu) devices_menu ;;
    setup) setup_environment ;;
    ssh-start) start_ssh_server ;;
    ssh-stop) stop_ssh_server ;;
    status) shift; show_server "${1:-}" ;;
    stop) stop_server ;;
    __detect_ip) discover_ip ;;
    __build_ssh_cmd) shift; build_ssh_cmd "${1:-}" "${2:-}" ;;
    __open_browser|__open_verified_browser) shift; open_verified_in_browser "${1:-}" ;;
    __serve) err "El modo interno del servidor debe despacharse antes del case."; exit 2 ;;
    *) err "Comando desconocido: ${1:-}"; usage; exit 2 ;;
esac
