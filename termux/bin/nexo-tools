    say "  pkg install openssh rsync"
    say "  termux-setup-storage        # si usarás almacenamiento compartido"
    say "  passwd                      # configura la contraseña SSH"
    say "  nexo-tools ssh-start        # configura/inicia el SSH local"
    say "  whoami                      # muestra el usuario que debes escribir"
    say "  nexo wifi status            # consulta su IP Wi-Fi"
    say ""
    say "${C_CYAN}Si el dispositivo remoto usa Ubuntu/Debian:${C_RESET}"
    say "  sudo apt update && sudo apt install openssh-server rsync"
    say "  sudo systemctl enable --now ssh"
    say "  whoami"
    say "  hostname -I"
    say ""
    say "En ambos dispositivos ejecuta: nexo-tools setup"
    say "En el dispositivo que recibirá con rsync, ejecuta: nexo-tools ssh-start"
    say "En el dispositivo que envía/recibe instala también: rsync y openssh."
    say "La primera conexión SSH puede pedir confirmar la huella del equipo remoto."
    say "Usa solo dispositivos y cuentas en los que tengas autorización."
    ui_pause
}


launch_gui() {
    require_runtime || return 1
    python3 -c 'import tkinter as t; r=t.Tk(); r.withdraw(); r.destroy()' >/dev/null 2>&1 || { err "No se pudo iniciar Tkinter. Comprueba DISPLAY/Termux:X11 y Tkinter instalado."; return 1; }
    python3 - "$SELF" <<'PYGUI'
import os, re, sys, ssl, json, time, hmac, hashlib, subprocess, threading, http.client, urllib.parse, shlex, concurrent.futures, shutil, unicodedata
from pathlib import Path
import tkinter as tk
from tkinter import ttk, filedialog, simpledialog, messagebox

SCRIPT = os.path.abspath(sys.argv[1])
VERSION = os.environ.get("NEXO_TOOLS_VERSION", "")
STATE = Path(os.environ.get("XDG_STATE_HOME", str(Path.home()/".local/state"))) / "nexo-tools"
ACTIVE_EXTS={x.lower() for x in os.environ.get("NEXO_TOOLS_ACTIVE_EXTS","").split(",") if x}
PASSIVE_EXTS={x.lower() for x in os.environ.get("NEXO_TOOLS_PASSIVE_EXTS","").split(",") if x}
MAX_FILE_BYTES=max(0,int(os.environ.get("NEXO_TOOLS_MAX_FILE_BYTES","0") or 0))

def classify_extension(path):
    ext=Path(str(path)).suffix.lower()
    return "active" if ext in ACTIVE_EXTS else ("passive" if ext in PASSIVE_EXTS else "unknown")

def safe_gui_text(value):
    return "".join("?" if ch in "\n\r\t" or ord(ch)<32 or 0xD800<=ord(ch)<=0xDFFF else ch for ch in str(value))

def gui_file_type(name,kind):
    if kind=="directory":return "Carpeta"
    if kind=="symlink":return "Enlace"
    if kind=="special":return "Especial"
    if kind!="file":return "No compatible"
    ext=Path(name).suffix.lower()
    if ext in (".html",".htm",".xhtml"):return "HTML"
    if ext in (".png",".jpg",".jpeg",".gif",".webp",".bmp",".tiff",".tif",".heic",".avif",".ico"):return "Imagen"
    if ext in (".mp3",".wav",".ogg",".oga",".flac",".m4a",".opus",".aac",".wma"):return "Audio"
    if ext in (".mp4",".mkv",".webm",".mov",".avi",".m4v",".mpg",".mpeg",".3gp"):return "Video"
    if classify_extension(name)=="passive":return "Texto" if ext in (".txt",".md",".markdown",".log",".csv",".tsv",".json",".yaml",".yml",".toml",".ini",".conf",".cfg",".rst",".tex") else "Archivo"
    return "Activo" if classify_extension(name)=="active" else "Desconocido"

class NexoGUI:
    def __init__(self, root):
        self.root = root
        root.title("NEXO-TOOLS · Transferencia local")
        root.update_idletasks()
        screen_w, screen_h = root.winfo_screenwidth(), root.winfo_screenheight()
        win_w, win_h = min(1120, max(820, screen_w - 48)), min(790, max(650, screen_h - 72))
        self.gui_state = STATE / "gui.json"
        try:
            saved=json.loads(self.gui_state.read_text(encoding="utf-8"))
            geometry=saved.get("geometry")
            if isinstance(geometry,str) and re.fullmatch(r"[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+",geometry):
                root.geometry(geometry)
            else: root.geometry(f"{win_w}x{win_h}")
        except Exception: root.geometry(f"{win_w}x{win_h}")
        root.minsize(min(820, win_w), min(650, win_h))
        root.configure(bg="#101923")
        style = ttk.Style(root)
        try: style.theme_use("clam")
        except tk.TclError: pass
        style.configure("TFrame", background="#101923")
        style.configure("Card.TFrame", background="#172533")
        style.configure("Panel.TFrame", background="#172b3a")
        style.configure("TLabel", background="#101923", foreground="#e5eef5", font=("TkDefaultFont", 10))
        style.configure("Title.TLabel", background="#101923", foreground="#55d6be", font=("TkDefaultFont", 20, "bold"))
        style.configure("Sub.TLabel", background="#101923", foreground="#9fb2c3")
        style.configure("Eyebrow.TLabel", background="#172b3a", foreground="#5eead4", font=("TkDefaultFont", 8, "bold"))
        style.configure("Status.TLabel", background="#172b3a", foreground="#e1edf3", font=("TkDefaultFont", 9))
        style.configure("Section.TLabel", background="#101923", foreground="#dce9f0", font=("TkDefaultFont", 10, "bold"))
        style.configure("TButton", padding=(11, 7), font=("TkDefaultFont", 9, "bold"))
        style.configure("Accent.TButton", background="#0f766e", foreground="white")
        style.map("Accent.TButton", background=[("active", "#149487"), ("disabled", "#29424b")], foreground=[("disabled", "#9fb2c3")])
        style.configure("Treeview", background="#172533", foreground="#e5eef5", fieldbackground="#172533", rowheight=27)
        style.configure("Treeview.Heading", background="#203446", foreground="#e5eef5")
        self.status_var = tk.StringVar(value="Preparado · detectando Nexo y red local…")
        self._refreshing = False
        self._build()
        self.refresh_status()

