        last = d;
        all = all.concat(d.entries || []);
        offset += (d.entries || []).length;
        if (d.has_more && d.entries && d.entries.length && offset < 200000) return page();
        return { meta: last, entries: all };
      });
    }
    return page();
  }

  function go(path) {
