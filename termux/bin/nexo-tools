def width(s):
 n=0
 for c in s:
  if unicodedata.combining(c): continue
  n+=2 if unicodedata.east_asian_width(c) in ("W","F") else 1
 return n
def clip(s,maxw):
 s=safe_text(s)
 if width(s)<=maxw:return s
 out=[]; n=0
 for c in s:
  cw=0 if unicodedata.combining(c) else (2 if unicodedata.east_asian_width(c) in ("W","F") else 1)
  if n+cw>max(0,maxw-1):break
  out.append(c);n+=cw
 return "".join(out)+"…"
def pad(s,maxw): s=clip(s,maxw); return s+" "*max(0,maxw-width(s))
def human_size(n):
 v=float(int(n))
 for u in ("B","KiB","MiB","GiB","TiB","PiB"):
  if v<1024 or u=="PiB":return f"{int(v)} {u}" if u=="B" else f"{v:.1f} {u}"
  v/=1024
