    say "${C_BOLD}PREPARAR RSYNC/SSH EN EL DISPOSITIVO QUE RECIBIRÁ${C_RESET}"
    say ""
    say "${C_CYAN}Si el dispositivo remoto también usa Termux:${C_RESET}"
