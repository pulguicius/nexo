UI_JS=r""""use strict";
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var token = "", role = "ro", cwd = "", entries = [], extCounts = {}, extFilter = null, busy = false;
  var IMG = /^(png|jpe?g|gif|webp|bmp|avif|ico)$/, VID = /^(mp4|webm|mov|m4v|ogv)$/, AUD = /^(mp3|wav|ogg|oga|opus|flac|m4a|aac)$/;
  var TXT = /^(txt|md|log|csv|tsv|json|ya?ml|toml|ini|conf|cfg|rst|tex|py|sh|js|c|h|cpp|java|kt|rs|go|css|xml|html?)$/;

  function ext(name) { var i = name.lastIndexOf("."); return i > 0 ? name.slice(i).toLowerCase() : ""; }
  function icon(e) {
    if (e.kind === "directory") return "📁";
    if (e.kind === "symlink") return "🔗";
    if (e.kind === "special") return "⚙️";
    var x = ext(e.name).slice(1);
    if (IMG.test(x)) return "🖼️";
    if (VID.test(x)) return "🎬";
