#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""nexo-usb: los dispositivos USB del móvil dentro de tu distro: adaptadores serie (Arduino, ESP32, CH340, CP210x, FTDI…) y discos
(pendrives, discos duros y SSD).

Es el cuarto programa de Nexo (los otros: el cliente `nexo`, `nexo-dbus` y `nexo-tools`). Una distro de proot no puede abrir
/dev/bus/usb ni montar nada: el USB es de Android. La app Nexo trabaja con las APIs oficiales y este programa se lo enseña a tu distro.

SERIE (la app abre el adaptador con UsbManager, con el permiso que tú das en el aviso de Android):
  · monitor  → un monitor serie en la terminal (como el de Arduino IDE, miniterm o picocom).
  · bridge   → un puerto serie falso (un PTY) para avrdude, arduino-cli, PlatformIO, minicom, screen, pyserial…
               y, si quieres, un servidor RFC2217 (esptool, pyserial: llevan DTR y RTS de verdad)
               y un TCP crudo (avrdude con «net:»).
  · list, permit, status, stop, reset

DISCOS (Android monta el disco por su cuenta; la app entra en él con el Storage Access Framework, en la carpeta que TÚ eliges en el
selector del sistema, y este programa le pide cada operación; si este proceso ya ve la ruta del disco —root, Shizuku—, trabaja directo):
  · mounts, access, ls, stat, cat, get, put, mkdir, rm, mv, df, eject

Solo necesita python3 (3.7 o más) y la biblioteca estándar. Habla con la app por el mismo protocolo que el cliente
(docs/PROTOCOLO.md, revisión 1.4): 127.0.0.1, JSON por línea y token.

Uso:  nexo-usb COMANDO …        (también:  nexo usb COMANDO …; la lista está en «nexo usb help»)
"""

import base64
import collections
import ctypes
import errno
import fcntl
import hashlib
import json
import mimetypes
import os
import re
import select
import shutil
import signal
import socket
import stat as stat_mod
import struct
import sys
import termios
import threading
import time

NEXO_USB_VERSION = "0.4.3"
CLIENT_NAME = "nexo-usb/" + NEXO_USB_VERSION

EXIT_ERR, EXIT_USAGE, EXIT_TOUCH, EXIT_NODEV, EXIT_GONE = 1, 2, 3, 4, 5
EXIT_NOAPP, EXIT_TOKEN, EXIT_TIMEOUT = 10, 11, 12

HELP = """nexo usb — los dispositivos USB del móvil dentro de tu distro: adaptadores serie (Arduino, ESP32, CH340, CP210x, FTDI…) y discos

Uso: nexo usb COMANDO [DISPOSITIVO|RUTA…] [opciones]

SERIE (Arduino, ESP32, adaptadores):
  list [--json|--lsusb|--all]    Lo que Android ve por USB y qué sirve como puerto serie
  permit [DISPOSITIVO]           Pide a Android el permiso para usarlo (sale un aviso en la pantalla del móvil)
  monitor [DISPOSITIVO]          Monitor serie en la terminal (salir: Ctrl+])
  bridge [DISPOSITIVO]           Crea un puerto serie en tu distro para avrdude, arduino-cli, PlatformIO, minicom, screen…
  status [--json]                Puentes que están en marcha
  stop [NOMBRE…|--all]           Cierra puentes
  reset [NOMBRE]                 Reinicia la placa (pulso en DTR) de un puente en marcha

DISCOS (pendrives, discos duros, SSD):
  mounts [--all] [--json] [--wait S]  Los discos que Android montó y si Nexo puede entrar (--all: también el almacenamiento interno)
  access [DISCO] [--revoke]      Android te enseña su selector de carpetas: elige el disco (se pregunta una sola vez)
  ls [-lahR] [RUTA…]             Lista una carpeta del disco        stat RUTA…      Tipo, tamaño y fecha
  cat RUTA…                      Escribe archivos del disco en la salida estándar
  get [-rfn] ORIGEN… DESTINO     Copia del disco a tu distro        put [-rfn] ORIGEN… DESTINO     Copia de tu distro al disco
  mkdir [-p] RUTA…               rm [-rf] RUTA…                     mv [-f] ORIGEN… DESTINO        (todo dentro del mismo disco)
  df [DISCO]                     Espacio total, usado y libre
  eject [DISCO]                  Cierra los archivos abiertos y pide a Android que lo expulse
  version | help

DISPOSITIVO: el id de «nexo usb list», un VID:PID (2341:0043) o parte del nombre o del número de serie.
Sin él se usa el único adaptador serie conectado.

Línea serie (monitor y bridge):  -b|--baud N (115200)  --format 8N1  --bits 5-8  --parity none|odd|even|mark|space  --stop 1|1.5|2

monitor:  --no-reset (no reinicia el Arduino al abrir)  --dtr on|off  --rts on|off  --seconds N  --idle N  --lines N
          --until REGEX (sale al verlo)  --send TEXTO (admite \\n \\r \\t \\xNN)  --eol lf|cr|crlf|none  --hex  -T|--timestamp
          --no-input  --wait (espera a que enchufes el adaptador)  --json (con --until/--seconds: resumen en JSON)

bridge:   --link RUTA (dónde dejar el puerto; por omisión en ~/.local/state/nexo/usb/NOMBRE.tty)  --no-pty
          --rfc2217 [HOST:]PUERTO   servidor RFC2217 (esptool, pyserial, PlatformIO: DTR y RTS de verdad)
          --tcp [HOST:]PUERTO       TCP crudo (avrdude -c arduino -P net:HOST:PUERTO)
          --no-auto-reset           no emula el reinicio del Arduino al abrir el puerto
          --name NOMBRE  -d|--detach (segundo plano)  --no-reconnect (salir si desenchufas)  --wait
          --dtr on|off --rts on|off (estado inicial)  --perm-timeout S (60)  --log ARCHIVO

Discos: una RUTA es de la raíz del disco: «/Música/rock», o con el disco delante: «PENDRIVE:/Música». Sin disco se usa el único
montado (si hay varios: --vol NOMBRE|UUID, o el prefijo NOMBRE:). El DISCO es su UUID, su nombre o el principio de cualquiera.
  Todas:      --vol DISCO  --via app|direct|auto (app = por Nexo; direct = por su ruta, si este proceso la ve; auto lo decide)
              --no-ask (no abrir el selector de Android si falta el acceso)  --timeout S (espera al selector: 120)
  ls:         -l detalle  -a ocultos  -h tamaños legibles  -R recursivo  --json
  get / put:  -r carpetas enteras (un ORIGEN que es carpeta y acaba en «/» copia lo de dentro, no la carpeta: como rsync)
              -f sustituye lo que ya existe  -n salta lo que ya existe  --verify (relee y compara SHA-256)
              -q sin avisos  --json  put además: --fix-names (cambia por «_» lo que el disco no admite: " * : < > ? \\ |)
              Sin -f ni -n, algo que ya existe es un fallo (y se sigue con lo demás). Se escribe a «.nexo-part-…» y se renombra al final.
  rm:         -r carpetas con todo lo que llevan  -f ignora lo que no existe  -v      mv: -f sustituye  -v      mkdir: -p
  eject:      sale con 0 solo si Android lo expulsó: si no, dice cómo hacerlo a mano antes de desenchufar

Códigos de salida: 0 bien · 1 error · 2 uso · 3 hace falta un toque en el móvil (permiso o selector) · 4 no hay dispositivo o disco
                   5 se desenchufó · 10 sin conexión con la app · 11 token · 12 sin respuesta a tiempo
"""


class UsbError(Exception):
    """Un fallo que se le cuenta al usuario tal cual y acaba con un código de salida."""

    def __init__(self, message, code=EXIT_ERR):
        Exception.__init__(self, message)
        self.message = message
        self.code = code


class Transient(UsbError):
    """Un fallo que suele arreglarse solo en un momento (dispositivo ocupado, recién enchufado…)."""


class Stopped(Exception):
    pass


class BridgeError(Exception):
    """La app contestó con ok=false."""

    def __init__(self, code, message="", extra=None):
        Exception.__init__(self, message or code)
        self.code = code
        self.message = message or code
        self.extra = extra or {}


# ----------------------------------------------------------------------------------------------------- utilidades


class Log(object):
    stream = sys.stderr
    stamp = False
    verbose = False
    lock = threading.Lock()


def log(msg):
    line = ("%s %s" % (time.strftime("%H:%M:%S"), msg)) if Log.stamp else msg
    with Log.lock:
        try:
            Log.stream.write(line + "\n")
            Log.stream.flush()
        except (OSError, ValueError):
            pass


def dbg(msg):
    if Log.verbose:
        log("· " + msg)


def home_dir():
    h = os.path.expanduser("~")
    return h if h and h != "~" else "/tmp"


def state_dir():
    d = os.environ.get("NEXO_USB_DIR")
    if not d:
        d = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(home_dir(), ".local", "state"), "nexo", "usb")
    return d


def ensure_state_dir():
    d = state_dir()
    try:
        os.makedirs(d, 0o700)
    except OSError as e:
        if e.errno != errno.EEXIST:
            raise UsbError("No puedo crear %s (%s)" % (d, e.strerror or e))
    return d


def load_config():
    """Mismo orden que el cliente `nexo`: variables de entorno, y luego el primer archivo de enlace que exista."""
    cfg = {"NEXO_PORT": os.environ.get("NEXO_PORT", ""), "NEXO_TOKEN": os.environ.get("NEXO_TOKEN", ""),
           "NEXO_HOST": os.environ.get("NEXO_HOST", "")}
    paths = []
    if os.environ.get("NEXO_CONFIG"):
        paths.append(os.environ["NEXO_CONFIG"])
    paths.append(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(home_dir(), ".config"), "nexo", "config"))
    paths.append("/etc/nexo/config")
    if os.environ.get("PREFIX"):
        paths.append(os.path.join(os.environ["PREFIX"], "etc", "nexo", "config"))
    for p in paths:
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                lines = f.read().splitlines()
        except OSError:
            continue
        for line in lines:
            k, sep, v = line.partition("=")
            k = k.strip()
            v = v.strip().strip("\r").strip("\"'")
            if sep and k in ("NEXO_PORT", "NEXO_TOKEN") and not cfg[k]:
                cfg[k] = v
        break
    if not cfg["NEXO_PORT"]:
        cfg["NEXO_PORT"] = "8765"
    if not cfg["NEXO_HOST"]:
        cfg["NEXO_HOST"] = "127.0.0.1"
    return cfg


def jline(obj):
    return (json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")


def to_onoff(s):
    v = str(s).strip().lower()
    if v in ("on", "1", "si", "sí", "yes", "true"):
        return True
    if v in ("off", "0", "no", "false"):
        return False
    raise ValueError(s)


def to_seconds(s):
    v = float(s)
    if v < 0:
        raise ValueError(s)
    return v


def to_hostport(s, default_host="127.0.0.1"):
    """«2217», «:2217» o «host:2217» → (host, puerto)."""
    s = str(s)
    host, sep, port = s.rpartition(":")
    if not sep:
        host, port = "", s
    p = int(port)
    if not 0 <= p <= 65535:
        raise ValueError(s)
    return (host or default_host, p)


def parse_args(argv, spec, hint="Prueba: nexo usb help"):
    """spec: {"--baud": ("baud", int), "-b": ("baud", int), "--no-reset": ("no_reset", True)} → (opciones, posicionales).
    Un True en lugar de un tipo marca una opción sin valor. Acepta --opción=valor y -b9600."""
    opts, pos = {}, []
    argv = list(argv)
    i = 0
    while i < len(argv):
        a = argv[i]
        i += 1
        if a == "--":
            pos.extend(argv[i:])
            break
        if not a.startswith("-") or a == "-":
            pos.append(a)
            continue
        val = None
        if a.startswith("--"):
            name, eq, v = a.partition("=")
            if eq:
                val = v
        else:
            name = a[:2]
            if len(a) > 2:
                val = a[2:]
                if name in spec and spec[name][1] is True:       # «-la» = «-l -a»
                    argv.insert(i, "-" + val)
                    val = None
        if name not in spec:
            raise UsbError("opción desconocida «%s». %s" % (a, hint), EXIT_USAGE)
        key, kind = spec[name]
        if kind is True:
            if val is not None:
                raise UsbError("«%s» no lleva valor" % name, EXIT_USAGE)
            opts[key] = True
            continue
        if val is None:
            if i >= len(argv):
                raise UsbError("«%s» necesita un valor" % name, EXIT_USAGE)
            val = argv[i]
            i += 1
        try:
            opts[key] = kind(val)
        except ValueError:
            raise UsbError("valor no válido para %s: «%s»" % (name, val), EXIT_USAGE)
    return opts, pos


LINE_SPEC = {
    "--baud": ("baud", int), "-b": ("baud", int), "--bits": ("bits", int), "--parity": ("parity", str),
    "--stop": ("stop", float), "--format": ("format", str),
}

PARITY_LETTER = {"none": "N", "odd": "O", "even": "E", "mark": "M", "space": "S"}
LETTER_PARITY = dict((v, k) for k, v in PARITY_LETTER.items())
DEFAULT_LINE = {"baud": 115200, "bits": 8, "parity": "none", "stop": 1}


def norm_stop(v):
    f = float(v)
    return int(f) if f in (1.0, 2.0) else f


def check_line(line):
    if not 50 <= line["baud"] <= 4000000:
        raise UsbError("baudios fuera de rango (50 a 4000000)", EXIT_USAGE)
    if line["bits"] not in (5, 6, 7, 8):
        raise UsbError("bits debe ser 5, 6, 7 u 8", EXIT_USAGE)
    if line["parity"] not in PARITY_LETTER:
        raise UsbError("parity debe ser none, odd, even, mark o space", EXIT_USAGE)
    if float(line["stop"]) not in (1.0, 1.5, 2.0):
        raise UsbError("stop debe ser 1, 1.5 o 2", EXIT_USAGE)
    line["stop"] = norm_stop(line["stop"])
    return line


def line_from_opts(o, base=None):
    line = dict(base or DEFAULT_LINE)
    if "format" in o:
        m = re.match(r"^([5-8])([NOEMS])(1|1\.5|2)$", o["format"].strip().upper())
        if not m:
            raise UsbError("--format es como 8N1 (bits, paridad N|O|E|M|S y parada 1|1.5|2)", EXIT_USAGE)
        line.update(bits=int(m.group(1)), parity=LETTER_PARITY[m.group(2)], stop=float(m.group(3)))
    for k in ("baud", "bits", "parity", "stop"):
        if k in o:
            line[k] = o[k]
    return check_line(line)


def line_str(line):
    return "%d %d%s%s" % (line["baud"], line["bits"], PARITY_LETTER.get(line["parity"], "?"), line["stop"])


def unescape(text):
    """TEXTO de --send: \\n \\r \\t \\0 \\\\ y \\xNN; lo demás va en UTF-8."""
    out = bytearray()
    pos = 0
    for m in re.finditer(r"\\(x[0-9a-fA-F]{2}|n|r|t|0|\\)", text):
        out += text[pos:m.start()].encode("utf-8")
        e = m.group(1)
        out.append(int(e[1:], 16) if e[0] == "x" else {"n": 10, "r": 13, "t": 9, "0": 0, "\\": 92}[e])
        pos = m.end()
    out += text[pos:].encode("utf-8")
    return bytes(out)


KINDS_ES = {"serial": "serie", "storage": "almacenamiento", "hid": "teclado/ratón", "hub": "hub", "audio": "audio",
            "video": "vídeo", "printer": "impresora", "net": "red", "other": "otro"}


def dev_title(d):
    return d.get("product") or d.get("vendor") or ("USB %s:%s" % (d.get("vid"), d.get("pid")))


def dev_vidpid(d):
    return "%s:%s" % (d.get("vid"), d.get("pid"))


def dev_signature(d):
    return (d.get("vid"), d.get("pid"), d.get("serial"))


def sig_matches(sig, d):
    """¿Es el mismo adaptador? (el id de Android cambia al volver a enchufarlo: se compara VID, PID y número de serie)"""
    if (d.get("vid"), d.get("pid")) != (sig[0], sig[1]):
        return False
    return not sig[2] or not d.get("serial") or sig[2] == d.get("serial")


def match_devices(devs, sel):
    s = sel.strip()
    if re.match(r"^[0-9]+$", s):
        return [d for d in devs if str(d.get("id")) == s]
    if re.match(r"^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$", s):
        return [d for d in devs if dev_vidpid(d) == s.lower()]
    if s.startswith("/dev/bus/usb/"):
        return [d for d in devs if d.get("path") == s]
    low = s.lower()
    out = []
    for d in devs:
        hay = " ".join(str(d.get(k) or "") for k in ("product", "vendor", "serial")).lower()
        if low in hay:
            out.append(d)
    return out


def unsupported_text(d):
    if d.get("note"):
        return "%s (%s): %s." % (dev_title(d), dev_vidpid(d), d["note"])
    kind = d.get("kind")
    why = {
        "storage": "es una unidad de almacenamiento (pendrive, disco…), no un puerto serie: se explora con «nexo usb mounts»",
        "hid": "es un teclado o ratón: Android ya lo usa, y una distro de proot no ve /dev/input",
        "hub": "es un hub: no hace nada por sí solo; lo que cuelgue de él aparece aparte",
    }.get(kind, "no es un adaptador serie que Nexo conozca todavía (sé hablar CDC-ACM, CP210x, FTDI y CH340)")
    return "%s (%s) no sirve como puerto serie: %s." % (dev_title(d), dev_vidpid(d), why)


def choose_device(devs, sel, need_serial=True):
    if sel:
        found = match_devices(devs, sel)
        if not found:
            raise UsbError("Ningún dispositivo USB encaja con «%s». Mira: nexo usb list" % sel, EXIT_NODEV)
        if len(found) > 1:
            raise UsbError("«%s» encaja con %d dispositivos (%s): usa el id o el VID:PID." % (
                sel, len(found), ", ".join("%s %s" % (d.get("id"), dev_vidpid(d)) for d in found)), EXIT_USAGE)
        d = found[0]
        if need_serial and not d.get("serial_capable"):
            raise UsbError(unsupported_text(d), EXIT_NODEV)
        return d
    cands = [d for d in devs if d.get("serial_capable")] if need_serial else list(devs)
    if len(cands) == 1:
        return cands[0]
    if not cands:
        if devs:
            raise UsbError("Android ve %d dispositivo(s) USB, pero ninguno es un adaptador serie que Nexo conozca (mira: nexo usb list)." % len(devs), EXIT_NODEV)
        raise UsbError("No veo ningún dispositivo USB. Enchúfalo con un cable OTG (en Xiaomi: Ajustes → Ajustes adicionales → OTG) y mira: nexo usb list", EXIT_NODEV)
    raise UsbError("Hay %d dispositivos posibles; elige uno (id o VID:PID):\n%s" % (
        len(cands), "\n".join("  %-6s %s  %s" % (d.get("id"), dev_vidpid(d), dev_title(d)) for d in cands)), EXIT_USAGE)


# ----------------------------------------------------------------------------------------------------- la app Nexo


def recv_line(sock, buf, timeout):
    """Lee hasta el primer salto de línea sin tragarse lo que venga detrás. Devuelve (línea, resto)."""
    end = time.monotonic() + timeout
    while b"\n" not in buf:
        left = end - time.monotonic()
        if left <= 0:
            raise socket.timeout()
        sock.settimeout(left)
        chunk = sock.recv(65536)
        if not chunk:
            raise ConnectionError("la app cerró la conexión")
        buf += chunk
        if len(buf) > (1 << 20) and b"\n" not in buf:
            raise ConnectionError("línea demasiado larga")
    line, _, rest = buf.partition(b"\n")
    return line, rest


def handshake(cfg, timeout=4.0):
    """Conecta, saluda con el token y devuelve (socket, bytes sobrantes, datos del hello)."""
    host, port = cfg["NEXO_HOST"], int(cfg["NEXO_PORT"])
    try:
        s = socket.create_connection((host, port), timeout=timeout)
    except OSError as e:
        raise UsbError("No se puede conectar con Nexo en %s:%s (%s). ¿Está encendido el puente en la app? (mira: nexo doctor)" % (
            host, port, e.strerror or e), EXIT_NOAPP)
    try:
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        s.sendall(jline({"id": "hello", "cmd": "hello", "token": cfg["NEXO_TOKEN"], "client": CLIENT_NAME}))
        line, rest = recv_line(s, b"", 8.0)
        o = json.loads(line.decode("utf-8", "replace"))
    except socket.timeout:
        s.close()
        raise UsbError("La app Nexo no contestó (¿la tiene congelada Android? Ábrela un momento).", EXIT_TIMEOUT)
    except (OSError, ValueError) as e:
        s.close()
        raise UsbError("Se perdió la conexión con la app Nexo (%s)." % e, EXIT_NOAPP)
    if not isinstance(o, dict) or not o.get("ok"):
        s.close()
        if isinstance(o, dict) and o.get("error") == "unauthorized":
            raise UsbError("Nexo rechazó el token. Vuelve a copiar el comando de instalación desde la app (o usa: nexo rekey TOKEN).", EXIT_TOKEN)
        raise UsbError("La app rechazó el saludo: %s" % (o.get("message") or o.get("error") if isinstance(o, dict) else o), EXIT_ERR)
    return s, rest, o.get("data") or {}


def usb_capable(info):
    return bool(info.get("usb")) or "usb.status" in (info.get("commands") or [])


class Link(object):
    """Conexión de control con la app: respuestas por id, eventos y un ping cuando se calla."""

    PING_AFTER = 20.0
    PING_TIMEOUT = 8.0

    def __init__(self, cfg, on_event=None):
        self.cfg = cfg
        self.on_event = on_event
        self.sock = None
        self.info = {}
        self.dead = threading.Event()
        self.reason = ""
        self._wlock = threading.Lock()
        self._ilock = threading.Lock()
        self._ids = 0
        self._waiters = {}

    def connect(self, timeout=4.0):
        s, rest, info = handshake(self.cfg, timeout)
        self.sock = s
        self.info = info
        threading.Thread(target=self._reader, args=(rest,), name="app", daemon=True).start()
        return info

    def _die(self, reason):
        if self.dead.is_set():
            return
        self.reason = reason
        self.dead.set()
        s = self.sock
        if s is not None:
            try:
                s.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            try:
                s.close()
            except OSError:
                pass
        for w in list(self._waiters.values()):
            w[0].set()

    def close(self):
        self._die("cerrada")

    def _reader(self, buf):
        s = self.sock
        last_rx = time.monotonic()
        last_ping = None
        try:
            s.settimeout(1.0)
            while not self.dead.is_set():
                while b"\n" in buf:
                    line, _, buf = buf.partition(b"\n")
                    self._on_line(line)
                try:
                    chunk = s.recv(65536)
                except socket.timeout:
                    chunk = None
                if chunk == b"":
                    raise ConnectionError("la app cerró la conexión")
                now = time.monotonic()
                if chunk:
                    last_rx, last_ping = now, None
                    buf += chunk
                    if len(buf) > (1 << 20) and b"\n" not in buf:
                        raise ConnectionError("línea demasiado larga")
                elif last_ping is None and now - last_rx > self.PING_AFTER:
                    self._send({"id": "ping", "cmd": "ping"})
                    last_ping = now
                elif last_ping is not None and now - last_ping > self.PING_TIMEOUT:
                    raise ConnectionError("la app no responde al ping")
        except Exception as e:
            self._die("%s" % (e,))

    def _on_line(self, raw):
        try:
            o = json.loads(raw.decode("utf-8", "replace"))
        except ValueError:
            return
        if not isinstance(o, dict):
            return
        if "event" in o:
            if self.on_event is not None:
                try:
                    self.on_event(o["event"], o.get("data") or {})
                except Exception as e:
                    log("error procesando un evento: %r" % (e,))
            return
        w = self._waiters.get(o.get("id"))
        if w is not None:
            w[1] = o
            w[0].set()

    def _send(self, obj):
        data = jline(obj)
        with self._wlock:
            s = self.sock
            if s is None or self.dead.is_set():
                raise BridgeError("no_connection", "No hay conexión con la app Nexo")
            try:
                s.sendall(data)
            except OSError as e:
                # Si la app murió a mitad de una copia, escribirle también falla (conexión reiniciada, tubería rota): para quien lo
                # lee es lo mismo que perderla, y se cuenta igual que cuando lo nota el hilo que lee (así no depende de quién llegó antes).
                raise BridgeError("no_connection", "Se perdió la conexión con la app Nexo (no pude escribirle: %s)" % (e.strerror or e))

    def call_async(self, cmd, **params):
        """Envía la petición y devuelve ya un Pending: así se pueden tener varias en vuelo (la app las contesta una a una, en orden)."""
        with self._ilock:
            self._ids += 1
            rid = "c%d" % self._ids
        w = [threading.Event(), None]
        self._waiters[rid] = w
        req = dict((k, v) for k, v in params.items() if v is not None)
        req["id"] = rid
        req["cmd"] = cmd
        try:
            self._send(req)
        except BaseException:
            self._waiters.pop(rid, None)
            raise
        return Pending(self, rid, w)

    def call(self, cmd, timeout=8.0, **params):
        return self.call_async(cmd, **params).result(timeout)


class Pending(object):
    """Una petición ya enviada cuya respuesta aún no llegó."""

    def __init__(self, link, rid, waiter):
        self.link, self.rid, self.waiter = link, rid, waiter

    def result(self, timeout=8.0):
        w = self.waiter
        try:
            if not w[0].wait(timeout):
                raise BridgeError("timeout", "La app no contestó a tiempo (¿la congeló Android?)")
        finally:
            self.link._waiters.pop(self.rid, None)
        r = w[1]
        if r is None:
            raise BridgeError("no_connection", "Se perdió la conexión con la app Nexo (%s)" % (self.link.reason or "?"))
        if r.get("ok"):
            return r.get("data") or {}
        extra = dict((k, v) for k, v in r.items() if k not in ("id", "ok", "error", "message"))
        raise BridgeError(r.get("error", "failed"), r.get("message", ""), extra)


def open_data(cfg, session, timeout=8.0):
    """La segunda conexión: saluda, pide usb.attach y, tras la línea de respuesta, todo son bytes crudos del adaptador."""
    s, rest, _ = handshake(cfg, timeout)
    try:
        s.sendall(jline({"id": "attach", "cmd": "usb.attach", "session": session}))
        line, rest = recv_line(s, rest, timeout)
        o = json.loads(line.decode("utf-8", "replace"))
    except (OSError, ValueError) as e:
        s.close()
        raise BridgeError("no_connection", "No pude abrir el flujo de datos USB (%s)" % e)
    if not isinstance(o, dict) or not o.get("ok"):
        s.close()
        o = o if isinstance(o, dict) else {}
        raise BridgeError(o.get("error", "failed"), o.get("message", ""))
    s.settimeout(None)
    return s, rest


def explain(e):
    """Un error de la app → un mensaje que diga qué hacer."""
    c, m = e.code, e.message
    if c in ("timeout", "no_connection"):
        return Transient("%s" % m, EXIT_TIMEOUT if c == "timeout" else EXIT_NOAPP)
    if c == "busy":
        return Transient("%s. Si lo tiene abierto otra app (Arduino IDE, «Serial USB Terminal»…), ciérrala; "
                         "si era un puente anterior, espera unos segundos." % m.rstrip("."), EXIT_ERR)
    if c == "not_found":
        return Transient(m, EXIT_NODEV)
    if c == "failed":
        return Transient(m, EXIT_ERR)
    if c == "permission_denied":
        return UsbError("Android no deja usar este dispositivo sin tu permiso. Prueba: nexo usb permit", EXIT_TOUCH)
    if c == "unauthorized":
        return UsbError("Nexo rechazó el token. Vuelve a copiar el comando de instalación desde la app (o usa: nexo rekey TOKEN).", EXIT_TOKEN)
    if c == "unsupported":
        return UsbError(m, EXIT_NODEV)
    if c == "bad_request":
        return UsbError(m, EXIT_USAGE)
    if c == "unknown_command":
        return UsbError("Esta versión de la app Nexo no sabe de USB. Instala el APK de la 0.4.1 o más nuevo (se actualiza encima, sin perder el enlace).", EXIT_ERR)
    return UsbError("%s (%s)" % (m, c), EXIT_ERR)


def connect_app(on_event=None, need="usb"):
    cfg = load_config()
    if not cfg["NEXO_TOKEN"]:
        raise UsbError("No hay token. Pega en Termux el comando de instalación que copia la app Nexo, o usa: nexo pair TOKEN", EXIT_TOKEN)
    if not re.match(r"^[0-9]+$", cfg["NEXO_PORT"]):
        raise UsbError("Puerto inválido: %s" % cfg["NEXO_PORT"], EXIT_USAGE)
    link = Link(cfg, on_event)
    link.connect()
    if need == "storage":
        if not storage_capable(link.info):
            link.close()
            raise UsbError("Esta versión de la app Nexo (%s) no sabe de discos USB. Instala el APK de la 0.4.2 o más nuevo "
                           "(se actualiza encima, sin perder el enlace)." % link.info.get("version", "?"), EXIT_ERR)
    elif not usb_capable(link.info):
        link.close()
        raise UsbError("Esta versión de la app Nexo (%s) no sabe de USB. Instala el APK de la 0.4.1 o más nuevo "
                       "(se actualiza encima, sin perder el enlace)." % link.info.get("version", "?"), EXIT_ERR)
    return link


def call_app(link, cmd, timeout=8.0, **params):
    try:
        return link.call(cmd, timeout, **params)
    except BridgeError as e:
        raise explain(e)


def ensure_permission(link, dev, say, timeout=60.0, stop=None):
    """Pide el permiso de Android y espera la respuesta del usuario (el aviso sale en la pantalla del móvil)."""
    if dev.get("permission"):
        return
    start = time.monotonic()
    announced = False
    while True:
        if stop is not None and stop.is_set():
            raise Stopped()
        left = timeout - (time.monotonic() - start)
        if left <= 0:
            raise UsbError("Nadie contestó al aviso de Android. Si no te salió nada, abre la app Nexo un momento y repite: "
                           "nexo usb permit  (en HyperOS/MIUI, mejor con Nexo en primer plano).", EXIT_TOUCH)
        wait = int(min(left, 10.0) * 1000)
        r = call_app(link, "usb.permission", wait / 1000.0 + 8.0, device=dev["id"], wait_ms=wait)
        if r.get("granted"):
            return
        if r.get("denied"):
            raise UsbError("Android no te dio permiso para usar «%s». Repite «nexo usb permit» y elige «Aceptar» "
                           "(marca «Usar siempre» para que no vuelva a preguntar)." % dev_title(dev), EXIT_TOUCH)
        if not announced:
            say("Android pide permiso para usar «%s» (%s): mira la pantalla del móvil y acepta; marca «Usar siempre» "
                "para que no vuelva a preguntar." % (dev_title(dev), dev_vidpid(dev)))
            announced = True


# ----------------------------------------------------------------------------------------------------- list y permit


def table(rows, headers):
    cols = [headers] + rows
    widths = [max(len(str(r[i])) for r in cols) for i in range(len(headers))]
    out = []
    for n, r in enumerate(cols):
        out.append("  ".join(str(c).ljust(widths[i]) for i, c in enumerate(r)).rstrip())
    return "\n".join(out)


def cmd_list(argv):
    o, pos = parse_args(argv, {"--json": ("json", True), "--pretty": ("pretty", True), "--lsusb": ("lsusb", True),
                               "--all": ("all", True), "-a": ("all", True)})
    if pos:
        raise UsbError("«list» no lleva argumentos. Prueba: nexo usb help", EXIT_USAGE)
    link = connect_app()
    try:
        st = call_app(link, "usb.status")
    finally:
        link.close()
    devs = st.get("devices") or []
    sess = dict((s.get("device"), s) for s in (st.get("sessions") or []))
    if o.get("json"):
        sys.stdout.write(json.dumps(st, ensure_ascii=False, indent=2 if o.get("pretty") or sys.stdout.isatty() else None) + "\n")
        return 0
    if o.get("lsusb"):
        for d in devs:
            sys.stdout.write("Bus %03d Device %03d: ID %s:%s %s\n" % (
                d.get("bus", 0), d.get("address", 0), d.get("vid"), d.get("pid"),
                " ".join(x for x in (d.get("vendor"), d.get("product")) if x) or "(sin nombre)"))
        return 0
    if not st.get("host", True):
        log("Este móvil no tiene USB host (no puede recibir dispositivos USB).")
        return EXIT_NODEV
    if not devs:
        log("Android no ve ningún dispositivo USB.")
        log("Enchúfalo con un cable OTG. En Xiaomi/HyperOS: Ajustes → Ajustes adicionales → OTG (se apaga solo si no hay nada).")
        return 0
    rows = []
    for d in devs:
        s = sess.get(d.get("id"))
        uso = "en uso (%s)" % s.get("session") if s else ("sí" if d.get("permission") else "no")
        extra = " · ".join(x for x in (d.get("vendor"), d.get("serial") and "serie " + d["serial"]) if x)
        rows.append((d.get("id"), dev_vidpid(d), KINDS_ES.get(d.get("kind"), d.get("kind") or "?"),
                     d.get("driver") or ("—" if d.get("kind") == "serial" else ""), uso,
                     dev_title(d) + (" · " + extra if extra else "")))
    sys.stdout.write(table(rows, ("ID", "VID:PID", "TIPO", "CONTROLADOR", "PERMISO", "DISPOSITIVO")) + "\n")
    notes = [d for d in devs if d.get("note")]
    for d in notes:
        sys.stdout.write("  %s: %s\n" % (dev_vidpid(d), d["note"]))
    if any(d.get("serial_capable") and not d.get("permission") for d in devs):
        sys.stdout.write("Siguiente paso: nexo usb permit   (Android te pregunta una vez; marca «Usar siempre»)\n")
    elif any(d.get("serial_capable") for d in devs):
        sys.stdout.write("Listo para: nexo usb monitor   ·   nexo usb bridge\n")
    elif not o.get("all"):
        sys.stdout.write("Ninguno sirve como puerto serie (los pendrives y discos: nexo usb mounts).\n")
    return 0


def cmd_permit(argv):
    o, pos = parse_args(argv, {"--wait": ("wait", True), "--timeout": ("timeout", to_seconds)})
    if len(pos) > 1:
        raise UsbError("Solo un DISPOSITIVO. Prueba: nexo usb help", EXIT_USAGE)
    link = connect_app()
    try:
        dev = wait_for_device(link, pos[0] if pos else None, o.get("wait"), pick=pick_for_permit)
        if dev.get("permission"):
            log("«%s» (%s) ya tiene permiso." % (dev_title(dev), dev_vidpid(dev)))
            return 0
        ensure_permission(link, dev, log, o.get("timeout", 60.0))
        log("Permiso concedido para «%s» (%s)." % (dev_title(dev), dev_vidpid(dev)))
        return 0
    finally:
        link.close()


def pick_for_permit(devs, sel):
    """Sin DISPOSITIVO: el único adaptador serie (o el único dispositivo) que aún no tiene permiso."""
    if sel:
        return choose_device(devs, sel, need_serial=False)
    sin = [d for d in devs if not d.get("permission")]
    serie = [d for d in sin if d.get("serial_capable")]
    cands = serie or sin
    if not cands:
        if not devs:
            raise UsbError("No veo ningún dispositivo USB. Enchúfalo con un cable OTG y mira: nexo usb list", EXIT_NODEV)
        todos = [d for d in devs if d.get("serial_capable")] or devs     # todos tienen ya permiso: se dice cuál
        return todos[0]
    return choose_device(cands, None, need_serial=False)


def wait_for_device(link, sel, wait, need_serial=True, stop=None, pick=None):
    """El dispositivo elegido; con --wait, espera a que lo enchufes."""
    told = False
    while True:
        st = call_app(link, "usb.status")
        try:
            devs = st.get("devices") or []
            return pick(devs, sel) if pick else choose_device(devs, sel, need_serial)
        except UsbError as e:
            if e.code != EXIT_NODEV or not wait:
                raise
            if not told:
                log("Esperando a que enchufes el dispositivo… (Ctrl+C para dejar de esperar)")
                told = True
        if stop is not None and stop.is_set():
            raise Stopped()
        time.sleep(1.0)


# ----------------------------------------------------------------------------------------------------- monitor


class Printer(object):
    """Lo que llega del adaptador, tal cual, en hexadecimal o con la hora de cada línea."""

    def __init__(self, hexmode=False, stamp=False):
        self.out = sys.stdout.buffer
        self.hexmode = hexmode
        self.stamp = stamp
        self.pend = b""
        self.mid = False          # ya se escribió el principio de la línea actual (con su hora)
        self.off = 0
        self.last = time.monotonic()

    @staticmethod
    def _ts():
        t = time.time()
        return ("[%s.%03d] " % (time.strftime("%H:%M:%S", time.localtime(t)), int((t % 1) * 1000))).encode()

    def _hexline(self, chunk):
        hexs = " ".join("%02x" % b for b in chunk)
        txt = "".join(chr(b) if 32 <= b < 127 else "." for b in chunk)
        self.out.write(("%08x  %-47s  |%s|\n" % (self.off, hexs, txt)).encode())
        self.off += len(chunk)

    def feed(self, data):
        self.last = time.monotonic()
        if self.hexmode:
            self.pend += data
            while len(self.pend) >= 16:
                self._hexline(self.pend[:16])
                self.pend = self.pend[16:]
        elif self.stamp:
            buf = self.pend + data
            while True:
                i = buf.find(b"\n")
                if i < 0:
                    break
                line, buf = buf[:i + 1], buf[i + 1:]
                self.out.write((b"" if self.mid else self._ts()) + line)
                self.mid = False
            self.pend = buf
        else:
            self.out.write(data)
        self.out.flush()

    def idle(self):
        """Cuando no llega nada: enseña lo que haya a medias."""
        if not self.pend or time.monotonic() - self.last < 0.3:
            return
        if self.hexmode:
            self._hexline(self.pend)
        else:
            self.out.write((b"" if self.mid else self._ts()) + self.pend)
            self.mid = True
        self.pend = b""
        self.out.flush()


class Collector(object):
    """Con --json: no escribe nada; guarda lo recibido para el resumen final."""

    def __init__(self):
        self.buf = bytearray()

    def feed(self, data):
        if len(self.buf) < (1 << 20):
            self.buf += data[:(1 << 20) - len(self.buf)]

    def idle(self):
        pass


def cmd_monitor(argv):
    spec = dict(LINE_SPEC)
    spec.update({"--no-reset": ("no_reset", True), "--dtr": ("dtr", to_onoff), "--rts": ("rts", to_onoff),
                 "--seconds": ("seconds", to_seconds), "-t": ("seconds", to_seconds), "--idle": ("idle", to_seconds),
                 "--lines": ("lines", int), "--until": ("until", str), "--send": ("send", str), "--eol": ("eol", str),
                 "--hex": ("hex", True), "--timestamp": ("stamp", True), "-T": ("stamp", True),
                 "--no-input": ("no_input", True), "--wait": ("wait", True), "--json": ("json", True)})
    o, pos = parse_args(argv, spec)
    if len(pos) > 1:
        raise UsbError("Solo un DISPOSITIVO. Prueba: nexo usb help", EXIT_USAGE)
    line = line_from_opts(o)
    eols = {"lf": b"\n", "cr": b"\r", "crlf": b"\r\n", "none": None}
    if o.get("eol", "lf") not in eols:
        raise UsbError("--eol: lf, cr, crlf o none", EXIT_USAGE)
    eol = eols[o.get("eol", "lf")]
    rx = None
    if "until" in o:
        try:
            rx = re.compile(o["until"].encode("utf-8"))
        except re.error as e:
            raise UsbError("--until no es una expresión regular válida (%s)" % e, EXIT_USAGE)
    reset = not o.get("no_reset", False)
    dtr, rts = o.get("dtr", reset), o.get("rts", reset)

    link = connect_app()
    sock = None
    session = None
    old_attr = None
    code = 0
    why = ""
    try:
        dev = wait_for_device(link, pos[0] if pos else None, o.get("wait"))
        ensure_permission(link, dev, log, 60.0)
        view = call_app(link, "usb.open", 15.0, device=dev["id"], baud=line["baud"], bits=line["bits"],
                        parity=line["parity"], stop=line["stop"], dtr=dtr, rts=rts)
        session = view["session"]
        try:
            sock, rest = open_data(link.cfg, session)
        except BridgeError as e:
            raise explain(e)
        tty_in = False
        try:
            tty_in = os.isatty(0)
        except OSError:
            pass
        forward = not o.get("no_input")
        if tty_in and forward:
            old_attr = termios.tcgetattr(0)
            new = termios.tcgetattr(0)
            new[0] &= ~(termios.IXON | termios.ICRNL | termios.INLCR | termios.IGNCR)
            new[3] &= ~(termios.ECHO | termios.ICANON | termios.ISIG | termios.IEXTEN)
            new[6][termios.VMIN] = 1
            new[6][termios.VTIME] = 0
            termios.tcsetattr(0, termios.TCSADRAIN, new)
        if sys.stderr.isatty():
            log("%s (%s) · %s · %s%s" % (dev_title(dev), dev_vidpid(dev), view.get("driver", "?"), line_str(line),
                                        "   —   salir: Ctrl+]" if tty_in and forward else ""))
        pr = Collector() if o.get("json") else Printer(o.get("hex"), o.get("stamp"))
        tail = b""
        total = 0
        nlines = 0
        matched = False
        start = last_rx = time.monotonic()
        eof_at = None
        if "send" in o:
            sock.sendall(unescape(o["send"]))
        stdin_open = forward

        def got(data):
            nonlocal tail, total, nlines, matched, last_rx
            pr.feed(data)
            total += len(data)
            nlines += data.count(b"\n")
            last_rx = time.monotonic()
            if rx is not None and not matched:
                tail = (tail + data)[-65536:]
                if rx.search(tail):
                    matched = True

        if rest:
            got(rest)
        done = False
        while not done:
            fds = [sock] + ([0] if stdin_open else [])
            try:
                r, _, _ = select.select(fds, [], [], 0.25)
            except InterruptedError:
                continue
            now = time.monotonic()
            if sock in r:
                data = sock.recv(65536)
                if not data:
                    # Si la app murió, la conexión de control cae a la vez que la de datos: es otra causa que desenchufar.
                    if link.dead.wait(0.5):
                        code, why = EXIT_NOAPP, "Se perdió la conexión con la app Nexo (%s)." % (link.reason or "?")
                    else:
                        code, why = EXIT_GONE, "El dispositivo se desenchufó (o la app cerró el flujo de datos)."
                    break
                got(data)
            else:
                pr.idle()
            if stdin_open and 0 in r:
                try:
                    data = os.read(0, 4096)
                except OSError:
                    data = b""
                if not data:
                    stdin_open = False
                    eof_at = now
                else:
                    if tty_in:
                        i = data.find(b"\x1d")
                        if i >= 0:
                            data, done = data[:i], True
                        if eol is not None:
                            data = data.replace(b"\r", eol)
                    elif "eol" in o and eol is not None:
                        data = data.replace(b"\n", eol)
                    if data:
                        sock.sendall(data)
            if link.dead.is_set():
                code, why = EXIT_NOAPP, "Se perdió la conexión con la app Nexo (%s)." % (link.reason or "?")
                break
            if matched or (o.get("lines") and nlines >= o["lines"]):
                break
            if o.get("seconds") is not None and now - start >= o["seconds"]:
                break
            idle = o.get("idle")
            if idle is None and eof_at is not None and o.get("seconds") is None:
                idle = 1.0                       # una tubería que ya acabó: espera la respuesta y sale
            if idle is not None and now - max(last_rx, eof_at or 0) >= idle:
                break
        if code == 0 and rx is not None and not matched:
            code, why = EXIT_TIMEOUT, "No apareció lo que buscaba --until."
        if o.get("json"):
            sys.stdout.write(json.dumps({"bytes": total, "lines": nlines, "matched": matched,
                                         "elapsed": round(time.monotonic() - start, 3),
                                         "text": bytes(pr.buf).decode("utf-8", "replace"), "hex": bytes(pr.buf).hex()},
                                        ensure_ascii=False) + "\n")
        else:
            pr.idle()
        if why:
            if old_attr is not None:
                termios.tcsetattr(0, termios.TCSADRAIN, old_attr)
                old_attr = None
            log("\n" + why if sys.stderr.isatty() else why)
        return code
    except (KeyboardInterrupt, BrokenPipeError):
        return 0
    finally:
        if old_attr is not None:
            try:
                termios.tcsetattr(0, termios.TCSADRAIN, old_attr)
            except (termios.error, OSError):
                pass
        if sock is not None:
            try:
                sock.close()
            except OSError:
                pass
        if session is not None:
            try:
                link.call("usb.close", 3.0, session=session)
            except BridgeError:
                pass
        link.close()


# ----------------------------------------------------------------------------------------------------- bridge: piezas

TCGETS2 = 0x802C542A
TCSETS2 = 0x402C542B
CBAUD = 0o10017
BOTHER = 0o10000
CMSPAR = 0o10000000000
IN_OPEN, IN_CLOSE_WRITE, IN_CLOSE_NOWRITE = 0x20, 0x8, 0x10
RESET_SETTLE = 0.15       # tras el pulso de reinicio, lo que tarda el cargador del Arduino en estar escuchando

STD_SPEEDS = {}
for _n in (50, 75, 110, 134, 150, 200, 300, 600, 1200, 1800, 2400, 4800, 9600, 19200, 38400, 57600, 115200, 230400,
           460800, 500000, 576000, 921600, 1000000, 1152000, 1500000, 2000000, 2500000, 3000000, 3500000, 4000000):
    _c = getattr(termios, "B%d" % _n, None)
    if _c is not None:
        STD_SPEEDS[_n] = _c


def pty_get_line(fd):
    """La línea serie que un programa le ha puesto al PTY: dict(baud, bits, parity, stop), o None si no se puede saber."""
    try:
        raw = fcntl.ioctl(fd, TCGETS2, b"\0" * 44)
        cflag = struct.unpack_from("=I", raw, 8)[0]
        ospeed = struct.unpack_from("=I", raw, 40)[0]
    except (OSError, struct.error):
        try:
            t = termios.tcgetattr(fd)
        except termios.error:
            return None
        cflag = t[2]
        ospeed = next((n for n, c in STD_SPEEDS.items() if c == t[5]), 0)
    if not ospeed:
        return None                       # B0 = «colgar», no es una velocidad
    bits = {termios.CS5: 5, termios.CS6: 6, termios.CS7: 7, termios.CS8: 8}[cflag & termios.CSIZE]
    if cflag & termios.PARENB:
        if cflag & CMSPAR:
            parity = "mark" if cflag & termios.PARODD else "space"
        else:
            parity = "odd" if cflag & termios.PARODD else "even"
    else:
        parity = "none"
    return {"baud": ospeed, "bits": bits, "parity": parity, "stop": 2 if cflag & termios.CSTOPB else 1}


def pty_init(fd, line):
    """El PTY como un puerto serie «en crudo» (sin eco, sin traducciones) y con la línea inicial."""
    t = termios.tcgetattr(fd)
    t[0] &= ~(termios.BRKINT | termios.ICRNL | termios.INPCK | termios.ISTRIP | termios.IXON | termios.INLCR | termios.IGNCR | termios.IXOFF)
    t[1] &= ~termios.OPOST
    t[3] &= ~(termios.ECHO | termios.ECHONL | termios.ICANON | termios.IEXTEN | termios.ISIG)
    t[6][termios.VMIN] = 1
    t[6][termios.VTIME] = 0
    c = t[2] & ~(termios.CSIZE | termios.PARENB | termios.PARODD | termios.CSTOPB | termios.HUPCL | CMSPAR)
    c |= {5: termios.CS5, 6: termios.CS6, 7: termios.CS7, 8: termios.CS8}[line["bits"]] | termios.CREAD | termios.CLOCAL
    if line["parity"] != "none":
        c |= termios.PARENB
        if line["parity"] in ("odd", "mark"):
            c |= termios.PARODD
        if line["parity"] in ("mark", "space"):
            c |= CMSPAR
    if line["stop"] != 1:
        c |= termios.CSTOPB
    t[2] = c
    code = STD_SPEEDS.get(line["baud"])
    if code is not None:
        t[4] = t[5] = code
    termios.tcsetattr(fd, termios.TCSANOW, t)
    if code is None:                      # una velocidad que no tiene constante B…: termios2 con BOTHER
        try:
            raw = bytearray(fcntl.ioctl(fd, TCGETS2, b"\0" * 44))
            cf = struct.unpack_from("=I", raw, 8)[0]
            struct.pack_into("=I", raw, 8, (cf & ~CBAUD) | BOTHER)
            struct.pack_into("=II", raw, 36, line["baud"], line["baud"])
            fcntl.ioctl(fd, TCSETS2, bytes(raw))
        except OSError as e:
            dbg("no pude poner %d baudios al PTY (%s)" % (line["baud"], e))


def inotify_watch(path):
    """Un descriptor de inotify que avisa de cada apertura y cierre de `path`. OSError si el sistema no lo permite."""
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        init = libc.inotify_init1
        add = libc.inotify_add_watch
    except (OSError, AttributeError) as e:
        raise OSError(errno.ENOSYS, "sin inotify (%s)" % e)
    init.argtypes = [ctypes.c_int]
    init.restype = ctypes.c_int
    add.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
    add.restype = ctypes.c_int
    fd = init(os.O_NONBLOCK | os.O_CLOEXEC)
    if fd < 0:
        e = ctypes.get_errno()
        raise OSError(e, os.strerror(e))
    if add(fd, os.fsencode(path), IN_OPEN | IN_CLOSE_WRITE | IN_CLOSE_NOWRITE) < 0:
        e = ctypes.get_errno()
        os.close(fd)
        raise OSError(e, os.strerror(e))
    return fd


def inotify_masks(fd):
    try:
        data = os.read(fd, 4096)
    except (BlockingIOError, InterruptedError):
        return []
    out = []
    i = 0
    while i + 16 <= len(data):
        _wd, mask, _cookie, ln = struct.unpack_from("=iIII", data, i)
        out.append(mask)
        i += 16 + ln
    return out


def proc_holders(path):
    """Cuántos procesos (de tu mismo usuario) tienen abierto `path`, mirando /proc/PID/fd. None si /proc no se puede leer."""
    me = os.getpid()
    n = 0
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return None
    for p in pids:
        if int(p) == me:
            continue
        d = "/proc/%s/fd" % p
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for f in names:
            try:
                if os.readlink(d + "/" + f) == path:
                    n += 1
                    break
            except OSError:
                continue
    return n


class Sink(object):
    """Cola de salida con hilo propio: lo que llega del dispositivo para un destino que puede ir lento (PTY o cliente de red)."""

    LIMIT = 1 << 20

    def __init__(self, name, write, on_error):
        self._write = write
        self._on_error = on_error
        self.cv = threading.Condition()
        self.q = collections.deque()
        self.size = 0
        self.dropped = 0
        self.closed = False
        threading.Thread(target=self._run, name="sink-" + name, daemon=True).start()

    def put(self, data):
        with self.cv:
            if self.closed:
                return
            self.q.append(data)
            self.size += len(data)
            while self.size > self.LIMIT and len(self.q) > 1:
                old = self.q.popleft()
                self.size -= len(old)
                self.dropped += len(old)
            self.cv.notify()

    def clear(self):
        with self.cv:
            self.q.clear()
            self.size = 0

    def close(self):
        with self.cv:
            self.closed = True
            self.q.clear()
            self.size = 0
            self.cv.notify_all()

    def _run(self):
        while True:
            with self.cv:
                while not self.q and not self.closed:
                    self.cv.wait()
                if self.closed:
                    return
                data = self.q.popleft()
                self.size -= len(data)
            try:
                self._write(data)
            except Exception as e:
                if not self.closed:
                    self.close()
                    self._on_error(e)
                return


class Session(object):
    """Mientras el dispositivo esté abierto: la conexión de control, la de datos y una cola ORDENADA de lo que se le manda
    (datos y órdenes de línea/DTR/RTS van por la misma cola, así «cambia la velocidad y escribe» llega en ese orden)."""

    HIGH = 1 << 20

    def __init__(self, br, link, dev, view, sock, rest):
        self.br, self.link, self.dev, self.view = br, link, dev, view
        self.id = view["session"]
        self.sock, self.rest = sock, rest
        self.q = collections.deque()
        self.qbytes = 0
        self.cv = threading.Condition()
        self.closed = threading.Event()
        self.lost_reason = ""
        self.rx = 0
        self.tx = 0

    def start(self):
        threading.Thread(target=self._reader, name="usb-rx", daemon=True).start()
        threading.Thread(target=self._writer, name="usb-tx", daemon=True).start()

    def fail(self, reason):
        with self.cv:
            if self.closed.is_set():
                return
            self.lost_reason = reason
            self.closed.set()
            self.cv.notify_all()
        self.br.wake.set()

    def _reader(self):
        try:
            if self.rest:
                self.rx += len(self.rest)
                self.br.on_rx(self.rest)
            while not self.closed.is_set():
                data = self.sock.recv(65536)
                if not data:
                    if self.link.dead.wait(0.5):          # la app murió (cayó también la conexión de control)
                        self.fail("se perdió la conexión con la app Nexo")
                    else:
                        self.fail("el dispositivo se desenchufó (o la app cerró el flujo de datos)")
                    return
                self.rx += len(data)
                self.br.on_rx(data)
        except OSError as e:
            self.fail("se cortó el flujo de datos (%s)" % (e.strerror or e))

    def _writer(self):
        while True:
            with self.cv:
                while not self.q and not self.closed.is_set():
                    self.cv.wait()
                if self.closed.is_set():
                    return
                op = self.q.popleft()
                if op[0] == "d":
                    self.qbytes -= len(op[1])
                    self.cv.notify_all()
            try:
                if op[0] == "d":
                    self.sock.sendall(op[1])
                    self.tx += len(op[1])
                elif op[0] == "setup":
                    self._call("usb.setup", **op[1])
                elif op[0] == "lines":
                    self._call("usb.control", dtr=op[1], rts=op[2])
                elif op[0] == "brk":
                    self._call("usb.control", brk=op[1])
            except OSError as e:
                self.fail("no pude escribir al dispositivo (%s)" % (e.strerror or e))
                return

    def _call(self, cmd, **params):
        try:
            return self.link.call(cmd, 8.0, session=self.id, **params)
        except BridgeError as e:
            if e.code in ("timeout", "no_connection", "not_found"):
                self.fail("la app dejó de contestar (%s)" % e.message)
            else:
                log("USB: «%s» falló: %s" % (cmd, e.message))      # p. ej. una velocidad que el adaptador no admite: se sigue
        return None

    def send(self, data):
        with self.cv:
            while self.qbytes > self.HIGH and not self.closed.is_set():
                self.cv.wait(0.5)
            if self.closed.is_set():
                return False
            self.q.append(("d", data))
            self.qbytes += len(data)
            self.cv.notify_all()
        return True

    def ctl(self, op):
        with self.cv:
            if self.closed.is_set():
                return
            if op[0] == "setup" and self.q and self.q[-1][0] == "setup":
                self.q[-1] = op                   # varios cambios seguidos de velocidad/formato: solo importa el último
            else:
                self.q.append(op)
            self.cv.notify_all()

    def close(self, polite=True):
        self.fail("cerrada")
        if polite and not self.link.dead.is_set():
            try:
                self.link.call("usb.close", 3.0, session=self.id)
            except BridgeError:
                pass
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass
        self.link.close()


class PtyFront(object):
    """Un pseudo-terminal que cualquier programa de la distro ve como «un puerto serie».

    Un PTY no puede llevar DTR/RTS (no hay ioctl de módem), así que:
      · la velocidad y el formato se leen del termios del PTY y se pasan al adaptador (antes de cada dato que se reenvía);
      · el reinicio automático de los Arduino (que ocurre al ABRIR el puerto) se emula: al abrirlo el primer programa se
        pulsa DTR/RTS, y al cerrarlo el último se sueltan. Para saber cuándo abren y cierran se usa inotify, o /proc/PID/fd
        si el sistema no deja usar inotify en /dev/pts."""

    def __init__(self, br, link_path, auto_reset):
        self.br = br
        self.auto_reset = auto_reset
        self.master, self.slave = os.openpty()
        self.path = os.ttyname(self.slave)
        pty_init(self.slave, br.line)
        os.set_blocking(self.master, False)
        self.last_line = pty_get_line(self.slave) or dict(br.line)
        self.opens = 0
        self.mode = "none"
        self.ino = None
        self.link_path = link_path
        self.stop = threading.Event()
        force = os.environ.get("NEXO_USB_WATCH", "")       # solo para depurar: inotify | proc | none
        try:
            if force in ("proc", "none"):
                raise OSError(errno.ENOSYS, "desactivado con NEXO_USB_WATCH=%s" % force)
            self.ino = inotify_watch(self.path)
            self.mode = "inotify"
        except OSError as e:
            dbg("inotify no sirve aquí (%s)" % (e.strerror or e))
            if force != "none" and proc_holders(self.path) is not None:
                self.mode = "proc"
        if self.mode == "none" and auto_reset:
            log("Aviso: no puedo saber cuándo un programa abre o cierra el puerto (ni inotify ni /proc): sin reinicio automático del Arduino. "
                "«nexo usb reset» lo reinicia a mano.")
        self.sink = Sink("pty", self._write_master, lambda e: log("PTY: %s" % e))
        self._link()
        threading.Thread(target=self._run, name="pty", daemon=True).start()

    def _link(self):
        lp = self.link_path
        d = os.path.dirname(lp)
        if d:
            try:
                os.makedirs(d, 0o700)
            except OSError as e:
                if e.errno != errno.EEXIST:
                    raise UsbError("No puedo crear la carpeta %s (%s)" % (d, e.strerror or e))
        tmp = "%s.%d.tmp" % (lp, os.getpid())
        try:
            os.symlink(self.path, tmp)
            if os.path.isdir(lp) and not os.path.islink(lp):
                raise UsbError("%s es una carpeta: pon --link con un nombre de archivo" % lp, EXIT_USAGE)
            os.replace(tmp, lp)
        except OSError as e:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise UsbError("No puedo crear el enlace %s (%s)" % (lp, e.strerror or e))

    def deliver(self, data):
        """Lo que llega del dispositivo. Si nadie tiene abierto el puerto se tira (así el siguiente que lo abra no recibe restos)."""
        if self.opens > 0 or self.mode == "none":
            self.sink.put(data)

    def _write_master(self, data):
        view = memoryview(data)
        while view and not self.stop.is_set():
            if self.opens == 0 and self.mode != "none":
                return
            try:
                n = os.write(self.master, view)
            except BlockingIOError:
                select.select([], [self.master], [], 0.2)
                continue
            except OSError as e:
                if e.errno == errno.EIO:
                    return
                raise
            view = view[n:]

    def _opened(self):
        self.sink.clear()
        try:
            termios.tcflush(self.slave, termios.TCIFLUSH)
        except termios.error:
            pass
        log("puerto %s abierto por un programa" % os.path.basename(self.link_path))
        if self.auto_reset and self.br.reset_pulse(hold=True):
            time.sleep(RESET_SETTLE)

    def _closed(self):
        self.sink.clear()
        log("puerto %s cerrado" % os.path.basename(self.link_path))
        if self.auto_reset:
            self.br.lines_off()

    def _follow(self):
        cur = pty_get_line(self.slave)
        if cur is not None and cur != self.last_line:
            self.last_line = cur
            self.br.set_line(cur, "PTY")

    def _run(self):
        next_scan = 0.0
        while not self.stop.is_set():
            fds = [self.master] + ([self.ino] if self.ino is not None else [])
            try:
                r, _, _ = select.select(fds, [], [], 0.05)
            except (OSError, ValueError):
                break
            if self.ino is not None and self.ino in r:
                for mask in inotify_masks(self.ino):
                    if mask & IN_OPEN:
                        self.opens += 1
                        if self.opens == 1:
                            self._opened()
                    elif mask & (IN_CLOSE_WRITE | IN_CLOSE_NOWRITE) and self.opens > 0:
                        self.opens -= 1
                        if self.opens == 0:
                            self._closed()
            if self.mode == "proc" and time.monotonic() >= next_scan:
                next_scan = time.monotonic() + 0.25
                n = proc_holders(self.path)
                if n is not None:
                    was = self.opens
                    self.opens = n
                    if n > 0 and was == 0:
                        self._opened()
                    elif n == 0 and was > 0:
                        self._closed()
            if self.master in r:
                try:
                    data = os.read(self.master, 65536)
                except (BlockingIOError, InterruptedError):
                    data = b""
                except OSError:
                    data = b""
                    time.sleep(0.05)
                self._follow()                    # primero la velocidad nueva y después los datos
                if data:
                    self.br.tx(data)
            else:
                self._follow()

    def close(self):
        self.stop.set()
        self.sink.close()
        try:
            if os.readlink(self.link_path) == self.path:
                os.unlink(self.link_path)
        except OSError:
            pass
        for fd in (self.ino, self.master, self.slave):
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass


# ----------------------------------------------------------------------------------------------------- bridge: red

IAC, DONT, DO, WONT, WILL, SB, SE = 255, 254, 253, 252, 251, 250, 240
T_BINARY, T_ECHO, T_SGA, T_COM = 0, 1, 3, 44
(C_SIGNATURE, C_BAUD, C_DATASIZE, C_PARITY, C_STOPSIZE, C_CONTROL, C_LINESTATE, C_MODEMSTATE, C_FC_SUSPEND, C_FC_RESUME,
 C_LINEMASK, C_MODEMMASK, C_PURGE) = range(13)
RFC_PARITY = {1: "none", 2: "odd", 3: "even", 4: "mark", 5: "space"}
PARITY_RFC = dict((v, k) for k, v in RFC_PARITY.items())
RFC_STOP = {1: 1, 2: 2, 3: 1.5}
STOP_RFC = {1: 1, 2: 2, 1.5: 3}


class NetClient(object):
    """Un cliente TCP del puente (RFC2217 o crudo): un hilo que lee, y una cola con su hilo que escribe."""

    kind = "net"
    count = 0

    def __init__(self, br, sock, addr):
        NetClient.count += 1
        self.br, self.sock, self.addr = br, sock, addr
        self.n = NetClient.count
        self.closed = False
        self.sink = Sink("%s%d" % (self.kind, self.n), self._send, lambda e: self.close("no pude escribirle (%s)" % e))

    def _send(self, data):
        self.sock.sendall(data)

    def start(self):
        threading.Thread(target=self._run, name="%s%d" % (self.kind, self.n), daemon=True).start()

    def deliver(self, data):
        self.sink.put(data)

    def close(self, why=""):
        if self.closed:
            return
        self.closed = True
        self.sink.close()
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass
        self.br.client_left(self, why)

    def _run(self):
        try:
            self.br.client_joined(self)
            self.loop()
            self.close("")
        except OSError as e:
            self.close(e.strerror or "")
        except Exception as e:
            log("error con el cliente %s %s: %r" % (self.kind, self.addr, e))
            self.close("error interno")

    def loop(self):
        raise NotImplementedError


class RawClient(NetClient):
    """TCP crudo: lo que entra va al dispositivo y lo que sale del dispositivo va al cliente (avrdude net:, nc, socat…)."""

    kind = "raw"

    def loop(self):
        while not self.closed:
            data = self.sock.recv(65536)
            if not data:
                return
            self.br.tx(data)


class Rfc2217Client(NetClient):
    """Servidor RFC 2217 (control de puerto serie sobre Telnet): lo que hablan pyserial («rfc2217://»), esptool y PlatformIO."""

    kind = "rfc2217"

    def __init__(self, br, sock, addr):
        NetClient.__init__(self, br, sock, addr)
        self.st = 0
        self.cmd = 0
        self.sb = bytearray()
        self.we = {}                  # opción → 0 no · 1 la pedimos · 2 sí      (lo que hacemos nosotros: WILL)
        self.they = {}                # lo mismo para lo que hace el cliente     (DO)
        self.line = dict(br.line)
        self.dtr = br.dtr
        self.rts = br.rts
        self.brk = False
        self.touched = False

    def deliver(self, data):
        self.sink.put(data.replace(b"\xff", b"\xff\xff"))

    def _put(self, *b):
        self.sink.put(bytes(bytearray(b)))

    def hello(self):
        for opt in (T_COM, T_BINARY):
            self.we[opt] = 1
            self._put(IAC, WILL, opt)
            self.they[opt] = 1
            self._put(IAC, DO, opt)
        self.we[T_SGA] = 1
        self._put(IAC, WILL, T_SGA)
        self.we[T_ECHO] = 1
        self._put(IAC, WILL, T_ECHO)

    def loop(self):
        self.hello()
        while not self.closed:
            data = self.sock.recv(65536)
            if not data:
                return
            user = self.feed(data)
            if user:
                self.br.tx(user)

    # --- Telnet
    def feed(self, data):
        if self.st == 0 and b"\xff" not in data:
            return data
        out = bytearray()
        for b in bytearray(data):
            st = self.st
            if st == 0:
                if b == IAC:
                    self.st = 1
                else:
                    out.append(b)
            elif st == 1:
                if b == IAC:
                    out.append(255)
                    self.st = 0
                elif b in (WILL, WONT, DO, DONT):
                    self.cmd = b
                    self.st = 2
                elif b == SB:
                    self.sb = bytearray()
                    self.st = 3
                else:
                    self.st = 0
            elif st == 2:
                self.option(self.cmd, b)
                self.st = 0
            elif st == 3:
                if b == IAC:
                    self.st = 4
                else:
                    self.sb.append(b)
            else:
                if b == IAC:
                    self.sb.append(255)
                    self.st = 3
                elif b == SE:
                    self.sub(bytes(self.sb))
                    self.st = 0
                else:
                    self.st = 0
        return bytes(out)

    def option(self, cmd, opt):
        mine = opt in (T_COM, T_BINARY, T_SGA, T_ECHO)          # lo que ofrecemos (WILL)
        theirs = opt in (T_COM, T_BINARY)                       # lo que le pedimos al cliente (DO)
        if cmd == DO:
            if mine:
                if self.we.get(opt, 0) == 0:
                    self._put(IAC, WILL, opt)
                self.we[opt] = 2
            else:
                self._put(IAC, WONT, opt)
        elif cmd == DONT:
            if self.we.get(opt, 0) == 2:
                self._put(IAC, WONT, opt)
            self.we[opt] = 0
        elif cmd == WILL:
            if theirs:
                if self.they.get(opt, 0) == 0:
                    self._put(IAC, DO, opt)
                self.they[opt] = 2
            else:
                self._put(IAC, DONT, opt)
        elif cmd == WONT:
            if self.they.get(opt, 0) == 2:
                self._put(IAC, DONT, opt)
            self.they[opt] = 0

    def reply(self, code, value=b""):
        payload = (bytes(bytearray([code + 100])) + value).replace(b"\xff", b"\xff\xff")
        self.sink.put(bytes(bytearray([IAC, SB, T_COM])) + payload + bytes(bytearray([IAC, SE])))

    def sub(self, p):
        if len(p) < 2 or p[0] != T_COM:
            return
        cmd, val = p[1], p[2:]
        br = self.br
        if cmd == C_SIGNATURE:
            self.reply(C_SIGNATURE, ("Nexo USB " + NEXO_USB_VERSION).encode())
        elif cmd == C_BAUD and len(val) == 4:
            n = struct.unpack("!I", val)[0]
            if n and 50 <= n <= 4000000:
                self.line["baud"] = n
                self.apply_line()
            self.reply(C_BAUD, struct.pack("!I", self.line["baud"]))
        elif cmd == C_DATASIZE and len(val) == 1:
            if val[0] in (5, 6, 7, 8):
                self.line["bits"] = val[0]
                self.apply_line()
            self.reply(C_DATASIZE, bytes(bytearray([self.line["bits"]])))
        elif cmd == C_PARITY and len(val) == 1:
            if val[0] in RFC_PARITY:
                self.line["parity"] = RFC_PARITY[val[0]]
                self.apply_line()
            self.reply(C_PARITY, bytes(bytearray([PARITY_RFC[self.line["parity"]]])))
        elif cmd == C_STOPSIZE and len(val) == 1:
            if val[0] in RFC_STOP:
                self.line["stop"] = RFC_STOP[val[0]]
                self.apply_line()
            self.reply(C_STOPSIZE, bytes(bytearray([STOP_RFC[self.line["stop"]]])))
        elif cmd == C_CONTROL and len(val) == 1:
            self.control(val[0])
        elif cmd == C_LINEMASK and len(val) == 1:
            self.reply(C_LINEMASK, val)
        elif cmd == C_MODEMMASK and len(val) == 1:
            self.reply(C_MODEMMASK, val)
            self.sink.put(bytes(bytearray([IAC, SB, T_COM, C_MODEMSTATE + 100, 0xB0 & val[0], IAC, SE])))
        elif cmd == C_PURGE and len(val) == 1:
            self.reply(C_PURGE, val)
        elif cmd in (C_FC_SUSPEND, C_FC_RESUME):
            pass

    def apply_line(self):
        self.touched = True
        self.br.set_line(self.line, "RFC2217")

    def control(self, v):
        """SET-CONTROL: DTR, RTS, BREAK y control de flujo. La respuesta repite el valor pedido (así lo comprueba pyserial)."""
        if v == 0:
            self.reply(C_CONTROL, b"\x01")                     # ¿control de flujo? → ninguno
        elif v == 1:
            self.reply(C_CONTROL, b"\x01")
        elif v in (2, 3):
            log("RFC2217: un cliente pide control de flujo por %s y Nexo no lo tiene; sigue sin control de flujo"
                % ("XON/XOFF" if v == 2 else "RTS/CTS"))
            self.reply(C_CONTROL, b"\x01")                     # la verdad: no se aplica
        elif v == 4:
            self.reply(C_CONTROL, b"\x05" if self.brk else b"\x06")
        elif v in (5, 6):
            self.brk = v == 5
            self.touched = True
            self.br.set_break(self.brk)
            self.reply(C_CONTROL, bytes(bytearray([v])))
        elif v == 7:
            self.reply(C_CONTROL, b"\x08" if self.dtr else b"\x09")
        elif v in (8, 9):
            self.dtr = v == 8
            self.touched = True
            self.br.set_lines(self.dtr, self.rts)
            self.reply(C_CONTROL, bytes(bytearray([v])))
        elif v == 10:
            self.reply(C_CONTROL, b"\x0b" if self.rts else b"\x0c")
        elif v in (11, 12):
            self.rts = v == 11
            self.touched = True
            self.br.set_lines(self.dtr, self.rts)
            self.reply(C_CONTROL, bytes(bytearray([v])))


class Listener(object):
    def __init__(self, br, cls, host, port):
        self.br, self.cls = br, cls
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            self.sock.bind((host, port))
        except OSError as e:
            self.sock.close()
            raise UsbError("No puedo escuchar en %s:%d (%s). ¿Ya hay un puente en ese puerto? (mira: nexo usb status)" % (host, port, e.strerror or e))
        self.sock.listen(5)
        self.sock.settimeout(0.5)
        self.host, self.port = host, self.sock.getsockname()[1]
        self.stop = threading.Event()
        threading.Thread(target=self._accept, name="listen-%s" % cls.kind, daemon=True).start()

    def _accept(self):
        while not self.stop.is_set():
            try:
                c, addr = self.sock.accept()
            except socket.timeout:
                continue
            except OSError:
                return
            if self.br.session is None:
                c.close()                         # sin dispositivo no hay a quién conectar
                continue
            c.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            c.settimeout(None)
            self.cls(self.br, c, addr).start()

    def close(self):
        self.stop.set()
        try:
            self.sock.close()
        except OSError:
            pass


# ----------------------------------------------------------------------------------------------------- bridge: el puente


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except (ValueError, TypeError, OverflowError, OSError):
        return False
    return True


def is_ours(pid):
    """¿Es de verdad un nexo-usb? (por si el sistema reutilizó el número de proceso)"""
    try:
        with open("/proc/%d/cmdline" % int(pid), "rb") as f:
            return b"nexo-usb" in f.read()
    except (OSError, ValueError):
        return True                           # sin /proc no se puede saber: se fía del número


def cleanup_state(path, st):
    lp = st.get("link")
    try:
        if lp and os.readlink(lp) == st.get("pty"):
            os.unlink(lp)
    except OSError:
        pass
    try:
        os.unlink(path)
    except OSError:
        pass


def read_states(clean=True):
    """Los puentes en marcha (sus archivos de estado; los de procesos que ya no existen se limpian)."""
    d = state_dir()
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return []
    out = []
    for fn in names:
        if not fn.endswith(".json"):
            continue
        p = os.path.join(d, fn)
        try:
            with open(p, encoding="utf-8") as f:
                st = json.load(f)
        except (OSError, ValueError):
            continue
        if not isinstance(st, dict) or "name" not in st:
            continue
        if not pid_alive(st.get("pid")) or not is_ours(st.get("pid")):
            if clean:
                cleanup_state(p, st)
            continue
        out.append(st)
    return out


def free_name():
    live = set(s.get("name") for s in read_states())
    for n in range(100):
        if "usb%d" % n not in live:
            return "usb%d" % n
    raise UsbError("Hay demasiados puentes USB en marcha (mira: nexo usb status).")


def format_banner(info, detached):
    d = info.get("device") or {}
    out = ["✔ %s (%s:%s) · %s · %s" % (d.get("title") or "?", d.get("vid"), d.get("pid"), info.get("driver", "?"), line_str(info["line"]))]
    if info.get("link"):
        out.append("  Puerto serie:  %s" % info["link"])
        out.append("                 úsalo donde pondrías /dev/ttyACM0 (avrdude -P, arduino-cli -p, minicom -D, screen, pyserial…)")
        if info.get("auto_reset"):
            out.append("                 al abrirlo un programa, el Arduino se reinicia (como en un PC); --no-auto-reset lo evita")
    if info.get("rfc2217"):
        out.append("  RFC2217:       rfc2217://%s   (esptool --port rfc2217://%s · pyserial serial_for_url)" % (info["rfc2217"], info["rfc2217"]))
    if info.get("tcp"):
        out.append("  TCP crudo:     %s   (avrdude -c arduino -P net:%s)" % (info["tcp"], info["tcp"]))
    out.append("  Para cerrarlo: nexo usb stop %s%s" % (info.get("name", ""), "" if detached else "   (o Ctrl+C en esta terminal)"))
    return "\n".join(out)


class FgNotifier(object):
    """El puente en primer plano: todo va a la terminal."""
    detached = False

    def say(self, msg):
        log(msg)

    def ready(self, info):
        log(format_banner(info, False))

    def fail(self, e):
        pass


class PipeNotifier(object):
    """El puente en segundo plano: hasta estar listo, cuenta lo que pasa al proceso que lo lanzó (por un tubo) y al registro."""
    detached = True

    def __init__(self, fd):
        self.fd = fd

    def _w(self, obj):
        if self.fd is not None:
            try:
                os.write(self.fd, jline(obj))
            except OSError:
                pass

    def say(self, msg):
        log(msg)
        self._w({"t": "msg", "m": msg})

    def ready(self, info):
        log("listo: %s" % json.dumps(info, ensure_ascii=False))
        self._w({"t": "ready", "info": info})
        self.close()

    def fail(self, e):
        self._w({"t": "fail", "code": e.code, "m": e.message})
        self.close()

    def close(self):
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None


class Bridge(object):
    """Mantiene abierto el adaptador y lo ofrece por el PTY, RFC2217 y TCP; si se desenchufa, espera y lo vuelve a abrir."""

    def __init__(self, o, nt):
        self.o = o
        self.nt = nt
        self.stop = threading.Event()
        self.wake = threading.Event()
        self.reset_req = threading.Event()
        self.slock = threading.Lock()
        self.sel = o.get("sel")
        self.sig = None
        self.line = dict(o["line"])
        self.dtr = bool(o.get("dtr", False))
        self.rts = bool(o.get("rts", False))
        self.session = None
        self.pty = None
        self.listeners = []
        self.clients = set()
        self.name = o["name"]
        self.state_path = os.path.join(state_dir(), self.name + ".json")
        self.started = int(time.time())
        self.rx_bytes = 0
        self.tx_bytes = 0
        self.dropped_tx = 0
        self.warned_down = False
        self.auto_reset = not o.get("no_auto_reset")
        self.closed = False

    def say(self, msg):
        self.nt.say(msg)

    # --- lo que usan las vías (PTY, clientes de red)

    def on_rx(self, data):
        self.rx_bytes += len(data)
        p = self.pty
        if p is not None:
            p.deliver(data)
        with self.slock:
            cs = list(self.clients)
        for c in cs:
            c.deliver(data)

    def tx(self, data):
        s = self.session
        if s is not None and s.send(data):
            self.tx_bytes += len(data)
            return
        if not self.warned_down:
            self.warned_down = True
            log("no hay dispositivo: se descarta lo que escriben los programas")
        self.dropped_tx += len(data)

    def set_line(self, line, who):
        line = dict(line)
        if line == self.line:
            return
        self.line = line
        log("línea serie (%s): %s" % (who, line_str(line)))
        s = self.session
        if s is not None:
            s.ctl(("setup", dict(line)))
        self.write_state()

    def set_lines(self, dtr, rts):
        self.dtr, self.rts = bool(dtr), bool(rts)
        s = self.session
        if s is not None:
            s.ctl(("lines", self.dtr, self.rts))

    def lines_off(self):
        self.set_lines(False, False)

    def set_break(self, on):
        s = self.session
        if s is not None:
            s.ctl(("brk", bool(on)))

    def reset_pulse(self, hold=True):
        """DTR/RTS de apagado a encendido: es lo que reinicia un Arduino (y lo que hace un PC al abrir el puerto)."""
        if self.session is None:
            return False
        self.set_lines(False, False)
        time.sleep(0.05)
        self.set_lines(True, True)
        if not hold:
            time.sleep(0.1)
            self.lines_off()
        return True

    def manual_reset(self):
        if self.session is None:
            log("reinicio: no hay dispositivo conectado")
            return
        keep = (self.pty is not None and self.pty.opens > 0) or any(c.kind == "raw" for c in list(self.clients))
        log("reinicio de la placa (pulso en DTR)")
        self.reset_pulse(hold=keep)

    def client_joined(self, c):
        with self.slock:
            self.clients.add(c)
            n_raw = sum(1 for x in self.clients if x.kind == "raw")
        log("cliente %s conectado (%s:%s)" % (c.kind, c.addr[0], c.addr[1]))
        if c.kind == "raw" and n_raw == 1 and self.auto_reset and self.reset_pulse(hold=True):
            time.sleep(RESET_SETTLE)

    def client_left(self, c, why):
        with self.slock:
            self.clients.discard(c)
            raw = sum(1 for x in self.clients if x.kind == "raw")
            rfc = sum(1 for x in self.clients if x.kind == "rfc2217")
        log("cliente %s desconectado%s" % (c.kind, " (%s)" % why if why else ""))
        if self.session is None or self.stop.is_set():
            return
        if (c.kind == "raw" and raw == 0 and self.auto_reset) or (c.kind == "rfc2217" and rfc == 0 and getattr(c, "touched", False)):
            self.lines_off()

    # --- el dispositivo

    def on_event(self, name, data):
        if name != "usb":
            return
        s = self.session
        devs, sess = data.get("devices"), data.get("sessions")
        if s is None or s.closed.is_set() or devs is None:
            return
        if not any(d.get("id") == s.dev.get("id") for d in devs):
            s.fail("el dispositivo se desenchufó")
        elif sess is not None and not any(x.get("session") == s.id for x in sess):
            s.fail("la app cerró la sesión USB")

    def pick(self, devs, sessions):
        busy = set(x.get("device") for x in sessions)
        if self.sig is None:
            return choose_device(devs, self.sel, True)
        cands = [d for d in devs if d.get("serial_capable") and sig_matches(self.sig, d)]
        if not cands:
            raise UsbError("Esperando a %s:%s%s…" % (self.sig[0], self.sig[1], " (serie %s)" % self.sig[2] if self.sig[2] else ""), EXIT_NODEV)
        return ([d for d in cands if d.get("id") not in busy] or cands)[0]

    def acquire_once(self):
        cfg = load_config()                       # se relee: «nexo rekey» puede haber cambiado el token
        if not cfg["NEXO_TOKEN"]:
            raise UsbError("No hay token. Pega el comando de instalación de la app, o usa: nexo pair TOKEN", EXIT_TOKEN)
        link = Link(cfg, self.on_event)
        link.connect()
        try:
            if not usb_capable(link.info):
                raise UsbError("Esta versión de la app Nexo no sabe de USB: instala el APK de la 0.4.1 o más nuevo.", EXIT_ERR)
            st = call_app(link, "usb.status")
            dev = self.pick(st.get("devices") or [], st.get("sessions") or [])
            ensure_permission(link, dev, self.say, self.o.get("perm_timeout", 60.0), self.stop)
            if self.pty is not None and self.pty.opens > 0 and self.auto_reset:
                self.dtr = self.rts = True        # un programa sigue con el puerto abierto: el dispositivo nuevo nace «abierto»
            view = call_app(link, "usb.open", 15.0, device=dev["id"], dtr=self.dtr, rts=self.rts, **self.line)
            try:
                sock, rest = open_data(cfg, view["session"])
            except BridgeError as e:
                try:
                    link.call("usb.close", 3.0, session=view["session"])
                except BridgeError:
                    pass
                raise explain(e)
            sess = Session(self, link, dev, view, sock, rest)
            self.session = sess
            sess.start()
            try:
                link.call("subscribe", 5.0, topics=["usb"])
            except BridgeError:
                pass
            self.sig = dev_signature(dev)
            return sess
        except BaseException:
            self.session = None
            link.close()
            raise

    def acquire(self, first):
        delay, tries, told = 0.5, 0, None
        while True:
            if self.stop.is_set():
                raise Stopped()
            try:
                return self.acquire_once()
            except BridgeError as e:
                err = explain(e)
            except UsbError as e:
                err = e
            if isinstance(err, Transient):
                tries += 1
                fatal = first and tries > 5
            elif err.code == EXIT_NODEV:
                fatal = first and not self.o.get("wait")
            elif err.code in (EXIT_NOAPP, EXIT_TIMEOUT, EXIT_TOKEN):
                fatal = first
            else:
                fatal = True
            if fatal:
                raise err
            if err.message != told:
                self.say(err.message if err.code == EXIT_NODEV and not first else err.message)
                told = err.message
            if self.stop.wait(delay):
                raise Stopped()
            delay = min(delay * 1.5, 3.0)

    def drop_session(self, sess):
        self.session = None
        with self.slock:
            cs = list(self.clients)
        for c in cs:
            c.close("el dispositivo ya no está")
        self.dtr, self.rts = bool(self.o.get("dtr", False)), bool(self.o.get("rts", False))
        sess.close(polite=not sess.link.dead.is_set())

    # --- vías, estado, bucle

    def create_frontends(self):
        o = self.o
        if not o.get("no_pty"):
            self.pty = PtyFront(self, o.get("link") or os.path.join(state_dir(), self.name + ".tty"), self.auto_reset)
        for key, cls in (("rfc2217", Rfc2217Client), ("tcp", RawClient)):
            hp = o.get(key)
            if hp:
                if hp[0] not in ("127.0.0.1", "localhost", "::1"):
                    self.say("Aviso: %s escucha en %s, no solo en este móvil, y no tiene contraseña: cualquiera de esa red podrá usar el adaptador." % (key, hp[0]))
                l = Listener(self, cls, hp[0], hp[1])
                l.key = key
                self.listeners.append(l)

    def info(self, state="conectado"):
        s = self.session
        d = s.dev if s is not None else None
        info = {"name": self.name, "pid": os.getpid(), "version": NEXO_USB_VERSION, "started": self.started, "state": state,
                "line": dict(self.line), "log": self.o.get("log_path"), "auto_reset": self.auto_reset}
        if d is not None:
            info["device"] = {"id": d.get("id"), "vid": d.get("vid"), "pid": d.get("pid"), "vendor": d.get("vendor"),
                              "product": d.get("product"), "serial": d.get("serial"), "title": dev_title(d)}
            info["driver"] = s.view.get("driver")
        elif self.sig is not None:
            info["device"] = {"vid": self.sig[0], "pid": self.sig[1], "serial": self.sig[2], "title": "%s:%s" % (self.sig[0], self.sig[1])}
        if self.pty is not None:
            info["pty"], info["link"], info["pty_watch"] = self.pty.path, self.pty.link_path, self.pty.mode
        for l in self.listeners:
            info[l.key] = "%s:%d" % (l.host, l.port)
        return info

    def write_state(self, state="conectado"):
        try:
            ensure_state_dir()
            tmp = self.state_path + ".tmp"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(self.info(state), f, ensure_ascii=False)
            os.replace(tmp, self.state_path)
        except (OSError, UsbError) as e:
            dbg("no pude escribir el estado: %s" % e)

    def shutdown(self):
        if self.closed:
            return
        self.closed = True
        self.stop.set()
        s, self.session = self.session, None
        if s is not None:
            s.close(polite=not s.link.dead.is_set())
        for l in self.listeners:
            l.close()
        with self.slock:
            cs = list(self.clients)
        for c in cs:
            c.close("el puente se cierra")
        if self.pty is not None:
            self.pty.close()
        try:
            os.unlink(self.state_path)
        except OSError:
            pass
        log("puente cerrado · recibido %d bytes del dispositivo · enviado %d" % (self.rx_bytes, self.tx_bytes))

    def run(self):
        code = 0
        try:
            sess = self.acquire(True)
            self.create_frontends()
            self.write_state()
            self.nt.ready(self.info())
            while True:
                while not self.stop.is_set() and not sess.closed.is_set():
                    self.wake.wait(0.5)
                    self.wake.clear()
                    if self.reset_req.is_set():
                        self.reset_req.clear()
                        self.manual_reset()
                if self.stop.is_set():
                    break
                reason = sess.lost_reason or "se perdió el dispositivo"
                self.drop_session(sess)
                log("USB: %s" % reason)
                if not self.o.get("reconnect", True):
                    code = EXIT_GONE
                    break
                self.write_state("esperando")
                self.say("Esperando a que vuelva el dispositivo… (el puerto se queda donde está)")
                try:
                    sess = self.acquire(False)
                except Stopped:
                    break
                except UsbError as e:
                    self.say("error: %s" % e.message)
                    code = e.code
                    break
                self.warned_down = False
                self.write_state()
                self.say("Dispositivo de vuelta: %s · %s" % (dev_title(sess.dev), line_str(self.line)))
        except Stopped:
            pass
        finally:
            self.shutdown()
        return code


def run_bridge(o, nt):
    br = Bridge(o, nt)

    def term(_sig, _frm):
        br.stop.set()
        br.wake.set()

    def usr1(_sig, _frm):
        br.reset_req.set()
        br.wake.set()
    signal.signal(signal.SIGTERM, term)
    signal.signal(signal.SIGINT, term)
    signal.signal(signal.SIGHUP, signal.SIG_IGN if nt.detached else term)
    signal.signal(signal.SIGUSR1, usr1)
    try:
        return br.run()
    except UsbError as e:
        nt.fail(e)
        if not nt.detached:
            log("nexo usb: %s" % e.message)
        else:
            log("error: %s" % e.message)
        return e.code
    except Exception:
        import traceback
        log("error inesperado:\n" + traceback.format_exc())
        nt.fail(UsbError("error inesperado (mira el registro)", EXIT_ERR))
        return EXIT_ERR


def wait_ready(r, logpath):
    buf = b""
    end = time.monotonic() + 180
    while True:
        left = end - time.monotonic()
        if left <= 0:
            log("nexo usb: el puente tarda demasiado en estar listo. Mira su registro: %s" % logpath)
            return EXIT_TIMEOUT
        rl, _, _ = select.select([r], [], [], min(left, 1.0))
        if not rl:
            continue
        chunk = os.read(r, 65536)
        if not chunk:
            log("nexo usb: el puente en segundo plano terminó sin avisar. Mira su registro: %s" % logpath)
            return EXIT_ERR
        buf += chunk
        while b"\n" in buf:
            line, _, buf = buf.partition(b"\n")
            try:
                m = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            t = m.get("t")
            if t == "msg":
                log(m.get("m", ""))
            elif t == "ready":
                log(format_banner(m["info"], True))
                return 0
            elif t == "fail":
                log("nexo usb: %s" % m.get("m"))
                return int(m.get("code", EXIT_ERR))


def start_detached(o):
    ensure_state_dir()
    r, w = os.pipe()
    pid = os.fork()
    if pid > 0:
        os.close(w)
        try:
            os.waitpid(pid, 0)                    # el intermedio sale enseguida
        except OSError:
            pass
        return wait_ready(r, o["log_path"])
    code = EXIT_ERR
    try:
        os.close(r)
        os.setsid()
        if os.fork() > 0:
            os._exit(0)
        devnull = os.open(os.devnull, os.O_RDWR)
        os.dup2(devnull, 0)
        lf = os.open(o["log_path"], os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        os.dup2(lf, 1)
        os.dup2(lf, 2)
        Log.stream = os.fdopen(2, "w", buffering=1, encoding="utf-8", errors="replace", closefd=False)
        Log.stamp = True
        code = run_bridge(o, PipeNotifier(w))
    except BaseException:
        pass
    finally:
        os._exit(code)


def cmd_bridge(argv):
    spec = dict(LINE_SPEC)
    spec.update({"--link": ("link", str), "--no-pty": ("no_pty", True), "--rfc2217": ("rfc2217", to_hostport),
                 "--tcp": ("tcp", to_hostport), "--no-auto-reset": ("no_auto_reset", True), "--name": ("name", str),
                 "--detach": ("detach", True), "-d": ("detach", True), "--no-reconnect": ("no_reconnect", True),
                 "--wait": ("wait", True), "--dtr": ("dtr", to_onoff), "--rts": ("rts", to_onoff),
                 "--perm-timeout": ("perm_timeout", to_seconds), "--log": ("log", str), "--verbose": ("verbose", True),
                 "-v": ("verbose", True)})
    o, pos = parse_args(argv, spec)
    if len(pos) > 1:
        raise UsbError("Solo un DISPOSITIVO. Prueba: nexo usb help", EXIT_USAGE)
    if o.get("no_pty") and not o.get("rfc2217") and not o.get("tcp"):
        raise UsbError("Con --no-pty hace falta --rfc2217 o --tcp; si no, no hay por dónde usar el adaptador.", EXIT_USAGE)
    if o.get("no_pty") and o.get("link"):
        raise UsbError("--link y --no-pty se contradicen.", EXIT_USAGE)
    cfg = load_config()
    if not cfg["NEXO_TOKEN"]:
        raise UsbError("No hay token. Pega en Termux el comando de instalación que copia la app Nexo, o usa: nexo pair TOKEN", EXIT_TOKEN)
    line = line_from_opts(o)
    live = set(s.get("name") for s in read_states())
    name = o.get("name")
    if name:
        if not re.match(r"^[A-Za-z0-9_.-]{1,32}$", name):
            raise UsbError("--name: letras, números, «.», «_» y «-» (hasta 32)", EXIT_USAGE)
        if name in live:
            raise UsbError("Ya hay un puente llamado «%s» en marcha (nexo usb stop %s)." % (name, name), EXIT_USAGE)
    else:
        name = free_name()
    ensure_state_dir()
    opts = {"sel": pos[0] if pos else None, "line": line, "name": name, "dtr": o.get("dtr", False), "rts": o.get("rts", False),
            "link": os.path.abspath(os.path.expanduser(o["link"])) if o.get("link") else None, "no_pty": o.get("no_pty", False),
            "rfc2217": o.get("rfc2217"), "tcp": o.get("tcp"), "no_auto_reset": o.get("no_auto_reset", False),
            "reconnect": not o.get("no_reconnect", False), "wait": o.get("wait", False), "perm_timeout": o.get("perm_timeout", 60.0),
            "log_path": os.path.abspath(os.path.expanduser(o["log"])) if o.get("log") else os.path.join(state_dir(), name + ".log")}
    Log.verbose = bool(o.get("verbose"))
    if o.get("detach"):
        return start_detached(opts)
    return run_bridge(opts, FgNotifier())


# ----------------------------------------------------------------------------------------------------- discos USB

# ----------------------------------------------------------------------------------------------------- discos USB: archivos
#
# Android monta el disco por su cuenta (lo hace vold: ni se puede ni se debe repetir desde proot) y lo enseña como un «volumen».
# Hay dos maneras de entrar en él y las dos dan los mismos resultados (las pruebas lo comparan):
#   · por la app (lo normal): Nexo abre el disco con el Storage Access Framework de Android, dentro de la carpeta que TÚ elegiste en el
#     selector del sistema (nexo usb access), y este programa le pide cada operación por el protocolo (storage.*).
#   · directa: si este proceso ya puede ver la ruta del disco (/storage/XXXX-XXXX) —con root, con Shizuku/rish, o porque el Android de
#     ese móvil lo permite— trabaja con ella sin pasar por la app. Nunca sale de la raíz del disco ni sigue enlaces simbólicos.

READ_CHUNK = 49152           # = StorageLimits.READ_MAX en la app: lo máximo que devuelve un storage.read
WRITE_CHUNK = 32768          # = StorageLimits.WRITE_MAX: lo máximo que admite un storage.write
LIST_PAGE = 2000             # = StorageLimits.LIST_MAX: lo máximo que devuelve un storage.list
PIPE_DEPTH = 3               # peticiones en vuelo a la vez al copiar (la app las atiende una a una, pero así no espera entre trozo y trozo)
PART_PREFIX = ".nexo-part-"  # los archivos se escriben con un nombre así (+ pid y número) y se renombran al terminar: nunca queda a medias uno con el nombre bueno
BAD_NEW_CHARS = '"*:<>?\\|'  # Android cambia estos por «_» al crear algo en un disco: se rechazan antes (como StoragePath.checkNewName)
MAX_PATH_CHARS = 4096
TOO_BIG_HINT = " Formatea el disco en exFAT o parte el archivo (split -b 4000M)."
MAX_NAME_BYTES = 255
# Fallos que paran todo (no tiene sentido seguir con el siguiente archivo); el resto se anota y se sigue
FATAL_FS = ("no_access", "unavailable", "gone", "no_space", "read_only", "timeout", "no_connection", "limit", "local_full")

STATE_ES = {"mounted": "montado", "mounted_ro": "solo lectura", "unmounted": "no montado", "checking": "comprobando",
            "ejecting": "expulsando", "removed": "quitado", "bad_removal": "quitado sin expulsar", "unmountable": "no se puede montar",
            "nofs": "sin sistema de archivos", "shared": "compartido con un PC"}


class FsError(Exception):
    """Un fallo al trabajar con un disco. `code` son los de la app (docs/PROTOCOLO.md) más «gone» (el disco desapareció a mitad),
    «local» (falló algo de este lado: una carpeta o un archivo de tu distro) y los de red (timeout, no_connection)."""

    def __init__(self, code, message, extra=None):
        Exception.__init__(self, message)
        self.code = code
        self.message = message
        self.extra = extra or {}


def check_name(name):
    if not name:
        raise FsError("bad_path", "Un nombre está vacío")
    if name in (".", ".."):
        raise FsError("bad_path", "«%s» no se permite en una ruta" % name)
    for ch in name:
        if ch < " " or ch == "\x7f":
            raise FsError("bad_path", "Un nombre lleva un carácter de control")
    try:
        n = len(name.encode("utf-8"))
    except UnicodeEncodeError:
        raise FsError("bad_path", "Un nombre no es texto UTF-8 válido: %r" % name)
    if n > MAX_NAME_BYTES:
        raise FsError("bad_path", "Un nombre pasa de %d bytes" % MAX_NAME_BYTES)


def check_new_name(name):
    for ch in name:
        if ch in BAD_NEW_CHARS:
            raise FsError("bad_path", "Los discos USB no admiten el carácter «%s» en un nombre nuevo: «%s» (usa otro nombre)" % (ch, name))
    if name.endswith(".") or name.endswith(" "):
        raise FsError("bad_path", "Un nombre nuevo no puede acabar en punto ni en espacio: «%s»" % name)


def parse_path(path):
    """«/Música/rock/» → ["Música", "rock"]. Rechaza «..», caracteres de control y nombres larguísimos (igual que la app)."""
    if len(path) > MAX_PATH_CHARS:
        raise FsError("bad_path", "La ruta es demasiado larga")
    out = []
    for seg in path.split("/"):
        if seg in ("", "."):
            continue
        check_name(seg)
        out.append(seg)
    return out


def join_path(parts):
    return "/" + "/".join(parts)


def human(n):
    n = float(n)
    for u in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or u == "TiB":
            return ("%d %s" % (n, u)) if u == "B" else ("%.1f %s" % (n, u))
        n /= 1024.0


def when(ms):
    if not ms:
        return "—"
    try:
        return time.strftime("%Y-%m-%d %H:%M", time.localtime(ms / 1000.0))
    except (OverflowError, OSError, ValueError):
        return "—"


def out(text):
    """A la salida estándar, sin que un nombre raro rompa el programa."""
    try:
        sys.stdout.write(text)
    except UnicodeEncodeError:
        sys.stdout.flush()
        sys.stdout.buffer.write(text.encode("utf-8", "replace"))


def os_error(e, writing=False):
    n = e.errno
    msg = e.strerror or str(e)
    if n == errno.ENOENT:
        return FsError("not_found", msg)
    if n == errno.ENOTDIR:
        return FsError("not_dir", msg)
    if n == errno.EISDIR:
        return FsError("is_dir", msg)
    if n == errno.EEXIST:
        return FsError("exists", msg)
    if n == errno.ENOTEMPTY:
        return FsError("not_empty", msg)
    if n in (errno.ENOSPC, getattr(errno, "EDQUOT", -1)):
        return FsError("no_space", "El disco está lleno")
    if n == errno.EFBIG:
        return FsError("too_big", "El sistema de archivos del disco no admite un archivo tan grande (FAT32: máximo 4 GB)." + TOO_BIG_HINT)
    if n == errno.EROFS:
        return FsError("read_only", "El disco está en solo lectura")
    if n in (errno.EACCES, errno.EPERM):
        return FsError("denied", ("Sin permiso para escribir ahí: %s" if writing else "Sin permiso para leer: %s") % msg)
    if n in (errno.ENODEV, errno.ENXIO, errno.ESTALE):
        return FsError("gone", msg)
    return FsError("io_error", msg)


def app_error(e, gone=False):
    """Un BridgeError (respuesta con ok=false o conexión caída) → FsError. `gone`: un «not_found» al leer o escribir un archivo ya
    abierto quiere decir que Android cerró el archivo porque el disco se fue."""
    c = e.code
    if c in ("timeout", "no_connection"):
        return FsError(c, e.message)
    if c == "not_found" and gone:
        return FsError("gone", e.message, e.extra)
    if c == "too_big":
        return FsError(c, e.message.rstrip(".") + "." + TOO_BIG_HINT, e.extra)
    return FsError(c, e.message, e.extra)


def fs_to_usb(e):
    """Un FsError → el UsbError (mensaje y código de salida) que se le cuenta al usuario."""
    c, m, x = e.code, e.message, e.extra
    vol = x.get("volume")
    if c == "no_access":
        return UsbError("Nexo no tiene acceso a ese disco (o Android se lo quitó). Pídelo con:  nexo usb access%s  y elige el disco en la "
                        "pantalla del móvil." % ((" " + vol) if vol else ""), EXIT_TOUCH)
    if c == "unavailable":
        return UsbError("%s. Desenchúfalo y vuélvelo a enchufar; si Android sigue sin montarlo, puede que su sistema de archivos no sea "
                        "compatible (exFAT y FAT32 casi siempre lo son; NTFS y ext4 depende del móvil)." % m.rstrip("."), EXIT_NODEV)
    if c == "gone":
        return UsbError("Se perdió el disco durante la operación (¿lo desenchufaste o lo expulsaste?). Lo que se estaba copiando puede "
                        "haber quedado a medias: busca archivos «%s*» en el disco para borrarlos." % PART_PREFIX, EXIT_GONE)
    if c == "timeout":
        return UsbError(m, EXIT_TIMEOUT)
    if c == "no_connection":
        return UsbError(m, EXIT_NOAPP)
    if c in ("bad_request", "bad_path"):
        return UsbError(m, EXIT_USAGE)
    if c in ("local", "local_full"):
        return UsbError(m, EXIT_ERR)
    if c == "unknown_command":
        return UsbError("Esta versión de la app Nexo no sabe de discos USB. Instala el APK de la 0.4.2 o más nuevo (se actualiza encima, "
                        "sin perder el enlace).", EXIT_ERR)
    if c == "read_only":
        return UsbError("%s. Android lo montó así: ¿el pendrive tiene el interruptor de protección, o hay que repararlo en un PC?" % m.rstrip("."),
                        EXIT_ERR)
    return UsbError(m, EXIT_ERR)


def safe_local_name(name):
    return bool(name) and name not in (".", "..") and "/" not in name and "\x00" not in name


def close_quiet(f):
    try:
        f.close()
    except Exception:
        pass


def remove_quiet(path):
    try:
        os.unlink(path)
    except OSError:
        pass


def delete_quiet(fs, parts):
    try:
        fs.delete(parts)
    except Exception:
        pass


# ----------------------------------------------------------------------------------------------------- discos USB: las dos maneras de entrar


class Done(object):
    """Lo mismo que una respuesta pendiente de la app, pero ya resuelta (la manera directa no espera a nadie)."""

    def __init__(self, v):
        self.v = v

    def result(self):
        return self.v


class AppPending(object):
    def __init__(self, pend, after=None, timeout=30.0):
        self.pend, self.after, self.timeout = pend, after, timeout

    def result(self):
        try:
            d = self.pend.result(self.timeout)
        except BridgeError as e:
            raise app_error(e, gone=True)
        return self.after(d) if self.after is not None else d


class AppFile(object):
    """Un archivo abierto en la app (storage.open): se lee y se escribe por trozos."""

    def __init__(self, fs, handle, size, writable):
        self.fs, self.h, self.size, self.writable, self.closed = fs, handle, size, writable, False

    def _start(self, cmd, **p):
        try:
            return self.fs.link.call_async(cmd, **p)
        except BridgeError as e:
            raise app_error(e, gone=True)

    def read_async(self, off, n):
        return AppPending(self._start("storage.read", handle=self.h, offset=off, len=n),
                          lambda d: base64.b64decode(d.get("data") or ""))

    def read(self, off, n):
        return self.read_async(off, n).result()

    def write_async(self, off, data):
        return AppPending(self._start("storage.write", handle=self.h, offset=off, data=base64.b64encode(data).decode("ascii")),
                          lambda d: int(d.get("n", 0)))

    def write(self, off, data):
        return self.write_async(off, data).result()

    def close(self):
        """Cierra el archivo (si es de escritura, la app lo sincroniza antes: si el disco falla, falla aquí)."""
        if self.closed:
            return
        self.closed = True
        try:
            self.fs.link.call("storage.close", 30.0, handle=self.h)
        except BridgeError as e:
            raise app_error(e, gone=True)


class AppFs(object):
    """Entrar en el disco por la app de Nexo (storage.*)."""

    kind = "app"

    def __init__(self, link, vol):
        self.link = link
        self.uuid = vol["uuid"]
        self.label = vol.get("label") or vol["uuid"]
        self.read_only = bool(vol.get("readonly"))

    def _call(self, cmd, timeout=30.0, **p):
        try:
            return self.link.call(cmd, timeout, volume=self.uuid, **p)
        except BridgeError as e:
            raise app_error(e)

    def stat(self, parts):
        return self._call("storage.stat", path=join_path(parts))

    def stat_opt(self, parts):
        try:
            return self.stat(parts)
        except FsError as e:
            if e.code == "not_found":
                return None
            raise

    def list(self, parts):
        out_, off = [], 0
        while True:
            d = self._call("storage.list", 40.0, path=join_path(parts), offset=off, limit=LIST_PAGE)
            ents = d.get("entries") or []
            out_.extend(ents)
            off += len(ents)
            if not ents or off >= int(d.get("total") or 0):
                return out_

    def open(self, parts, mode="r", create=None, truncate=None, exclusive=None):
        d = self._call("storage.open", path=join_path(parts), mode=mode, create=create, truncate=truncate, exclusive=exclusive)
        return AppFile(self, d["handle"], int(d.get("size") or 0), bool(d.get("writable")))

    def mkdir(self, parts, parents=False):
        self._call("storage.mkdir", path=join_path(parts), parents=bool(parents))

    def delete(self, parts):
        self._call("storage.delete", path=join_path(parts))

    def rename(self, src, dst, overwrite=False):
        self._call("storage.rename", overwrite=bool(overwrite), **{"from": join_path(src), "to": join_path(dst)})


class DirectFile(object):
    def __init__(self, fd, writable):
        self.fd, self.writable, self.closed = fd, writable, False
        self.size = os.fstat(fd).st_size

    def read(self, off, n):
        try:
            return os.pread(self.fd, n, off)
        except OSError as e:
            raise os_error(e)

    def read_async(self, off, n):
        return Done(self.read(off, n))

    def write(self, off, data):
        done = 0
        try:
            while done < len(data):
                k = os.pwrite(self.fd, data[done:], off + done)
                if k <= 0:
                    raise FsError("io_error", "El disco no aceptó más datos")
                done += k
        except OSError as e:
            raise os_error(e, True)
        return done

    def write_async(self, off, data):
        return Done(self.write(off, data))

    def truncate(self, n):
        try:
            os.ftruncate(self.fd, n)
        except OSError as e:
            raise os_error(e, True)

    def close(self):
        if self.closed:
            return
        self.closed = True
        err = None
        try:
            if self.writable:
                os.fsync(self.fd)
        except OSError as e:
            err = os_error(e, True)
        finally:
            os.close(self.fd)
        if err is not None:
            raise err


class DirectFs(object):
    """Entrar en el disco por su ruta, sin la app: las mismas comprobaciones y los mismos errores que StorageOps (la app), sobre
    la carpeta real. Nunca sale de la raíz del disco y no sigue enlaces simbólicos (en FAT/exFAT no los hay: es como si no existieran)."""

    kind = "directo"

    def __init__(self, vol):
        self.root = vol["path"]
        self.label = vol.get("label") or vol["uuid"]
        self.read_only = bool(vol.get("readonly"))

    def _need_writable(self):
        if self.read_only:
            raise FsError("read_only", "El disco está en solo lectura")

    @staticmethod
    def _nf(parts):
        return FsError("not_found", "No existe: " + join_path(parts))

    def _p(self, parts):
        p = self.root
        for seg in parts:
            p = os.path.join(p, seg)
            try:
                if stat_mod.S_ISLNK(os.lstat(p).st_mode):
                    return None
            except OSError:
                return None
        return p

    def _entry(self, p, name):
        try:
            s = os.lstat(p)
        except OSError:
            return None
        if stat_mod.S_ISDIR(s.st_mode):
            isdir = True
        elif stat_mod.S_ISREG(s.st_mode):
            isdir = False
        else:
            return None
        e = {"name": name, "type": "dir" if isdir else "file", "size": 0 if isdir else s.st_size, "mtime_ms": int(s.st_mtime * 1000)}
        if not isdir:
            e["mime"] = mimetypes.guess_type(name)[0] or "application/octet-stream"
        e["writable"] = (not self.read_only) and (isdir or os.access(p, os.W_OK))
        return e

    def stat_opt(self, parts):
        if not parts:
            return {"name": "", "type": "dir", "size": 0, "mtime_ms": 0, "writable": not self.read_only}
        p = self._p(parts)
        return None if p is None else self._entry(p, parts[-1])

    def stat(self, parts):
        e = self.stat_opt(parts)
        if e is None:
            raise self._nf(parts)
        return e

    def _check_parent_dir(self, parent):
        if not parent:
            return
        e = self.stat_opt(parent)
        if e is None:
            raise self._nf(parent)
        if e["type"] != "dir":
            raise FsError("not_dir", "No es una carpeta: " + join_path(parent))

    def list(self, parts):
        if parts:
            e = self.stat(parts)
            if e["type"] != "dir":
                raise FsError("not_dir", "No es una carpeta: " + join_path(parts))
        p = self._p(parts)
        try:
            names = os.listdir(p)
        except OSError as ex:
            raise os_error(ex)
        out_ = []
        for name in names:
            e = self._entry(os.path.join(p, name), name)
            if e is not None:
                out_.append(e)
        out_.sort(key=lambda e: (e["type"] != "dir", e["name"].lower(), e["name"]))
        return out_

    def open(self, parts, mode="r", create=None, truncate=None, exclusive=None):
        write = mode != "r"
        if create is None:
            create = mode in ("w", "a")
        if truncate is None:
            truncate = mode == "w"
        if not parts:
            raise FsError("is_dir", "La raíz del disco es una carpeta")
        if write:
            self._need_writable()
        e = self.stat_opt(parts)
        if e is not None and e["type"] == "dir":
            raise FsError("is_dir", "Es una carpeta: " + join_path(parts))
        if e is not None and write and exclusive:
            raise FsError("exists", "Ya existe: " + join_path(parts))
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        try:
            if e is None:
                if not write or not create:
                    raise self._nf(parts)
                parent = parts[:-1]
                self._check_parent_dir(parent)
                check_new_name(parts[-1])
                fd = os.open(os.path.join(self._p(parent), parts[-1]), os.O_RDWR | os.O_CREAT | os.O_EXCL | nofollow, 0o644)
            else:
                if write and not e["writable"]:
                    raise FsError("read_only", "No se puede escribir en: " + join_path(parts))
                fd = os.open(self._p(parts), (os.O_RDWR if write else os.O_RDONLY) | nofollow)
        except OSError as ex:
            raise os_error(ex, write)
        f = DirectFile(fd, write)
        if write and truncate:
            try:
                f.truncate(0)
            except BaseException:
                close_quiet(f)
                raise
        return f

    def mkdir(self, parts, parents=False):
        self._need_writable()
        if not parts:
            if parents:
                return
            raise FsError("exists", "La raíz del disco ya existe")
        e = self.stat_opt(parts)
        if e is not None:
            if e["type"] == "dir" and parents:
                return
            raise FsError("exists", "Ya existe: " + join_path(parts))
        parent = parts[:-1]
        if parent:
            pe = self.stat_opt(parent)
            if pe is None:
                if not parents:
                    raise self._nf(parent)
                first = len(parts) - 1               # antes de crear nada, ningún nivel nuevo puede llevar un nombre que el disco no admita
                while first > 0 and self.stat_opt(parts[:first]) is None:
                    first -= 1
                for seg in parts[first:]:
                    check_new_name(seg)
                self.mkdir(parent, True)
            elif pe["type"] != "dir":
                raise FsError("not_dir", "No es una carpeta: " + join_path(parent))
        check_new_name(parts[-1])
        try:
            os.mkdir(os.path.join(self._p(parent), parts[-1]), 0o755)
        except OSError as ex:
            raise os_error(ex, True)

    def delete(self, parts):
        self._need_writable()
        if not parts:
            raise FsError("bad_path", "La raíz del disco no se borra")
        e = self.stat(parts)
        try:
            if e["type"] == "dir":
                if os.listdir(self._p(parts)):
                    raise FsError("not_empty", "La carpeta no está vacía: " + join_path(parts))
                os.rmdir(self._p(parts))
            else:
                os.unlink(self._p(parts))
        except OSError as ex:
            raise os_error(ex, True)

    def rename(self, src_parts, dst_parts, overwrite=False):
        self._need_writable()
        if not src_parts or not dst_parts:
            raise FsError("bad_path", "La raíz del disco no se mueve ni se sustituye")
        if src_parts == dst_parts:
            return
        if len(dst_parts) > len(src_parts) and dst_parts[:len(src_parts)] == src_parts:
            raise FsError("bad_path", "No se puede mover una carpeta dentro de sí misma")
        check_new_name(dst_parts[-1])
        src = self.stat(src_parts)
        dst = self.stat_opt(dst_parts)
        if dst is not None:
            same = False
            try:
                same = os.path.samefile(self._p(src_parts), self._p(dst_parts))
            except OSError:
                pass
            if not same:
                if not overwrite:
                    raise FsError("exists", "Ya existe: " + join_path(dst_parts))
                if dst["type"] == "dir" and src["type"] != "dir":
                    raise FsError("is_dir", "El destino es una carpeta: " + join_path(dst_parts))
                if dst["type"] != "dir" and src["type"] == "dir":
                    raise FsError("not_dir", "El destino es un archivo: " + join_path(dst_parts))
                self.delete(dst_parts)
        self._check_parent_dir(dst_parts[:-1])
        try:
            os.rename(self._p(src_parts), os.path.join(self._p(dst_parts[:-1]), dst_parts[-1]))
        except OSError as ex:
            raise os_error(ex, True)

# ----------------------------------------------------------------------------------------------------- discos USB: elegir el disco

STATE_HELP = {
    "checking": "Android lo está comprobando: espera unos segundos y repite.",
    "ejecting": "Android lo está expulsando.",
    "unmounted": "Está expulsado: desenchúfalo y vuélvelo a enchufar.",
    "removed": "Se quitó: enchúfalo de nuevo.",
    "bad_removal": "Se quitó sin expulsar: enchúfalo de nuevo (si da problemas, repáralo en un PC).",
    "unmountable": "Android no pudo montarlo: su sistema de archivos no es compatible con este móvil o está dañado "
                   "(en un PC, repáralo o formatéalo en exFAT).",
    "nofs": "No tiene sistema de archivos: formatéalo en un PC (exFAT sirve en casi todo).",
    "shared": "Android lo tiene compartido con un PC (modo almacenamiento USB): desactívalo.",
}


def storage_capable(info):
    return bool(info.get("storage")) or "storage.status" in (info.get("commands") or [])


def scall(link, cmd, timeout=15.0, **params):
    """Una orden storage.* a la app; si falla, sale ya como el UsbError que se le cuenta al usuario."""
    try:
        return link.call(cmd, timeout, **params)
    except BridgeError as e:
        raise fs_to_usb(app_error(e))


def vol_label(v):
    return v.get("label") or v.get("uuid") or "?"


def vol_state(v):
    return STATE_ES.get(v.get("state"), v.get("state") or "?")


def vol_access(v):
    if not v.get("granted"):
        return "no"
    sc = (v.get("scope") or "").strip("/")
    return "sí" if not sc else "sí (solo /%s)" % sc


def fmt_space(v):
    t, f = v.get("total"), v.get("free")
    if t is None:
        return "—"
    return "%s libres de %s" % (human(f), human(t)) if f is not None else human(t)


def no_disk_text(st):
    n = int(st.get("mass_storage_devices") or 0)
    if n > 0:
        return ("Android ve %d dispositivo%s de almacenamiento por USB pero no montó ningún disco: o aún lo está comprobando (espera unos "
                "segundos), o su sistema de archivos no es compatible con este móvil (exFAT y FAT32 casi siempre lo son; NTFS y ext4 "
                "depende del móvil), o no tiene particiones. Mira Ajustes → Almacenamiento." % (n, "" if n == 1 else "s"))
    return ("No hay ningún disco USB. Enchúfalo con un cable OTG (en Xiaomi/HyperOS: Ajustes → Ajustes adicionales → OTG) y mira: "
            "nexo usb mounts")


def unmounted_text(v):
    return "El disco «%s» no está montado%s. %s" % (vol_label(v), "" if v.get("state") == "unmounted" else " (%s)" % vol_state(v),
                                                   STATE_HELP.get(v.get("state"), "Desenchúfalo y vuélvelo a enchufar."))


def match_volumes(vols, sel):
    """Los discos que encajan con lo que escribió el usuario, del más al menos exacto: UUID o nombre enteros, el principio, un trozo."""
    k = sel.strip().lower()
    if not k:
        return []
    tiers = (lambda v: v.get("uuid", "").lower() == k or vol_label(v).lower() == k,
             lambda v: v.get("uuid", "").lower().startswith(k) or vol_label(v).lower().startswith(k),
             lambda v: k in v.get("uuid", "").lower() or k in vol_label(v).lower())
    for pred in tiers:
        found = [v for v in vols if pred(v)]
        if found:
            return found
    return []


def pick_volume(st, sel, need_mounted=True):
    vols = st.get("volumes") or []
    if sel:
        found = match_volumes(vols, sel)
        if not found:
            names = ", ".join("«%s»" % vol_label(v) for v in vols if not v.get("primary")) or "ninguno"
            raise UsbError("No hay ningún disco llamado «%s» (los que ve Android: %s). Mira: nexo usb mounts" % (sel, names), EXIT_NODEV)
        if len(found) > 1:
            raise UsbError("Varios discos encajan con «%s» (%s): usa su UUID (nexo usb mounts)." % (
                sel, ", ".join("%s «%s»" % (v.get("uuid"), vol_label(v)) for v in found)), EXIT_USAGE)
        v = found[0]
    else:
        cands = [v for v in vols if not v.get("primary")]
        mounted = [v for v in cands if v.get("mounted")]
        if len(mounted) == 1:
            v = mounted[0]
        elif len(mounted) > 1:
            raise UsbError("Hay varios discos montados (%s): di cuál con --vol NOMBRE o escribiendo NOMBRE:/ruta." % ", ".join(
                "«%s»" % vol_label(x) for x in mounted), EXIT_USAGE)
        elif len(cands) == 1:
            v = cands[0]
        elif cands:
            raise UsbError("Hay varios discos (%s) y ninguno está montado: mira nexo usb mounts." % ", ".join(
                "«%s»" % vol_label(x) for x in cands), EXIT_NODEV)
        else:
            raise UsbError(no_disk_text(st), EXIT_NODEV)
    if need_mounted and not v.get("mounted"):
        raise UsbError(unmounted_text(v), EXIT_NODEV)
    return v


def split_ref(spec):
    """«PENDRIVE:/Música» → («PENDRIVE», «/Música»); «/Música» → (None, «/Música»). Un «:» después de la primera «/» es del nombre."""
    i = spec.find(":")
    j = spec.find("/")
    if i > 0 and (j < 0 or i < j):
        return spec[:i], spec[i + 1:]
    return None, spec


def resolve_refs(specs, o):
    """«A:/x», «/y» → (qué disco, [partes de cada ruta]). Todas tienen que ser del mismo disco."""
    sel = o.get("vol")
    parts = []
    for s in specs:
        v, p = split_ref(s)
        if v is not None:
            if sel is not None and sel.strip().lower() != v.strip().lower():
                raise UsbError("Mezclas discos distintos («%s» y «%s»): usa una orden por disco." % (sel, v), EXIT_USAGE)
            sel = v
        parts.append(parse_path(p))
    return sel, parts


def direct_root(v):
    """La carpeta del disco tal como la vería la app (la que se autorizó), si la ruta que da Android parece una."""
    path = v.get("path")
    if not isinstance(path, str) or not path.startswith("/"):
        return None
    root = path
    if v.get("granted"):
        for seg in (v.get("scope") or "").split("/"):
            if seg:
                root = os.path.join(root, seg)
    return root


def try_direct(v, required):
    """DirectFs si este proceso ve de verdad la carpeta del disco (root, Shizuku/rish, o un Android que lo permita); si no, None."""
    root = direct_root(v)
    ok = False
    why = "Android no dio la ruta del disco"
    if root is not None:
        why = "este proceso no puede abrir %s" % root
        try:
            if os.path.isdir(root) and os.access(root, os.R_OK | os.X_OK):
                with os.scandir(root) as it:
                    for _ in it:
                        break
                ok = True
        except OSError as e:
            why = "%s: %s" % (root, e.strerror or e)
    if not ok:
        if required:
            raise UsbError("No puedo entrar directamente en el disco (%s). Android no deja a las apps normales abrir /storage/UUID; "
                           "sin --via direct se usa la app Nexo." % why, EXIT_ERR)
        return None
    vv = dict(v)
    vv["path"] = root
    return DirectFs(vv)


def ensure_access(link, v, say, timeout=120.0):
    """Pide a Android que Nexo pueda entrar en el disco y espera a que elijas la carpeta en el móvil. Devuelve el volumen ya autorizado."""
    if v.get("granted"):
        return v
    start = time.monotonic()
    announced = False
    while True:
        left = timeout - (time.monotonic() - start)
        if left <= 0:
            raise UsbError("Nadie eligió el disco en el móvil. Si no te salió el selector, abre la app Nexo un momento y repite: "
                           "nexo usb access  (en HyperOS/MIUI, mejor con Nexo en primer plano).", EXIT_TOUCH)
        wait = int(min(left, 25.0) * 1000)
        r = scall(link, "storage.access", wait / 1000.0 + 8.0, volume=v["uuid"], wait_ms=wait)
        if r.get("granted"):
            vv = dict(v)
            vv["granted"] = True
            return vv
        if r.get("denied"):
            raise UsbError("Android no le dio acceso a «%s» a Nexo. Repite «nexo usb access», elige el disco (ábrelo desde el menú ≡ si "
                           "no sale) y toca «Usar esta carpeta» → «Permitir»." % vol_label(v), EXIT_TOUCH)
        if not announced:
            say("Nexo necesita tu permiso para entrar en «%s»: mira la pantalla del móvil, elige el disco y toca «Usar esta carpeta» → "
                "«Permitir» (se pregunta una sola vez)." % vol_label(v))
            announced = True


class Disk(object):
    """Un disco listo para trabajar: la conexión con la app, el volumen elegido y la manera de entrar (fs)."""

    def __init__(self, link, vol, fs):
        self.link, self.vol, self.fs = link, vol, fs

    def close(self):
        self.link.close()


def open_disk(o, sel):
    """Conecta con la app, elige el disco y la manera de entrar (--via app|direct|auto) y, si hace falta, pide el acceso."""
    link = connect_app(None, "storage")
    try:
        st = scall(link, "storage.status")
        if not st.get("available", True):
            raise UsbError("Este Android no tiene el servicio de almacenamiento que necesita Nexo.", EXIT_ERR)
        v = pick_volume(st, sel)
        via = o.get("via") or "auto"
        fs = try_direct(v, via == "direct") if via in ("auto", "direct") else None
        if fs is None:
            if not v.get("granted"):
                if o.get("no_ask"):
                    raise UsbError("Nexo todavía no tiene acceso a «%s». Pídelo con:  nexo usb access" % vol_label(v), EXIT_TOUCH)
                v = ensure_access(link, v, log, o.get("timeout", 120.0))
            fs = AppFs(link, v)
        return Disk(link, v, fs)
    except BaseException:
        link.close()
        raise


# ----------------------------------------------------------------------------------------------------- discos USB: copiar


def via_arg(s):
    v = str(s).strip().lower()
    if v not in ("auto", "app", "direct"):
        raise ValueError(s)
    return v


STORAGE_SPEC = {"--vol": ("vol", str), "--via": ("via", via_arg), "--no-ask": ("no_ask", True), "--timeout": ("timeout", to_seconds)}
TRANSFER_SPEC = {"-r": ("recursive", True), "-R": ("recursive", True), "--recursive": ("recursive", True),
                 "-f": ("force", True), "--force": ("force", True), "-n": ("skip", True), "--skip-existing": ("skip", True),
                 "--verify": ("verify", True), "-q": ("quiet", True), "--quiet": ("quiet", True), "--json": ("json", True)}


def spec_with(*parts):
    d = dict(STORAGE_SPEC)
    for p in parts:
        d.update(p)
    return d


def local_error(e, what):
    if e.errno in (errno.ENOSPC, getattr(errno, "EDQUOT", -1)):
        return FsError("local_full", "No cabe en tu distro: %s" % what)
    return FsError("local", "%s: %s" % (what, e.strerror or e))


def write_all(fd, data):
    view = memoryview(data)
    try:
        while len(view):
            n = os.write(fd, view)
            view = view[n:]
    except OSError as e:
        raise local_error(e, "no pude escribir en un archivo de tu distro")


def hash_local(path):
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            while True:
                b = f.read(1 << 20)
                if not b:
                    return h.hexdigest()
                h.update(b)
    except OSError as e:
        raise local_error(e, "no pude releer «%s»" % path)


def hash_disk(fs, parts):
    h = hashlib.sha256()
    f = fs.open(parts, "r")
    try:
        pipeline_read(f, f.size, h.update, Meter(False))
    finally:
        close_quiet(f)
    return h.hexdigest()


def disp(job, parts):
    return "%s:%s" % (vol_label(job.disk.vol), join_path(parts))


def fix_name(name):
    """Los caracteres que un disco USB no admite en un nombre nuevo, cambiados por «_» (--fix-names)."""
    out_ = "".join("_" if (ch in BAD_NEW_CHARS or ch < " " or ch == "\x7f") else ch for ch in name)
    while out_.endswith(".") or out_.endswith(" "):
        out_ = out_[:-1] + "_"
    return out_ or "_"


class Meter(object):
    """La línea de avance de una copia (solo en una terminal; a un archivo o una tubería no escribe nada)."""

    def __init__(self, enabled):
        self.on = bool(enabled) and hasattr(sys.stderr, "isatty") and sys.stderr.isatty()
        self.name, self.size, self.done = "", 0, 0
        self.t0, self.last, self.shown = time.monotonic(), 0.0, False

    def start(self, name, size):
        self.name, self.size, self.done = name, size, 0
        self.t0, self.last = time.monotonic(), 0.0

    def add(self, n):
        self.done += n
        if not self.on:
            return
        now = time.monotonic()
        if now - self.last < 0.2:
            return
        self.last = now
        el = max(now - self.t0, 0.001)
        pct = ("%3d %%" % (100 * self.done // self.size)) if self.size else ""
        line = "  %s  %s / %s  %s  %s/s" % (self.name, human(self.done), human(self.size), pct, human(self.done / el))
        try:
            cols = shutil.get_terminal_size((80, 24)).columns
        except Exception:
            cols = 80
        if len(line) >= cols:
            line = "…" + line[len(line) - (cols - 2):]
        sys.stderr.write("\r" + line + "\x1b[K")
        sys.stderr.flush()
        self.shown = True

    def clear(self):
        if self.shown:
            sys.stderr.write("\r\x1b[K")
            sys.stderr.flush()
            self.shown = False


def pipeline_read(f, size, sink, meter):
    """Lee `size` bytes de un archivo abierto, con PIPE_DEPTH peticiones en vuelo, y se los va dando a sink(bytes), en orden."""
    q = collections.deque()
    sent = 0
    while sent < size or q:
        while sent < size and len(q) < PIPE_DEPTH:
            want = min(READ_CHUNK, size - sent)
            q.append((sent, want, f.read_async(sent, want)))
            sent += want
        off, want, p = q.popleft()
        data = p.result()
        while len(data) < want:                                    # lectura corta: se pide lo que falta
            more = f.read(off + len(data), want - len(data))
            if not more:
                raise FsError("io_error", "El archivo cambió o se acortó mientras se copiaba")
            data += more
        sink(data)
        meter.add(len(data))


def pipeline_write(f, src, size, meter, hasher=None):
    """Escribe `size` bytes de un archivo local en uno abierto del disco, con PIPE_DEPTH escrituras en vuelo."""
    q = collections.deque()
    off = 0
    while off < size:
        data = src.read(min(WRITE_CHUNK, size - off))
        if not data:
            raise FsError("local", "El archivo local cambió o se acortó mientras se copiaba")
        if hasher is not None:
            hasher.update(data)
        q.append((off, data, f.write_async(off, data)))
        off += len(data)
        if len(q) >= PIPE_DEPTH:
            finish_write(f, q.popleft(), meter)
    while q:
        finish_write(f, q.popleft(), meter)


def finish_write(f, item, meter):
    off, data, p = item
    n = p.result()
    while n < len(data):                                           # escritura corta: se manda lo que falta
        k = f.write(off + n, data[n:])
        if k <= 0:
            raise FsError("io_error", "El disco no aceptó más datos")
        n += k
    meter.add(len(data))


class Job(object):
    """Lo que comparten los archivos de una misma orden (get, put, rm…): el disco, las opciones, los fallos y lo copiado."""

    def __init__(self, disk, o):
        self.disk = disk
        self.fs = disk.fs
        self.force = bool(o.get("force"))
        self.skip = bool(o.get("skip"))
        self.recursive = bool(o.get("recursive"))
        self.verify = bool(o.get("verify"))
        self.fix_names = bool(o.get("fix_names"))
        self.verbose = bool(o.get("verbose"))
        self.json = bool(o.get("json"))
        self.quiet = bool(o.get("quiet")) or self.json
        self.meter = Meter(not self.quiet)
        self.errors, self.items = [], []
        self.bytes = 0
        self.skipped = 0
        self.t0 = time.monotonic()
        self.counter = 0

    def say(self, msg):
        if not self.quiet:
            self.meter.clear()
            log(msg)

    def part_name(self):
        self.counter += 1
        return "%s%d-%d" % (PART_PREFIX, os.getpid(), self.counter)

    def fail(self, e, what):
        self.errors.append({"path": what, "error": e.code, "message": e.message})
        self.meter.clear()
        log("nexo usb: %s: %s" % (what, e.message))

    def run(self, what, fn, *args):
        """fn(*args); un fallo que solo afecta a este archivo se anota y se sigue, uno que afecta a todo (disco lleno, sin disco…) sale."""
        try:
            return fn(*args)
        except FsError as e:
            if e.code in FATAL_FS:
                raise
            self.fail(e, what)
            return None


def finish_job(job, label):
    job.meter.clear()
    el = max(time.monotonic() - job.t0, 0.001)
    if job.json:
        out(json.dumps({"ok": not job.errors, "files": len(job.items), "bytes": job.bytes, "skipped": job.skipped,
                        "seconds": round(el, 3), "items": job.items, "errors": job.errors}, ensure_ascii=False) + "\n")
    elif not job.quiet and (len(job.items) > 1 or job.errors or job.skipped):
        log("%s: %d archivo%s, %s en %.1f s%s%s%s" % (
            label, len(job.items), "" if len(job.items) == 1 else "s", human(job.bytes), el,
            (" (%s/s)" % human(job.bytes / el)) if job.bytes else "",
            (", %d omitido%s" % (job.skipped, "" if job.skipped == 1 else "s")) if job.skipped else "",
            (", %d con fallos" % len(job.errors)) if job.errors else ""))
    return EXIT_ERR if job.errors else 0


# ---- disco → distro


def get_file(job, sp, entry, target):
    fs = job.fs
    name = disp(job, sp)
    if os.path.lexists(target):
        if os.path.isdir(target) and not os.path.islink(target):
            raise FsError("is_dir", "En tu distro «%s» es una carpeta" % target)
        if job.skip:
            job.skipped += 1
            job.say("  omitido (ya existe): %s" % target)
            return
        if not job.force:
            raise FsError("exists", "Ya existe «%s» (usa -f para sustituirlo, o -n para saltarlo)" % target)
    dirn = os.path.dirname(target) or "."
    if not os.path.isdir(dirn):
        raise FsError("local", "No existe la carpeta de destino «%s»" % dirn)
    tmp = os.path.join(dirn, job.part_name())
    f = fs.open(sp, "r")
    fd = None
    ok = False
    size = 0
    try:
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
        except OSError as e:
            raise local_error(e, "no pude crear «%s»" % tmp)
        h = hashlib.sha256() if job.verify else None

        def sink(data):
            if h is not None:
                h.update(data)
            write_all(fd, data)

        size = f.size
        job.meter.start(name, size)
        pipeline_read(f, size, sink, job.meter)
        try:
            os.close(fd)
        except OSError as e:
            fd = None
            raise local_error(e, "no pude cerrar «%s»" % tmp)
        fd = None
        if h is not None and hash_local(tmp) != h.hexdigest():
            raise FsError("io_error", "La copia en tu distro no coincide con lo leído del disco")
        ms = entry.get("mtime_ms")
        if ms:
            try:
                os.utime(tmp, (ms / 1000.0, ms / 1000.0))
            except (OSError, OverflowError, ValueError):
                pass
        try:
            os.replace(tmp, target)
        except OSError as e:
            raise local_error(e, "no pude dejar «%s»" % target)
        ok = True
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        close_quiet(f)
        job.meter.clear()
        if not ok:
            remove_quiet(tmp)
    job.bytes += size
    job.items.append({"src": name, "dst": target, "bytes": size})
    job.say("  %s → %s  (%s)" % (name, target, human(size)))


def get_tree(job, sp, target):
    """Una carpeta entera del disco a una carpeta de tu distro (se mezcla con lo que ya haya)."""
    if os.path.lexists(target):
        if not os.path.isdir(target) or os.path.islink(target) and not os.path.isdir(os.path.realpath(target)):
            raise FsError("exists", "Ya existe «%s» y no es una carpeta" % target)
    else:
        try:
            os.mkdir(target, 0o777)
        except OSError as e:
            raise local_error(e, "no pude crear la carpeta «%s»" % target)
    for e in job.fs.list(sp):
        name = e["name"]
        cp = sp + [name]
        what = disp(job, cp)
        if not safe_local_name(name):
            job.fail(FsError("bad_path", "nombre no válido en tu distro: %r" % name), what)
            continue
        dst = os.path.join(target, name)
        if e["type"] == "dir":
            job.run(what, get_tree, job, cp, dst)
        else:
            job.run(what, get_file, job, cp, e, dst)


def get_one(job, sp, dest, dest_is_dir, contents=False):
    e = job.fs.stat(sp)
    if contents and e["type"] == "dir":                            # «ORIGEN/»: lo que hay dentro va directo a DESTINO (como rsync)
        if not job.recursive:
            raise FsError("is_dir", "Es una carpeta (usa -r para copiarla entera)")
        get_tree(job, sp, dest.rstrip("/") or dest)
        return
    name = sp[-1] if sp else (vol_label(job.disk.vol).replace("/", "_") or "disco")
    if dest_is_dir:
        target = os.path.join(dest, name)
    else:
        if dest.endswith("/") and e["type"] != "dir":
            raise FsError("local", "No existe la carpeta de destino «%s»" % dest)
        target = dest.rstrip("/") or dest
    if e["type"] == "dir":
        if not job.recursive:
            raise FsError("is_dir", "Es una carpeta (usa -r para copiarla entera)")
        get_tree(job, sp, target)
    else:
        get_file(job, sp, e, target)


def cmd_get(argv):
    o, pos = parse_args(argv, spec_with(TRANSFER_SPEC))
    if len(pos) < 2:
        raise UsbError("«get» necesita ORIGEN (en el disco) y DESTINO (en tu distro). Ejemplo: nexo usb get /Fotos/a.jpg .", EXIT_USAGE)
    sel, plist = resolve_refs(pos[:-1], o)
    slash = [split_ref(x)[1].endswith("/") for x in pos[:-1]]
    dest = pos[-1]
    deep_ok()
    dest_is_dir = os.path.isdir(dest)
    if len(plist) > 1 and not dest_is_dir:
        raise UsbError("Con varios ORIGEN, DESTINO tiene que ser una carpeta que ya exista («%s»)." % dest, EXIT_USAGE)
    disk = open_disk(o, sel)
    try:
        job = Job(disk, o)
        for sp, sl in zip(plist, slash):
            job.run(disp(job, sp), get_one, job, sp, dest, dest_is_dir, sl)
        return finish_job(job, "get")
    finally:
        disk.close()


# ---- distro → disco


def ensure_dir(job, dp):
    """La carpeta dp del disco: se crea si falta (la de arriba tiene que existir); si ya hay una, se mezcla."""
    e = job.fs.stat_opt(dp)
    if e is None:
        job.fs.mkdir(dp)
    elif e["type"] != "dir":
        raise FsError("not_dir", "En el disco «%s» ya existe y no es una carpeta" % disp(job, dp))


def put_file(job, lp, st, dp):
    fs = job.fs
    name = disp(job, dp)
    if not dp:
        raise FsError("bad_path", "Un archivo no puede ser la raíz del disco")
    check_name(dp[-1])
    check_new_name(dp[-1])                                         # antes de crear nada: Android cambiaría estos caracteres sin avisar
    existing = fs.stat_opt(dp)
    if existing is not None:
        if existing["type"] == "dir":
            raise FsError("is_dir", "En el disco «%s» es una carpeta" % name)
        if job.skip:
            job.skipped += 1
            job.say("  omitido (ya existe): %s" % name)
            return
        if not job.force:
            raise FsError("exists", "Ya existe en el disco «%s» (usa -f para sustituirlo, o -n para saltarlo)" % name)
    size = st.st_size
    try:
        src = open(lp, "rb")
    except OSError as e:
        raise local_error(e, "no pude leerlo")
    tmp = dp[:-1] + [job.part_name()]
    f = None
    made = False
    keep = False
    ok = False
    try:
        f = fs.open(tmp, "w", exclusive=True)
        made = True
        h = hashlib.sha256() if job.verify else None
        job.meter.start(name, size)
        try:
            pipeline_write(f, src, size, job.meter, h)
        except OSError as e:
            raise local_error(e, "no pude leerlo")
        f.close()                                                  # aquí se vacía al disco: si falla, falla la copia
        if h is not None and hash_disk(fs, tmp) != h.hexdigest():
            raise FsError("io_error", "Lo escrito en el disco no coincide con el original")
        try:
            fs.rename(tmp, dp, overwrite=existing is not None)
        except FsError as e:
            if existing is not None:
                try:
                    keep = fs.stat_opt(dp) is None                 # el viejo ya se borró y el nuevo no llegó a su sitio: no se pierde
                except FsError:
                    keep = False
            if keep:
                raise FsError(e.code, "%s (lo copiado quedó en «%s»)" % (e.message, disp(job, tmp)), e.extra)
            raise
        ok = True
    finally:
        close_quiet(src)
        if f is not None:
            close_quiet(f)
        job.meter.clear()
        if made and not ok and not keep:
            delete_quiet(fs, tmp)
    job.bytes += size
    job.items.append({"src": lp, "dst": name, "bytes": size})
    job.say("  %s → %s  (%s)" % (lp, name, human(size)))


def put_tree(job, lp, dp):
    """Una carpeta de tu distro entera al disco (se mezcla con lo que ya haya; los enlaces simbólicos y archivos especiales se saltan)."""
    ensure_dir(job, dp)
    try:
        names = sorted(os.listdir(lp))
    except OSError as e:
        raise local_error(e, "no pude leer la carpeta")
    for name in names:
        p = os.path.join(lp, name)
        cdp = dp + [fix_name(name) if job.fix_names else name]
        try:
            st = os.lstat(p)
        except OSError as e:
            job.fail(local_error(e, "no pude leerlo"), p)
            continue
        if stat_mod.S_ISDIR(st.st_mode):
            job.run(p, put_tree, job, p, cdp)
        elif stat_mod.S_ISREG(st.st_mode):
            job.run(p, put_file, job, p, st, cdp)
        else:
            job.skipped += 1
            job.say("  omitido (%s): %s" % ("enlace simbólico" if stat_mod.S_ISLNK(st.st_mode) else "no es un archivo normal", p))


def put_one(job, lp, dp, dest_exists_dir, dest):
    try:
        st = os.stat(lp)
    except OSError as e:
        raise local_error(e, "no pude leerlo")
    if lp.endswith("/") and stat_mod.S_ISDIR(st.st_mode):          # «ORIGEN/»: lo que hay dentro va directo a DESTINO (como rsync)
        if not job.recursive:
            raise FsError("is_dir", "Es una carpeta (usa -r para copiarla entera)")
        put_tree(job, lp, dp)
        return
    base = os.path.basename(os.path.abspath(lp)) or "raiz"
    if job.fix_names:
        base = fix_name(base)
    if dest_exists_dir:
        target = dp + [base]
    else:
        if dest.endswith("/") and not stat_mod.S_ISDIR(st.st_mode):
            raise FsError("not_found", "En el disco no existe la carpeta «%s»" % dest)
        target = dp
    if stat_mod.S_ISDIR(st.st_mode):
        if not job.recursive:
            raise FsError("is_dir", "Es una carpeta (usa -r para copiarla entera)")
        if not target:
            raise FsError("bad_path", "No se puede sustituir la raíz del disco")
        put_tree(job, lp, target)
    elif stat_mod.S_ISREG(st.st_mode):
        put_file(job, lp, st, target)
    else:
        raise FsError("local", "No es un archivo normal")


def cmd_put(argv):
    o, pos = parse_args(argv, spec_with(TRANSFER_SPEC, {"--fix-names": ("fix_names", True)}))
    if len(pos) < 2:
        raise UsbError("«put» necesita ORIGEN (en tu distro) y DESTINO (en el disco). Ejemplo: nexo usb put ./a.jpg /Fotos/", EXIT_USAGE)
    srcs = pos[:-1]
    sel, dparts = resolve_refs([pos[-1]], o)
    dp = dparts[0]
    dest = split_ref(pos[-1])[1]
    deep_ok()
    disk = open_disk(o, sel)
    try:
        job = Job(disk, o)
        de = disk.fs.stat_opt(dp)
        dir_ = de is not None and de["type"] == "dir"
        if len(srcs) > 1 and not dir_:
            raise UsbError("Con varios ORIGEN, DESTINO tiene que ser una carpeta que ya exista en el disco («%s»)." % pos[-1], EXIT_USAGE)
        for lp in srcs:
            job.run(lp, put_one, job, lp, dp, dir_, dest)
        return finish_job(job, "put")
    finally:
        disk.close()


def deep_ok():
    """Una ruta de disco mide como mucho 4096 caracteres (hasta ~2000 niveles): se deja recursión de sobra."""
    if sys.getrecursionlimit() < 6000:
        sys.setrecursionlimit(6000)


# ----------------------------------------------------------------------------------------------------- discos USB: comandos


def json_out(obj, o):
    out(json.dumps(obj, ensure_ascii=False, indent=2 if o.get("pretty") or sys.stdout.isatty() else None) + "\n")


def cmd_mounts(argv):
    o, pos = parse_args(argv, {"--json": ("json", True), "--pretty": ("pretty", True), "--all": ("all", True), "-a": ("all", True),
                               "--wait": ("wait", to_seconds)})
    if pos:
        raise UsbError("«mounts» no lleva argumentos. Prueba: nexo usb help", EXIT_USAGE)
    link = connect_app(None, "storage")
    waited = False
    try:
        st = scall(link, "storage.status")
        if o.get("wait"):
            end = time.monotonic() + o["wait"]
            told = False
            while not [v for v in st.get("volumes") or [] if not v.get("primary") and v.get("mounted")] and time.monotonic() < end:
                if not told:
                    log("Esperando a que enchufes un disco… (Ctrl+C para dejar de esperar)")
                    told = True
                time.sleep(1.0)
                st = scall(link, "storage.status")
            waited = True
    finally:
        link.close()
    if o.get("json"):
        json_out(st, o)
        return 0
    vols = st.get("volumes") or []
    shown = [v for v in vols if o.get("all") or not v.get("primary")]
    if not shown:
        log(no_disk_text(st))
        return EXIT_NODEV if waited else 0
    rows = []
    for v in shown:
        rows.append((v.get("uuid"), vol_label(v) + (" (interno)" if v.get("primary") else ""), vol_state(v), fmt_space(v), vol_access(v),
                     v.get("path") or "—"))
    out(table(rows, ("ID", "NOMBRE", "ESTADO", "ESPACIO", "NEXO PUEDE ENTRAR", "RUTA EN ANDROID")) + "\n")
    usable = [v for v in shown if not v.get("primary")]
    for v in usable:
        if not v.get("mounted"):
            out("  %s: %s\n" % (vol_label(v), STATE_HELP.get(v.get("state"), "Android no lo tiene montado.")))
    if any(v.get("mounted") and not v.get("granted") for v in usable):
        out("Siguiente paso: nexo usb access   (Android te enseña su selector de carpetas: elige el disco; se pregunta una sola vez)\n")
    elif any(v.get("mounted") and v.get("granted") for v in usable):
        out("Listo para: nexo usb ls · get · put · cat · mkdir · rm · mv · df · eject\n")
    elif not usable:
        out("No hay discos USB montados (el interno no cuenta). %s\n" % no_disk_text(st))
    return 0


def cmd_access(argv):
    o, pos = parse_args(argv, {"--vol": ("vol", str), "--timeout": ("timeout", to_seconds), "--revoke": ("revoke", True),
                               "--json": ("json", True), "--pretty": ("pretty", True)})
    if len(pos) > 1:
        raise UsbError("Solo un DISCO. Prueba: nexo usb help", EXIT_USAGE)
    sel = pos[0] if pos else o.get("vol")
    link = connect_app(None, "storage")
    try:
        st = scall(link, "storage.status")
        v = pick_volume(st, sel, need_mounted=not o.get("revoke"))
        if o.get("revoke"):
            r = scall(link, "storage.revoke", 15.0, volume=v["uuid"])
            if o.get("json"):
                json_out(r, o)
            else:
                out("Nexo ya no tiene acceso a «%s» (se quitaron %d permiso%s).\n" % (
                    vol_label(v), int(r.get("released") or 0), "" if int(r.get("released") or 0) == 1 else "s"))
            return 0
        if v.get("granted"):
            if o.get("json"):
                json_out({"volume": v["uuid"], "granted": True, "requested": False, "denied": False, "scope": v.get("scope")}, o)
            else:
                out("Nexo ya tiene acceso a «%s» (%s).\n" % (vol_label(v), vol_access(v)[3:].strip("()") if (v.get("scope") or "").strip("/") else
                                                             "el disco entero"))
            return 0
        v = ensure_access(link, v, log, o.get("timeout", 120.0))
        if o.get("json"):
            json_out({"volume": v["uuid"], "granted": True, "requested": True, "denied": False}, o)
        else:
            out("Listo: Nexo ya puede entrar en «%s». Prueba:  nexo usb ls\n" % vol_label(v))
        return 0
    finally:
        link.close()


def entry_line(e, long_, human_):
    name = e["name"] + ("/" if e["type"] == "dir" else "")
    if not long_:
        return name
    size = "-" if e["type"] == "dir" else (human(e["size"]) if human_ else str(e["size"]))
    return "%s%s  %10s  %s  %s" % ("d" if e["type"] == "dir" else "-", "w" if e.get("writable") else "r", size, when(e.get("mtime_ms")), name)


def walk_listing(fs, sp, recursive, acc, errors):
    try:
        ents = fs.list(sp)
    except FsError as e:
        if e.code in FATAL_FS:
            raise
        errors.append((sp, e))
        return
    acc.append({"path": join_path(sp), "entries": ents})
    if recursive:
        for e in ents:
            if e["type"] == "dir":
                walk_listing(fs, sp + [e["name"]], True, acc, errors)


def cmd_ls(argv):
    o, pos = parse_args(argv, spec_with({"-l": ("long", True), "--long": ("long", True), "-a": ("all", True), "--all": ("all", True),
                                         "-h": ("human", True), "--human": ("human", True), "-R": ("recursive", True),
                                         "--recursive": ("recursive", True), "--json": ("json", True), "--pretty": ("pretty", True)}))
    sel, plist = resolve_refs(pos or ["/"], o)
    deep_ok()
    disk = open_disk(o, sel)
    try:
        acc, errs, rc = [], [], 0
        for sp in plist:
            try:
                e = disk.fs.stat(sp)
                if e["type"] != "dir":
                    acc.append({"path": join_path(sp), "entries": [e], "file": True})
                else:
                    walk_listing(disk.fs, sp, bool(o.get("recursive")), acc, errs)
            except FsError as ex:
                if ex.code in FATAL_FS:
                    raise
                errs.append((sp, ex))
        for sp, ex in errs:
            log("nexo usb: %s:%s: %s" % (vol_label(disk.vol), join_path(sp), ex.message))
            rc = EXIT_ERR
        if o.get("json"):
            json_out({"volume": disk.vol.get("uuid"), "listings": [{"path": a["path"], "entries": a["entries"]} for a in acc],
                      "errors": [{"path": join_path(sp), "error": ex.code, "message": ex.message} for sp, ex in errs]}, o)
            return rc
        multi = len(acc) > 1
        for n, a in enumerate(acc):
            if multi and not a.get("file"):
                out("%s%s:\n" % ("\n" if n else "", a["path"]))
            for e in a["entries"]:
                if a.get("file"):
                    e = dict(e, name=a["path"])
                elif e["name"].startswith(".") and not o.get("all"):
                    continue
                out(entry_line(e, o.get("long"), o.get("human")) + "\n")
        return rc
    finally:
        disk.close()


def cmd_stat(argv):
    o, pos = parse_args(argv, spec_with({"--json": ("json", True), "--pretty": ("pretty", True)}))
    if not pos:
        raise UsbError("«stat» necesita una RUTA del disco.", EXIT_USAGE)
    sel, plist = resolve_refs(pos, o)
    disk = open_disk(o, sel)
    try:
        res, rc = [], 0
        for sp in plist:
            try:
                e = dict(disk.fs.stat(sp))
            except FsError as ex:
                if ex.code in FATAL_FS:
                    raise
                log("nexo usb: %s:%s: %s" % (vol_label(disk.vol), join_path(sp), ex.message))
                rc = EXIT_ERR
                continue
            e["path"] = join_path(sp)
            e["volume"] = disk.vol.get("uuid")
            res.append(e)
        if o.get("json"):
            json_out(res[0] if len(plist) == 1 and res else res, o)
            return rc
        for n, e in enumerate(res):
            if n:
                out("\n")
            out("  Ruta:        %s:%s\n  Tipo:        %s\n" % (vol_label(disk.vol), e["path"], "carpeta" if e["type"] == "dir" else "archivo"))
            if e["type"] != "dir":
                out("  Tamaño:      %s (%d bytes)\n" % (human(e["size"]), e["size"]))
            out("  Modificado:  %s\n  Escritura:   %s\n" % (when(e.get("mtime_ms")), "sí" if e.get("writable") else "no"))
            if e.get("mime"):
                out("  MIME:        %s\n" % e["mime"])
        return rc
    finally:
        disk.close()


def cmd_cat(argv):
    o, pos = parse_args(argv, spec_with({}))
    if not pos:
        raise UsbError("«cat» necesita una o más RUTAS de archivos del disco.", EXIT_USAGE)
    sel, plist = resolve_refs(pos, o)
    disk = open_disk(o, sel)
    try:
        outb = sys.stdout.buffer
        meter = Meter(False)
        rc = 0
        for sp in plist:
            what = "%s:%s" % (vol_label(disk.vol), join_path(sp))
            try:
                e = disk.fs.stat(sp)
                if e["type"] == "dir":
                    raise FsError("is_dir", "Es una carpeta")
                f = disk.fs.open(sp, "r")
                try:
                    pipeline_read(f, f.size, outb.write, meter)
                finally:
                    close_quiet(f)
            except FsError as ex:
                if ex.code in FATAL_FS:
                    raise
                log("nexo usb: %s: %s" % (what, ex.message))
                rc = EXIT_ERR
        outb.flush()
        return rc
    finally:
        disk.close()


def cmd_mkdir(argv):
    o, pos = parse_args(argv, spec_with({"-p": ("parents", True), "--parents": ("parents", True)}))
    if not pos:
        raise UsbError("«mkdir» necesita una o más RUTAS.", EXIT_USAGE)
    sel, plist = resolve_refs(pos, o)
    disk = open_disk(o, sel)
    try:
        rc = 0
        for sp in plist:
            what = "%s:%s" % (vol_label(disk.vol), join_path(sp))
            try:
                disk.fs.mkdir(sp, bool(o.get("parents")))
            except FsError as ex:
                if ex.code in FATAL_FS:
                    raise
                log("nexo usb: %s: %s" % (what, ex.message))
                rc = EXIT_ERR
        return rc
    finally:
        disk.close()


def rm_tree(job, root, verbose):
    """Borra una carpeta y todo lo que lleva dentro (de abajo arriba: la app solo borra archivos y carpetas vacías)."""
    stack = [(root, False)]
    while stack:
        sp, visited = stack.pop()
        what = disp(job, sp)
        if visited:
            job.run(what, job.fs.delete, sp)
            if verbose:
                job.say("  borrado: %s" % what)
            continue
        stack.append((sp, True))
        try:
            kids = job.fs.list(sp)
        except FsError as e:
            if e.code in FATAL_FS:
                raise
            job.fail(e, what)
            continue
        for c in kids:
            cp = sp + [c["name"]]
            if c["type"] == "dir":
                stack.append((cp, False))
            else:
                job.run(disp(job, cp), job.fs.delete, cp)
                if verbose:
                    job.say("  borrado: %s" % disp(job, cp))


def rm_one(job, sp, force, verbose):
    e = job.fs.stat_opt(sp)
    if not sp:
        raise FsError("bad_path", "La raíz del disco no se borra (borra sus carpetas una a una)")
    if e is None:
        if force:
            return
        raise FsError("not_found", "No existe: " + join_path(sp))
    if e["type"] == "dir":
        if not job.recursive:
            raise FsError("is_dir", "Es una carpeta (usa -r para borrarla con todo lo que lleva dentro)")
        rm_tree(job, sp, verbose)
    else:
        job.fs.delete(sp)
        if verbose:
            job.say("  borrado: %s" % disp(job, sp))


def cmd_rm(argv):
    o, pos = parse_args(argv, spec_with({"-r": ("recursive", True), "-R": ("recursive", True), "--recursive": ("recursive", True),
                                         "-f": ("force", True), "--force": ("force", True), "-v": ("verbose", True),
                                         "--verbose": ("verbose", True)}))
    if not pos:
        raise UsbError("«rm» necesita una o más RUTAS.", EXIT_USAGE)
    sel, plist = resolve_refs(pos, o)
    deep_ok()
    disk = open_disk(o, sel)
    try:
        job = Job(disk, o)
        for sp in plist:
            job.run(disp(job, sp), rm_one, job, sp, bool(o.get("force")), bool(o.get("verbose")))
        return EXIT_ERR if job.errors else 0
    finally:
        disk.close()


def cmd_mv(argv):
    o, pos = parse_args(argv, spec_with({"-f": ("force", True), "--force": ("force", True), "-v": ("verbose", True),
                                         "--verbose": ("verbose", True)}))
    if len(pos) < 2:
        raise UsbError("«mv» necesita ORIGEN y DESTINO (los dos en el disco). Ejemplo: nexo usb mv /a.txt /Carpeta/", EXIT_USAGE)
    sel, plist = resolve_refs(pos, o)
    disk = open_disk(o, sel)
    try:
        job = Job(disk, o)
        dest = plist[-1]
        de = disk.fs.stat_opt(dest)
        dir_ = de is not None and de["type"] == "dir"
        if len(plist) > 2 and not dir_:
            raise UsbError("Con varios ORIGEN, DESTINO tiene que ser una carpeta que ya exista en el disco.", EXIT_USAGE)
        for sp in plist[:-1]:
            what = disp(job, sp)

            def one(sp=sp, what=what):
                if not sp:
                    raise FsError("bad_path", "La raíz del disco no se mueve")
                target = dest + [sp[-1]] if dir_ else dest
                disk.fs.rename(sp, target, bool(o.get("force")))
                if o.get("verbose"):
                    job.say("  %s → %s" % (what, disp(job, target)))
            job.run(what, one)
        return EXIT_ERR if job.errors else 0
    finally:
        disk.close()


def cmd_df(argv):
    o, pos = parse_args(argv, {"--vol": ("vol", str), "--json": ("json", True), "--pretty": ("pretty", True), "--all": ("all", True),
                               "-a": ("all", True)})
    if len(pos) > 1:
        raise UsbError("Solo un DISCO. Prueba: nexo usb help", EXIT_USAGE)
    link = connect_app(None, "storage")
    try:
        st = scall(link, "storage.status")
    finally:
        link.close()
    sel = pos[0] if pos else o.get("vol")
    vols = st.get("volumes") or []
    if sel:
        vols = [pick_volume(st, sel, need_mounted=False)]
    elif not o.get("all"):
        vols = [v for v in vols if not v.get("primary")]
    if o.get("json"):
        json_out(vols, o)
        return 0
    if not vols:
        log(no_disk_text(st))
        return 0
    rows = []
    for v in vols:
        t, f = v.get("total"), v.get("free")
        used = (t - f) if (t is not None and f is not None) else None
        pct = ("%d %%" % round(100.0 * used / t)) if (used is not None and t) else "—"
        rows.append((v.get("uuid"), vol_label(v), human(t) if t is not None else "—", human(used) if used is not None else "—",
                     human(f) if f is not None else "—", pct, vol_state(v)))
    out(table(rows, ("ID", "NOMBRE", "TOTAL", "USADO", "LIBRE", "USO", "ESTADO")) + "\n")
    return 0


def cmd_eject(argv):
    o, pos = parse_args(argv, {"--vol": ("vol", str), "--json": ("json", True), "--pretty": ("pretty", True)})
    if len(pos) > 1:
        raise UsbError("Solo un DISCO. Prueba: nexo usb help", EXIT_USAGE)
    sel = pos[0] if pos else o.get("vol")
    link = connect_app(None, "storage")
    try:
        st = scall(link, "storage.status")
        v = pick_volume(st, sel, need_mounted=False)
        r = scall(link, "storage.eject", 30.0, volume=v["uuid"])
    finally:
        link.close()
    ejected = bool(r.get("ejected"))
    if o.get("json"):
        json_out(r, o)
        return 0 if ejected else EXIT_ERR
    n = int(r.get("closed_files") or 0)
    if n:
        out("Cerré %d archivo%s abierto%s de «%s».\n" % (n, "" if n == 1 else "s", "" if n == 1 else "s", vol_label(v)))
    if ejected:
        out("«%s» expulsado: ya puedes desenchufarlo.\n" % vol_label(v))
        return 0
    log(r.get("hint") or "Android no expulsó «%s» desde aquí (a una app normal no siempre se lo permite). Expúlsalo con el botón «Expulsar» "
        "de Android (la notificación del disco o Ajustes → Almacenamiento) y luego desenchúfalo." % vol_label(v))
    return EXIT_ERR


# ----------------------------------------------------------------------------------------------------- status, stop, reset


def cmd_status(argv):
    o, pos = parse_args(argv, {"--json": ("json", True)})
    if pos:
        raise UsbError("«status» no lleva argumentos.", EXIT_USAGE)
    sts = read_states()
    if o.get("json"):
        sys.stdout.write(json.dumps(sts, ensure_ascii=False) + "\n")
        return 0
    if not sts:
        sys.stdout.write("No hay ningún puente USB en marcha. Crea uno con:  nexo usb bridge\n")
        return 0
    for s in sts:
        d = s.get("device") or {}
        sys.stdout.write("%s · pid %s · %s · %s (%s:%s) · %s\n" % (
            s.get("name"), s.get("pid"), s.get("state", "?"), d.get("title") or "?", d.get("vid"), d.get("pid"),
            line_str(s["line"]) if s.get("line") else "?"))
        if s.get("link"):
            sys.stdout.write("    puerto serie   %s\n" % s["link"])
        if s.get("rfc2217"):
            sys.stdout.write("    RFC2217        rfc2217://%s\n" % s["rfc2217"])
        if s.get("tcp"):
            sys.stdout.write("    TCP crudo      %s\n" % s["tcp"])
        if s.get("log"):
            sys.stdout.write("    registro       %s\n" % s["log"])
    return 0


def pick_bridges(names, all_, verb):
    sts = read_states()
    if names:
        found = [s for s in sts if s.get("name") in names]
        lost = [n for n in names if n not in [s.get("name") for s in found]]
        if lost:
            raise UsbError("No hay ningún puente llamado %s (mira: nexo usb status)." % ", ".join("«%s»" % n for n in lost), EXIT_NODEV)
        return found
    if len(sts) > 1 and not all_:
        raise UsbError("Hay varios puentes (%s): di cuál (nexo usb %s NOMBRE)%s." % (
            ", ".join(s.get("name") for s in sts), verb, " o usa --all" if verb == "stop" else ""), EXIT_USAGE)
    return sts


def cmd_stop(argv):
    o, pos = parse_args(argv, {"--all": ("all", True), "-a": ("all", True)})
    sts = pick_bridges(pos, o.get("all"), "stop")
    if not sts:
        sys.stdout.write("No hay ningún puente USB en marcha.\n")
        return 0
    bad = 0
    for s in sts:
        pid = int(s["pid"])
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError as e:
            log("No pude avisar a %s (pid %d): %s" % (s.get("name"), pid, e.strerror or e))
            bad = 1
            continue
        end = time.monotonic() + 6.0
        while pid_alive(pid) and time.monotonic() < end:
            time.sleep(0.1)
        if pid_alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
            cleanup_state(os.path.join(state_dir(), s["name"] + ".json"), s)
            log("«%s» no contestó y lo forcé a cerrar." % s.get("name"))
        else:
            sys.stdout.write("Cerrado «%s».\n" % s.get("name"))
    return bad


def cmd_reset(argv):
    o, pos = parse_args(argv, {})
    sts = pick_bridges(pos, False, "reset")
    if not sts:
        raise UsbError("No hay ningún puente USB en marcha: crea uno con «nexo usb bridge».", EXIT_NODEV)
    for s in sts:
        os.kill(int(s["pid"]), signal.SIGUSR1)
        sys.stdout.write("Reinicio enviado a «%s».\n" % s.get("name"))
    return 0


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        sys.stdout.write(HELP)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd in ("version", "--version", "-V"):
        sys.stdout.write("nexo-usb %s\n" % NEXO_USB_VERSION)
        return 0
    cmds = {"list": cmd_list, "permit": cmd_permit, "monitor": cmd_monitor, "bridge": cmd_bridge, "status": cmd_status, "stop": cmd_stop,
            "reset": cmd_reset, "mounts": cmd_mounts, "access": cmd_access, "ls": cmd_ls, "stat": cmd_stat, "cat": cmd_cat, "get": cmd_get,
            "put": cmd_put, "mkdir": cmd_mkdir, "rm": cmd_rm, "mv": cmd_mv, "df": cmd_df, "eject": cmd_eject}
    fn = cmds.get(cmd)
    if fn is None:
        sys.stderr.write("nexo usb: comando desconocido «%s». Prueba: nexo usb help\n" % cmd)
        return EXIT_USAGE
    if "--help" in rest or rest == ["-h"]:
        sys.stdout.write(HELP)
        return 0
    try:
        return fn(rest)
    except UsbError as e:
        sys.stderr.write("nexo usb: %s\n" % e.message)
        return e.code
    except FsError as e:
        u = fs_to_usb(e)
        sys.stderr.write("nexo usb: %s\n" % u.message)
        return u.code
    except Stopped:
        return 0
    except BrokenPipeError:                                  # «nexo usb cat … | head»: quien leía cerró; como cat, sale con 141
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        except OSError:
            pass
        return 141
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
